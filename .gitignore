# local env + creds (only inert examples belong in Git)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
**/*.bak
**/*.bak-*
**/*.bak.*
**/state/portal-auth.json
**/state/panda-auth.json

# generated runtime state
.runtime/
**/.workshop/
.cadgen-budget.json
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# python
__pycache__/
__cadgen__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
.venv*/
/build/
/dist/

# macOS
.DS_Store
.venv-cad/

# Runtime-created toy projects are private and ignored by default. Keep only
# this explanation in Git; a product is published through a verified Factory
# receipt, not by committing a customer's run workspace.
/toys/*
!/toys/README.md
!/toys/leo-false-lantern/
!/toys/leo-false-lantern/**
