# local env + creds (only inert examples belong in Git)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
**/*.bak
**/*.bak-*
**/*.bak.*
**/state/portal-auth.json
**/state/panda-auth.json
# Host credentials stay ignored even when WORKSHOP_HOME points inside a checkout.
**/credentials/inventors/*.env*
**/credentials/factory.env*

# generated runtime state
.runtime/
/.tmp/
/err.log
/outputs/
**/.workshop/
.cadgen-budget.json
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# python
__pycache__/
__cadgen__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
.venv*/
/build/
/dist/

# macOS
.DS_Store
.venv-cad/

# Private runtime workspaces never belong in Git.  Toy output and design
# material are no longer committed either: new files under `toys/`,
# `toys-spec/` and the owner's `inbox/` stay untracked, and
# `tools/sync-to-main.sh` copies them from a worktree into the main checkout.
# Files already tracked there stay tracked and are committed as before.
/toys/
/toys-spec/
/inbox/
/runs/
/state/
/credentials/
/tmp/

# Private planning material (not published)
/docs/inventor-army/
/mockups/

# brainstorm-trend run workspaces (run.json, per-candidate contracts/images)
/brainstorm-trend/

# Host renderer dependencies are installed per machine (workshop doctor).
/tools/render/node_modules/

_prototypes/
# Node dev tooling (Sandcastle agent orchestration).
/node_modules/
