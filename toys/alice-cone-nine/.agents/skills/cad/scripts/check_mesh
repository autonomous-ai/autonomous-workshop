#!/usr/bin/env python3
"""Printability check for an exported STL: watertight, manifold, winding, size.

The mesh half of the print gate, and the sibling of `check_fit`. `check_fit`
builds `part_*.step.py` and reads the STEP source; this reads the STL that
actually goes to the slicer, so the pair is also what catches a stale export --
a source at `min(Z) == 0` beside an artifact that is not. `inspect validate`
answers a third question again: whether the STEP solid is sound.

Unlike its siblings it takes a file, not a project directory, because a project
exports one STL per printable part and each is sliced on its own. That is also
why a non-manifold edge FAILS here: the subject is one printed part, and an edge
four faces share is a defect in one part however normal it is between two. Point
this at a combined assembly STL and pass `--assembly` to get the old warning.

Three defect classes are entangled and are reported so you can tell them apart:

    slivers        triangles with no height -- numerically a line, not a surface
    open edges     reported both with the slivers dropped and with them kept,
                   because dropping a sliver that was stitching a T-junction
                   *creates* the hole the next line then fails on
    non-manifold   edges >2 faces, and the pinched vertices left behind after
                   the edges are split apart

`scripts/repair_mesh` fixes all three in the artifact; the source fixes that stop
them recurring are in `references/repair-loop.md`.

    python "$CAD_SKILL_ROOT/scripts/check_mesh" <part.stl> --bed 256x256x256
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from meshlib import SLIVER_HEIGHT, load_stl, summarize, weld  # noqa: E402


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("stl")
    ap.add_argument("--bed", default="256x256x256", help="printer bed WxDxH in mm")
    ap.add_argument("--min-feature", type=float, default=0.8,
                    help="mm; triangles smaller than this are only reported, not failed")
    ap.add_argument("--sliver-height", type=float, default=SLIVER_HEIGHT,
                    help="mm; a triangle thinner than this altitude is a sliver. "
                         "Height, not area: a needle 0.15 mm long and a nanometre "
                         "wide has an area far above any threshold set near zero.")
    ap.add_argument("--assembly", action="store_true",
                    help="the STL holds several bodies in assembly pose, so demote "
                         "non-manifold edges to a warning")
    args = ap.parse_args()

    verts, faces = weld(load_stl(args.stl))
    m = summarize(verts, faces, sliver_height=args.sliver_height)

    checks = []          # (status, label, detail); status in {PASS, WARN, FAIL}
    def check(status, label, detail):
        checks.append((status, label, detail))

    # --- slivers ---------------------------------------------------------------
    # Tessellation routinely emits a few; they carry no geometry, so drop them
    # before the topology counts rather than letting them fake open edges. The
    # next check reports what the drop cost.
    check("WARN" if m["slivers"] else "PASS", "sliver triangles",
          f"{m['slivers']} under {args.sliver_height:g} mm altitude (dropped)"
          + (f", longest edge {m['sliver_longest_edge']:.3f} mm" if m["slivers"] else ""))

    # --- watertight ------------------------------------------------------------
    where = ""
    if m["boundary"]:
        lo, hi = m["boundary_z"]
        where = (f" in {m['boundary_loops']} loop(s), z "
                 + (f"{lo:.2f}" if abs(hi - lo) < 5e-3 else f"{lo:.2f}..{hi:.2f}"))
    blame = ""
    if m["boundary"] != m["boundary_with_slivers"]:
        blame = (f"; {m['boundary_with_slivers']} with the slivers kept, so "
                 f"{m['boundary'] - m['boundary_with_slivers']} of these are the drop")
    check("PASS" if m["boundary"] == 0 else "FAIL", "watertight (no open edges)",
          f"{m['boundary']} boundary edges{where}{blame}")

    # --- manifold --------------------------------------------------------------
    detail = f"{m['nonmanifold_edges']} edges shared by >2 faces"
    if m["nonmanifold_edges"]:
        detail += f" (up to {m['max_faces_per_edge']})"
    check("PASS" if not m["nonmanifold_edges"] else ("WARN" if args.assembly else "FAIL"),
          "manifold edges", detail)

    # A pinch survives splitting the edges apart and most slicers tolerate it,
    # so it is a note -- but it is what `repair_mesh` leaves behind, and the
    # source fix for it is not the same one.
    check("PASS" if not m["pinched_vertices"] else "WARN", "manifold vertices",
          f"{m['pinched_vertices']} pinched (two cones of material meeting at a point)")

    check("PASS" if m["flipped"] == 0 else "FAIL", "consistent winding",
          f"{m['flipped']} edges with flipped neighbours")

    check("PASS" if m["volume"] > 0 else "FAIL", "positive volume (normals point out)",
          f"{m['volume'] / 1000:.2f} cm3")

    check("PASS", "connected shells",
          f"{m['shells']} (>1 = separate bodies; check they touch, not float)")

    # --- size vs bed ------------------------------------------------------------
    size = m["size"]
    bed = [float(x) for x in args.bed.lower().split("x")]
    fits = all(s <= b for s, b in zip(sorted(size[:2], reverse=True),
                                      sorted(bed[:2], reverse=True))) and size[2] <= bed[2]
    check("PASS" if fits else "FAIL", f"fits {args.bed} bed",
          "x".join(f"{s:.1f}" for s in size) + " mm")

    check("PASS", "small triangles",
          f"{m['tiny']} under {args.min_feature} mm edge scale (thin walls / nozzle limit)")

    print(f"{args.stl}: {m['triangles']} triangles, {m['vertices']} vertices")
    hard_fail = False
    for status, label, detail in checks:
        print(f"  {status}  {label:34s} {detail}")
        hard_fail |= status == "FAIL"
    print("RESULT:", "NOT PRINTABLE AS-IS" if hard_fail else "printable")
    return 1 if hard_fail else 0


if __name__ == "__main__":
    sys.exit(main())
