{"assignment_sha256":"8bfb0478df09dabd86ae69d77f1328b59e5d7fd3f7b29a649b8312dd3041e8e4","blueprint_sha256":"0137a4b232bfb2bdee48b161a3a1d3d547dfeac102f19755ba4a3de7174107ea","cad_project_path":"cad_project","cad_verification_path":"assembled.step.json","cad_verification_sha256":"d42576fd181e484d4bc0597699b847da6a52cac95ffeba5f7ffd9d1f6816cceb","invented_sha256":"b6545181737a5e274c1f2d9ddf0d82fedaefb9290c5d31edd3a711451819267d","kind":"autonomous-workshop.made","made_sha256":"c4db7cd1145bfe5a990a0e8bdc35b35adf15785190ea1986a120c9949f13cb15","product":{"calculated_geometry":{"chamber_target_volumes_mm3":{"crickets":6000.0,"frog-song":12000.0,"rain":8000.0},"event_count":46,"field_counts":{"crickets":20,"frog-song":9,"rain":17},"port_brep_areas_mm2":{"crickets":23.9996,"frog-song":14.9996,"rain":17.9996}},"category":"hand-powered passive acoustic desktop toy","envelope_mm":{"depth":120.0,"height_at_design_travel":51.65,"width":120.0},"evidence":{"assembled_step":"assembled.step","assembled_stl":"assembled.stl","cad_project":"cad_project","cad_verification":"assembled.step.json","declared_output_reproducibility":"cad_project/measure/reproducibility.md","final_pipeline":"CAD-VERIFICATION.md","geometry_audit":"cad_project/measure/acoustic_geometry.json","motion_manifest":"cad_project/measure/motion.json","renders":["cad_project/renders/isometric.png","cad_project/renders/top.png","cad_project/renders/front.png"],"visual_review":"cad_project/measure/visual_review.md"},"interaction":{"primary_control":"Turn the broad outer wheel clockwise by hand.","reset":"The 360-degree path is continuous; each field is separated by a 7-degree rib-free lane.","reverse_use":"Reverse rotation is reserved as a geometric clearing direction and has not been physically tested.","sequence":["rain","frog-song","crickets"]},"kind":"autonomous-workshop.make-product","limitations":["No exact physical print, slicing study, clearance coupon, or assembly trial has been performed.","No microphone, loudness, pitch, hearing-safety, or human listening measurement establishes sound character, recognition, pleasantness, or relative voice strength.","No gravity free-fall, inversion, shake, walking, tipping, retention, bearing-noise, or repeated-cycle wear test has been performed.","The dry chamber labyrinths are serviceable seams and are not claimed airtight or tuned Helmholtz resonators.","Digital print-ready status means the declared CAD, fit, motion, mesh, and 0.8 mm wall gates passed; it is not a claim of successful manufacture."],"make_refinement":"The exact Ø14.5 wheel bore and full z=21–25 lower journal land are retained. Above z=25 the wheel uses one rounded 210-degree C-profile, replacing the Invent sketch's sub-nozzle 0.15 mm radial relief and opening the deliberate keeper service route after cap removal.","make_retry_repair":"The combined assembly retains native part labels but omits optional per-component STEP presentation colors, removing process-dependent style-record ordering without changing topology, geometry, or bounds. The six generated thickness reports use the host-equivalent relative `project` path. After a third host rejection proved that those 21 files were still not the complete mutable set, the active CAD handoff was rematerialized without run-specific `__cadgen__` caches, and the time-bearing PASS pipeline record was preserved at the product root outside the verifier-mutated project.","material_and_print":{"assembly_policy":"dry assembly; no glue, beads, batteries, magnets, string, metal, purchased reeds, or flexible material","material":"ordinary rigid FDM filament such as PLA or PETG","nominal_layer_height_mm":0.2,"nonprinted_hardware":false,"nozzle_mm":0.4,"supports_intended":false},"physical_test_status":"not-run","playtest_status":"not-run","printed_parts":[{"id":"base","name":"Three-chamber resonator bowl and spindle","step":"cad_project/part_base.step","stl":"cad_project/part_base.stl"},{"id":"rib-deck","name":"Indexed annular sound dec