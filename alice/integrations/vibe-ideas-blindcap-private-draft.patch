+def _project_source_files(project: Path) -> dict[str, bytes]:
+    if not project.is_absolute():
+        raise ImportRefused("--project must be an absolute path")
+    if project.is_symlink() or not project.is_dir():
+        raise ImportRefused("--project must be a real project directory")
+    files: dict[str, bytes] = {}
+    expanded = 0
+    for path in sorted(project.rglob("*")):
+        relative = path.relative_to(project)
+        if path.is_symlink():
+            raise ImportRefused(f"project contains symlink: {relative.as_posix()}")
+        if path.is_dir():
+            continue
+        if not path.is_file():
+            raise ImportRefused(f"project contains non-regular entry: {relative.as_posix()}")
+        if (
+            relative.parts
+            and relative.parts[0] == "build"
+            or any(
+                part in {"__pycache__", ".git", ".panda", ".venv", "venv", "node_modules"}
+                for part in relative.parts
+            )
+            or path.name == ".DS_Store"
+            or path.suffix.lower() in {".pyc", ".pyo"}
+        ):
+            continue
+        rel = _safe_archive_name(relative.as_posix())
+        if rel == MANIFEST_PATH:
+            raise ImportRefused(
+                f"project contains stale {MANIFEST_PATH}; prepare mode owns that file"
+            )
+        if len(relative.parts) == 1 and rel.lower().endswith(".step.json"):
+            raise ImportRefused(f"project contains unbound root STEP sidecar: {rel}")
+        try:
+            size = path.stat().st_size
+            if size > MAX_FILE_BYTES:
+                raise ImportRefused(
+                    f"project file exceeds {MAX_FILE_BYTES} bytes: {rel}"
+                )
+            raw = path.read_bytes()
+        except OSError as exc:
+            raise ImportRefused(f"cannot read project file {rel}: {type(exc).__name__}") from None
+        if len(raw) > MAX_FILE_BYTES:
+            raise ImportRefused(f"project file exceeds {MAX_FILE_BYTES} bytes: {rel}")
+        expanded += len(raw)
+        if expanded > MAX_EXPANDED_BYTES:
+            raise ImportRefused(
+                f"project exceeds the {MAX_EXPANDED_BYTES}-byte expanded archive limit"
+            )
+        if len(files) >= MAX_FILES - 1:
+            raise ImportRefused(f"project would exceed {MAX_FILES} archive entries")
+        if _secret_shaped(rel, raw):
+            raise ImportRefused(f"project contains secret-shaped file/content: {rel}")
+        files[f"{ARCHIVE_ROOT}/{rel}"] = raw
+    return files
+
+
+def _page_media_paths(raw: bytes) -> list[str]:
+    data = _json_no_duplicates(raw, label="Factory page manifest")
+    roles = data.get("media_roles") if isinstance(data, dict) else None
+    if not isinstance(roles, dict) or not roles:
+        raise ImportRefused("Factory page manifest has no media_roles")
+    paths: list[str] = []
+    for role, value in roles.items():
+        if not isinstance(role, str) or not isinstance(value, str):
+            raise ImportRefused("Factory page media_roles are malformed")
+        relative = _safe_archive_name(value)
+        paths.append(relative)
+    return paths
+
+
+def prepare_archive(
+    *,
+    project: Path,
+    page_manifest_path: Path,
+    title: str,
+    prompt: str,
+    output: Path,
+) -> PreparedArchive:
+    """Build and fully re-validate the deterministic one-folder Factory ZIP."""
+    title = title.strip()
+    prompt = prompt.strip()
+    if not title or len(title) > 120:
+        raise ImportRefused("--title must contain 1..120 characters")
+    if not prompt or len(prompt) > MAX_PROMPT_CHARS:
+        raise ImportRefused(f"--prompt must contain 1..{MAX_PROMPT_CHARS} characters")
+    if not output.is_absolute():
+        raise ImportRefused("--output must be an absolute path")
+    if output.exists() or output.is_symlink():
+        raise ImportRefused("--output already exists; refusing to overwrite a prepared operation")
+    if not page_manifest_path.is_absolute() or page_manifest_path.is_symlink() or not page_manifest_path.is_file():
+        raise ImportRefused("--page-manifest must be an absolute regular non-symlink file")
+    page_raw = page_manifest_path.read_bytes()
+    if not page_raw or len(page_raw) > MAX_JSON_BYTES:
+        raise ImportRefused("page manifest is outside the bounded JSON size")
+
+    files = _project_source_files(project)
+    page_entry = f"{ARCHIVE_ROOT}/content/factory-page.json"
+    existing_page = files.get(page_entry)
+    if existing_page is not None and existing_page != page_raw:
+        raise ImportRefused("project/content/factory-page.json differs from --page-manifest")
+    files[page_entry] = page_raw
+    game_root = page_manifest_path.parent.parent
+    for relative in _page_media_paths(page_raw):
+        destination = f"{ARCHIVE_ROOT}/{relative}"
+        candidates = [project / relative, game_root / relative]
+        available = [path for path in candidates if path.is_file() and not path.is_symlink()]
+        if not available:
+            raise ImportRefused(f"page media is missing from project/game folder: {relative}")
+        if any(path.stat().st_size > MAX_MEDIA_BYTES for path in available):
+            raise ImportRefused(f"page media exceeds {MAX_MEDIA_BYTES} bytes: {relative}")
+        payloads = [path.read_bytes() for path in available]
+        if any(raw != payloads[0] for raw in payloads[1:]):
+            raise ImportRefused(f"project and game copies of page media differ: {relative}")
+        if destination in files and files[destination] != payloads[0]:
+            raise ImportRefused(f"collected page media differs from project copy: {relative}")
+        files[destination] = payloads[0]
+
+    brief_entry = f"{ARCHIVE_ROOT}/brief.json"
+    external_brief = game_root / "brief.json"
+    if brief_entry not in files:
+        if external_brief.is_symlink() or not external_brief.is_file():
+            raise ImportRefused("gate-bound brief.json is absent from project and game folder")
+        if external_brief.stat().st_size > MAX_JSON_BYTES:
+            raise ImportRefused("external brief.json exceeds the bounded JSON limit")
+        files[brief_entry] = external_brief.read_bytes()
+    elif external_brief.is_file() and not external_brief.is_symlink():
+        if external_brief.stat().st_size > MAX_JSON_BYTES:
+            raise ImportRefused("external brief.json exceeds the bounded JSON limit")
+        if files[brief_entry] != external_brief.read_bytes():
+            raise ImportRefused("project/brief.json differs from game brief.json")
+
+    if len(files) + 1 > MAX_FILES:
+        raise ImportRefused(f"prepared archive would exceed {MAX_FILES} entries")
+    if sum(len(raw) for raw in files.values()) > MAX_EXPANDED_BYTES:
+        raise ImportRefused("prepared archive would exceed expanded-byte limit")
+    records = [
+        {"bytes": len(raw), "path": path, "sha256": sha256_bytes(raw)}
+        for path, raw in sorted(files.items())
+    ]
+    manifest = manifest_for_files(title=title, prompt=prompt, files=records)
+    manifest_raw = canonical_json(manifest)
+
+    output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    fd, temp_name = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
+    os.close(fd)
+    temp = Path(temp_name)
+    try:
+        with zipfile.ZipFile(
+            temp, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9
+        ) as archive:
+            for name, raw in [*sorted(files.items()), (MANIFEST_ARCHIVE_PATH, manifest_raw)]:
+                info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
+                info.create_system = 3
+                info.external_attr = (stat.S_IFREG | 0o644) << 16
+                info.compress_type = zipfile.ZIP_DEFLATED
+                archive.writestr(info, raw, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)
+        digest = sha256_bytes(temp.read_bytes())
+        prepared = validate_archive(temp.resolve(), digest, title=title, prompt=prompt)
+        validate_release_gate(prepared)
+        validate_page_manifest(page_manifest_path, prepared, title=title)
+        validate_game_handoff(prepared, page_manifest_path)
+        os.replace(temp, output)
+        os.chmod(output, 0o644)
+        return dataclasses.replace(prepared, path=output)
+    finally:
+        with contextlib.suppress(FileNotFoundError):
+            temp.unlink()
+
+
+def read_stored_refresh_token(auth_path: Path) -> str:
+    if not auth_path.is_absolute():
+        raise ImportRefused("--auth must be an absolute path")
+    if auth_path.is_symlink():
+        raise ImportRefused("stored desktop auth must not be a symlink")
+    try:
+        info = auth_path.stat()
+    except OSError as exc:
+        raise ImportRefused(f"cannot stat stored desktop auth: {exc.strerror or type(exc).__name__}") from None
+    if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
+        raise ImportRefused("stored desktop auth must be a regular 0600 file")
+    try:
+        raw = auth_path.read_bytes()
+    except OSError as exc:
+        raise ImportRefused(f"cannot read stored desktop auth: {exc.strerror or type(exc).__name__}") from None
+    if len(raw) > MAX_JSON_BYTES:
+        raise ImportRefused("stored desktop auth is unexpectedly large")
+    data = _json_no_duplicates(raw, label="stored desktop auth")
+    if not isinstance(data, dict):
+        raise ImportRefused("stored desktop auth is not an object")
+    token = data.get("refresh_token")
+    if not isinstance(token, str) or not token.strip() or len(token) > 16_384:
+        raise ImportRefused("stored desktop auth has no usable refresh_token")
+    return token
+
+
+def _journal_identity(
+    prepared: PreparedArchive, page: PageManifest, title: str, prompt: str
+) -> dict[str, Any]:
+    return {
+        "kind": JOURNAL_KIND,
+        "manifest_path": MANIFEST_ARCHIVE_PATH,
+        "manifest_sha256": prepared.manifest_sha256,
+        "operation_id": operation_id(prepared.sha256, title, prompt),
+        "page_manifest_entry": page.entry,
+        "page_manifest_path": str(page.path),
+        "page_manifest_sha256": page.sha256,
+        "prompt_sha256": prompt_sha256(prompt),
+        "schema_version": SCHEMA_VERSION,
+        "title": title,
+        "zip_bytes": prepared.size,
+        "zip_path": str(prepared.path),
+        "zip_sha256": prepared.sha256,
+    }
+
+
+def _validate_journal_shape(data: Any) -> dict[str, Any]:
+    if not isinstance(data, dict):
+        raise ImportRefused("operation journal is not an object")
+    required = {
+        "kind",
+        "manifest_path",
+        "manifest_sha256",
+        "operation_id",
+        "prompt_sha256",
+        "schema_version",
+        "title",
+        "zip_bytes",
+        "zip_path",
+        "zip_sha256",
+        "state",
+        "prepared_at",
+        "post_attempted",
+        "sending_at",
+        "ambiguous_at",
+        "confirmed_at",
+        "reason",
+        "design",
+        "page_state",
+        "page_reason",
+        "page_operations",
+        "page_confirmed_at",
+        "slice_state",
+        "slice_reason",
+        "slice_post_attempted",
+        "slice_sending_at",
+        "slice_job",
+        "slice_done_at",
+        "completed_at",
+        "page_manifest_entry",
+        "page_manifest_path",
+        "page_manifest_sha256",
+    }
+    if set(data) != required:
+        raise ImportRefused("operation journal fields are not exact")
+    if data.get("kind") != JOURNAL_KIND or data.get("schema_version") != SCHEMA_VERSION:
+        raise ImportRefused("operation journal schema is unsupported")
+    if data.get("state") not in {"prepared", "sending", "ambiguous", "confirmed"}:
+        raise ImportRefused("operation journal has invalid state")
+    if not isinstance(data.get("post_attempted"), bool):
+        raise ImportRefused("operation journal has invalid post_attempted")
+    if data.get("page_state") not in {"pending", "applying", "ambiguous", "confirmed"}:
+        raise ImportRefused("operation journal has invalid page_state")
+    operations = data.get("page_operations")
+    if not isinstance(operations, dict) or set(operations) != {"use_case", "story_blocks"}:
+        raise ImportRefused("operation journal has invalid page_operations")
+    for name, operation in operations.items():
+        if not isinstance(operation, dict) or set(operation) != {
+            "attempts",
+            "confirmed_at",
+            "sending_at",
+            "state",
+        }:
+            raise ImportRefused(f"operation journal has invalid page operation {name}")
+        if operation.get("state") not in {"pending", "sending", "ambiguous", "confirmed"}:
+            raise ImportRefused(f"operation journal has invalid page operation state {name}")
+    if data.get("slice_state") not in {
+        "pending",
+        "checking",
+        "sending",
+        "ambiguous",
+        "polling",
+        "done",
+        "failed",
+    }:
+        raise ImportRefused("operation journal has invalid slice_state")
+    if not isinstance(data.get("slice_post_attempted"), bool):
+        raise ImportRefused("operation journal has invalid slice_post_attempted")
+    return data
+
+
+def _atomic_write_0600(path: Path, data: dict[str, Any]) -> None:
+    if path.exists() and path.is_symlink():
+        raise ImportRefused("operation journal must not be a symlink")
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    raw = canonical_json(data)
+    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+    temp_path = Path(temp_name)
+    try:
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "wb", closefd=True) as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_path, path)
+        os.chmod(path, 0o600)
+        dir_fd = os.open(path.parent, os.O_RDONLY)
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+    finally:
+        with contextlib.suppress(FileNotFoundError):
+            temp_path.unlink()
+
+
+def load_or_prepare_journal(
+    path: Path,
+    prepared: PreparedArchive,
+    page: PageManifest,
+    *,
+    title: str,
+    prompt: str,
+) -> dict[str, Any]:
+    if not path.is_absolute():
+        raise ImportRefused("--journal must be an absolute path")
+    identity = _journal_identity(prepared, page, title, prompt)
+    if path.exists():
+        if path.is_symlink():
+            raise ImportRefused("operation journal must not be a symlink")
+        mode = stat.S_IMODE(path.stat().st_mode)
+        if mode != 0o600:
+            raise ImportRefused("existing operation journal must have mode 0600")
+        raw = path.read_bytes()
+        if len(raw) > MAX_JSON_BYTES:
+            raise ImportRefused("operation journal is unexpectedly large")
+        data = _validate_journal_shape(_json_no_duplicates(raw, label="operation journal"))
+        if canonical_json(data) != raw:
+            raise ImportRefused("operation journal is not canonical JSON")
+        for key, value in identity.items():
+            if data.get(key) != value:
+                raise ImportRefused(f"operation journal does not match exact {key}")
+        return data
+    data = {
+        **identity,
+        "ambiguous_at": None,
+        "confirmed_at": None,
+        "design": None,
+        "completed_at": None,
+        "page_confirmed_at": None,
+        "page_operations": {
+            "story_blocks": {
+                "attempts": 0,
+                "confirmed_at": None,
+                "sending_at": None,
+                "state": "pending",
+            },
+            "use_case": {
+                "attempts": 0,
+                "confirmed_at": None,
+                "sending_at": None,
+                "state": "pending",
+            },
+        },
+        "page_reason": None,
+        "page_state": "pending",
+        "post_attempted": False,
+        "prepared_at": utc_now(),
+        "reason": None,
+        "sending_at": None,
+        "slice_done_at": None,
+        "slice_job": None,
+        "slice_post_attempted": False,
+        "slice_reason": None,
+        "slice_sending_at": None,
+        "slice_state": "pending",
+        "state": "prepared",
+    }
+    _atomic_write_0600(path, data)
+    return data
+
+
+def _set_state(
+    path: Path,
+    journal: dict[str, Any],
+    state: str,
+    *,
+    reason: str | None = None,
+    design: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    updated = dict(journal)
+    updated["state"] = state
+    updated["reason"] = reason
+    if state == "sending":
+        updated["sending_at"] = utc_now()
+        updated["post_attempted"] = True
+    elif state == "ambiguous":
+        updated["ambiguous_at"] = utc_now()
+    elif state == "confirmed":
+        updated["confirmed_at"] = utc_now()
+        updated["design"] = design
+    _atomic_write_0600(path, updated)
+    return updated
+
+
+def _parse_time(value: Any) -> dt.datetime | None:
+    if not isinstance(value, str) or not value:
+        return None
+    try:
+        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if parsed.tzinfo is None:
+        return None
+    return parsed.astimezone(dt.timezone.utc)
+
+
+def _list_all_designs(http: HttpTransport, access: str) -> list[dict[str, Any]]:
+    items: list[dict[str, Any]] = []
+    offset = 0
+    total: int | None = None
+    while total is None or offset < total:
+        if offset >= MAX_DESIGNS_SCANNED:
+            raise ImportRefused(
+                f"account has more than {MAX_DESIGNS_SCANNED} designs; "
+                "bounded duplicate reconciliation is incomplete"
+            )
+        page = http.list_designs(access, offset=offset, limit=PAGE_SIZE)
+        raw_items = page.get("items") if isinstance(page, dict) else None
+        raw_total = page.get("total") if isinstance(page, dict) else None
+        if not isinstance(raw_items, list) or isinstance(raw_total, bool) or not isinstance(raw_total, int):
+            raise RemoteError("GET /me/designs returned an invalid bounded envelope")
+        if raw_total < 0 or raw_total > 1_000_000:
+            raise RemoteError("GET /me/designs returned an invalid total")
+        if len(raw_items) > PAGE_SIZE:
+            raise RemoteError("GET /me/designs returned too many items")
+        for item in raw_items:
+            if not isinstance(item, dict):
+                raise RemoteError("GET /me/designs returned an invalid design item")
+            items.append(item)
+        total = raw_total
+        offset += len(raw_items)
+        if not raw_items and offset < total:
+            raise RemoteError("GET /me/designs pagination stopped before total")
+    return items
+
+
+def _candidate_time_matches(
+    candidate: dict[str, Any], journal: dict[str, Any], window_seconds: int
+) -> bool:
+    observed = _parse_time(candidate.get("updated_at") or candidate.get("created_at"))
+    reference = _parse_time(journal.get("sending_at") or journal.get("prepared_at"))
+    return bool(
+        observed
+        and reference
+        and abs((observed - reference).total_seconds()) <= window_seconds
+    )
+
+
+def _validate_detail_identity(
+    detail: dict[str, Any], title: str, metadata: dict[str, Any] | None = None
+) -> str | None:
+    if detail.get("title") != title:
+        return "exact design title differs"
+    if detail.get("status") != "draft":
+        return "design is not private draft"
+    if detail.get("published_history_id") not in (None, ""):
+        return "design has a published history"
+    if detail.get("published_at") not in (None, "", "0001-01-01T00:00:00Z"):
+        return "design has a published timestamp"
+    if metadata is not None:
+        if detail.get("description") != metadata["description"]:
+            return "design description differs from page metadata"
+        if detail.get("tags") != metadata["tags"]:
+            return "design tags differ from page metadata"
+        category = detail.get("category")
+        if not isinstance(category, dict) or category.get("slug") != metadata["category"]:
+            return "design category differs from page metadata"
+        license_value = detail.get("license")
+        if not isinstance(license_value, dict) or license_value.get("type") != metadata["license"]:
+            return "design license differs from page metadata"
+    for key in ("id", "slug", "current_history_id", "project_url"):
+        if not isinstance(detail.get(key), str) or not detail[key].strip():
+            return f"design has no {key}"
+    project = urllib.parse.urlsplit(detail["project_url"])
+    if (
+        project.scheme != "https"
+        or not project.netloc
+        or project.username is not None
+        or project.password is not None
+        or project.query
+        or project.fragment
+    ):
+        return "design project_url is not an immutable HTTPS folder URL"
+    return None
+
+
+def _remote_manifest_matches(
+    http: HttpTransport, detail: dict[str, Any], prepared: PreparedArchive
+) -> bool:
+    url = _project_file_url(detail, MANIFEST_PATH)
+    raw = http.fetch_bytes(url, max_bytes=MAX_JSON_BYTES)
+    if len(raw) > MAX_JSON_BYTES:
+        return False
+    if sha256_bytes(raw) != prepared.manifest_sha256 or raw != prepared.manifest_bytes:
+        return False
+    parsed = _json_no_duplicates(raw, label="remote embedded operation manifest")
+    return parsed == prepared.manifest and canonical_json(parsed) == raw
+
+
+def _design_record(detail: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "current_history_id": detail["current_history_id"],
+        "id": detail["id"],
+        "project_url": detail["project_url"],
+        "slug": detail["slug"],
+        "status": detail["status"],
+        "title": detail["title"],
+    }
+
+
+def _detail_record_problem(
+    detail: dict[str, Any], record: dict[str, Any]
+) -> str | None:
+    for key in (
+        "current_history_id",
+        "id",
+        "project_url",
+        "slug",
+        "status",
+        "title",
+    ):
+        if detail.get(key) != record.get(key):
+            return f"design {key} moved from the confirmed imported draft"
+    return None
+
+
+def reconcile(
+    http: HttpTransport,
+    access: str,
+    prepared: PreparedArchive,
+    journal: dict[str, Any],
+    page: PageManifest,
+    *,
+    title: str,
+    window_seconds: int,
+) -> tuple[str, dict[str, Any] | None]:
+    """Return ``(none|confirmed|ambiguous, design)`` without any remote write."""
+    designs = _list_all_designs(http, access)
+    same_title = [item for item in designs if item.get("title") == title]
+    if not same_title:
+        return "none", None
+
+    eligible: list[dict[str, Any]] = []
+    wrong_status = False
+    for item in same_title:
+        if item.get("status") != "draft":
+            wrong_status = True
+            continue
+        if not _candidate_time_matches(item, journal, window_seconds):
+            continue
+        slug = item.get("slug")
+        if not isinstance(slug, str) or not slug:
+            continue
+        detail = http.get_design(access, slug)
+        if _validate_detail_identity(detail, title, page.metadata) is not None:
+            continue
+        if _remote_manifest_matches(http, detail, prepared):
+            eligible.append(detail)
+
+    if len(eligible) == 1 and len(same_title) == 1 and not wrong_status:
+        return "confirmed", _design_record(eligible[0])
+    # A title collision is terminal even when its timestamp or manifest does not
+    # match.  Importing anyway could create a duplicate; guessing is forbidden.
+    return "ambiguous", None
+
+
+def _verify_created(
+    http: HttpTransport,
+    access: str,
+    created: dict[str, Any],
+    prepared: PreparedArchive,
+    page: PageManifest,
+    *,
+    title: str,
+) -> dict[str, Any]:
+    problem = _validate_detail_identity(created, title, page.metadata)
+    if problem:
+        raise RemoteError(f"201 import response failed closed: {problem}")
+    detail = http.get_design(access, created["slug"])
+    problem = _validate_detail_identity(detail, title, page.metadata)
+    if problem:
+        raise RemoteError(f"exact design readback failed closed: {problem}")
+    if detail["id"] != created["id"] or detail["slug"] != created["slug"]:
+        raise RemoteError("exact design readback identity differs from 201 response")
+    if not _remote_manifest_matches(http, detail, prepared):
+        raise RemoteError("immutable project manifest/hash readback differs")
+    return _design_record(detail)
+
+
+def _project_file_url(detail: dict[str, Any], relative: str) -> str:
+    relative = _safe_archive_name(relative)
+    base = detail["project_url"]
+    if not base.endswith("/"):
+        base += "/"
+    base_parts = urllib.parse.urlsplit(base)
+    if (
+        base_parts.scheme != "https"
+        or not base_parts.netloc
+        or base_parts.username is not None
+        or base_parts.password is not None
+        or base_parts.query
+        or base_parts.fragment
+    ):
+        raise ImportRefused("project_url is not a safe immutable HTTPS folder")
+    # Encode every archive-name segment ourselves. In particular, a literal
+    # ``%2e%2e`` filename must become ``%252e%252e`` rather than being decoded
+    # by a CDN/proxy into path traversal after urljoin's lexical check.
+    encoded_relative = "/".join(
+        urllib.parse.quote(segment, safe="")
+        for segment in PurePosixPath(relative).parts
+    )
+    return urllib.parse.urlunsplit(
+        (
+            "https",
+            base_parts.netloc,
+            base_parts.path + encoded_relative,
+            "",
+            "",
+        )
+    )
+
+
+def _resolve_page_value(value: Any, detail: dict[str, Any]) -> Any:
+    if isinstance(value, str) and value.startswith("${PROJECT_URL}"):
+        relative = _placeholder_media_path(value, label="page media placeholder")
+        return _project_file_url(detail, relative)
+    if isinstance(value, list):
+        return [_resolve_page_value(item, detail) for item in value]
+    if isinstance(value, dict):
+        return {key: _resolve_page_value(item, detail) for key, item in value.items()}
+    return value
+
+
+def _verify_page_files(
+    http: HttpTransport,
+    detail: dict[str, Any],
+    prepared: PreparedArchive,
+    page: PageManifest,
+) -> None:
+    if not page.entry.startswith(ARCHIVE_ROOT + "/"):
+        raise ImportRefused("page manifest archive entry is outside project wrapper")
+    page_url = _project_file_url(detail, page.entry[len(ARCHIVE_ROOT) + 1 :])
+    remote_page = http.fetch_bytes(page_url, max_bytes=MAX_JSON_BYTES)
+    if remote_page != page.raw or sha256_bytes(remote_page) != page.sha256:
+        raise RemoteError("immutable page manifest readback differs from prepared archive")
+    for role, relative in page.media_roles.items():
+        expected = prepared.files[f"{ARCHIVE_ROOT}/{relative}"]
+        remote = http.fetch_bytes(
+            _project_file_url(detail, relative), max_bytes=MAX_MEDIA_BYTES
+        )
+        if remote != expected or sha256_bytes(remote) != sha256_bytes(expected):
+            raise RemoteError(f"immutable media readback differs for role {role}")
+    cover_paths = sorted(
+        path
+        for path in prepared.files
+        if re.fullmatch(r"project/[^/]+_review/_(?:assembled|qa)\.png", path)
+    )
+    if len(cover_paths) != 2:
+        raise RemoteError("prepared archive does not have exactly two canonical covers")
+    for archive_path in cover_paths:
+        expected = prepared.files[archive_path]
+        remote = http.fetch_bytes(
+            _project_file_url(
+                detail, archive_path[len(ARCHIVE_ROOT) + 1 :]
+            ),
+            max_bytes=MAX_MEDIA_BYTES,
+        )
+        if remote != expected:
+            raise RemoteError(
+                f"immutable canonical cover readback differs: {PurePosixPath(archive_path).name}"
+            )
+
+
+def _page_operation_update(
+    journal_path: Path,
+    journal: dict[str, Any],
+    name: str,
+    state: str,
+) -> dict[str, Any]:
+    updated = dict(journal)
+    operations = {
+        key: dict(value) for key, value in journal["page_operations"].items()
+    }
+    operation = operations[name]
+    operation["state"] = state
+    if state == "sending":
+        operation["attempts"] += 1
+        operation["sending_at"] = utc_now()
+    if state == "confirmed":
+        operation["confirmed_at"] = utc_now()
+    operations[name] = operation
+    updated["page_operations"] = operations
+    updated["page_state"] = "applying" if state != "ambiguous" else "ambiguous"
+    if state == "ambiguous":
+        updated["page_reason"] = f"{name} write outcome is not yet exact on readback"
+    _atomic_write_0600(journal_path, updated)
+    return updated
+
+
+def _page_confirmed(
+    journal_path: Path, journal: dict[str, Any]
+) -> dict[str, Any]:
+    updated = dict(journal)
+    updated["page_state"] = "confirmed"
+    updated["page_reason"] = None
+    updated["page_confirmed_at"] = utc_now()
+    _atomic_write_0600(journal_path, updated)
+    return updated
+
+
+def apply_rich_page(
+    http: HttpTransport,
+    access: str,
+    prepared: PreparedArchive,
+    page: PageManifest,
+    journal_path: Path,
+    journal: dict[str, Any],
+) -> dict[str, Any]:
+    """Idempotently apply and read back the two owner-only page operations."""
+    slug = journal["design"]["slug"]
+
+    def checked_detail() -> dict[str, Any]:
+        current = http.get_design(access, slug)
+        problem = _validate_detail_identity(
+            current, journal["title"], page.metadata
+        ) or _detail_record_problem(current, journal["design"])
+        if problem:
+            raise RemoteError(f"rich-page preflight failed closed: {problem}")
+        return current
+
+    detail = checked_detail()
+    _verify_page_files(http, detail, prepared, page)
+    expected_use = _resolve_page_value(page.use_case, detail)
+    expected_story = _resolve_page_value(page.story_blocks, detail)
+    operations = (
+        (
+            "use_case",
+            expected_use,
+            lambda: http.patch_json(
+                access,
+                f"/designs/{urllib.parse.quote(slug, safe='')}/use-case",
+                expected_use,
+            ),
+        ),
+        (
+            "story_blocks",
+            expected_story,
+            lambda: http.put_json(
+                access,
+                f"/designs/{urllib.parse.quote(slug, safe='')}/story-blocks",
+                {"story_blocks": expected_story},
+            ),
+        ),
+    )
+    for name, expected, writer in operations:
+        detail = checked_detail()
+        actual = detail.get(name)
+        if actual == expected:
+            if journal["page_operations"][name]["state"] != "confirmed":
+                journal = _page_operation_update(
+                    journal_path, journal, name, "confirmed"
+                )
+            continue
+        # PATCH use-case and PUT story-blocks are exact, owner-only idempotent
+        # replacements.  Persist before each attempt; after a crash, readback is
+        # checked before the same replacement can be repeated.
+        journal = _page_operation_update(journal_path, journal, name, "sending")
+        try:
+            status, _ = writer()
+            if status != 200:
+                raise RemoteError(f"{name} write returned HTTP {status}")
+            detail = checked_detail()
+            if detail.get(name) != expected:
+                raise RemoteError(f"{name} exact readback differs")
+            journal = _page_operation_update(
+                journal_path, journal, name, "confirmed"
+            )
+        except Exception:
+            # One immediate GET can prove a lost response.  Otherwise keep the
+            # stage ambiguous; a restart will GET before its safe replacement.
+            with contextlib.suppress(Exception):
+                detail = checked_detail()
+                if detail.get(name) == expected:
+                    journal = _page_operation_update(
+                        journal_path, journal, name, "confirmed"
+                    )
+                    continue
+            return _page_operation_update(
+                journal_path, journal, name, "ambiguous"
+            )
+    detail = checked_detail()
+    if detail.get("use_case") != expected_use or detail.get("story_blocks") != expected_story:
+        raise RemoteError("final rich-page readback differs")
+    _verify_page_files(http, detail, prepared, page)
+    return _page_confirmed(journal_path, journal)
+
+
+def _slice_update(
+    journal_path: Path,
+    journal: dict[str, Any],
+    state: str,
+    *,
+    reason: str | None = None,
+    job: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    updated = dict(journal)
+    updated["slice_state"] = state
+    updated["slice_reason"] = reason
+    if job is not None:
+        updated["slice_job"] = {
+            key: job.get(key) for key in ("id", "design_id", "history_id", "status")
+        }
+    if state == "sending":
+        updated["slice_post_attempted"] = True
+        updated["slice_sending_at"] = utc_now()
+    if state == "done":
+        updated["slice_done_at"] = utc_now()
+        updated["completed_at"] = utc_now()
+    _atomic_write_0600(journal_path, updated)
+    return updated
+
+
+def _slice_done_readback(
+    http: HttpTransport,
+    access: str,
+    slug: str,
+    job: dict[str, Any],
+    journal: dict[str, Any],
+) -> str | None:
+    if not isinstance(job.get("id"), str) or not job["id"]:
+        return "done slice has no exact job id"
+    if job.get("design_id") != journal["design"]["id"]:
+        return "slice job design differs from imported draft"
+    if job.get("history_id") != journal["design"]["current_history_id"]:
+        return "slice job history differs from imported history"
+    totals = job.get("totals")
+    if not isinstance(totals, dict) or not totals:
+        return "done slice has no totals"
+    if totals.get("part_count") != 28:
+        return "done slice does not measure the bill's exact 28 printed pieces"
+    for field in ("weight_g", "volume_cm3", "length_mm", "print_time_seconds"):
+        value = totals.get(field)
+        if (
+            isinstance(value, bool)
+            or not isinstance(value, (int, float))
+            or not math.isfinite(value)
+            or value <= 0
+        ):
+            return f"done slice has no positive finite {field}"
+    materials = totals.get("materials")
+    if (
+        not isinstance(materials, list)
+        or not materials
+        or any(not isinstance(value, str) or not value.strip() for value in materials)
+    ):
+        return "done slice has no exact material list"
+    detail = http.get_design(access, slug)
+    identity_problem = _validate_detail_identity(
+        detail, journal["title"]
+    ) or _detail_record_problem(detail, journal["design"])
+    if identity_problem:
+        return f"slice readback identity failed closed: {identity_problem}"
+    usage = detail.get("material_usage")
+    specs = detail.get("print_specs")
+    if not isinstance(usage, dict) or not usage or not isinstance(specs, dict) or not specs:
+        return "done slice has not published material_usage and print_specs"
+    for field in ("weight_g", "volume_cm3", "length_mm"):
+        if usage.get(field) != totals[field]:
+            return f"published material_usage {field} differs from slice totals"
+    if usage.get("materials") != materials:
+        return "published material_usage materials differ from slice totals"
+    if detail.get("print_time_seconds") != totals["print_time_seconds"]:
+        return "published print_time_seconds differs from slice totals"
+    if specs.get("part_count") != 28:
+        return "published print_specs does not report the bill's exact 28 pieces"
+    if specs.get("weight_g") != totals["weight_g"]:
+        return "published print_specs weight differs from slice totals"
+    expected_minutes = math.ceil(totals["print_time_seconds"] / 60)
+    if specs.get("print_time_minutes") != expected_minutes:
+        return "published print_specs time differs from slice totals"
+    if specs.get("materials") != materials:
+        return "published print_specs materials differ from slice totals"
+    totals_have_dimensions = "dimensions_mm" in totals
+    specs_have_dimensions = "dimensions_mm" in specs
+    if totals_have_dimensions != specs_have_dimensions:
+        return "printed dimensions are present on only one slice readback"
+    if totals_have_dimensions:
+        dimensions = totals["dimensions_mm"]
+        published_dimensions = specs["dimensions_mm"]
+        for label, value in (
+            ("slice totals", dimensions),
+            ("published print_specs", published_dimensions),
+        ):
+            if not isinstance(value, dict) or set(value) != {"x", "y", "z"}:
+                return f"{label} has no exact printed bounding box"
+            for axis in ("x", "y", "z"):
+                dimension = value[axis]
+                if (
+                    isinstance(dimension, bool)
+                    or not isinstance(dimension, (int, float))
+                    or not math.isfinite(dimension)
+                    or dimension <= 0
+                ):
+                    return f"{label} has no positive finite {axis} dimension"
+        if published_dimensions != dimensions:
+            return "published print_specs dimensions differ from slice totals"
+    return None
+
+
+def finish_slice(
+    http: HttpTransport,
+    access: str,
+    journal_path: Path,
+    journal: dict[str, Any],
+    *,
+    poll_timeout_seconds: int,
+    poll_interval_seconds: float,
+) -> dict[str, Any]:
+    """GET-first, one-shot slice queueing followed by bounded polling."""
+    if journal["page_state"] != "confirmed":
+        return journal
+    slug = journal["design"]["slug"]
+    deadline = time.monotonic() + poll_timeout_seconds
+    journal = _slice_update(journal_path, journal, "checking")
+    try:
+        detail = http.get_design(access, slug)
+        if (
+            detail.get("status") != "draft"
+            or detail.get("published_history_id") not in (None, "")
+            or detail.get("id") != journal["design"]["id"]
+            or detail.get("current_history_id")
+            != journal["design"]["current_history_id"]
+        ):
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason="slice preflight identity is not the confirmed private draft",
+            )
+        completed_detail_measurement = bool(
+            isinstance(detail.get("material_usage"), dict)
+            and detail.get("material_usage")
+            and isinstance(detail.get("print_specs"), dict)
+            and detail.get("print_specs")
+        )
+        status, job = http.get_slice(access, slug)
+    except Exception as exc:
+        return _slice_update(
+            journal_path,
+            journal,
+            "ambiguous",
+            reason=f"slice read preflight failed: {type(exc).__name__}",
+        )
+    if status == 404:
+        if completed_detail_measurement:
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason="design has completed measurement but slice status returned 404",
+            )
+        if journal["slice_post_attempted"]:
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason="slice POST may have happened but GET still returns 404; not requeueing",
+            )
+        journal = _slice_update(journal_path, journal, "sending")
+        try:
+            post_status, job = http.post_slice(access, slug)
+        except Exception as exc:
+            # A response loss after POST is reconciled only with GET.
+            journal = _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason=f"slice send outcome uncertain: {type(exc).__name__}",
+            )
+            try:
+                status, job = http.get_slice(access, slug)
+            except Exception:
+                return journal
+            if status == 404:
+                return journal
+        else:
+            if post_status != 202 or not isinstance(job, dict):
+                return _slice_update(
+                    journal_path,
+                    journal,
+                    "ambiguous",
+                    reason=f"slice POST returned HTTP {post_status}, not 202",
+                )
+            status = 200
+    if status != 200 or not isinstance(job, dict):
+        return _slice_update(
+            journal_path,
+            journal,
+            "ambiguous",
+            reason=f"slice GET returned HTTP {status}",
+        )
+
+    while True:
+        job_status = job.get("status")
+        if job_status == "done":
+            try:
+                problem = _slice_done_readback(http, access, slug, job, journal)
+            except Exception as exc:
+                return _slice_update(
+                    journal_path,
+                    journal,
+                    "ambiguous",
+                    reason=f"done slice readback failed: {type(exc).__name__}",
+                    job=job,
+                )
+            if problem:
+                return _slice_update(
+                    journal_path, journal, "ambiguous", reason=problem, job=job
+                )
+            return _slice_update(
+                journal_path, journal, "done", reason=None, job=job
+            )
+        if job_status == "failed":
+            return _slice_update(
+                journal_path,
+                journal,
+                "failed",
+                reason="slice worker reported failed; explicit human retry decision required",
+                job=job,
+            )
+        if job_status not in {"queued", "slicing"}:
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason="slice returned an unknown state",
+                job=job,
+            )
+        journal = _slice_update(
+            journal_path, journal, "polling", reason=None, job=job
+        )
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return journal
+        if poll_interval_seconds:
+            time.sleep(min(poll_interval_seconds, remaining))
+        try:
+            status, job = http.get_slice(access, slug)
+        except Exception as exc:
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason=f"slice poll failed: {type(exc).__name__}",
+            )
+        if status != 200 or not isinstance(job, dict):
+            return _slice_update(
+                journal_path,
+                journal,
+                "ambiguous",
+                reason=f"slice poll returned HTTP {status}",
+            )
+
+
+def execute(
+    *,
+    zip_path: Path,
+    zip_sha256: str,
+    title: str,
+    prompt: str,
+    page_manifest_path: Path,
+    journal_path: Path,
+    auth_path: Path,
+    http: HttpTransport | None = None,
+    reconcile_window_seconds: int = DEFAULT_RECONCILE_WINDOW_SECONDS,
+    slice_poll_timeout_seconds: int = 900,
+    slice_poll_interval_seconds: float = 5.0,
+) -> dict[str, Any]:
+    """Create/reconcile the import, rich page, and first slice measurement."""
+    title = title.strip()
+    prompt = prompt.strip()
+    if not title or len(title) > 120:
+        raise ImportRefused("--title must contain 1..120 characters")
+    if not prompt or len(prompt) > MAX_PROMPT_CHARS:
+        raise ImportRefused(f"--prompt must contain 1..{MAX_PROMPT_CHARS} characters")
+    if not (1 <= reconcile_window_seconds <= 86_400):
+        raise ImportRefused("reconcile window must be 1..86400 seconds")
+    if not (1 <= slice_poll_timeout_seconds <= 1800):
+        raise ImportRefused("slice poll timeout must be 1..1800 seconds")
+    if not (0 <= slice_poll_interval_seconds <= 60):
+        raise ImportRefused("slice poll interval must be 0..60 seconds")
+    prepared = validate_archive(zip_path, zip_sha256, title=title, prompt=prompt)
+    validate_release_gate(prepared)
+    page = validate_page_manifest(
+        page_manifest_path, prepared, title=title
+    )
+    validate_game_handoff(prepared, page_manifest_path)
+    refresh_token = read_stored_refresh_token(auth_path)
+    transport: HttpTransport = http or FactoryHttp()
+
+    lock_path = journal_path.with_name(journal_path.name + ".lock")
+    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    if lock_path.exists() and lock_path.is_symlink():
+        raise ImportRefused("operation lock must not be a symlink")
+    lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
+    try:
+        os.fchmod(lock_fd, 0o600)
+        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+        journal = load_or_prepare_journal(
+            journal_path, prepared, page, title=title, prompt=prompt
+        )
+        if (
+            journal["state"] == "confirmed"
+            and journal["page_state"] == "confirmed"
+            and journal["slice_state"] == "done"
+        ):
+            return journal
+
+        # Auth refresh and all reconciliation reads happen before the one
+        # possible design write.  No HTTP client in this module retries.
+        access = transport.refresh(refresh_token)
+        if not isinstance(access, str) or not access:
+            raise RemoteError("token refresh returned no access_token")
+        if journal["state"] != "confirmed":
+            outcome, design = reconcile(
+                transport,
+                access,
+                prepared,
+                journal,
+                page,
+                title=title,
+                window_seconds=reconcile_window_seconds,
+            )
+            if outcome == "confirmed":
+                journal = _set_state(
+                    journal_path, journal, "confirmed", design=design, reason=None
+                )
+            elif outcome == "ambiguous":
+                return _set_state(
+                    journal_path,
+                    journal,
+                    "ambiguous",
+                    reason="same-title design collision could not be uniquely proven",
+                )
+            elif journal["state"] in {"sending", "ambiguous"} or journal["post_attempted"]:
+                return _set_state(
+                    journal_path,
+                    journal,
+                    "ambiguous",
+                    reason="prior send may have reached Factory; no matching readback yet",
+                )
+            else:
+                # Re-read the exact archive and page file immediately before the
+                # irreversible boundary.  The bytes below are those just checked.
+                prepared = validate_archive(
+                    zip_path, zip_sha256, title=title, prompt=prompt
+                )
+                validate_release_gate(prepared)
+                page = validate_page_manifest(
+                    page_manifest_path, prepared, title=title
+                )
+                validate_game_handoff(prepared, page_manifest_path)
+                journal = _set_state(journal_path, journal, "sending")
+                try:
+                    status, created = transport.import_draft(
+                        access,
+                        zip_name=zip_path.name,
+                        zip_bytes=prepared.payload,
+                        title=title,
+                        prompt=prompt,
+                        operation_id=journal["operation_id"],
+                        metadata=page.metadata,
+                    )
+                    if status != 201 or not isinstance(created, dict):
+                        raise RemoteError(f"import returned HTTP {status}, not 201")
+                    design = _verify_created(
+                        transport, access, created, prepared, page, title=title
+                    )
+                    journal = _set_state(
+                        journal_path,
+                        journal,
+                        "confirmed",
+                        design=design,
+                        reason=None,
+                    )
+                except Exception as exc:
+                    journal = _set_state(
+                        journal_path,
+                        journal,
+                        "ambiguous",
+                        reason=f"send outcome uncertain: {type(exc).__name__}",
+                    )
+                    try:
+                        outcome, design = reconcile(
+                            transport,
+                            access,
+                            prepared,
+                            journal,
+                            page,
+                            title=title,
+                            window_seconds=reconcile_window_seconds,
+                        )
+                    except Exception:
+                        return journal
+                    if outcome == "confirmed":
+                        journal = _set_state(
+                            journal_path,
+                            journal,
+                            "confirmed",
+                            design=design,
+                            reason=None,
+                        )
+                    else:
+                        return journal
+
+        if journal["page_state"] != "confirmed":
+            try:
+                journal = apply_rich_page(
+                    transport,
+                    access,
+                    prepared,
+                    page,
+                    journal_path,
+                    journal,
+                )
+            except Exception as exc:
+                updated = dict(journal)
+                updated["page_state"] = "ambiguous"
+                updated["page_reason"] = f"rich page outcome uncertain: {type(exc).__name__}"
+                _atomic_write_0600(journal_path, updated)
+                return updated
+        if journal["page_state"] != "confirmed":
+            return journal
+        return finish_slice(
+            transport,
+            access,
+            journal_path,
+            journal,
+            poll_timeout_seconds=slice_poll_timeout_seconds,
+            poll_interval_seconds=slice_poll_interval_seconds,
+        )
+    finally:
+        os.close(lock_fd)
+
+
+class FactoryHttp:
+    """Small, bounded HTTPS client with no redirects and no automatic retry."""
+
+    def __init__(self, api_base: str = API_BASE) -> None:
+        parsed = urllib.parse.urlsplit(api_base)
+        if (
+            parsed.scheme != "https"
+            or not parsed.netloc
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.query
+            or parsed.fragment
+        ):
+            raise ImportRefused("Factory API base must be a plain HTTPS origin/path")
+        self._origin = f"{parsed.scheme}://{parsed.netloc}"
+        self._host = parsed.netloc
+        self._base_path = parsed.path.rstrip("/")
+        self._ssl = ssl.create_default_context()
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        *,
+        body: bytes | None = None,
+        headers: dict[str, str] | None = None,
+        timeout: int = CONNECT_TIMEOUT_SECONDS,
+        max_bytes: int = MAX_JSON_BYTES,
+    ) -> tuple[int, bytes]:
+        connection = http.client.HTTPSConnection(
+            self._host, timeout=timeout, context=self._ssl
+        )
+        try:
+            connection.request(method, path, body=body, headers=headers or {})
+            response = connection.getresponse()
+            raw = response.read(max_bytes + 1)
+            if len(raw) > max_bytes:
+                raise RemoteError(f"{method} response exceeded {max_bytes} bytes")
+            return response.status, raw
+        except ImportRefused:
+            raise
+        except Exception as exc:
+            raise RemoteError(f"{method} transport failed: {type(exc).__name__}") from None
+        finally:
+            connection.close()
+
+    @staticmethod
+    def _json(raw: bytes, *, label: str) -> dict[str, Any]:
+        parsed = _json_no_duplicates(raw, label=label)
+        if not isinstance(parsed, dict):
+            raise RemoteError(f"{label} is not a JSON object")
+        return parsed
+
+    def refresh(self, refresh_token: str) -> str:
+        body = json.dumps(
+            {"refresh_token": refresh_token}, separators=(",", ":")
+        ).encode("utf-8")
+        status, raw = self._request(
+            "POST",
+            self._base_path + "/auth/refresh",
+            body=body,
+            headers={"Content-Type": "application/json", "Content-Length": str(len(body))},
+        )
+        if status != 200:
+            raise RemoteError(f"token refresh returned HTTP {status}")
+        token = self._json(raw, label="token refresh response").get("access_token")
+        if not isinstance(token, str) or not token:
+            raise RemoteError("token refresh returned no access_token")
+        return token
+
+    def list_designs(
+        self, access_token: str, *, offset: int, limit: int
+    ) -> dict[str, Any]:
+        query = urllib.parse.urlencode(
+            {"tab": "models", "limit": limit, "offset": offset}
+        )
+        status, raw = self._request(
+            "GET",
+            self._base_path + "/me/designs?" + query,
+            headers={"Authorization": "Bearer " + access_token},
+        )
+        if status != 200:
+            raise RemoteError(f"GET /me/designs returned HTTP {status}")
+        return self._json(raw, label="GET /me/designs response")
+
+    def get_design(self, access_token: str, slug: str) -> dict[str, Any]:
+        encoded = urllib.parse.quote(slug, safe="")
+        status, raw = self._request(
+            "GET",
+            self._base_path + "/designs/" + encoded,
+            headers={"Authorization": "Bearer " + access_token},
+        )
+        if status != 200:
+            raise RemoteError(f"exact design GET returned HTTP {status}")
+        return self._json(raw, label="exact design response")
+
+    def fetch_bytes(self, url: str, *, max_bytes: int = MAX_JSON_BYTES) -> bytes:
+        parsed = urllib.parse.urlsplit(url)
+        if (
+            parsed.scheme != "https"
+            or not parsed.netloc
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.fragment
+        ):
+            raise RemoteError("remote manifest URL is not safe HTTPS")
+        connection = http.client.HTTPSConnection(
+            parsed.netloc, timeout=CONNECT_TIMEOUT_SECONDS, context=self._ssl
+        )
+        path = parsed.path + (("?" + parsed.query) if parsed.query else "")
+        try:
+            # Deliberately no Authorization header: never leak the Factory bearer
+            # token to the immutable CDN origin.
+            connection.request("GET", path)
+            response = connection.getresponse()
+            raw = response.read(max_bytes + 1)
+            if response.status != 200:
+                raise RemoteError(f"remote manifest GET returned HTTP {response.status}")
+            if len(raw) > max_bytes:
+                raise RemoteError("immutable project file response is too large")
+            return raw
+        except ImportRefused:
+            raise
+        except Exception as exc:
+            raise RemoteError(f"remote manifest GET failed: {type(exc).__name__}") from None
+        finally:
+            connection.close()
+
+    def import_draft(
+        self,
+        access_token: str,
+        *,
+        zip_name: str,
+        zip_bytes: bytes,
+        title: str,
+        prompt: str,
+        operation_id: str,
+        metadata: dict[str, Any],
+    ) -> tuple[int, dict[str, Any] | None]:
+        boundary = "factory-private-" + secrets.token_hex(24)
+
+        def field(name: str, value: str) -> bytes:
+            return (
+                f"--{boundary}\r\n"
+                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'
+                f"{value}\r\n"
+            ).encode("utf-8")
+
+        safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", zip_name) or "design.zip"
+        prefix = (
+            f"--{boundary}\r\n"
+            f'Content-Disposition: form-data; name="file"; filename="{safe_name}"\r\n'
+            "Content-Type: application/zip\r\n\r\n"
+        ).encode("ascii")
