+        shipped_stls: dict[str, str] = {}
+        for filename, digest in shipped.items():
+            if (
+                not isinstance(filename, str)
+                or PurePosixPath(filename).name != filename
+                or _safe_archive_name(filename) != filename
+                or not isinstance(digest, str)
+                or not HEX64.fullmatch(digest)
+            ):
+                raise ImportRefused(f"package gate has invalid shipped hash for {family}")
+            suffix = PurePosixPath(filename).suffix
+            if suffix == ".step":
