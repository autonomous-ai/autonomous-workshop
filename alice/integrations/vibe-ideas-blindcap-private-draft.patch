+                raise ImportRefused(f"package gate repeats a shipped part: {filename}")
+            if _required_archive_sha(prepared, archive_path) != digest:
+                raise ImportRefused(f"packaged part artifact differs from gate: {filename}")
+            expected_part_paths.add(archive_path)
+        if set(shipped_steps) != {f"{family}.step"} or not shipped_stls:
+            raise ImportRefused(
+                f"package gate must bind every occurrence STL and one canonical family STEP for {family}"
+            )
+
+        instance_stls: dict[str, str] = {}
+        instance_steps: dict[str, str] = {}
+        first_step_digest: str | None = None
+        for instance, digest in instances.items():
+            if (
+                not isinstance(instance, str)
+                or PurePosixPath(instance).name != instance
+                or _safe_archive_name(instance) != instance
+                or not isinstance(digest, str)
+                or not HEX64.fullmatch(digest)
+            ):
+                raise ImportRefused(f"fresh build instance hash is invalid for {family}")
+            suffix = PurePosixPath(instance).suffix
+            occurrence = PurePosixPath(instance).stem
+            if (
+                suffix not in {".stl", ".step"}
+                or re.search(r"_\d+$", occurrence) is None
+                or re.sub(r"_\d+$", "", occurrence) != family
