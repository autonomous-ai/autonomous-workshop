+            "package gate must bind exactly 15 canonical family STEP files"
+        )
+    archived_part_models = {
+        path
+        for path in prepared.files
+        if PurePosixPath(path).suffix.lower() in {".stl", ".step"}
+        and any(part.endswith("_parts") for part in PurePosixPath(path).parts[:-1])
+    }
+    if archived_part_models != expected_part_paths:
+        raise ImportRefused(
+            "archived *_parts STEP/STL inventory differs from the exact gate-bound set"
