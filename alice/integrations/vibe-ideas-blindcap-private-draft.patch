+def promote_packaged_artifacts(home: Path, cad: dict, parts: list) -> list[str]:
+    """Atomically promote this exact fresh build into Factory's archive layout.
+
+    This is explicit because it overwrites generated artifacts. It never
+    touches source, rules, evidence, or unknown files, and never deletes an
+    extra artifact (the verifier reports extras for a human/packager to clean).
+    """
+    built_stl = Path(str(cad.get("stl_path") or ""))
+    built_step = Path(str(cad.get("step_path") or ""))
+    if not built_stl.is_file() or not built_step.is_file():
+        raise ValueError("fresh build omitted assembled STEP/STL")
+    destinations = [(built_stl, home / built_stl.name),
+                    (built_step, home / built_step.name)]
+    package_parts = home / f"{built_stl.stem}_parts"
+    package_parts.mkdir(parents=True, exist_ok=True)
+    promoted_step_families = set()
+    for part in parts:
+        name = str(part.get("name") or "")
+        family = _part_family(name)
+        if not family or not name:
+            continue
+        source_stl = Path(str(part.get("stl_path") or ""))
+        if not source_stl.is_file():
+            raise ValueError(f"fresh build omitted {name} .stl")
+        destinations.append((source_stl, package_parts / f"{name}.stl"))
+        if family not in promoted_step_families:
+            promoted_step_families.add(family)
+            source_step = Path(str(part.get("step_path") or ""))
+            if not source_step.is_file():
+                raise ValueError(f"fresh build omitted {name} .step")
+            destinations.append((source_step, package_parts / f"{family}.step"))
+
+    promoted = []
+    for source, destination in destinations:
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        temporary = destination.with_name(f".{destination.name}.gate-promote-{os.getpid()}")
+        try:
+            shutil.copyfile(source, temporary)
+            os.replace(temporary, destination)
+        finally:
+            if temporary.exists():
+                temporary.unlink()
+        promoted.append(destination.relative_to(home).as_posix())
+    return promoted
+
