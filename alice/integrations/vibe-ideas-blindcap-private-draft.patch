+TITLE = "Blindcap: Duel"
+PROMPT = "Design a two-player 3D-printable board game about reading hidden mushroom caps."
+
+
+class SimulatedCrash(BaseException):
+    pass
+
+
+def iso_now() -> str:
+    return IMPORTER.utc_now()
