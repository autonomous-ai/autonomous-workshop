+class FakeHttp:
+    def __init__(self, manifest_raw: bytes, remote_files: dict[str, bytes]) -> None:
+        self.manifest_raw = manifest_raw
+        self.remote_files = remote_files
+        self.details: dict[str, dict[str, Any]] = {}
+        self.post_calls = 0
+        self.refresh_calls = 0
+        self.list_calls = 0
+        self.import_mode = "success"
+        self.crash_before_list_once = False
+        self.patch_calls = 0
+        self.put_calls = 0
+        self.slice_post_calls = 0
+        self.slice_get_calls = 0
+        self.slice_jobs: dict[str, dict[str, Any]] = {}
+        self.slice_mode = "success"
+        self.page_mode = "success"
+
+    def add(self, value: dict[str, Any]) -> None:
+        self.details[value["slug"]] = value
+
+    def refresh(self, refresh_token: str) -> str:
+        self.refresh_calls += 1
+        if refresh_token != "offline-refresh-token":
+            raise AssertionError("unexpected refresh token")
+        return "offline-access-token"
+
+    def list_designs(
+        self, access_token: str, *, offset: int, limit: int
+    ) -> dict[str, Any]:
+        self.list_calls += 1
+        if self.crash_before_list_once:
+            self.crash_before_list_once = False
+            raise SimulatedCrash("before the irreversible send boundary")
+        values = list(self.details.values())
+        items = [
+            {
+                "id": value["id"],
+                "slug": value["slug"],
+                "status": value["status"],
+                "title": value["title"],
+                "updated_at": value["updated_at"],
+            }
+            for value in values[offset : offset + limit]
+        ]
+        return {"items": items, "limit": limit, "offset": offset, "total": len(values)}
+
+    def get_design(self, access_token: str, slug: str) -> dict[str, Any]:
+        return dict(self.details[slug])
+
+    def fetch_bytes(self, url: str, *, max_bytes: int = IMPORTER.MAX_JSON_BYTES) -> bytes:
+        matching = [path for path in self.remote_files if url.endswith("/" + path)]
+        if len(matching) != 1:
+            raise AssertionError(f"unexpected immutable project URL: {url}")
+        raw = self.remote_files[matching[0]]
+        if len(raw) > max_bytes:
+            raise AssertionError("fake response exceeded requested bound")
+        return raw
+
+    def import_draft(
+        self,
+        access_token: str,
+        *,
+        zip_name: str,
+        zip_bytes: bytes,
+        title: str,
+        prompt: str,
+        operation_id: str,
+        metadata: dict[str, Any],
+    ) -> tuple[int, dict[str, Any] | None]:
+        self.post_calls += 1
+        if access_token != "offline-access-token":
+            raise AssertionError("unexpected access token")
+        if title != TITLE or prompt != PROMPT or not zip_bytes:
+            raise AssertionError("import did not carry exact prepared values")
+        if metadata != page_data()["metadata"]:
+            raise AssertionError("import did not carry exact page metadata")
+        if not operation_id.startswith("factory-draft:"):
+            raise AssertionError("missing operation id")
+        if self.import_mode == "ambiguous_without_create":
+            raise TimeoutError("response lost")
+        created = detail(
+            "blindcap-duel" if self.post_calls == 1 else f"blindcap-duel-{self.post_calls}",
+            status="public" if self.import_mode == "wrong_status" else "draft",
+            ordinal=self.post_calls,
+        )
+        self.add(created)
+        if self.import_mode == "crash_after_create":
+            raise SimulatedCrash("process died after server commit")
+        return 201, dict(created)
+
+    def patch_json(
+        self, access_token: str, path: str, body: dict[str, Any]
+    ) -> tuple[int, dict[str, Any] | None]:
+        self.patch_calls += 1
+        slug = path.split("/designs/", 1)[1].split("/", 1)[0]
+        self.details[slug]["use_case"] = dict(body)
+        if self.page_mode == "crash_after_patch":
+            raise SimulatedCrash("after use-case commit")
+        return 200, {"use_case": body, "story_blocks": self.details[slug]["story_blocks"]}
+
+    def put_json(
+        self, access_token: str, path: str, body: dict[str, Any]
+    ) -> tuple[int, dict[str, Any] | None]:
+        self.put_calls += 1
+        slug = path.split("/designs/", 1)[1].split("/", 1)[0]
+        self.details[slug]["story_blocks"] = list(body["story_blocks"])
+        return 200, {
+            "use_case": self.details[slug]["use_case"],
+            "story_blocks": body["story_blocks"],
+        }
+
+    def get_slice(
+        self, access_token: str, slug: str
+    ) -> tuple[int, dict[str, Any] | None]:
+        self.slice_get_calls += 1
+        job = self.slice_jobs.get(slug)
+        if job is None:
+            return 404, None
+        if job["status"] in {"queued", "slicing"} and self.slice_mode in {
+            "success",
+            "undercount",
+            "missing_dimensions",
+            "totals_dimensions_only",
+            "specs_dimensions_only",
+            "malformed_dimensions",
+            "mismatched_dimensions",
+        }:
+            job["status"] = "done"
+            job["totals"] = {
+                "weight_g": 42.5,
+                "volume_cm3": 35.4,
+                "length_mm": 14123.0,
+                "print_time_seconds": 3600,
+                "part_count": 15 if self.slice_mode == "undercount" else 28,
+                "materials": ["PLA"],
+                "dimensions_mm": {"x": 180.0, "y": 180.0, "z": 42.0},
+            }
+            self.details[slug]["material_usage"] = {
+                "weight_g": 42.5,
+                "volume_cm3": 35.4,
+                "length_mm": 14123.0,
+                "materials": ["PLA"],
+            }
+            self.details[slug]["print_time_seconds"] = 3600
+            self.details[slug]["print_specs"] = {
+                "weight_g": 42.5,
+                "print_time_minutes": 60,
+                "part_count": 15 if self.slice_mode == "undercount" else 28,
+                "materials": ["PLA"],
+                "dimensions_mm": {"x": 180.0, "y": 180.0, "z": 42.0},
+            }
+            if self.slice_mode in {"missing_dimensions", "specs_dimensions_only"}:
+                del job["totals"]["dimensions_mm"]
+            if self.slice_mode in {"missing_dimensions", "totals_dimensions_only"}:
+                del self.details[slug]["print_specs"]["dimensions_mm"]
+            if self.slice_mode == "malformed_dimensions":
+                job["totals"]["dimensions_mm"] = {"x": 180.0, "y": 180.0}
+                self.details[slug]["print_specs"]["dimensions_mm"] = {
+                    "x": 180.0,
+                    "y": 180.0,
+                }
+            if self.slice_mode == "mismatched_dimensions":
+                self.details[slug]["print_specs"]["dimensions_mm"]["z"] = 43.0
+        return 200, dict(job)
+
+    def post_slice(
+        self, access_token: str, slug: str
+    ) -> tuple[int, dict[str, Any] | None]:
+        self.slice_post_calls += 1
+        if self.slice_mode == "crash_after_queue":
+            self.slice_jobs[slug] = {
+                "id": "slice-1",
+                "design_id": self.details[slug]["id"],
+                "history_id": self.details[slug]["current_history_id"],
+                "status": "queued",
+            }
+            raise SimulatedCrash("after slice queue")
+        if self.slice_mode == "ambiguous_without_queue":
+            raise TimeoutError("slice response lost")
+        job = {
+            "id": "slice-1",
+            "design_id": self.details[slug]["id"],
+            "history_id": self.details[slug]["current_history_id"],
+            "status": "queued",
+        }
+        if self.slice_mode == "failed":
+            job["status"] = "failed"
+        self.slice_jobs[slug] = job
+        return 202, dict(job)
+
