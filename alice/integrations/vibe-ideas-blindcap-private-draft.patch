+def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Prepare, create, and reconcile exactly one private Factory draft."
+    )
+    commands = parser.add_subparsers(dest="command", required=True)
+    prepare = commands.add_parser(
+        "prepare", help="offline deterministic package + full release preflight"
+    )
+    prepare.add_argument("--project", required=True, type=Path, help="absolute final project directory")
+    prepare.add_argument("--title", required=True, help="exact Factory title")
+    prepare.add_argument("--prompt", required=True, help="exact originating prompt")
+    prepare.add_argument(
+        "--page-manifest",
+        required=True,
+        type=Path,
+        help="absolute final content/factory-page.json",
+    )
+    prepare.add_argument("--output", required=True, type=Path, help="new absolute ZIP path")
+
+    run = commands.add_parser(
+        "import", help="one-shot private import, rich page, and first slice"
+    )
+    run.add_argument("--zip", required=True, type=Path, help="absolute prepared ZIP path")
+    run.add_argument("--zip-sha256", required=True, help="exact lowercase SHA-256")
+    run.add_argument("--title", required=True, help="exact Factory title")
+    run.add_argument("--prompt", required=True, help="exact originating prompt")
+    run.add_argument(
+        "--page-manifest",
+        required=True,
+        type=Path,
+        help="absolute local content/factory-page.json included byte-exact in the ZIP",
+    )
+    run.add_argument("--journal", required=True, type=Path, help="absolute 0600 journal path")
+    run.add_argument(
+        "--auth",
+        type=Path,
+        default=DEFAULT_AUTH_PATH,
+        help=f"desktop auth JSON (default: {DEFAULT_AUTH_PATH})",
+    )
+    run.add_argument(
+        "--reconcile-window-seconds",
+        type=int,
+        default=DEFAULT_RECONCILE_WINDOW_SECONDS,
+        help="candidate updated-time tolerance (default: 600; max: 86400)",
+    )
+    run.add_argument(
+        "--slice-poll-timeout-seconds",
+        type=int,
+        default=900,
+        help="bounded GET-only slice polling time (default: 900; max: 1800)",
+    )
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(argv)
+    try:
+        if args.command == "prepare":
+            prepared = prepare_archive(
+                project=args.project,
+                page_manifest_path=args.page_manifest,
+                title=args.title,
+                prompt=args.prompt,
+                output=args.output,
+            )
+            print(
+                json.dumps(
+                    {
+                        "manifest_sha256": prepared.manifest_sha256,
+                        "path": str(prepared.path),
+                        "state": "prepared",
+                        "zip_bytes": prepared.size,
+                        "zip_sha256": prepared.sha256,
+                    },
+                    sort_keys=True,
+                )
+            )
+            return 0
+        result = execute(
+            zip_path=args.zip,
+            zip_sha256=args.zip_sha256,
+            title=args.title,
+            prompt=args.prompt,
+            page_manifest_path=args.page_manifest,
+            journal_path=args.journal,
+            auth_path=args.auth,
+            reconcile_window_seconds=args.reconcile_window_seconds,
+            slice_poll_timeout_seconds=args.slice_poll_timeout_seconds,
+        )
+    except ImportRefused as exc:
+        print(json.dumps({"error": str(exc), "state": "refused"}, sort_keys=True), file=sys.stderr)
