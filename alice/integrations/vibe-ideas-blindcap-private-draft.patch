+def verify_packaged_artifacts(home: Path, cad: dict, parts: list) -> tuple[dict, list]:
+    """Bind the exact top-level STEP/STL bytes the importer will archive.
+
+    Cadcode builds into ``project/build``. The Factory archive intentionally
+    drops that cache and ships root ``<slug>.{step,stl}`` plus one printable
+    family under ``<slug>_parts``. A clean source build therefore proves
+    nothing about a stale root export unless the bytes are compared here.
+    """
+    findings = []
+    report = {"verified": False, "assembled": {}, "parts": {}, "coupons": {}}
+
+    built_stl = Path(str(cad.get("stl_path") or ""))
+    built_step = Path(str(cad.get("step_path") or ""))
+    if not built_stl.is_file() or not built_step.is_file():
+        return report, ["package: build did not return assembled STEP and STL paths"]
+    root_stl = home / built_stl.name
+    root_step = home / built_step.name
+    # Cadcode's generated sidecar contains build-occurrence paths and mutable
+    # generator metadata.  It is useful inside build/, but is neither promoted
+    # nor normalized for the one-family package layout.  Refuse a stale root
+    # copy instead of silently archiving an unbound manifest.
+    root_sidecar = home / f"{built_stl.stem}.step.json"
+    if root_sidecar.exists():
+        findings.append(
+            f"package: unbound generated sidecar {root_sidecar.name}; keep the "
+            "fresh sidecar in build/ or generate a package-normalized manifest")
+    for label, built, shipped in (
+        ("assembled STL", built_stl, root_stl),
+        ("assembled STEP", built_step, root_step),
+    ):
+        expected = file_sha256(built)
+        actual = file_sha256(shipped)
+        report["assembled"][shipped.name] = actual
+        if actual is None:
+            findings.append(f"package:{label}: missing {shipped.name}")
+        elif actual != expected:
+            findings.append(f"package:{label}: {shipped.name} is stale or differs "
+                            "from the fresh build")
+
+    package_parts = home / f"{built_stl.stem}_parts"
+    expected_part_files = set()
+    compared_step_families = set()
+    for part in parts:
+        name = str(part.get("name") or "")
+        family = _part_family(name)
+        if not family:
+            continue
+        entry = report["parts"].setdefault(
+            family, {"shipped": {}, "build_instances": {}})
+        for suffix, key in ((".stl", "stl_path"), (".step", "step_path")):
+            built = Path(str(part.get(key) or ""))
+            # Factory's slicer counts each STL file once and does not multiply
+            # family meshes by bill quantities.  Ship every named occurrence
+            # STL so its totals describe the actual 28-piece kit, while one
+            # editable STEP per family avoids redundant timestamped B-reps.
+            shipped = package_parts / (
+                f"{name}.stl" if suffix == ".stl" else f"{family}.step")
+            expected_part_files.add(shipped.name)
+            expected = file_sha256(built)
+            actual = file_sha256(shipped)
+            entry["shipped"][shipped.name] = actual
+            entry["build_instances"][f"{name}{suffix}"] = expected
+            # One family ships one STEP. Cadcode writes the occurrence name
+            # and wall-clock timestamp into every STEP header, so repeated
+            # instances are intentionally not byte-identical even when their
+            # geometry is. Every occurrence STL is shipped and byte-bound;
+            # the first occurrence is the exact canonical family STEP.
+            if suffix == ".step" and family in compared_step_families:
+                continue
+            if expected is None:
+                findings.append(f"package:{name}: build omitted {suffix[1:].upper()}")
+            elif actual is None:
+                findings.append(f"package:{family}: missing {shipped.relative_to(home)}")
+            elif actual != expected:
+                findings.append(f"package:{name}: {shipped.relative_to(home)} is stale "
+                                "or differs from this fresh build occurrence")
+            if suffix == ".step":
+                compared_step_families.add(family)
+
+    actual_part_files = {
+        path.name for path in package_parts.iterdir()
+        if path.is_file() and path.suffix.lower() in {".stl", ".step"}
+    } if package_parts.is_dir() else set()
+    for extra in sorted(actual_part_files - expected_part_files):
+        findings.append(f"package: unbuilt extra artifact {package_parts.name}/{extra}")
+
+    # Fit coupons are part of the exact customer archive too.  Bind every
+    # regular coupon artifact here; their STL bytes are fed into the same mesh
+    # and Orca checks as the game parts below.
+    coupons = home / "coupons"
+    if coupons.exists():
+        if coupons.is_symlink() or not coupons.is_dir():
+            findings.append("package: coupons must be a real directory")
+        else:
+            for path in sorted(coupons.rglob("*")):
+                relative = path.relative_to(home).as_posix()
+                if path.is_symlink():
+                    findings.append(f"package: coupon artifact is a symlink: {relative}")
+                elif path.is_file():
+                    report["coupons"][relative] = file_sha256(path)
+                elif not path.is_dir():
+                    findings.append(f"package: coupon artifact is not a file: {relative}")
+
+    report["verified"] = not findings
+    return report, findings
+
