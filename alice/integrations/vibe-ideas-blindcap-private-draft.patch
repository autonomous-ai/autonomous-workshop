+    part_dir = f"project/{stem}_parts"
+    expected_part_paths: set[str] = set()
+    shipped_occurrence_stls: set[str] = set()
+    build_occurrence_stls: set[str] = set()
+    for family, value in parts.items():
+        if (
+            not isinstance(family, str)
+            or not family
+            or PurePosixPath(family).name != family
+            or _safe_archive_name(family) != family
+            or PurePosixPath(family).suffix.lower() in {".stl", ".step"}
+            or not isinstance(value, dict)
+            or set(value) != {
+            "shipped",
+            "build_instances",
