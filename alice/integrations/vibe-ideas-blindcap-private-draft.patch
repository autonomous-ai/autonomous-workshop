+    def test_empty_or_symlinked_project_rules_fail_closed(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            project = root / "project"
+            project.mkdir()
+            rules = project / "RULES.md"
