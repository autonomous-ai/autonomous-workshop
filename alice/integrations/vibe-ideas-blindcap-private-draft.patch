+
+def write_auth(root: Path) -> Path:
+    path = root / "panda-social-auth.json"
+    path.write_text(
+        json.dumps({"refresh_token": "offline-refresh-token", "user": {"id": "u1"}}),
+        encoding="utf-8",
+    )
+    os.chmod(path, 0o600)
+    return path
+
+
+def png(width: int, height: int) -> bytes:
+    def chunk(kind: bytes, payload: bytes) -> bytes:
+        return (
+            struct.pack(">I", len(payload))
+            + kind
+            + payload
+            + struct.pack(">I", zlib.crc32(kind + payload) & 0xFFFFFFFF)
+        )
+
+    ihdr = struct.pack(">IIBBBBB", width, height, 1, 0, 0, 0, 0)
+    scanline = b"\x00" + bytes((width + 7) // 8)
+    return (
+        b"\x89PNG\r\n\x1a\n"
+        + chunk(b"IHDR", ihdr)
+        + chunk(b"IDAT", zlib.compress(scanline * height, 9))
+        + chunk(b"IEND", b"")
+    )
+
+
+USE_BODY = (
+    "Blindcap: Duel is built for exactly two people and a short table. Each player "
+    "plants hidden mushrooms, spends physical probes to read the rival field, and "
+    "commits crowns before the harvest reveals every species and scores connected groves."
+)
+STORY_BODY = (
+    "Plant one hidden mushroom, then either probe or crown a rival mushroom. The pin "
+    "stops high or settles low according to a tunnel buried inside the shank. Results "
+    "narrow the species without cards or an app, while the final harvest turns every "
+    "public clue and committed crown into countable scoring state."
+)
+
+
+# Mirrors Blindcap's 28-piece, 15-family Cadcode expansion. Every physical
+# occurrence has its own STL for the backend slicer; each family keeps one
+# canonical editable STEP because later occurrence STEP headers are volatile.
+PART_FAMILIES = [
+    ("loam_tile", 2),
+    ("stool_deadhead_p1", 2),
+    ("stool_deadhead_p2", 2),
+    ("stool_bracket_p1", 2),
+    ("stool_bracket_p2", 2),
+    ("stool_inkcap_p1", 1),
+    ("stool_inkcap_p2", 1),
+    ("stool_hollow_p1", 1),
+    ("stool_hollow_p2", 1),
+    ("claim_crown_p1", 3),
+    ("claim_crown_p2", 3),
+    ("probe_pin_p1", 3),
+    ("probe_pin_p2", 3),
+    ("spore_trough_p1", 1),
+    ("spore_trough_p2", 1),
+]
+assert sum(quantity for _, quantity in PART_FAMILIES) == 28
+
+
