+def file_sha256(path: Path | None) -> str | None:
+    """Hash one regular input file without loading large binaries into RAM."""
+    if path is None or not path.is_file():
+        return None
+    h = hashlib.sha256()
+    with path.open("rb") as fh:
+        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def brief_path(explicit: Path | None, home: Path) -> Path | None:
+    """Resolve the exact brief file the gate will read."""
+    candidates = [explicit] if explicit else [home / "brief.json",
+                                              home.parent / "brief.json"]
+    return next((path.resolve() for path in candidates
+                 if path is not None and path.is_file()), None)
+
+
+def gate_input_fingerprints(project: Path, home: Path, *, bill: Path | None,
+                            brief: Path | None, no_slice: bool) -> dict:
+    """Bind every mutable input that can change the deterministic verdict.
+
+    The old report bound Python source only.  A bill, motion sweep, brief, or
+    slicer profile could therefore be edited after a pass while the displayed
+    source hash stayed current.  Keep the individual hashes (rather than one
+    opaque aggregate) so an auditor can say exactly what changed.
+    """
+    motion = home / "motion.json"
+    cad_project = home / "cad_project.json"
+    resolved_bill = bill.resolve() if bill is not None and bill.is_file() else None
+    resolved_brief = brief_path(brief, home)
+    inputs = {
+        "source_sha256": source_fingerprint(project),
+        "cad_project_sha256": file_sha256(
+            cad_project.resolve() if cad_project.is_file() else None),
+        "bill_sha256": file_sha256(resolved_bill),
+        "motion_sha256": file_sha256(motion.resolve() if motion.is_file() else None),
+        "brief_sha256": file_sha256(resolved_brief),
+        "slicer_executable_sha256": None,
+        "slicer_profile_sha256": [],
+    }
+    if not no_slice:
+        slicer_value = os.getenv("ORCASLICER_CLI", "").strip()
+        slicer = Path(slicer_value).expanduser() if slicer_value else None
+        inputs["slicer_executable_sha256"] = file_sha256(
+            slicer.resolve() if slicer is not None and slicer.is_file() else None)
+        profile_value = os.getenv("ORCA_PROFILE", "").strip()
+        if profile_value:
+            inputs["slicer_profile_sha256"] = [
+                file_sha256(path.expanduser().resolve())
+                for path in (Path(item) for item in profile_value.split(";") if item)
+            ]
+    return inputs
+
+
