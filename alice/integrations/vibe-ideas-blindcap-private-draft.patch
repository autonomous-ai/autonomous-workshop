+#!/usr/bin/env python3
+"""One-shot, fail-closed importer for a private Autonomous Factory draft.
+
+This is deliberately narrower than the desktop app's Publish button.  It can
+create one *draft* from one already-prepared ZIP, and it can reconcile that
+operation after an uncertain response.  It has no public-publish code path.
+
+The archive must contain ``project/factory-private-draft-operation.json``. That file
+is canonical JSON and binds the title, prompt hash, draft-only intent, and the
+hash/size of every other file in the archive.  The CLI separately requires the
+SHA-256 of the complete ZIP bytes, avoiding the circularity of putting a ZIP's
+own hash inside itself.
+
+Example::
+
+    python board-game/tools/import_private_draft.py prepare \
+      --project /absolute/path/blindcap-duel/project \
+      --page-manifest /absolute/path/blindcap-duel/content/factory-page.json \
+      --title 'Blindcap: Duel' --prompt 'Design a two-player ...' \
+      --output /absolute/path/blindcap-duel.factory.zip
+
+    python board-game/tools/import_private_draft.py \
+      import \
+      --zip /absolute/path/blindcap-duel.zip \
+      --zip-sha256 <64-lowercase-hex> \
+      --title 'Blindcap: Duel' \
+      --prompt 'Design a two-player ...' \
+      --journal /absolute/private/path/blindcap-duel-import.json
+
+The journal is an exact 0600, atomically-replaced record.  Once it reaches
+``sending`` or ``ambiguous``, this program will only perform authenticated
+reads to reconcile; it will never issue a second import POST.
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import dataclasses
+import datetime as dt
+import fcntl
+import hashlib
+import http.client
+import io
+import json
+import math
+import os
+import re
+import secrets
+import ssl
+import stat
+import struct
+import sys
+import tempfile
+import time
+import unicodedata
+import urllib.parse
+import zipfile
+import zlib
+from pathlib import Path, PurePosixPath
+from typing import Any, BinaryIO, Protocol
+
+
+API_BASE = "https://panda-social-api.autonomous.ai/api/v1"
+DEFAULT_AUTH_PATH = (
+    Path.home()
+    / "Library"
+    / "Application Support"
+    / "app.panda.desktop"
+    / "panda-social-auth.json"
+)
+MANIFEST_PATH = "factory-private-draft-operation.json"
+ARCHIVE_ROOT = "project"
+MANIFEST_ARCHIVE_PATH = f"{ARCHIVE_ROOT}/{MANIFEST_PATH}"
+MANIFEST_KIND = "factory.private-draft-import"
+JOURNAL_KIND = "factory.private-draft-import-journal"
+SCHEMA_VERSION = 1
+
+MAX_ZIP_BYTES = 100 << 20
+MAX_FILES = 4096
+MAX_FILE_BYTES = 95 << 20
+MAX_EXPANDED_BYTES = 512 << 20
+MAX_JSON_BYTES = 2 << 20
+MAX_MEDIA_BYTES = 20 << 20
+MAX_PROMPT_CHARS = 20_000
+PAGE_SIZE = 50
+MAX_DESIGNS_SCANNED = 1000
+DEFAULT_RECONCILE_WINDOW_SECONDS = 600
+CONNECT_TIMEOUT_SECONDS = 30
+IMPORT_TIMEOUT_SECONDS = 120
+
+HEX64 = re.compile(r"[0-9a-f]{64}\Z")
+SECRET_BASENAMES = {
+    ".env",
+    "credentials.json",
+    "gcs-sa.json",
+    "service-account.json",
+    "id_rsa",
+    "id_ed25519",
+}
+SECRET_SUFFIXES = (".pem", ".key", ".p12", ".pfx")
+PRIVATE_KEY_MARKER = re.compile(
+    rb"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
+)
+TOKEN_VALUE_MARKER = re.compile(
+    rb'''(?ix)
+    ["']?(?:refresh[_-]?token|access[_-]?token|api[_-]?key|secret[_-]?key)["']?
+    \s*[:=]\s*["']
+    (?!\$\{|<|example|replace|redacted)
+    [A-Za-z0-9_./+\-=]{16,}
+    ["']
+    '''
+)
+
+
+class ImportRefused(RuntimeError):
+    """A fail-closed condition; callers may report the message, never secrets."""
+
+
+class RemoteError(ImportRefused):
+    """A bounded, sanitized remote failure."""
+
