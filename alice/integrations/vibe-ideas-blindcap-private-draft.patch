+
+def utc_now() -> str:
+    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def canonical_json(value: Any) -> bytes:
+    return (
+        json.dumps(
+            value,
+            indent=2,
+            sort_keys=True,
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+        + "\n"
+    ).encode("utf-8")
+
+
+def sha256_bytes(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def prompt_sha256(prompt: str) -> str:
+    return sha256_bytes(prompt.encode("utf-8"))
+
+
+def operation_id(zip_sha256: str, title: str, prompt: str) -> str:
+    material = (
+        b"factory-private-draft-v1\0"
+        + zip_sha256.encode("ascii")
+        + b"\0"
+        + title.encode("utf-8")
+        + b"\0"
+        + prompt_sha256(prompt).encode("ascii")
+    )
+    return "factory-draft:" + sha256_bytes(material)
+
+
+def _json_no_duplicates(raw: bytes, *, label: str) -> Any:
+    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
+        out: dict[str, Any] = {}
+        for key, value in values:
+            if key in out:
+                raise ValueError(f"duplicate JSON key {key!r}")
+            out[key] = value
+        return out
+
+    try:
+        return json.loads(raw.decode("utf-8"), object_pairs_hook=pairs)
+    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
+        raise ImportRefused(f"{label} is not strict UTF-8 JSON: {exc}") from None
+
+
+def _safe_archive_name(name: str) -> str:
+    if not name or "\x00" in name or "\\" in name:
+        raise ImportRefused(f"unsafe archive path: {name!r}")
+    if unicodedata.normalize("NFC", name) != name:
+        raise ImportRefused(f"archive path is not NFC-normalized: {name!r}")
+    path = PurePosixPath(name)
+    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
+        raise ImportRefused(f"unsafe archive path: {name!r}")
+    normalized = path.as_posix()
+    if normalized != name.rstrip("/"):
+        raise ImportRefused(f"non-canonical archive path: {name!r}")
+    return normalized
+
+
+def _secret_shaped(path: str, raw: bytes) -> bool:
+    base = PurePosixPath(path).name.lower()
+    if (
+        base in SECRET_BASENAMES
+        or base.startswith(".env.")
+        or base.startswith("secrets.")
+        or base.endswith(SECRET_SUFFIXES)
+    ):
+        return True
+    # High-confidence content checks only.  The cap makes this bounded and
+    # avoids decoding arbitrary CAD/mesh data.
+    sample = raw[: 2 << 20]
+    return bool(PRIVATE_KEY_MARKER.search(sample) or TOKEN_VALUE_MARKER.search(sample))
+
+
+def manifest_for_files(
+    *, title: str, prompt: str, files: list[dict[str, Any]]
+) -> dict[str, Any]:
+    """Return the exact manifest a packager must place at ``MANIFEST_PATH``."""
+    return {
+        "files": files,
+        "kind": MANIFEST_KIND,
+        "prompt_sha256": prompt_sha256(prompt),
+        "public_publish_allowed": False,
+        "schema_version": SCHEMA_VERSION,
+        "status": "draft",
+        "title": title,
+    }
+
+
+def validate_archive(
+    zip_path: Path, expected_sha256: str, *, title: str, prompt: str
+) -> PreparedArchive:
+    if not zip_path.is_absolute():
+        raise ImportRefused("--zip must be an absolute path")
+    if zip_path.is_symlink():
+        raise ImportRefused("--zip must not be a symlink")
+    if not HEX64.fullmatch(expected_sha256):
+        raise ImportRefused("--zip-sha256 must be exactly 64 lowercase hex characters")
+    try:
+        before = zip_path.stat()
+    except OSError as exc:
+        raise ImportRefused(f"cannot stat prepared ZIP: {exc.strerror or type(exc).__name__}") from None
+    if not stat.S_ISREG(before.st_mode):
+        raise ImportRefused("--zip must name a regular file")
+    if before.st_size <= 0 or before.st_size > MAX_ZIP_BYTES:
+        raise ImportRefused(f"prepared ZIP must be 1..{MAX_ZIP_BYTES} bytes")
+    try:
+        payload = zip_path.read_bytes()
+        after = zip_path.stat()
+    except OSError as exc:
+        raise ImportRefused(f"cannot read prepared ZIP: {exc.strerror or type(exc).__name__}") from None
+    stable = (
+        before.st_dev,
+        before.st_ino,
+        before.st_size,
+        before.st_mtime_ns,
+    ) == (
+        after.st_dev,
+        after.st_ino,
+        after.st_size,
+        after.st_mtime_ns,
+    )
+    if not stable or len(payload) != before.st_size:
+        raise ImportRefused("prepared ZIP changed while it was being verified")
+    actual_sha = sha256_bytes(payload)
+    if actual_sha != expected_sha256:
+        raise ImportRefused(
+            f"prepared ZIP SHA-256 mismatch (actual {actual_sha})"
+        )
+
+    records: list[dict[str, Any]] = []
+    file_bytes: dict[str, bytes] = {}
+    manifest_raw: bytes | None = None
+    seen: set[str] = set()
+    seen_folded: set[str] = set()
+    expanded = 0
+    try:
+        archive = zipfile.ZipFile(io.BytesIO(payload), "r")
+    except (zipfile.BadZipFile, OSError) as exc:
+        raise ImportRefused(f"prepared file is not a valid ZIP: {type(exc).__name__}") from None
+    with archive:
+        infos = archive.infolist()
+        if not infos or len(infos) > MAX_FILES:
+            raise ImportRefused(f"ZIP must contain 1..{MAX_FILES} entries")
+        for info in infos:
+            name = _safe_archive_name(info.filename)
+            path_parts = PurePosixPath(name).parts
+            if (
+                name.startswith("project/build/")
+                or any(
+                    part in {"__pycache__", ".git", ".panda", ".venv", "venv", "node_modules"}
+                    for part in path_parts
+                )
+                or PurePosixPath(name).name == ".DS_Store"
+                or PurePosixPath(name).suffix.lower() in {".pyc", ".pyo"}
+            ):
+                raise ImportRefused(f"archive contains excluded build/cache entry: {name}")
+            if (
+                len(PurePosixPath(name).parts) == 2
+                and name.startswith("project/")
+                and name.lower().endswith(".step.json")
+            ):
+                raise ImportRefused(f"archive contains unbound root STEP sidecar: {name}")
+            folded = name.casefold()
+            if name in seen or folded in seen_folded:
+                raise ImportRefused(f"duplicate/case-colliding archive path: {name}")
+            seen.add(name)
+            seen_folded.add(folded)
+            unix_mode = (info.external_attr >> 16) & 0xFFFF
+            file_type = stat.S_IFMT(unix_mode)
+            if file_type == stat.S_IFLNK:
+                raise ImportRefused(f"archive contains symlink: {name}")
+            if file_type not in (0, stat.S_IFREG, stat.S_IFDIR):
+                raise ImportRefused(f"archive contains non-regular entry: {name}")
+            if info.flag_bits & 0x1:
+                raise ImportRefused(f"archive contains encrypted entry: {name}")
+            if info.is_dir():
+                continue
+            if info.file_size > MAX_FILE_BYTES:
+                raise ImportRefused(f"archive file exceeds {MAX_FILE_BYTES} bytes: {name}")
+            expanded += info.file_size
+            if expanded > MAX_EXPANDED_BYTES:
+                raise ImportRefused(
+                    f"expanded archive exceeds {MAX_EXPANDED_BYTES} bytes"
+                )
+            try:
+                raw = archive.read(info)
+            except (OSError, RuntimeError, zipfile.BadZipFile) as exc:
+                raise ImportRefused(f"cannot verify archive entry {name}: {type(exc).__name__}") from None
+            if len(raw) != info.file_size:
+                raise ImportRefused(f"archive entry size changed while reading: {name}")
+            if not name.startswith(ARCHIVE_ROOT + "/"):
+                raise ImportRefused(
+                    f"every archive file must live inside the single {ARCHIVE_ROOT}/ wrapper: {name}"
+                )
+            if name == MANIFEST_ARCHIVE_PATH:
+                manifest_raw = raw
+                continue
+            if _secret_shaped(name, raw):
+                raise ImportRefused(f"archive contains secret-shaped file/content: {name}")
+            file_bytes[name] = raw
+            records.append(
+                {"bytes": len(raw), "path": name, "sha256": sha256_bytes(raw)}
+            )
+
+    if manifest_raw is None:
+        raise ImportRefused(f"ZIP is missing exact embedded {MANIFEST_ARCHIVE_PATH}")
+    if len(manifest_raw) > MAX_JSON_BYTES:
+        raise ImportRefused("embedded operation manifest is too large")
+    manifest = _json_no_duplicates(manifest_raw, label="embedded operation manifest")
+    if not isinstance(manifest, dict) or canonical_json(manifest) != manifest_raw:
+        raise ImportRefused("embedded operation manifest is not canonical JSON")
+    records.sort(key=lambda item: item["path"])
+    expected_manifest = manifest_for_files(title=title, prompt=prompt, files=records)
+    if manifest != expected_manifest:
+        raise ImportRefused(
+            "embedded operation manifest does not exactly bind title, prompt, "
+            "draft-only status, and every archive file"
+        )
+    return PreparedArchive(
+        path=zip_path,
+        sha256=actual_sha,
+        size=len(payload),
+        payload=payload,
+        manifest=manifest,
+        manifest_bytes=manifest_raw,
+        manifest_sha256=sha256_bytes(manifest_raw),
+        files=file_bytes,
+    )
+
+
+def _plain_text(value: Any, *, label: str, minimum: int, maximum: int) -> str:
+    if not isinstance(value, str):
+        raise ImportRefused(f"{label} must be text")
+    if value != value.strip() or not (minimum <= len(value) <= maximum):
+        raise ImportRefused(f"{label} must be {minimum}..{maximum} trimmed characters")
+    if "<" in value or ">" in value or "\x00" in value:
+        raise ImportRefused(f"{label} must be plain text")
+    return value
+
+
+def _placeholder_media_path(value: Any, *, label: str) -> str:
+    prefix = "${PROJECT_URL}"
+    if not isinstance(value, str) or not value.startswith(prefix):
+        raise ImportRefused(f"{label} must start with literal {prefix}")
+    relative = _safe_archive_name(value[len(prefix) :])
+    if relative.startswith("/"):
+        raise ImportRefused(f"{label} must be relative to PROJECT_URL")
+    return relative
+
+
+def validate_page_manifest(
+    path: Path,
+    prepared: PreparedArchive,
+    *,
+    title: str,
+    entry: str = "project/content/factory-page.json",
+) -> PageManifest:
+    if not path.is_absolute():
+        raise ImportRefused("--page-manifest must be an absolute path")
+    if path.is_symlink() or not path.is_file():
+        raise ImportRefused("--page-manifest must be a regular non-symlink file")
+    entry = _safe_archive_name(entry)
+    try:
+        raw = path.read_bytes()
+    except OSError as exc:
+        raise ImportRefused(f"cannot read page manifest: {exc.strerror or type(exc).__name__}") from None
+    if not raw or len(raw) > MAX_JSON_BYTES:
+        raise ImportRefused("page manifest size is outside the bounded JSON limit")
+    archived = prepared.files.get(entry)
+    if archived is None or archived != raw:
+        raise ImportRefused(
+            f"local page manifest is not byte-exact with archive entry {entry}"
+        )
+    data = _json_no_duplicates(raw, label="Factory page manifest")
+    if not isinstance(data, dict) or set(data) != {
+        "schema_version",
+        "metadata",
+        "media_roles",
+        "write_operations",
+    }:
+        raise ImportRefused("Factory page manifest top-level fields are not exact")
+    if data.get("schema_version") != SCHEMA_VERSION:
+        raise ImportRefused("Factory page manifest schema_version is unsupported")
+
+    metadata = data.get("metadata")
+    if not isinstance(metadata, dict) or set(metadata) != {
+        "title",
+        "description",
+        "tags",
+        "category",
+        "license",
+        "status",
+    }:
+        raise ImportRefused("Factory page metadata fields are not exact")
+    if metadata.get("title") != title or metadata.get("status") != "draft":
+        raise ImportRefused("Factory page metadata must bind the exact title and draft status")
+    _plain_text(metadata.get("description"), label="metadata.description", minimum=1, maximum=2000)
+    _plain_text(metadata.get("category"), label="metadata.category", minimum=1, maximum=80)
+    _plain_text(metadata.get("license"), label="metadata.license", minimum=1, maximum=60)
+    tags = metadata.get("tags")
+    if not isinstance(tags, list) or len(tags) > 10:
+        raise ImportRefused("metadata.tags must be an array of at most 10 tags")
+    tag_keys: set[str] = set()
+    for index, tag in enumerate(tags):
+        value = _plain_text(tag, label=f"metadata.tags[{index}]", minimum=1, maximum=40)
+        key = value.casefold()
+        if key in tag_keys:
+            raise ImportRefused("metadata.tags contains a duplicate")
+        tag_keys.add(key)
+
+    media_roles = data.get("media_roles")
+    if not isinstance(media_roles, dict) or not media_roles or len(media_roles) > 20:
+        raise ImportRefused("media_roles must be an object with 1..20 entries")
+    clean_roles: dict[str, str] = {}
+    media_paths: set[str] = set()
+    for role, relative in media_roles.items():
+        if not isinstance(role, str) or re.fullmatch(r"[a-z][a-z0-9_]{0,39}", role) is None:
+            raise ImportRefused(f"invalid media role: {role!r}")
+        if not isinstance(relative, str):
+            raise ImportRefused(f"media role {role} path must be text")
+        relative = _safe_archive_name(relative)
+        if PurePosixPath(relative).suffix.lower() != ".png":
+            raise ImportRefused(f"media role {role} must be a PNG")
+        if relative in media_paths:
+            raise ImportRefused("media_roles contains duplicate file paths")
+        archive_relative = f"{ARCHIVE_ROOT}/{relative}"
+        if archive_relative not in prepared.files:
+            raise ImportRefused(f"media role {role} is missing from prepared archive: {relative}")
+        if len(prepared.files[archive_relative]) > MAX_MEDIA_BYTES:
+            raise ImportRefused(f"media role {role} exceeds {MAX_MEDIA_BYTES} bytes")
+        width, height = _png_dimensions(
+            prepared.files[archive_relative], label=f"media role {role}"
+        )
+        if width * 9 != height * 16:
+            raise ImportRefused(
+                f"media role {role} must have exact 16:9 pixel dimensions"
+            )
+        clean_roles[role] = relative
+        media_paths.add(relative)
+
+    operations = data.get("write_operations")
+    if not isinstance(operations, list) or len(operations) != 2:
+        raise ImportRefused("write_operations must contain exactly use-case PATCH and story-blocks PUT")
+    use_op, story_op = operations
+    if (
+        not isinstance(use_op, dict)
+        or set(use_op) != {"method", "path_template", "body"}
+        or use_op.get("method") != "PATCH"
+        or use_op.get("path_template") != "/api/v1/designs/{slug}/use-case"
+    ):
+        raise ImportRefused("first write operation must be exact owner-only use-case PATCH")
+    if (
+        not isinstance(story_op, dict)
+        or set(story_op) != {"method", "path_template", "body"}
+        or story_op.get("method") != "PUT"
+        or story_op.get("path_template") != "/api/v1/designs/{slug}/story-blocks"
+    ):
+        raise ImportRefused("second write operation must be exact owner-only story-blocks PUT")
+
+    use_case = use_op.get("body")
+    if not isinstance(use_case, dict) or set(use_case) != {"label", "body", "image"}:
+        raise ImportRefused("use-case body fields are not exact")
+    _plain_text(use_case.get("label"), label="use_case.label", minimum=1, maximum=40)
+    _plain_text(use_case.get("body"), label="use_case.body", minimum=180, maximum=400)
+    used_media = {
+        _placeholder_media_path(use_case.get("image"), label="use_case.image")
+    }
+
+    story_body = story_op.get("body")
+    if not isinstance(story_body, dict) or set(story_body) != {"story_blocks"}:
+        raise ImportRefused("story-blocks PUT body must contain only story_blocks")
+    story_blocks = story_body.get("story_blocks")
+    if not isinstance(story_blocks, list) or not (1 <= len(story_blocks) <= 10):
+        raise ImportRefused("story_blocks must contain 1..10 blocks")
+    clean_blocks: list[dict[str, Any]] = []
+    for index, block in enumerate(story_blocks):
+        if not isinstance(block, dict) or not {"lead", "body"}.issubset(block):
+            raise ImportRefused(f"story_blocks[{index}] is incomplete")
+        if not set(block).issubset({"lead", "body", "hero_image", "pair_images"}):
+            raise ImportRefused(f"story_blocks[{index}] has unsupported fields")
+        _plain_text(block.get("lead"), label=f"story_blocks[{index}].lead", minimum=1, maximum=40)
+        _plain_text(block.get("body"), label=f"story_blocks[{index}].body", minimum=180, maximum=400)
+        if "hero_image" in block:
+            used_media.add(
+                _placeholder_media_path(
+                    block["hero_image"], label=f"story_blocks[{index}].hero_image"
+                )
+            )
+        if "pair_images" in block:
+            pairs = block["pair_images"]
+            if not isinstance(pairs, list) or len(pairs) > 10:
+                raise ImportRefused(f"story_blocks[{index}].pair_images must have 0..10 entries")
+            for pair_index, image in enumerate(pairs):
+                used_media.add(
+                    _placeholder_media_path(
+                        image,
+                        label=f"story_blocks[{index}].pair_images[{pair_index}]",
+                    )
+                )
+        clean_blocks.append(dict(block))
+    if not used_media.issubset(media_paths):
+        missing = sorted(used_media - media_paths)
+        raise ImportRefused(f"page copy references undeclared media roles: {missing}")
+
+    return PageManifest(
+        path=path,
+        entry=entry,
+        sha256=sha256_bytes(raw),
+        raw=raw,
+        data=data,
+        metadata=dict(metadata),
+        media_roles=clean_roles,
+        use_case=dict(use_case),
+        story_blocks=clean_blocks,
+    )
+
+
+def validate_game_handoff(
+    prepared: PreparedArchive, page_manifest_path: Path
+) -> None:
+    """Bind the playable rules and text2game handoff to their live sources."""
+    if (
+        page_manifest_path.name != "factory-page.json"
+        or page_manifest_path.parent.name != "content"
+    ):
+        raise ImportRefused(
+            "--page-manifest must be the game's exact content/factory-page.json"
+        )
+    game_root = page_manifest_path.parent.parent
+    bindings = (
+        (
+            "project/RULES.md",
+            game_root / "content" / "RULES.md",
+            MAX_JSON_BYTES,
+        ),
+        (
+            "project/_text2game/vibe-idea.json",
+            game_root / "idea.json",
+            MAX_JSON_BYTES,
+        ),
+    )
+    for archive_path, source, maximum in bindings:
+        if source.is_symlink() or not source.is_file():
+            raise ImportRefused(
+                f"game handoff source is missing or symlinked: {source}"
+            )
+        try:
+            raw = source.read_bytes()
+        except OSError as exc:
+            raise ImportRefused(
+                f"cannot read game handoff source {source.name}: {type(exc).__name__}"
+            ) from None
+        if not raw or len(raw) > maximum:
+            raise ImportRefused(
+                f"game handoff source is empty or too large: {source.name}"
+            )
+        if prepared.files.get(archive_path) != raw:
+            raise ImportRefused(
+                f"archive {archive_path} is not byte-exact with {source}"
+            )
+        if archive_path.endswith(".json"):
+            parsed = _json_no_duplicates(raw, label="game idea handoff")
+            if not isinstance(parsed, dict):
+                raise ImportRefused("game idea handoff must be a JSON object")
+        else:
+            try:
+                text = raw.decode("utf-8")
+            except UnicodeDecodeError:
+                raise ImportRefused("game RULES.md is not UTF-8 text") from None
+            if not text.strip() or "\x00" in text:
+                raise ImportRefused("game RULES.md has no usable rules text")
+
+
+def _required_archive_sha(prepared: PreparedArchive, path: str) -> str:
+    raw = prepared.files.get(path)
+    if raw is None:
+        raise ImportRefused(f"release gate input is missing from archive: {path}")
+    return sha256_bytes(raw)
+
+
+def _png_dimensions(raw: bytes, *, label: str) -> tuple[int, int]:
+    if len(raw) < 45 or raw[:8] != b"\x89PNG\r\n\x1a\n":
+        raise ImportRefused(f"{label} is not a valid PNG")
+    offset = 8
+    dimensions: tuple[int, int] | None = None
+    saw_idat = False
+    saw_iend = False
+    while offset + 12 <= len(raw):
+        length = struct.unpack(">I", raw[offset : offset + 4])[0]
+        if length > MAX_MEDIA_BYTES or offset + 12 + length > len(raw):
+            raise ImportRefused(f"{label} has a malformed PNG chunk")
+        kind = raw[offset + 4 : offset + 8]
+        payload = raw[offset + 8 : offset + 8 + length]
+        expected_crc = struct.unpack(">I", raw[offset + 8 + length : offset + 12 + length])[0]
+        if zlib.crc32(kind + payload) & 0xFFFFFFFF != expected_crc:
+            raise ImportRefused(f"{label} has an invalid PNG checksum")
+        if dimensions is None:
+            if kind != b"IHDR" or length != 13:
+                raise ImportRefused(f"{label} PNG does not begin with IHDR")
+            width, height = struct.unpack(">II", payload[:8])
+            if width < 1 or height < 1:
+                raise ImportRefused(f"{label} PNG has invalid dimensions")
+            dimensions = (width, height)
+        if kind == b"IDAT":
+            saw_idat = True
+        if kind == b"IEND":
+            if length != 0:
+                raise ImportRefused(f"{label} PNG has malformed IEND")
+            saw_iend = True
+            offset += 12
+            break
+        offset += 12 + length
+    if dimensions is None or not saw_idat or not saw_iend or offset != len(raw):
+        raise ImportRefused(f"{label} PNG is incomplete or has trailing bytes")
+    return dimensions
+
+
+def validate_release_gate(prepared: PreparedArchive) -> None:
+    """Prove the archived product is the exact fully-gated package build."""
+    gate_path = "project/gate.json"
+    raw = prepared.files.get(gate_path)
+    if raw is None or not raw or len(raw) > MAX_JSON_BYTES:
+        raise ImportRefused("prepared archive is missing bounded project/gate.json")
