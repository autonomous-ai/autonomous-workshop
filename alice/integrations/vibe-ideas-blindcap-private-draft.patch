+    complete = (
+        result["state"] == "confirmed"
+        and result["page_state"] == "confirmed"
+        and result["slice_state"] == "done"
+    )
+    return 0 if complete else 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
