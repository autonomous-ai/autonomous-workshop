+    files["project/gate.json"] = json.dumps(gate, indent=2).encode("utf-8") + b"\n"
+    if missing_occurrence:
+        del files[occurrence_paths[-1]]
+    if extra_part:
+        files["project/blindcap-duel_parts/unbound_01.stl"] = (
+            b"solid unbound\nendsolid unbound\n"
+        )
+    if secret:
+        files["project/.env"] = b"ACCESS_TOKEN='this-is-a-real-shaped-secret-value'\n"
+    if root_sidecar:
+        files["project/blindcap-duel.step.json"] = b'{"stale":true}\n'
+    if outside_wrapper:
+        files["README-outside-project.txt"] = b"would be dropped by backend\n"
+    records = [
+        {"bytes": len(raw), "path": name, "sha256": IMPORTER.sha256_bytes(raw)}
+        for name, raw in sorted(files.items())
+    ]
+    manifest = IMPORTER.manifest_for_files(title=TITLE, prompt=PROMPT, files=records)
+    manifest_raw = IMPORTER.canonical_json(manifest)
+    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
+        for name, raw in files.items():
+            archive.writestr(name, raw)
+        if symlink:
+            info = zipfile.ZipInfo("project/linked-model.stl")
+            info.create_system = 3
+            info.external_attr = (stat.S_IFLNK | 0o777) << 16
+            archive.writestr(info, "blindcap-duel.stl")
+            # The manifest deliberately does not include it; symlink rejection
+            # must happen before manifest comparison.
+        archive.writestr(IMPORTER.MANIFEST_ARCHIVE_PATH, manifest_raw)
+    raw = path.read_bytes()
+    page_path = root / "content" / "factory-page.json"
+    page_path.parent.mkdir(parents=True, exist_ok=True)
+    page_path.write_bytes(page_raw)
+    (root / "content" / "RULES.md").write_bytes(rules)
+    (root / "idea.json").write_bytes(idea)
+    if handoff_mismatch:
+        (root / "idea.json").write_text(
+            '{"title":"different inventor handoff"}\n', encoding="utf-8"
+        )
+    remote_files = {
+        name[len("project/") :]: value for name, value in files.items()
+    }
+    remote_files[IMPORTER.MANIFEST_PATH] = manifest_raw
+    return path, IMPORTER.sha256_bytes(raw), manifest_raw, page_path, remote_files
+
+
+def detail(
+    slug: str,
+    *,
+    title: str = TITLE,
+    status: str = "draft",
+    updated_at: str | None = None,
+    ordinal: int = 1,
+) -> dict[str, Any]:
+    out: dict[str, Any] = {
+        "current_history_id": f"history-{ordinal}",
+        "id": f"design-{ordinal}",
+        "project_url": f"https://cdn.example.test/design-{ordinal}/history-{ordinal}/",
+        "slug": slug,
+        "status": status,
+        "title": title,
+        "updated_at": updated_at or iso_now(),
+        "description": page_data()["metadata"]["description"],
+        "tags": page_data()["metadata"]["tags"],
+        "category": {"slug": page_data()["metadata"]["category"]},
+        "license": {"type": page_data()["metadata"]["license"]},
+        "use_case": None,
+        "story_blocks": [],
+    }
+    if status != "draft":
+        out["published_history_id"] = f"published-{ordinal}"
+        out["published_at"] = iso_now()
+    return out
