+        build_occurrence_stls.update(instance_stls)
+
+    if shipped_occurrence_stls != build_occurrence_stls:
+        raise ImportRefused("package gate shipped/build occurrence sets differ")
+    if len(shipped_occurrence_stls) != 28:
