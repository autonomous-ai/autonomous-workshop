<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Main tick agent. StartInterval 1800s (30 min): one tick advances ONE unit of
  work (one gate, one book study, one improvement session, or one stage of one
  game) then exits. A slow steady cadence beats a daily monolith that loses the
  whole spend when killed (text2cad receipt: "a kill loses the entire spend").
  eve drive executes real agent runs (the driver consumes the
  planner's dispatch and actually calls Claude); a logged no-op when audit/lease
  say no, so a 30-min cadence is safe to fire around the clock.
-->
<dict>
    <key>Label</key>
    <string>ai.autonomous.eve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/d/code/inventors/eve/bin/eve</string>
        <string>drive</string>
        <string>--steps</string>
        <string>1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/d/code/inventors/eve</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- RunAtLoad: first tick fires at install, so a fresh deploy proves
         itself immediately instead of 30 silent minutes later. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd agents get a bare PATH (/usr/bin:/bin); the claude CLI lives
         in ~/.local/bin, so agent dispatch would fail with "claude: command
         not found" without this. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/d/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Both streams to one log: the watchdog greps its tail for Traceback,
         and text2cad got burned by buffered/split output ("for up to 8 hours
         there was no live log at all"). launchd appends, never buffers. -->
    <key>StandardOutPath</key>
    <string>/Users/d/code/inventors/eve/state/logs/tick.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/d/code/inventors/eve/state/logs/tick.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
