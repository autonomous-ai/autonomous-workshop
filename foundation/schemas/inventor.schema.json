{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/v1.json",
  "title": "Autonomous inventor manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "niche",
    "summary",
    "autonomy",
    "status",
    "entrypoint",
    "capabilities",
    "core_features",
    "source"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "name": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "niche": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "summary": {
      "type": "string", "minLength": 1, "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "autonomy": {
      "enum": ["autonomous", "human-checkpointed", "reference"]
    },
    "status": {
      "enum": ["active", "experimental", "blocked", "reference", "archived"]
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "core_features": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["local", "upstream-snapshot"]},
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\u0000-\\u001f\\u007f]+/[^?#\\u0000-\\u001f\\u007f]+$"
        },
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "imported_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "oneOf": [
        {
          "properties": {"kind": {"const": "local"}},
          "required": ["kind"],
          "maxProperties": 1
        },
        {
          "properties": {"kind": {"const": "upstream-snapshot"}},
          "required": ["kind", "url", "commit", "imported_at"]
        }
      ]
    }
  }
}
