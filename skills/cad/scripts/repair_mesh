#!/usr/bin/env python3
"""Repair the three defect classes `check_mesh` fails on, in the exported STL.

    slivers        dropped -- a triangle with no altitude is a line, not a surface
    open edges     each boundary loop is planarised, polygonized and triangulated
    non-manifold   every vertex whose faces form more than one umbrella is split
                   into one vertex per umbrella, each nudged into its own material

Run in that order, because the stages feed each other: dropping a sliver that was
stitching a T-junction opens a hole, and filling a figure-8 rim removes the pinch
that would otherwise have to be split.

**This is the second-best fix and it says so.** Every defect here was produced by
the generator, and a repaired STL is not reproducible -- the next `export` writes
the broken mesh again, and nothing downstream compares the two. The report ends
by naming the source fix for whatever it had to touch;
`references/repair-loop.md` carries them under "Mesh defects the generator
produced". Repair the artifact to unblock a print, then fix the source.

    python skills/cad/scripts/repair_mesh part_x.stl -o part_x.fixed.stl
    python skills/cad/scripts/repair_mesh part_x.stl --dry-run

Exit 0 when the result is watertight, manifold and consistently wound, 1 when
anything is left, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent))

from meshlib import (  # noqa: E402
    SLIVER_HEIGHT, boundary_directed, components, edge_table, load_stl,
    sliver_metrics, summarize, vertex_umbrellas, weld, write_stl,
)

PLANE_TOL = 1e-3     # mm; how far a hole rim may stray from its own best-fit plane
NUDGE = 2e-3         # mm; how far a split umbrella moves into its own material


def drop_slivers(verts, faces, height_tol):
    """Remove triangles with no altitude. Returns (faces, count)."""
    _, height, _ = sliver_metrics(verts, faces)
    keep = height > height_tol
    return faces[keep], int((~keep).sum())


def _fit_plane(points):
    """Best-fit plane of a point set as (centroid, ex, ey, normal).

    The normal's sign is pinned by its largest component so two loops in the
    same plane cannot be grouped apart just because SVD flipped one of them, and
    `ey` is then rebuilt from the cross product rather than taken from SVD --
    negating an SVD basis wholesale mirrors it, and a mirrored projection turns
    every left/right test below into its own opposite.
    """
    centroid = points.mean(axis=0)
    basis = np.linalg.svd(points - centroid)[2]
    normal = basis[2]
    if normal[np.argmax(np.abs(normal))] < 0:
        normal = -normal
    ex = basis[0]
    return centroid, ex, np.cross(normal, ex), normal


def _planar_patch(verts, ring, plane_tol):
    """Project a set of boundary vertices onto their plane. None if not flat."""
    centroid, ex, ey, normal = _fit_plane(verts[ring])
    deviation = float(np.abs((verts[ring] - centroid) @ normal).max())
    if deviation > plane_tol:
        return None, deviation
    return {int(i): (float((verts[i] - centroid) @ ex),
                     float((verts[i] - centroid) @ ey)) for i in ring}, deviation


def _coplanar_groups(verts, edges, labels, plane_tol):
    """Group boundary loops that share a plane.

    Nested rims -- a hole with an island in it -- are separate connected
    components, so filling each on its own lays the outer patch straight over
    the island. Only loops considered together can be resolved as one planar
    subdivision, and "together" means coplanar, not connected.
    """
    groups: list[dict] = []
    for label in np.unique(labels[np.unique(edges)]):
        loop = edges[labels[edges[:, 0]] == label]
        centroid, _ex, _ey, normal = _fit_plane(verts[np.unique(loop)])
        offset = float(centroid @ normal)
        for group in groups:
            if (float(group["normal"] @ normal) > 1 - 1e-6
                    and abs(offset - group["offset"]) <= plane_tol):
                group["loops"].append(loop)
                break
        else:
            groups.append({"normal": normal, "offset": offset, "loops": [loop]})
    return groups


def _rim_votes(rings, lookup, traversal):
    """How a candidate region's rings run against the mesh's own rim traversal."""
    forward = reverse = 0
    for ring in rings:
        ids = [lookup.get(xy) for xy in ring]
        for a, b in zip(ids, ids[1:]):
            if a is None or b is None:
                continue
            forward += (a, b) in traversal
            reverse += (b, a) in traversal
    return forward, reverse


def fill_holes(verts, faces, plane_tol):
    """Triangulate every boundary loop that lies in a plane.

    A rim that pinches -- two holes meeting at one corner, the figure-8 that
    defeats a naive fan or ear-clip fill -- is handled by polygonizing the rim
    segments rather than walking them: `polygonize` returns one region per face
    of the planar subdivision, so the pinch simply comes back as two.

    Which of those regions is material is decided by the rim's own direction,
    not by nesting. The single mesh face on a boundary edge traverses it one
    way, and material lies on the side a patch closing it would traverse the
    other way. Nesting looks like it would do -- fill the outer ring, subtract
    the inner -- and it silently gets an annulus backwards, because polygonize
    hands back the ring and the island as siblings, neither containing the
    other. The direction test is also what keeps the fill's winding consistent
    with the shell it closes, so the two questions have one answer.

    A constrained Delaunay triangulation then fills each material region
    without adding vertices, so every patch triangle lands on rim vertices that
    already exist.
    """
    from shapely import constrained_delaunay_triangles
    from shapely.geometry import MultiLineString
    from shapely.geometry.polygon import orient
    from shapely.ops import polygonize

    _keys, inverse, counts, directed = edge_table(faces)
    edges = boundary_directed(counts, inverse, directed)
    if not len(edges):
        return verts, faces, 0, []

    notes: list[str] = []
    labels = components(len(verts), edges)
    traversal = {(int(a), int(b)) for a, b in edges}
    patch: list[list[int]] = []

    for group in _coplanar_groups(verts, edges, labels, plane_tol):
        loop_edges = np.concatenate(group["loops"])
        where = f"{len(group['loops'])} loop(s), {len(loop_edges)} edges"
        flat, deviation = _planar_patch(verts, np.unique(loop_edges), plane_tol)
        if flat is None:
            notes.append(f"{where} not planar ({deviation:.4f} mm out); left open")
            continue
        lookup = {xy: i for i, xy in flat.items()}
        try:
            regions = list(polygonize(MultiLineString(
                [(flat[int(a)], flat[int(b)]) for a, b in loop_edges])))
            if not regions:
                raise ValueError("rim does not enclose a region")
        except Exception as exc:                    # noqa: BLE001 - reported, not raised
            notes.append(f"{where}: {exc}; left open")
            continue

        added, missed, skipped = [], 0, 0
        for region in regions:
            region = orient(region, 1.0)            # CCW exterior, CW interiors
            rings = [list(region.exterior.coords)] + \
                    [list(r.coords) for r in region.interiors]
            forward, reverse = _rim_votes(rings, lookup, traversal)
            if reverse <= forward:                  # void, not material
                skipped += 1
                continue
            try:
                triangles = constrained_delaunay_triangles(region)
            except Exception as exc:                # noqa: BLE001
                notes.append(f"{where}: {exc}; region left open")
                continue
            for tri in getattr(triangles, "geoms", []):
                corners = list(tri.exterior.coords)[:3]
                ids = [lookup.get(xy) for xy in corners]
                if any(i is None for i in ids):
                    missed += 1
                    continue
                (ax, ay), (bx, by), (cx, cy) = corners
                if (bx - ax) * (cy - ay) - (by - ay) * (cx - ax) < 0:
                    ids.reverse()                   # normalise every triangle to CCW
                added.append(ids)
        if missed:
            notes.append(f"{where}: {missed} patch triangles landed off "
                         "the rim and were skipped")
        if not added:
            if skipped:
                notes.append(f"{where}: every region read as void; left open")
            continue
        # Final safety net on the whole patch: it must traverse each rim edge
        # against the mesh. Region selection should already guarantee this.
        flip, keep = 0, 0
        for a, b, c in added:
            for u, v in ((a, b), (b, c), (c, a)):
                flip += (u, v) in traversal
                keep += (v, u) in traversal
        patch += [[c, b, a] for a, b, c in added] if flip > keep else added

    if not patch:
        return verts, faces, 0, notes
    return verts, np.concatenate([faces, np.array(patch, dtype=faces.dtype)]), len(patch), notes


def split_umbrellas(verts, faces, nudge):
    """Give every extra umbrella its own vertex, moved into its own material.

    The move is what makes the split survive the round trip. STL carries
    coordinates and no indices, so two umbrellas left at the same point are
    welded straight back together by the next reader -- the split would hold in
    memory and be gone from the file. `--nudge 0` therefore repairs nothing you
    can export.

    It is not free: the vertex takes roughly `area * nudge / 3` of volume with
    it per incident triangle, which on a coarse mesh is tenths of a cubic
    millimetre. The report prints the volume either side so the cost is visible
    rather than inferred.
    """
    _keys, inverse, counts, _directed = edge_table(faces)
    labels = vertex_umbrellas(faces, counts, inverse)
    pairs = np.stack([faces.reshape(-1), labels], axis=1)
    uniq, inv = np.unique(pairs, axis=0, return_inverse=True)
    inv = inv.reshape(-1)

    # Group corners by umbrella once. Scanning `inv` per umbrella instead would
    # be O(vertices x faces), which is invisible on a fixture and minutes on a
    # tessellated part.
    order = np.argsort(inv, kind="stable")
    sizes = np.bincount(inv, minlength=len(uniq))
    starts = np.cumsum(sizes) - sizes

    remap = np.empty(len(uniq), dtype=np.int64)
    seen: set[int] = set()
    extra: list[np.ndarray] = []
    for k, (vertex, _label) in enumerate(uniq):
        vertex = int(vertex)
        if vertex not in seen:
            seen.add(vertex)
            remap[k] = vertex
            continue
        # Aim at the centroid of this umbrella's own faces: whichever way the
        # two cones of material lie, that direction is inside one of them.
        owned = faces[order[starts[k]:starts[k] + sizes[k]] // 3]
        toward = verts[owned].reshape(-1, 3).mean(axis=0) - verts[vertex]
        length = float(np.linalg.norm(toward))
        offset = toward / length * nudge if length > 0 else np.zeros(3)
        remap[k] = len(verts) + len(extra)
        extra.append(verts[vertex] + offset)

    if not extra:
        return verts, faces, 0
    return (np.concatenate([verts, np.array(extra)]),
            remap[inv].reshape(-1, 3), len(extra))


def _grid(origin, u, v, nu, nv, skip=()):
    """Tessellate a planar quad into nu x nv cells, omitting `skip` cells."""
    o, u, v = map(np.asarray, (origin, u, v))
    out = []
    for i in range(nu):
        for j in range(nv):
            if (i, j) in skip:
                continue
            p = [o + u * (i + di) / nu + v * (j + dj) / nv
                 for di, dj in ((0, 0), (1, 0), (1, 1), (0, 1))]
            out += [[p[0], p[1], p[2]], [p[0], p[2], p[3]]]
    return out


def _repair(tris, **kw):
    verts, faces = weld(np.array(tris, dtype=float))
    faces, _ = drop_slivers(verts, faces, kw.get("sliver_height", SLIVER_HEIGHT))
    verts, faces, _added, notes = fill_holes(verts, faces, PLANE_TOL)
    verts, faces, _split = split_umbrellas(verts, faces, NUDGE)
    return summarize(verts, faces), notes


def _self_check():
    """The three defect classes, each on a fixture whose right answer is exact.

    The volumes are what make this a check rather than a demonstration. A fill
    that gets an annulus backwards still closes the mesh and still reports
    watertight -- it just lays the patch over the hole, and the only witness is
    that the solid came out 1.0 cm3 too heavy.
    """
    W = D = 40.0

    # 1. two square holes in a top face, touching at one corner: a figure-8 rim,
    #    plus two zero-height slivers.
    H, N = 23.2, 8
    holes = {(i, j) for i in (2, 3) for j in (2, 3)} | {(i, j) for i in (4, 5) for j in (4, 5)}
    tris = (_grid((0, 0, H), (W, 0, 0), (0, D, 0), N, N, skip=holes)
            + _grid((0, 0, 0), (0, D, 0), (W, 0, 0), N, N)
            + _grid((0, 0, 0), (W, 0, 0), (0, 0, H), N, N)
            + _grid((0, D, 0), (0, 0, H), (W, 0, 0), N, N)
            + _grid((0, 0, 0), (0, 0, H), (0, D, 0), N, N)
            + _grid((W, 0, 0), (0, D, 0), (0, 0, H), N, N)
            + [[[0, 0, 0], [W / 2, 0, 0], [W, 0, 0]], [[0, 0, H], [W / 2, 0, H], [W, 0, H]]])
    got, _ = _repair(tris)
    assert got["boundary"] == 0 and got["slivers"] == 0, got
    assert abs(got["volume"] - W * D * H) < 1e-6, got["volume"]

    # 2. a plate with a through-hole and no top face at all: two nested rims in
    #    one plane. Even-odd nesting fills this one over the hole.
    H, A, B, L = 10.0, 15.0, 25.0, 10.0
    hole = {(i, j) for i in (3, 4) for j in (3, 4)}
    tris = (_grid((0, 0, 0), (0, D, 0), (W, 0, 0), N, N, skip={(j, i) for i, j in hole})
            + _grid((0, 0, 0), (W, 0, 0), (0, 0, H), N, N)
            + _grid((0, D, 0), (0, 0, H), (W, 0, 0), N, N)
            + _grid((0, 0, 0), (0, 0, H), (0, D, 0), N, N)
            + _grid((W, 0, 0), (0, D, 0), (0, 0, H), N, N)
            + _grid((A, A, 0), (0, L, 0), (0, 0, H), 2, 4)
            + _grid((B, A, 0), (0, 0, H), (0, L, 0), 4, 2)
            + _grid((A, A, 0), (0, 0, H), (L, 0, 0), 4, 2)
            + _grid((A, B, 0), (L, 0, 0), (0, 0, H), 2, 4))
    got, _ = _repair(tris)
    assert got["boundary"] == 0, got
    assert abs(got["volume"] - (W * D - L * L) * H) < 1e-6, got["volume"]

    # 3. two blocks at a 28 mm pitch with a 28 mm footprint, so they meet along
    #    exactly one edge: the bowtie a pocket grid produces.
    def block(x0, y0, x1, y1, z1):
        return (_grid((x0, y0, z1), (x1 - x0, 0, 0), (0, y1 - y0, 0), 1, 1)
                + _grid((x0, y0, 0), (0, y1 - y0, 0), (x1 - x0, 0, 0), 1, 1)
                + _grid((x0, y0, 0), (x1 - x0, 0, 0), (0, 0, z1), 1, 1)
                + _grid((x0, y1, 0), (0, 0, z1), (x1 - x0, 0, 0), 1, 1)
                + _grid((x0, y0, 0), (0, 0, z1), (0, y1 - y0, 0), 1, 1)
                + _grid((x1, y0, 0), (0, y1 - y0, 0), (0, 0, z1), 1, 1))
    pitch = 28.0
    got, _ = _repair(block(0, 0, pitch, pitch, 5) + block(pitch, pitch, 2 * pitch, 2 * pitch, 5),
                     sliver_height=0.0)
    assert got["nonmanifold_edges"] == 0 and got["pinched_vertices"] == 0, got
    # The split moves geometry, so this one is a bound rather than an equality.
    # A vertex shared by two 392 mm2 triangles carries roughly area * nudge / 3
    # of volume with it -- 0.3 mm3 here, and larger the coarser the tessellation.
    nominal = 2 * pitch * pitch * 5
    assert abs(got["volume"] - nominal) / nominal < 1e-4, got["volume"]

    # 4. a rim spanning two faces of a box lies in no plane, and must be left
    #    open with a note rather than filled with something plausible.
    tris = (_grid((0, 0, H), (W, 0, 0), (0, D, 0), 2, 2, skip={(0, 0)})
            + _grid((0, 0, 0), (0, D, 0), (W, 0, 0), 2, 2)
            + _grid((0, 0, 0), (W, 0, 0), (0, 0, H), 2, 2, skip={(0, 1)})
            + _grid((0, D, 0), (0, 0, H), (W, 0, 0), 2, 2)
            + _grid((0, 0, 0), (0, 0, H), (0, D, 0), 2, 2)
            + _grid((W, 0, 0), (0, D, 0), (0, 0, H), 2, 2))
    got, notes = _repair(tris)
    assert got["boundary"] == 6, got
    assert any("not planar" in n for n in notes), notes

    print("repair_mesh self-check: ok")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("stl", nargs="?", help="omit with --self-check")
    ap.add_argument("-o", "--out", help="output STL (default: <name>.repaired.stl)")
    ap.add_argument("--sliver-height", type=float, default=SLIVER_HEIGHT,
                    help="mm; triangles thinner than this altitude are dropped")
    ap.add_argument("--plane-tol", type=float, default=PLANE_TOL,
                    help="mm; a hole rim further than this from its own plane is left open")
    ap.add_argument("--nudge", type=float, default=NUDGE,
                    help="mm; how far a split umbrella moves into its own material")
    ap.add_argument("--no-fill", action="store_true", help="leave open edges alone")
    ap.add_argument("--no-split", action="store_true", help="leave non-manifold edges alone")
    ap.add_argument("--dry-run", action="store_true", help="report, write nothing")
    ap.add_argument("--self-check", action="store_true",
                    help="repair four fixtures whose right answer is known, and stop")
    args = ap.parse_args()

    if args.self_check:
        _self_check()
        return 0
    if not args.stl:
        ap.error("an STL is required unless --self-check is given")

    source = Path(args.stl)
    verts, faces = weld(load_stl(source))
    before = summarize(verts, faces, sliver_height=args.sliver_height)

    actions, notes = [], []
    faces, dropped = drop_slivers(verts, faces, args.sliver_height)
    if dropped:
        actions.append(f"dropped {dropped} sliver triangles")

    if not args.no_fill:
        verts, faces, added, fill_notes = fill_holes(verts, faces, args.plane_tol)
        notes += fill_notes
        if added:
            actions.append(f"filled {before['boundary_loops']} boundary loop(s) "
                           f"with {added} triangles")

    if not args.no_split:
        verts, faces, split = split_umbrellas(verts, faces, args.nudge)
        if split:
            actions.append(f"split {split} umbrellas, each moved {args.nudge:g} mm")

    after = summarize(verts, faces, sliver_height=args.sliver_height)

    print(f"{source}: {before['triangles']} triangles -> {after['triangles']}")
    rows = [
        ("sliver triangles", "slivers"),
        ("open edges", "boundary"),
        ("non-manifold edges", "nonmanifold_edges"),
        ("pinched vertices", "pinched_vertices"),
        ("flipped edges", "flipped"),
        ("shells", "shells"),
    ]
    for label, key in rows:
        mark = " " if before[key] == after[key] else ("+" if after[key] > before[key] else "-")
        print(f"  {mark} {label:22s} {before[key]:>7} -> {after[key]}")
    print(f"    {'volume cm3':22s} {before['volume'] / 1000:>7.2f} -> {after['volume'] / 1000:.2f}")

    for action in actions:
        print(f"  did   {action}")
    for note in notes:
        print(f"  note  {note}")

    residual = (after["boundary"] or after["nonmanifold_edges"] or after["flipped"]
                or after["volume"] <= 0)
    if not args.dry_run:
        out = Path(args.out) if args.out else source.with_suffix(".repaired.stl")
        write_stl(out, verts, faces, header=f"repair_mesh from {source.name}")
        print(f"  wrote {out}")

    if before["nonmanifold_edges"]:
        print("  fix   a feature whose pitch equals its own size leaves neighbours "
              "touching at a corner; see references/repair-loop.md")
    if before["boundary"]:
        print("  fix   a union of solids that only touch returns two solids, not one; "
              "overlap the operands and assert the body count in the builder")

    print("RESULT:", "DEFECTS REMAIN" if residual else "clean")
    return 1 if residual else 0


if __name__ == "__main__":
    sys.exit(main())
