# Bob runtime knobs — copy to .env (ops scripts `set -a` source it). All optional.
BOB_DAILY_BUDGET_USD=25
BOB_MAX_INFLIGHT=3
BOB_PUBLISH_DRY_RUN=1          # 0 only after state/panda-auth.json holds the bob account
BOB_TELEGRAM_TOKEN=
BOB_TELEGRAM_CHAT=
# Per-phase model routing (defaults to claude-sonnet-5). Opus where mistakes cascade.
BOB_BOB_IDEATOR_MODEL=claude-opus-5
BOB_BOB_RULES_WRITER_MODEL=claude-opus-5
BOB_BOB_ENGINE_WRITER_MODEL=claude-opus-5
BOB_BOB_BRIEF_WRITER_MODEL=claude-opus-5
BOB_BOB_BUILDER_MODEL=claude-opus-5
BOB_BOB_IMPROVER_MODEL=claude-opus-5
