SAMPLES_DIR = "samples"
HELPER_ROUNDS_DIR = "helper-rounds"
HELPER_FREEZE_NAME = "shared-helpers-freeze.json"
HELPER_FREEZE_LOG = "shared-helper-freezes.jsonl"
INTERFACE_ROUNDS_DIR = "interface-rounds"
COUPLED = "coupled"
SEPARABLE = "separable"
# An Interface may name one instance of a Unique Geometry whose count is above
# 1, ``wing#2`` (issue #80). The instance's Component is the geometry's one
# source file, whose placement hook then takes the instance number.
INSTANCE_REFERENCE = re.compile(r"^([a-z0-9]+(?:-[a-z0-9]+)*)#([1-9][0-9]*)$")
PLACE_FUNC = "assembly_pose"
# A schema 3 Design Contract seals each reference's Reference Camera, and the
# host's camera-only amendments live beside WISH.json (ADR 0083).
CAMERA_SCHEMA_VERSION = 3
# A schema 4 Design Contract gives every Interface its text, and a component
# round delivers the Component's contract itself (ADR 0084).
INTERFACE_TEXT_SCHEMA_VERSION = 4
AMENDMENTS_NAME = "CONTRACT-AMENDMENTS.json"
# The host reaches a run with an Owner Contract Amendment (issue #100) only
# when this tool carries the marker below; a run materialized before it is
# refused, since its rounds would keep reading the sealed rows.
OWNER_AMENDMENTS_MARKER = "workshop-owner-contract-amendments-v1"
DISPLAY_POSE_DIR = "display-pose"
INSTANCE_PARAM = "instance"
INSTANCE_CONVENTION = ("define %s(shape, pose, %s) to place instance n in assembly coordinates, and "
                       "gen_step(%s=1) to build a variant per instance (omit it to build identical copies)"
                       % (PLACE_FUNC, INSTANCE_PARAM, INSTANCE_PARAM))
# Directories that hold no Shared Helper: evidence, caches and the samples.
NOT_HELPERS = frozenset({"measure", "rounds", "snap", "review", "ref", SAMPLES_DIR,
                         "__cadgen__", "__pycache__", ".git", ".venv"})


def file_hash(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def source_hashes(project):
    """Bind helpers and design constraints as well as entry generators: the
    assembly packet depends on every file of the project."""
    return {
        p.relative_to(project).as_posix(): file_hash(p)
        for p in sorted(project.rglob("*"))
        if p.is_file() and p.suffix in (".py", ".md", ".json", ".step", ".stp")
        and not any(v in ("rounds", "__cadgen__", "__pycache__", ".git", ".venv")
                    for v in p.relative_to(project).parts)
        and (p.suffix in (".py", ".step", ".stp") or not any(
            v in ("measure", "snap", "review") for v in p.relative_to(project).parts))
    }


def _module_files(project: Path, base: Path, dotted: str, level: int) -> list[Path]:
    """The project files ``import`` of ``dotted`` at relative ``level`` from a
    module in ``base`` executes: each package's ``__init__.py`` and the module
    itself. A name outside the project (cadgen, the standard library) has none."""

    root = project if level == 0 else base
    for _ in range(max(0, level - 1)):
        root = root.parent
    files = []
    parts = [part for part in dotted.split(".") if part]
    for index, part in enumerate(parts):
        root = root / part
        if (root / "__init__.py").is_file():
            files.append(root / "__init__.py")
        elif index == len(parts) - 1 and root.with_suffix(".py").is_file():
            files.append(root.with_suffix(".py"))
        elif not root.is_dir():
            break
    return [path for path in files if project in path.resolve().parents]


def imported_helpers(project: Path, source: Path) -> dict[str, str]:
    """Project-relative path -> sha256 of every project-local module the
    Component's source imports, directly or through another such module.

    Read from the import statements, without running the source: a component
    packet and lock depend on these Shared Helpers only, never on a helper the
    Component does not import or on another Component's files (ADR 0081).
    """

    import ast

    project = project.resolve()
    found: dict[Path, None] = {}
    pending = [source.resolve()]
    seen = set()
    while pending:
        module = pending.pop()
        if module in seen:
            continue
        seen.add(module)
        try:
            tree = ast.parse(module.read_text(encoding="utf-8"))
        except (OSError, SyntaxError, UnicodeError, ValueError):
            continue
        for node in ast.walk(tree):
            targets = []
            if isinstance(node, ast.Import):
                targets = [(alias.name, 0) for alias in node.names]
            elif isinstance(node, ast.ImportFrom):
                stem = node.module or ""
                targets = [(stem, node.level)]
                # ``from features import forms`` may name a submodule.
                targets += [((stem + "." if stem else "") + alias.name, node.level)
                            for alias in node.names if alias.name != "*"]
            for dotted, level in targets:
                for path in _module_files(project, module.parent, dotted, level):
                    resolved = path.resolve()
                    if resolved != source.resolve() and resolved not in found:
                        found[resolved] = None
                        pending.append(resolved)
    return {path.relative_to(project).as_posix(): file_hash(path) for path in sorted(found)}


def component_sources(project: Path, role: str) -> dict[str, str]:
    """What a component round binds: its own source and STEP and the Shared
    Helpers it imports (ADR 0081)."""

    project = project.resolve()
    source = project / ("part_%s.step.py" % role)
    bound = imported_helpers(project, source) if source.is_file() else {}
    for path in (source, project / ("part_%s.step" % role), project / ("part_%s.stp" % role)):
        if path.is_file():
            bound[path.name] = file_hash(path)
    return dict(sorted(bound.items()))


def compose_comparison(reference: Path, render: Path, out_path: Path, caption: str) -> None:
    """The reference beside the model at the reference's camera, both scaled to
    one height, so a thinner limb, a blockier body or a missing opening shows
    as a difference of form (ADR 0075)."""

    from PIL import Image, ImageDraw

    panels = []
    for path in (reference, render):
        image = Image.open(path)
        image.load()
        flat = Image.new("RGBA", image.size, (255, 255, 255, 255))
        flat.alpha_composite(image.convert("RGBA"))
        width = max(1, round(flat.width * COMPARISON_HEIGHT / flat.height))
        panels.append(flat.convert("RGB").resize((width, COMPARISON_HEIGHT)))
    gap, header = 16, 24
    canvas = Image.new("RGB", (sum(p.width for p in panels) + gap, COMPARISON_HEIGHT + header), "white")
    canvas.paste(panels[0], (0, header))
    canvas.paste(panels[1], (panels[0].width + gap, header))
    ImageDraw.Draw(canvas).text((4, 4), caption, fill="black")
    canvas.save(out_path)


def reference_view(ref: str) -> tuple[str, str, str]:
    """``(render_review --view value, output stem, caption camera)`` for one
    reference: its declared ``@AZ,EL`` camera, else the front view. A declared
    tolerance only mattered to the removed pose search."""

    camera = split_camera(ref)[1]
    if camera is None:
        return "front", "front", "front (no declared camera)"
    az, el = (float(v) for v in camera.split(",")[:2])
    # render_review names an AZ,EL view az{:g}_el{:g}.
    return "%g,%g" % (az, el), "az%g_el%g" % (az, el), "%g,%g" % (az, el)


def prepare_comparisons(project, out, refs, display_pose=False):
    """``(comparisons, error)``: one composed image per shown reference.
    ``display_pose`` composes the Component's Display Pose render at each
    Reference Camera instead of the print stance (ADR 0083)."""

    views = out / "visual"
    renders = views / DISPLAY_POSE_DIR if display_pose else views
    comparisons = {}
    for index, (label, ref) in enumerate(refs):
        reference = resolve_reference(ref, project)
        _view, stem, caption_camera = reference_view(ref)
        render = renders / (stem + ".png")
        if reference is None or not render.is_file():
            return {}, "no model render at the declared camera for %s" % label
        target = views / ("compare-%02d.png" % index)
        if display_pose:
            caption = "%s  reference | model in its Display Pose at Reference Camera %s" % (label, caption_camera)
        else:
            caption = "%s  reference | model at declared camera %s" % (label, caption_camera)
        try:
            compose_comparison(reference, render, target, caption)
        except Exception as exc:  # noqa: BLE001 - any unreadable image leaves no evidence
            return {}, "could not compose the comparison for %s: %s" % (label, exc)
        comparisons[str(target.resolve())] = {"label": label, "sha256": file_hash(target)}
    return comparisons, None


def prepare_visual(project, entry, out, cad, refs, component=None, display_pose=False, contract=None,
                   rulings=None):
    """Render evidence for native inspection; never infer a visual verdict.
    ``component`` is the role of a component round, else None.
    ``display_pose`` (a component round of a schema 3 contract) renders the
    comparisons from the Component in its Display Pose at each reference's
    Reference Camera, while front, top and iso stay in the print stance.
    ``contract`` (a component round of a schema 4 contract) is the
    Component's own Design Contract, bound into the packet (ADR 0084).
    ``rulings`` are the Workshop Manager's decided rulings on the
    Component's Blocked Reports, bound into the packet when there are any
    (issue #97)."""
    bound = (lambda: component_sources(project, component)) if component else (lambda: source_hashes(project))
    before = bound()
    views = out / "visual"
    command = [sys.executable, str(cad / "render_review"), str(entry)]
    for view in VISUAL_VIEWS:
        command += ["--view", view]
    reference_views = list(dict.fromkeys(reference_view(ref)[0] for _label, ref in refs))
    for view in reference_views if not display_pose else ():
        if view not in VISUAL_VIEWS:
            # the = form: argparse reads a leading "-" as a new option
            command.append("--view=%s" % view)
    done = run(command + ["--sheet", "-o", str(views)], cwd=project, log=out / "visual-render.log")
    paths = [views / (VISUAL_SHEET + ".png")]
    rendered = [views / (v + ".png") for v in VISUAL_VIEWS]
    if done.returncode or not all(p.is_file() for p in (*paths, *rendered)) or before != bound():
        return {"status": "error", "findings": [], "detail": "Visual render failed or source changed; inspect visual-render.log"}
    if display_pose and refs:
        posed = out / ("display_pose_%s.step.py" % component.replace("-", "_"))
        posed.write_text(DISPLAY_POSE_ENTRY % {"project": str(project), "part": entry.name}, encoding="utf-8")
        done = run([sys.executable, str(cad / "render_review"), str(posed),
                    *("--view=%s" % view for view in reference_views),
                    "-o", str(views / DISPLAY_POSE_DIR)],
                   cwd=project, log=out / "display-pose-render.log")
        if done.returncode or before != bound():
            return {"status": "error", "findings": [],
                    "detail": "Display Pose render failed or source changed; inspect display-pose-render.log"}
    comparisons, error = prepare_comparisons(project, out, refs, display_pose)
    if error is not None:
        return {"status": "error", "findings": [], "detail": error}
    references = {}
    for label, ref in refs:
        path = resolve_reference(ref, project)
        if path is not None:
            references[str(path.resolve())] = file_hash(path)
    packet = {"schema_version": 3, "sources": before,
              "images": {str(p.resolve()): file_hash(p) for p in paths},
              "references": references,
              "comparisons": comparisons}
    if contract is not None:
        packet["contract"] = contract
    if rulings:
        packet["rulings"] = rulings
    packet_path = out / "visual-packet.json"
    packet_path.write_text(json.dumps(packet, sort_keys=True, indent=2) + "\n", encoding="utf-8")
    if component:
        detail = ("An independent reviewer (not the Workshop Manager) compares each reference with the model "
                  "beside it and all views; record the review with --record-review <review.json>")
        if display_pose:
            detail = ("An independent reviewer (not the Workshop Manager) compares each reference with the model "
                      "beside it in its Display Pose at the Reference Camera, and judges print-facing surfaces "
                      "from the print-stance views; record the review, or a camera mismatch, with "
                      "--record-review <review.json>")
        if contract is not None:
            detail += ("; the packet's contract holds the Component's rows and the text of every Interface "
                       "naming it")
        if rulings:
            detail += ("; the packet's rulings are the Workshop Manager's decisions on this Component's Blocked "
                       "Reports, which bind the reviewer")
        detail += COMPONENT_REVIEW_STEPS
    else:
        detail = VISUAL_REVIEW_STEPS
        if comparisons:
            detail += " Then, in each compare-NN.png, compare each reference with the model beside it and list every difference of form."
    return {"status": "pending", "findings": [], "packet": str(packet_path),
            "packet_sha256": file_hash(packet_path),
            "sheet": str((views / (VISUAL_SHEET + ".png")).resolve()),
            "detail": detail}


def component_role(project: Path, value: str) -> tuple[str, Path]:
    """Resolve one canonical component source without accepting path traversal."""
    name = Path(value).name
    if value != name or not name.startswith("part_") or not name.endswith(".step.py"):
        raise ValueError("--component must name one part_<role>.step.py in the CAD project")
    role = name[len("part_"):-len(".step.py")]
    if not role or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", role):
        raise ValueError("--component has an invalid role")
    source = project / name
    if not source.is_file():
        raise ValueError("component source does not exist: %s" % name)
    return role, source


def state_and_round_root(project: Path, component: str | None) -> tuple[Path, Path]:
    measure = project / "measure"
    if component is None:
        return measure / STATE_NAME, measure / ROUNDS_DIR
    role, _ = component_role(project, component)
    root = measure / COMPONENT_ROUNDS_DIR / role
    return root / STATE_NAME, root


def packet_error(visual: dict, project: Path, role: str | None = None) -> str | None:
    """Why a round's visual packet no longer shows the current evidence, or
    None. ``role`` names a component round's Component."""

    packet_path = Path(visual["packet"])
    if file_hash(packet_path) != visual["packet_sha256"]:
        return "visual packet changed"
    packet = json.loads(packet_path.read_text())
    current = source_hashes(project) if role is None else component_sources(project, role)
    if packet["sources"] != current:
        return "stale CAD sources or design constraints"
    comparisons = packet.get("comparisons") or {}
    bound = {**packet["images"], **packet["references"],
             **{path: item["sha256"] for path, item in comparisons.items()}}
    for path, digest in bound.items():
        if not Path(path).is_file() or file_hash(path) != digest:
            return "stale images or references"
    return None


def record_visual(project, feedback_path, full=False, component=None, check_motion=None):
    """Attach native observations to the last assembly round without rebuilding it."""
    if component is not None:
        raise ValueError("a component round is judged by an independent reviewer: use --record-review")
    state_path, _ = state_and_round_root(project, None)
    state = json.loads(state_path.read_text())
    out = Path(state["last_out"])
    summary_path = out / "summary.json"
    summary = json.loads(summary_path.read_text())
    visual = summary["visual"]
    if visual["status"] != "pending":
        raise ValueError("visual feedback is only accepted once for a pending round")
    stale = packet_error(visual, project)
    if stale is not None:
        raise ValueError("visual packet changed" if stale == "visual packet changed" else "visual feedback has %s" % stale)
    feedback = json.loads(Path(feedback_path).read_text())
    if not VISUAL_FEEDBACK_FIELDS <= set(feedback) or not set(feedback) <= VISUAL_FEEDBACK_FIELDS | {"differences"}:
        raise ValueError("invalid visual feedback fields")
    if feedback["packet_sha256"] != visual["packet_sha256"]:
        raise ValueError("visual feedback belongs to a different round")
    if feedback["status"] not in ("pass", "fail", "inconclusive"):
        raise ValueError("invalid visual feedback status")
    findings = feedback["findings"]
    if not isinstance(findings, list) or len(findings) > 12:
        raise ValueError("visual feedback needs at most 12 findings")
    for item in findings:
        if not isinstance(item, dict) or set(item) != {"part", "defect", "evidence", "repair"}:
            raise ValueError("visual findings need part, defect, evidence and repair")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("visual finding text must be nonempty and bounded")
    if (feedback["status"] == "pass" and findings) or (feedback["status"] == "fail" and not findings):
        raise ValueError("visual status contradicts findings")
    check_verdicts(feedback, visual, feedback["status"] == "pass", "a visual pass")
    if not isinstance(feedback["observation"], str) or not 1 <= len(feedback["observation"].strip()) <= 2000:
        raise ValueError("visual feedback needs a bounded observation, including uncertainty")
    check_differences(feedback)
    previous = previous_observation(out, summary)
    if previous is not None and " ".join(previous.split()) in " ".join(feedback["observation"].split()):
        raise ValueError("visual feedback repeats the previous round's observation; inspect this round's images")
    visual.update(feedback)
    summary["ok"] = summary["checks_ok"] and feedback["status"] == "pass"
    if full:
        if not summary["ok"]:
            raise ValueError("final verification requires a clean round and visual pass")
        cad = skills_root() / "cad" / "scripts"
        # The final verifier independently requires the separate blind review.
        command = [sys.executable, str(cad / "verify_project"), str(project),
                   "--strict-fit", "--print-gates", "--nozzle", str(summary.get("nozzle", 0.4)),
                   "--report", str(project / "measure/verification-pipeline.md")]
        motion_option = summary.get("check_motion") if check_motion is None else check_motion
        if motion_option is not None:
            command += ["--check-motion", str(motion_option).lower()]
        if summary["refs"] or summary.get("sealed"):
            command.append("--image-derived")
        done = run(command, cwd=project, log=out / "verify.log", timeout=FULL_TIMEOUT_SECONDS)
        summary["full"] = {"ok": done.returncode == 0, "returncode": done.returncode, "tail": tail(done.stdout or done.stderr)}
        summary["ok"] = done.returncode == 0
        report = project / "measure/geometry-inspection.json"
        if report.is_file() and json.loads(report.read_bytes()).get("status") == "unverified":
            summary["geometry_status"] = "unverified"
            summary["print_ready_claim"] = False
            summary["full"]["status"] = "unverified"
    (out / "visual-feedback.json").write_text(json.dumps(feedback, sort_keys=True, indent=2) + "\n")
    summary_path.write_text(json.dumps(summary, sort_keys=True, indent=1) + "\n")
    return summary


def check_verdicts(record: dict, visual: dict, passing: bool, what: str) -> None:
    """Two separate judgements, as the review asks them (ADR 0087): against
    the plan the object is built from, and against the reference images when
    the packet has any. A reference judgement without a reference, or none
    with one, is a malformed record rather than a guess to accept."""

    if type(record["matches_plan"]) is not bool:
        raise ValueError("matches_plan must be true or false")
    shown = json.loads(Path(visual["packet"]).read_text(encoding="utf-8")).get("comparisons")
    if shown:
        if type(record["matches_reference"]) is not bool:
            raise ValueError("matches_reference must be true or false when the packet has reference images")
    elif record["matches_reference"] is not None:
        raise ValueError("matches_reference must be null when the packet has no reference image")
    if passing and (record["matches_plan"] is not True or record["matches_reference"] is False):
        raise ValueError("%s needs matches_plan true and matches_reference not false" % what)


def check_differences(feedback: dict) -> None:
    """Differences from a reference are named, and one still to repair cannot
    pass (ADR 0075)."""

    differences = feedback.get("differences", [])
    if not isinstance(differences, list) or len(differences) > MAX_DIFFERENCES:
        raise ValueError("visual feedback needs at most %d differences" % MAX_DIFFERENCES)
    for item in differences:
        if not isinstance(item, dict) or set(item) != {"feature", "reference", "model", "decision", "reason"}:
            raise ValueError("a difference needs feature, reference, model, decision and reason")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("difference text must be nonempty and bounded")
        if item["decision"] not in ("repair", "keep"):
            raise ValueError("a difference is either repaired or kept with a reason")
    if feedback["status"] == "pass" and any(item["decision"] == "repair" for item in differences):
        raise ValueError("a difference still to repair cannot pass")


def record_review(project: Path, review_path, component: str) -> dict:
    """Attach an independent reviewer's judgement to the latest component
    round without rebuilding it (ADR 0076).

    The reviewer saw the round's packet, so the packet, its images and the
    sources must be exactly what it saw. Agreement passes the component. A
    disagreement at the shape-repair limit is recorded as a component
    acceptance the run reports when it ends; before the limit it is the
    repair list for the next shape round.
    """

    role, source = component_role(project, component)
    state_path, round_root = state_and_round_root(project, component)
    state = json.loads(state_path.read_text())
    latest = state.get("round")
    if type(latest) is not int or latest < 1 or state.get("scope") != "component:%s" % role:
        raise ValueError("component round state is invalid")
    out = round_root / ("r%04d" % latest)
    summary_path = out / "summary.json"
    summary = json.loads(summary_path.read_text())
    if (
        summary.get("scope") != "component:%s" % role
        or summary.get("entry") != source.name
        or summary.get("parts") != [role]
    ):
        raise ValueError("component round summary is invalid")
    review = json.loads(Path(review_path).read_text(encoding="utf-8"))
    required = {"round", "packet_sha256", "reviewer", "agrees", "matches_plan", "matches_reference", "reason"}
    mismatch = isinstance(review, dict) and "camera_mismatch" in review
    if mismatch:
        required = (required - {"agrees", "matches_plan", "matches_reference"}) | {"camera_mismatch"}
    if (not isinstance(review, dict) or not required <= set(review)
            or not set(review) <= required | ({"differences", "reference_conflicts", "ruling_disputes"}
                                              if not mismatch else set())):
        raise ValueError("a review needs round, packet_sha256, reviewer, agrees, matches_plan, matches_reference "
                         "and reason, and optional differences, reference_conflicts and ruling_disputes; a "
                         "camera mismatch replaces agrees, matches_plan, matches_reference, differences, "
                         "reference_conflicts and ruling_disputes with camera_mismatch")
    if type(review["round"]) is not int or review["round"] != latest:
        raise ValueError("a review must judge the latest round, r%04d" % latest)
    if summary.get("review") is not None:
        raise ValueError("r%04d already has a recorded review" % latest)
    if summary.get("camera_mismatch") is not None:
        raise ValueError("r%04d already has a recorded camera mismatch; the run waits for the host to amend "
                         "that Reference Camera, then the Component is rerun unchanged" % latest)
    if not summary.get("checks_ok"):
        raise ValueError("r%04d did not pass its build and print checks; repair them before review" % latest)
    visual = summary.get("visual") or {}
    if visual.get("status") != "pending" or not visual.get("packet"):
        raise ValueError("r%04d has no visual packet to review" % latest)
    if review["packet_sha256"] != visual["packet_sha256"]:
        raise ValueError("the review belongs to a different visual packet")
    stale = packet_error(visual, project, role)
    if stale is not None:
        raise ValueError("the reviewed round has %s" % stale if stale != "visual packet changed" else stale)
    # Issue #97: the rulings the reviewer read are the Manager's current ones.
    shown_rulings = json.loads(Path(visual["packet"]).read_text(encoding="utf-8")).get("rulings") or []
    if shown_rulings != component_rulings(project, role):
        raise ValueError("the Workshop Manager decided a Blocked Report of %s after r%04d was rendered, so its "
                         "packet does not carry the current rulings; the worker reruns the Component unchanged "
                         "and the reviewer judges the new packet" % (role, latest))
    reviewer = review["reviewer"]
    if not isinstance(reviewer, str) or not 1 <= len(reviewer.strip()) <= 200:
        raise ValueError("a review needs the reviewer's name")
    if reviewer.strip().lower() in MANAGER_NAMES:
        raise ValueError("the Workshop Manager cannot review its own component")
    bound = reviewer_binding(state, reviewer)
    if not isinstance(review["reason"], str) or not 1 <= len(review["reason"].strip()) <= MAX_REASON:
        raise ValueError("a review needs a reason of 1 to %d characters" % MAX_REASON)
    if mismatch:
        return record_camera_mismatch(state, state_path, summary, summary_path, out, review, bound)
    if type(review["agrees"]) is not bool:
        raise ValueError("a review's agrees must be true or false")
    check_verdicts(review, visual, review["agrees"], "an agreeing review")
    differences = review.get("differences", [])
    if not isinstance(differences, list) or len(differences) > MAX_DIFFERENCES:
        raise ValueError("a review lists at most %d differences" % MAX_DIFFERENCES)
    for item in differences:
        if not isinstance(item, dict) or set(item) != {"feature", "reference", "model"}:
            raise ValueError("a difference needs feature, reference and model")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("difference text must be nonempty and bounded")
    conflicts = reference_conflicts(review, summary, project)
    disputes = ruling_disputes(review, summary, shown_rulings)
    if not review["agrees"] and not differences and (conflicts or disputes):
        if disputes and not conflicts:
            raise ValueError("a review whose only findings are Ruling Disputes agrees: the Workshop Manager's "
                             "ruling binds the reviewer, and a dispute is not a difference (issue #97); answer "
                             "with agrees true")
        raise ValueError("a review whose only findings are Reference Conflicts agrees: the Design Contract "
                         "wins, and a conflict is not a difference (ADR 0084); answer with agrees true")
    if not review["agrees"] and not differences:
        raise ValueError("a disagreeing review must list how the model differs from its reference")
    recorded = {
        "reviewer": reviewer.strip(), "agrees": review["agrees"], "reason": review["reason"].strip(),
        "matches_plan": review["matches_plan"], "matches_reference": review["matches_reference"],
        "round": latest, "differences": differences,
    }
    policy = review_policy(component_policy(state, round_root), {
        "agrees": review["agrees"], "identity": state.get("identity"), "carry_key": summary.get("carry_key"),
        "contract_rows": summary.get("contract_rows"),
        "imported_helpers": summary.get("imported_helpers") or {}, "review": recorded,
        **({"reference_conflicts": conflicts} if conflicts else {}),
        **({"ruling_disputes": disputes} if disputes else {}),
    })
    reviewed = policy["reviewed"]
    acceptance = None
    if reviewed["accepted"]:
        acceptance = {"reviewer": recorded["reviewer"], "reason": recorded["reason"],
                      "shape_rounds": int(policy.get("shape_rounds") or 0)}
        summary["accepted"] = acceptance
    reviewed["acceptance"] = acceptance
    summary["review"] = recorded
    if conflicts:
        summary["reference_conflicts"] = conflicts
        (out / "reference-conflicts.json").write_text(json.dumps(conflicts, sort_keys=True, indent=2) + "\n")
    if disputes:
        summary["ruling_disputes"] = disputes
        (out / "ruling-disputes.json").write_text(json.dumps(disputes, sort_keys=True, indent=2) + "\n")
    visual["status"] = "reviewed"
    summary["ok"] = policy["phase"] == LOCKED
    summary["locked"] = lock_record(policy)
    # The worker reads review.json; a Reference Conflict or a Ruling Dispute
    # is nothing to repair.
    worker_review = {key: value for key, value in review.items()
                     if key not in ("reference_conflicts", "ruling_disputes")}
    (out / "review.json").write_text(json.dumps(worker_review, sort_keys=True, indent=2) + "\n")
    summary_path.write_text(json.dumps(summary, sort_keys=True, indent=1) + "\n")
    state["policy"] = policy
    if bound is not None:
        state["reviewer_id"] = bound
    state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    return summary


def reference_conflicts(review: dict, summary: dict, project: Path) -> list[dict]:
    """A review's Reference Conflicts (ADR 0084), checked like a camera
    mismatch: each names a reference this round compared, what it shows and
    what the Design Contract requires instead. Returned as recorded, with the
    reference's label and the round's Component."""

    conflicts = review.get("reference_conflicts", [])
    if not isinstance(conflicts, list) or len(conflicts) > MAX_DIFFERENCES:
        raise ValueError("a review lists at most %d reference_conflicts" % MAX_DIFFERENCES)
    compared = {}
    for label, ref in summary.get("refs") or ():
        path = resolve_reference(ref, project)
        if path is not None:
            compared.setdefault(path.name, label)
    recorded = []
    for item in conflicts:
        if not isinstance(item, dict) or set(item) != {"file", "reference", "contract"}:
            raise ValueError("a reference conflict needs file, reference and contract: the reference image, "
                             "what it shows, and what the Design Contract requires, quoting the row or Interface")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= MAX_REASON for v in item.values()):
            raise ValueError("reference conflict text must be 1 to %d characters" % MAX_REASON)
        name = item["file"].strip()
        if name not in compared:
            raise ValueError("a reference conflict names one reference this round compared: %s"
                             % (", ".join(sorted(compared)) or "none"))
        recorded.append({"component": summary["parts"][0], "label": compared[name], "file": name,
                         "round": summary["round"], "reviewer": review["reviewer"].strip(),
                         "reference": item["reference"].strip(), "contract": item["contract"].strip()})
    return recorded


def record_camera_mismatch(state, state_path, summary, summary_path, out, review, bound) -> dict:
    """Record a reviewer's camera mismatch (ADR 0083): the side of the model
    that faces the Reference Camera is not the side the reference shows.

    It names the landmarks each side shows. It is not a Component Review: the
    policy stays awaiting review, no Shape Round is spent, and nothing is
    written where the worker reads its review. The summary holds the need the
    Workshop Manager stops the run with; the host answers it by amending that
    one reference's camera, and an unchanged rerun shows the new view.
    """

    shown = summary.get("reference_cameras")
    if not shown:
        raise ValueError("a camera mismatch needs a round compared at a Reference Camera (a schema 3 Design "
                         "Contract); this round has none")
    claim = review["camera_mismatch"]
    if not isinstance(claim, dict) or set(claim) != {"file", "reference", "model"}:
        raise ValueError("a camera mismatch needs file, reference and model: the reference image, the "
                         "landmarks it shows facing the camera, and the landmarks the model shows instead")
    if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= MAX_REASON for v in claim.values()):
        raise ValueError("a camera mismatch names the landmarks each side shows, in 1 to %d characters" % MAX_REASON)
    camera = next((item for item in shown if item["file"] == claim["file"].strip()), None)
    if camera is None:
        raise ValueError("a camera mismatch names one reference this round compared: %s"
                         % ", ".join(item["file"] for item in shown))
    az, el = camera["camera"]
    need = ("Reference Camera mismatch for %s (%s) at %g,%g: the reference shows %s; the model in its Display "
            "Pose shows %s. Answer with workshop resume <wish-id> --reference-camera %s=AZ,EL"
            % (camera["file"], camera["label"], az, el, claim["reference"].strip(), claim["model"].strip(),
               camera["file"]))
    summary["camera_mismatch"] = {
        "reviewer": review["reviewer"].strip(), "reason": review["reason"].strip(), "round": summary["round"],
        "file": camera["file"], "label": camera["label"], "camera": camera["camera"],
        "reference": claim["reference"].strip(), "model": claim["model"].strip(), "need": need,
    }
    summary["visual"]["status"] = "camera-mismatch"
    summary["ok"] = False
    (out / "camera-mismatch.json").write_text(json.dumps(review, sort_keys=True, indent=2) + "\n")
    summary_path.write_text(json.dumps(summary, sort_keys=True, indent=1) + "\n")
    if bound is not None:
        state["reviewer_id"] = bound
        state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    return summary


def reviewer_binding(state: dict, reviewer: str, runtime: str | None = None) -> str | None:
    """The native reviewer id a review binds the Component to, or None where
    the runtime gives no such id (issue #77).

    The id must have the runtime's format, so a name or a placeholder is
    refused. The Component's first review binds it; a review naming another
    id is refused with the bound one, so the Manager asks that thread again.
    """

    runtime = os.environ.get(REVIEWER_RUNTIME_ENV) if runtime is None else runtime
    if runtime not in REVIEWER_ID_FORMATS:
        return None
    pattern, shape = REVIEWER_ID_FORMATS[runtime]
    if not pattern.fullmatch(reviewer):
        raise ValueError(
            "reviewer must be the component-reviewer's native agent id (%s), exactly as the "
            "runtime returned it when the reviewer was spawned; got %r" % (shape, reviewer[:40]))
    bound = state.get("reviewer_id")
    if bound is not None and bound != reviewer:
        raise ValueError(
            "this Component's reviews are bound to reviewer %s; send the review request to "
            "that reviewer's thread and record its answer under that id" % bound)
    return reviewer


def lock_record(policy: dict) -> dict | None:
    """``{"round", "source"}`` of the review that locks the Component, or None."""

    if policy.get("phase") != LOCKED:
        return None
    reviewed = policy["reviewed"]
    return {"round": reviewed["round"], "source": "agreeing-review" if reviewed["agrees"] else "component-acceptance"}


def previous_observation(out: Path, summary: dict) -> str | None:
    """The previous round's recorded observation, when it is long enough that
    repeating it can only be a copy."""

    round_value = summary.get("round")
    if type(round_value) is not int or round_value < 2:
        return None
    try:
        earlier = json.loads((out.parent / ("r%04d" % (round_value - 1)) / "visual-feedback.json").read_text())
    except (OSError, ValueError):
        return None
    text = earlier.get("observation") if isinstance(earlier, dict) else None
    if not isinstance(text, str) or len(text.strip()) < COPIED_OBSERVATION_CHARS:
        return None
    return text


# ---------------------------------------------------------------------------
# locating the sibling skills


def skills_root() -> Path | None:
    """``.agents/skills`` in a run; the installed component roots in a checkout."""
    here = Path(__file__).resolve()
    candidate = here.parents[2]
    if (candidate / "cad" / "scripts").is_dir() and (candidate / "image-to-cad" / "scripts").is_dir():
        return candidate
    try:
        from workshop.runtime.package_data import product_run_domain_skill_roots
    except Exception:  # noqa: BLE001 - outside a Workshop install there is no fallback
        return None
    roots = product_run_domain_skill_roots()
    if "cad" in roots and "image-to-cad" in roots:
        return _RootsView(roots)
    return None


class _RootsView:
    """A mapping of skill name -> root that answers ``root / name`` like a Path."""

    def __init__(self, roots):
        self._roots = dict(roots)

    def __truediv__(self, name: str) -> Path:
        return Path(self._roots[name])


# ---------------------------------------------------------------------------
# pure helpers (self-checked without CAD)


def parse_build(stdout: str, stderr: str, returncode: int) -> dict:
    """The verdict and the reason from one part's `gen --write` run.

    Nothing here measures a wall: the toolchain writes STEP only and has no
    mesh, overhang or thickness gate, so a part that builds is *built*, never
    printable.
    """
    if returncode == 0:
        return {"verdict": "PASS", "failures": []}
    refusals = detail_refusals(stderr or stdout)
    if refusals:
        # Issue #86: the summary carries every Detail Refusal of the build,
        # so the worker never needs the log.
        return {"verdict": "FAIL", "detail_refusals": refusals,
                "failures": ["%d Detail Refusal(s); see the refuse lines" % len(refusals)]}
    fails = []
    for line in (stderr or stdout).splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("{"):
            fails.append(stripped[:80])
    return {"verdict": "FAIL", "failures": fails[-4:] or ["gen exit %d" % returncode]}


# print-details marks each Detail Refusal of a failed build with this, then
# its feature, site, reason and passing value as JSON (issue #86).
REFUSAL_LINE = "detail-refusal "


def detail_refusals(text: str) -> list[dict]:
    """Every Detail Refusal a failed build reported, in order."""
    found = []
    for line in (text or "").splitlines():
        at = line.find(REFUSAL_LINE + "{")
        if at < 0:
            continue
        try:
            item = json.loads(line[at + len(REFUSAL_LINE):])
        except ValueError:
            continue
        if isinstance(item, dict) and {"feature", "site", "reason", "passes"} <= item.keys():
            found.append({key: str(item[key]) for key in ("feature", "site", "reason", "passes")})
    return found


def refusal_keys(build: dict) -> list[str]:
    """What a later round compares to find a refused detail again: its
    feature and the line that asked for it."""
    return ["%s@%s" % (item["feature"], item["site"]) for item in build.get("detail_refusals") or []]


def repeated_refusals(previous: list | None, current: dict) -> list[str]:
    """A detail refused this round that was refused at the same site in the
    part's previous round. Counted apart from Repeated Print Defects: the
    worker leaves such a detail out (issue #86)."""
    before = set(previous or [])
    return [key for key in refusal_keys(current) if key in before]


def parse_identity(stdout: str) -> str | None:
    """A built part's B-rep hash from `gen --json`, when the tool reported one.

    `gen` emits `identitySha256` only for a shape it just built from a
    `gen_step()` source (ADR 0073: never for a shape reloaded from STEP).
    Absent for a component sourced by another cadgen build, an older cadgen
    without the field, or a mocked `run` in a test -- callers fall back to
    hashing the exported STEP bytes.
    """
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            payload = json.loads(line)
        except ValueError:
            continue
        value = payload.get("identitySha256") if isinstance(payload, dict) else None
        if isinstance(value, str) and value:
            return value
    return None


# Issue #102: a component round builds its source a second time, in its own
# process, and a source whose two builds differ fails the round.
REPRODUCE_TOOL = "reproduce_build"
REPRODUCE_HINT = ("the build depends on something besides its source: an unseeded random, set or dict "
                  "iteration order, the clock, a file it reads, or a Boolean switched back to parallel. "
                  "Make it build the same shape every time, then rerun the round")


def reproduction_failure(identity: str, done: subprocess.CompletedProcess) -> dict | None:
    """The build failure of a source whose second build did not reproduce
    ``identity``, the B-rep identity `gen` reported for its first; None when
    it did. A second build that fails, refuses a detail or reports another
    identity all mean one source does not give one B-rep (issue #102)."""
    second = parse_identity(done.stdout) if done.returncode == 0 else None
    if second == identity:
        return None
    failure = {"verdict": "FAIL", "reproducible": False, "identities": [identity, second]}
    if second is not None:
        why = "two builds of this source gave B-rep identities %s and %s" % (identity[:12], second[:12])
    elif done.returncode == 0:
        why = "a second build of this source reported no B-rep identity"
    else:
        refusals = detail_refusals(done.stderr or done.stdout)
        if refusals:
            failure["reproduction_refusals"] = refusals
            why = "the first build passed and a second build of the same source refused %s" % ", ".join(
                "%s at %s" % (item["feature"], item["site"]) for item in refusals[:4])
        else:
            lines = [line.strip() for line in (done.stderr or done.stdout or "").splitlines() if line.strip()]
            why = "the first build passed and a second build of the same source failed: %s" % (
                lines[-1][:120] if lines else "exit %d" % done.returncode)
    failure["failures"] = ["not reproducible: " + why, REPRODUCE_HINT]
    return failure


def reproduction_check(python: str, part: Path, project: Path, out: Path, identity: str) -> dict | None:
    """Build ``part`` again in its own process and compare its B-rep identity
    with ``identity``, the one `gen` reported for this round's build. Returns
    the round's build failure when they differ, else None. Self-contained, so
    a caller may run it beside the round's other checks."""
    role = part.name.removeprefix("part_").removesuffix(".step.py")
    tool = Path(__file__).resolve().with_name(REPRODUCE_TOOL)
    done = run([python, str(tool), str(part)], cwd=project, log=out / ("reproduce-%s.log" % role))
    return reproduction_failure(identity, done)


# A region row of either print gate, `N. [kind] ...`, and the line under it
# naming its feature: `at feature <key> -- ...` or `at face <key> -- ...`.
REGION_ROW = re.compile(r"\d+\.\s+\[([a-z ]+)\]")
REGION_FEATURE = re.compile(r"at (feature|face) (\S+) -- ")


def print_defects(stdout: str, failing: str) -> list[str]:
    """The keys of the regions of kind `failing` (wall, overhang), in order.

    A key is the print-details feature the gate named (`band@part_x.step.py:42`)
    or the nearest B-rep face (`plane@(12,-4,30)`). A region whose gate named
    nothing has no key and is not listed.
    """
    keys, kind = [], None
    for line in stdout.splitlines():
        stripped = line.strip()
        row = REGION_ROW.match(stripped)
        if row:
            kind = row.group(1).strip()
            continue
        named = REGION_FEATURE.match(stripped)
        if named and kind == failing and named.group(2) not in keys:
            keys.append(named.group(2))
        kind = None if named else kind
    return keys


def repeated_defects(previous: dict | None, current: dict) -> list[str]:
    """A Repeated Print Defect: a feature failing this round that also failed
    the same part's previous round (issue #82). Run comparisons count these,
    not the failure rate: repeats are blind repair."""
    if not isinstance(previous, dict) or previous.get("verdict") != "FAIL":
        return []
    before = {key for gate in ("thickness", "overhang")
              for key in ((previous.get(gate) or {}).get("defects") or [])}
    return [key for gate in ("thickness", "overhang")
            for key in ((current.get(gate) or {}).get("defects") or []) if key in before]


def parse_thickness(stdout: str) -> dict:
    """The verdict and the thinnest region from a check_thickness run."""
    verdict = "PASS" if "RESULT: printable at this wall" in stdout else "FAIL"
    fails = []
    wall_pass = False
    thinnest = None
    for line in stdout.splitlines():
        stripped = line.strip()
        if re.match(r"PASS\s+wall\s+>=", stripped):
            wall_pass = True
        if stripped.startswith("FAIL"):
            verdict = "FAIL"
            fails.append(" ".join(stripped.split()[1:])[:80])
        match = re.match(r"\d+\.\s+\[[a-z ]+\]\s+([0-9.]+) mm", stripped)
        if match:
            value = float(match.group(1))
            thinnest = value if thinnest is None else min(thinnest, value)
    if "RESULT: WALL BELOW MINIMUM" in stdout:
        verdict = "FAIL"
    if not fails and "RESULT: WALL BELOW MINIMUM" not in stdout and wall_pass:
        verdict = "PASS"
    if verdict == "FAIL" and not fails:
        fails.append("no passing wall result" if "RESULT: WALL BELOW MINIMUM" not in stdout else "wall below minimum")
    return {"verdict": verdict, "thinnest_mm": thinnest, "failures": fails[:4],
            "defects": print_defects(stdout, "wall")}


def parse_overhang(stdout: str) -> dict:
    """The verdict and the largest unsupported region from a check_overhang run.

    A `bridge` is spannable and does not fail the gate; only an `overhang`
    does. The gate has already decided that, so read its RESULT rather than
    re-deciding here, and keep the region rows for the repair prompt.
    """
    verdict = "PASS" if "RESULT: prints unsupported" in stdout else "FAIL"
    fails = []
    largest = None
    for line in stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("FAIL"):
            verdict = "FAIL"
            fails.append(" ".join(stripped.split()[1:])[:80])
        match = re.match(r"\d+\.\s+\[([a-z ]+)\]\s+([0-9.]+) mm2", stripped)
        if match and match.group(1).strip() == "overhang":
            area = float(match.group(2))
            largest = area if largest is None else max(largest, area)
    if "RESULT: NEEDS SUPPORT" in stdout:
        verdict = "FAIL"
    if verdict == "FAIL" and not fails:
        fails.append("needs support" if "RESULT: NEEDS SUPPORT" in stdout else "no overhang result")
    return {"verdict": verdict, "overhang_mm2": largest, "failures": fails[:4],
            "defects": print_defects(stdout, "overhang")}


# A print gate's exit status when the B-rep is valid but its mesh stays open
# after the finer retry (printlib.printed_mesh): nothing was measured, and it
# is not a print failure. It still never passes a round.
GATE_UNMEASURABLE = 4


def unmeasurable(parsed: dict, stdout: str) -> dict:
    """A gate result that could not measure an open mesh on a valid solid."""
    reason = next((line.strip() for line in stdout.splitlines() if "tessellation stays open" in line), "")
    parsed.update(verdict="UNMEASURABLE", defects=[],
                  failures=["unmeasurable mesh: " + (reason.split(": ", 1)[-1][:120] if reason
                                                     else "the mesh stays open on a valid solid")])
    return parsed


def print_context(cad: Path, nozzle: float, angle: float) -> dict | None:
    """Inputs to this print measurement, without importing numerical libraries.

    An unavailable identity disables reuse; it never supplies passing evidence.
    The wrapper hash also invalidates results after a parsing/cache-rule change,
    and `printlib.py` is in here because it owns the tessellation both gates
    measure -- a change to the deviation would change every verdict.
    """
    try:
        sources = {
            name: hashlib.sha256(path.read_bytes()).hexdigest()
            for name, path in (
                ("check_thickness", cad / "check_thickness"),
                ("check_overhang", cad / "check_overhang"),
                ("meshlib.py", cad / "meshlib.py"),
                ("printlib.py", cad / "printlib.py"),
                ("make_round", Path(__file__)),
            )
        }
        packages = {name: package_version(name) for name in ("numpy", "scipy")}
    except (OSError, PackageNotFoundError):
        return None
    return {
        "nozzle": nozzle, "overhang_angle": angle, "sources": sources,
        "packages": packages,
        "python": str(Path(sys.executable).resolve()), "python_version": sys.version,
        "platform": sys.platform,
    }


def reusable_print(item: dict | None) -> bool:
    """Only a recorded PASS of both gates, with its original tool logs, reuses."""
    if not isinstance(item, dict) or item.get("verdict") != "PASS":
        return False
    if not {"thickness", "overhang", "measured_round", "logs"} <= item.keys():
        return False
    if not isinstance(item["logs"], dict) or not item["logs"]:
        return False
    for path, digest in item["logs"].items():
        try:
            if hashlib.sha256(Path(path).read_bytes()).hexdigest() != digest:
                return False
        except (OSError, TypeError, ValueError):
            return False
    return all(
        isinstance(item.get(gate), dict) and item[gate].get("verdict") == "PASS"
        for gate in ("thickness", "overhang")
    )


def diff_parts(previous: dict, current: dict) -> list[str]:
    """Roles whose identity changed, or every role when nothing was recorded."""
    if not previous:
        return sorted(current)
    return sorted(role for role, digest in current.items() if previous.get(role) != digest)


LEDGER_LINE = re.compile(r"^\s*[-*]?\s*`?([A-Za-z][A-Za-z0-9_-]*)=(ref/[^`\s]+)`?\s*$")
# The Likeness handoff table in image-to-cad's build_spec.md template. A filled
# template produced no reference at all until this row was read too (ADR 0072).
LEDGER_ROW = re.compile(r"^\s*\|\s*([A-Za-z][A-Za-z0-9_-]*)\s*\|\s*`?(ref/[^`\s|]+)`?\s*\|")
# The template's camera column, `AZ,EL` optionally followed by `(±TOL)`.
LEDGER_CAMERA = re.compile(
    r"^\s*`?(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)`?\s*(?:\(\s*±\s*(\d+(?:\.\d+)?)\s*\))?\s*$"
)
# `@AZ,EL[,TOL]` after a reference path: where the image was taken from. It
# travels on the reference string, which is the form verify_project reads, and
# render_views gets it as --camera. Both own the rules; this only checks them
# early so a bad camera costs no render.
CAMERA_SUFFIX = re.compile(r"@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)(?:,(\d+(?:\.\d+)?))?$")


def split_camera(ref: str) -> tuple[str, str | None]:
    """``PATH[@AZ,EL[,TOL]]`` -> (path, camera text or None)."""
    match = CAMERA_SUFFIX.search(ref)
    if match is None:
        return ref, None
    return ref[:match.start()].strip(), ",".join(v for v in match.groups() if v is not None)


def checked_camera(ref: str) -> str:
    """The reference unchanged, or ValueError when its camera cannot be used."""
    if "@" not in ref:
        return ref
    _path, camera = split_camera(ref)
    if camera is None:
        raise ValueError("a reference camera must be @AZ,EL or @AZ,EL,TOL in degrees: %r" % (ref,))
    values = [float(v) for v in camera.split(",")]
    if not -90.0 <= values[1] <= 90.0:
        raise ValueError("reference camera elevation %g is outside -90..90: %r" % (values[1], ref))
    if len(values) == 3 and not 0.0 < values[2] < 90.0:
        raise ValueError("reference camera tolerance %g must be above 0 and below 90: %r" % (values[2], ref))
    return ref


def ledger_camera(line: str, match) -> str:
    """``@AZ,EL[,TOL]`` from a Likeness handoff row's camera column, or ""."""
    cells = line[match.end():].split("|")
    camera = LEDGER_CAMERA.match(cells[0]) if cells else None
    if camera is None:
        return ""
    return "@" + ",".join(v for v in camera.groups() if v is not None)


def parse_refs(values, spec_paths) -> list[tuple[str, str]]:
    """``LABEL=PATH[@AZ,EL[,TOL]]`` pairs from the command line, else from the
    spec's ledger. A declared camera stays on the path string."""
    refs = []
    for value in values or ():
        label, _, path = str(value).partition("=")
        if not label or not path:
            raise ValueError("--ref must be LABEL=PATH: %r" % (value,))
        refs.append((label.strip(), checked_camera(path.strip())))
    if refs:
        return refs
    for spec in spec_paths:
        for line in Path(spec).read_text(encoding="utf-8", errors="replace").splitlines():
            match = LEDGER_LINE.match(line)
            camera = ""
            if match is None:
                match = LEDGER_ROW.match(line)
                if match is not None:
                    camera = ledger_camera(line, match)
            if match:
                ref = str(Path(spec).parent / match.group(2)) + camera
                refs.append((match.group(1), checked_camera(ref)))
    return refs


def at_features(gate: dict) -> str:
    defects = gate.get("defects") or []
    if not defects:
        return ""
    return "  at " + ", ".join(defects[:4]) + (" ..." if len(defects) > 4 else "")


def render_summary(summary: dict) -> str:
    lines = [
        "make_round r%04d  %s  %s  changed %d/%d part(s)"
        % (summary["round"], summary.get("scope", "assembly"), summary["project"], len(summary["changed"]), len(summary["parts"]))
    ]
    for role in summary["checked"]:
        item = summary["build"][role]
        extra = ("  " + "; ".join(item["failures"])) if item["verdict"] == "FAIL" and item["failures"] else ""
        lines.append("  build %-4s %-28s%s" % (item["verdict"], role, extra))
        for refusal in item.get("detail_refusals") or []:
            lines.append("  refuse %s at %s: %s; passes with %s" % (
                refusal["feature"], refusal["site"], refusal["reason"], refusal["passes"]))
        for key in item.get("repeated_refusals") or []:
            lines.append("  again REFUSE %s  refused at the same site last round too: leave it out and "
                         "name it in your report" % key)
        gates = (summary.get("print") or {}).get(role)
        if gates is None:
            continue
        wall = gates["thickness"]
        thin = "" if wall.get("thinnest_mm") is None else "  thinnest %.2f mm" % wall["thinnest_mm"]
        failing = ("FAIL", "UNMEASURABLE")
        why = ("  " + "; ".join(wall["failures"])) if wall["verdict"] in failing and wall["failures"] else ""
        lines.append("  wall  %-4s %-28s%s%s%s" % (wall["verdict"], role, thin, why, at_features(wall)))
        over = gates["overhang"]
        area = "" if over.get("overhang_mm2") is None else "  largest %.0f mm2" % over["overhang_mm2"]
        why = ("  " + "; ".join(over["failures"])) if over["verdict"] in failing and over["failures"] else ""
        lines.append("  over  %-4s %-28s%s%s%s" % (over["verdict"], role, area, why, at_features(over)))
    for role, keys in sorted((summary.get("repeated_print_defects") or {}).items()):
        lines.append("  again FAIL %-28s  failed last round too: %s; repair from the report's feature column"
                     % (role, ", ".join(keys[:4])))
    unchecked = [r for r in summary["parts"] if r not in summary["checked"]]
    if unchecked:
        lines.append("  build skip %d unchanged part(s): %s" % (len(unchecked), ", ".join(unchecked[:6]) + (" ..." if len(unchecked) > 6 else "")))
        if summary.get("reused"):
            lines[-1] += "  (retained PASS evidence)"
    for item in summary.get("reference_errors") or []:
        lines.append("  ref   FAIL %-14s %s" % (item["label"], item["error"][:160]))
    for item in summary.get("sealed") or []:
        lines.append("  seal  %-14s shown to %s" % (item["label"], item["scored_by"]))
    if summary.get("shape_limit") is not None:
        used = summary.get("shape_rounds_used", summary.get("shape_rounds", 0))
        lines.append("  shape %d/%d shape round(s) used; this round %s" % (
            used, summary["shape_limit"], "is a shape round" if summary.get("shape_round") else "is not one"))
        if summary.get("identity") is not None:
            lines.append("  identity %s  B-rep identity (summary.json identity)" % summary["identity"])
        helpers = summary.get("imported_helpers") or {}
        if helpers:
            lines.append("  helpers " + ", ".join("%s %s" % (path, digest[:12]) for path, digest in helpers.items()))
        for item in summary.get("unlock") or []:
            if item.get("kind") == "shared-helper":
                lines.append("  unlock imported Shared Helper changed: %s" % ", ".join(item["paths"]))
            elif item.get("kind") == "contract-amendment":
                lines.append("  unlock a Contract Amendment changed this Component's rows (ADR 0085)")
            elif item.get("kind") == "interface":
                lines.append("  unlock interface %s r%04d: %s" % (item.get("interface"), item.get("interface_round", 0),
                                                                item.get("reason", "")[:160]))
            else:
                lines.append("  unlock %s r%04d: %s" % (item.get("kind"), item.get("assembly_round", 0), item.get("reason", "")[:160]))
        frozen = summary.get("helper_freeze") or {}
        for path in frozen.get("changed") or []:
            lines.append("  frozen %s changed since the freeze of r%04d; imported by %s; the Manager reruns "
                         "--shared-helpers" % (path, frozen.get("round") or 0,
                                               ", ".join(frozen["affected"].get(path, [])) or "no Component"))
        for interface_id, item in (summary.get("envelopes") or {}).items():
            lines.append("  keep  %-4s %-14s %s: %s" % (item["verdict"], interface_id, item["role"], item["detail"][:120]))
        locked = summary.get("locked")
        if locked:
            lines.append("  lock  LOCKED by the %s of r%04d; change the geometry only after an unlock" % (
                locked["source"].replace("-", " "), locked["round"]))
        for item in summary.get("wakes_blocked") or ():
            lines.append("  wake  Blocked Report %d of %s waited on this Component; tell the Manager to wake its worker"
                         % (item["report"], item["component"]))
    if summary.get("motion_status") == "not-run":
        lines.append("  move  SKIP motion unverified")
    if summary.get("motion") is not None:
        motion = summary["motion"]
        lines.append("  move  %-4s %s" % (motion["verdict"].upper()[:4], motion["detail"][:90]))
    if summary.get("full") is not None:
        lines.append("  full  %-4s verify_project exit %s  %s" % ("ok" if summary["full"]["ok"] else "FAIL", summary["full"]["returncode"], summary["full"]["tail"][:90]))
    if summary.get("visual") is not None:
        visual = summary["visual"]
        verdicts = ""
        if "matches_plan" in visual:
            verdicts = "plan=%s ref=%s  " % (
                str(visual["matches_plan"]).lower(),
                "n/a" if visual["matches_reference"] is None else str(visual["matches_reference"]).lower())
        lines.append("  visual %s  %s%s" % (visual["status"].upper(), verdicts,
                                            visual.get("observation", visual.get("detail", ""))))
        if visual.get("packet_sha256"):
            lines.append("  packet %s  %s  (summary.json visual.packet_sha256, visual.packet)"
                         % (visual["packet_sha256"], visual.get("packet", "")))
        for item in visual["findings"]:
            lines.append("    %s: %s | evidence: %s | repair: %s" % (item["part"], item["defect"], item["evidence"], item["repair"]))
        for item in visual.get("differences") or []:
            lines.append("    differs %s: reference %s | model %s | %s: %s" % (
                item["feature"], item["reference"], item["model"], item["decision"], item["reason"]))
        if visual["status"] == "pending" and summary.get("shape_limit") is not None:
            lines.append("    reviewer inspects %s; record it with --record-review <review.json>" % visual["packet"])
            lines.append("    worker: report this round and wait; only a rerun that leaves the geometry unchanged may run before the review")
        elif visual["status"] == "pending":
            lines.append("    inspect %s then use --record-visual <feedback.json>" % visual.get("sheet", visual["packet"]))
    review = summary.get("review")
    if review is not None:
        carried = " (carried from r%04d)" % review["carried_from"] if review.get("carried_from") else ""
        verdicts = ""
        if "matches_plan" in review:
            verdicts = "plan=%s ref=%s " % (
                str(review["matches_plan"]).lower(),
                "n/a" if review["matches_reference"] is None else str(review["matches_reference"]).lower())
        lines.append("  review %s%s by %s: %s%s" % ("AGREES" if review["agrees"] else "DISAGREES", carried,
                                                  review["reviewer"], verdicts, review["reason"][:160]))
        for item in review.get("differences") or []:
            lines.append("    differs %s: reference %s | model %s" % (item["feature"], item["reference"], item["model"]))
        if summary.get("accepted"):
            lines.append("    ACCEPTED at the shape-repair limit (%d shape rounds); reported when the run ends" % summary["accepted"]["shape_rounds"])
    conflicts = summary.get("reference_conflicts") or []
    if conflicts:
        lines.append("  conflict %d Reference Conflict(s) recorded: the Design Contract wins; nothing to repair; "
                     "reported when the run ends" % len(conflicts))
    disputes = summary.get("ruling_disputes") or []
    if disputes:
        lines.append("  dispute the reviewer disputes the ruling on Blocked Report %s: not a difference; the ruling "
                     "stands and nothing is repaired; the Workshop Manager reads ruling-disputes.json"
                     % ", ".join(str(item["report"]) for item in disputes))
    rulings = summary.get("rulings") or []
    if rulings:
        lines.append("  ruling %d Blocked Report ruling(s) in the packet bind the reviewer: %s" % (
            len(rulings), ", ".join(str(item["report"]) for item in rulings)))
    contract = summary.get("contract")
    if contract is not None:
        lines.append("  contract %d requirement row(s), %d Interface(s) in summary.json and the packet" % (
            len(contract.get("requirements") or ()), len(contract.get("interfaces") or ())))
    for item in summary.get("reference_cameras") or []:
        amended = (" (amended from %g,%g)" % tuple(item["amended_from"])) if item.get("amended_from") else ""
        lines.append("  camera %s %s at %g,%g in the Display Pose%s" % (item["label"], item["file"], item["camera"][0], item["camera"][1], amended))
    mismatch = summary.get("camera_mismatch")
    if mismatch is not None:
        lines.append("  review CAMERA MISMATCH by %s: not a Shape Round; the worker gets no repair text" % mismatch["reviewer"])
        lines.append("    need: %s" % mismatch["need"])
        lines.append("    Workshop Manager: stop the run with this need; after the host amends the camera, rerun the Component unchanged")
    verdict = ("UNVERIFIED" if summary.get("geometry_status") == "unverified" else "PASS") if summary["ok"] else "FAIL"
    if (summary.get("visual") or {}).get("status") == "pending" and summary.get("checks_ok"):
        verdict = "PENDING"
    lines.append("  %s  reports under %s" % (verdict, summary["out"]))
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# running the tools


def run(command, *, cwd, log: Path, timeout=TOOL_TIMEOUT_SECONDS, extra_env=None) -> subprocess.CompletedProcess:
    started = time.monotonic()
    name = Path(command[1]).name if len(command) > 1 else ""
    analysis = name in {"check_thickness", "check_overhang", "check_motion", "check_mesh", "check_envelope"}
    environment = {**os.environ, "CADGEN_WARM": "0", **(extra_env or {})}
    if analysis:
        budget = float(environment.get("WORKSHOP_GEOMETRY_TIMEOUT", "600"))
        if not 0 < budget <= 86400:
            raise ValueError("WORKSHOP_GEOMETRY_TIMEOUT must be in (0, 86400]")
        # An explicitly selected analysis allowance must not be silently
        # capped by the generic 900-second command timeout. Keep the old
        # command default when no operation override was requested.
        operation_timeout = float(environment.get("WORKSHOP_GEOMETRY_OPERATION_TIMEOUT", timeout))
        if not math.isfinite(operation_timeout) or not 0 < operation_timeout <= 86400:
            raise ValueError("WORKSHOP_GEOMETRY_OPERATION_TIMEOUT must be finite and in (0, 86400]")
        deadline = _GEOMETRY_DEADLINES.setdefault(str(cwd), time.monotonic() + budget)
        timeout = min(operation_timeout, max(0, deadline - time.monotonic()))
    with tempfile.TemporaryFile() as failures:
        environment["WORKSHOP_GEOMETRY_FAILURE_FD"] = str(failures.fileno())
        if timeout == 0:
            stdout, stderr, code = "", "geometry time allowance exhausted", 3
        else:
            process = subprocess.Popen(command, cwd=str(cwd), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, start_new_session=True, env=environment, pass_fds=(failures.fileno(),))
            try:
                stdout, stderr = process.communicate(timeout=timeout)
                code = process.returncode
            except (subprocess.TimeoutExpired, KeyboardInterrupt) as interrupted:
                if isinstance(interrupted, KeyboardInterrupt) and analysis:
                    _GEOMETRY_DEADLINES[str(cwd)] = time.monotonic()
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                stdout, stderr = process.communicate(timeout=5)
                code = 3 if analysis else 124
        failures.seek(0)
        if code == 3 and failures.read(1):
            code = 124  # an earlier measured failure remains a failure
    done = subprocess.CompletedProcess(command, code, stdout, stderr)
    log.write_text(
        "$ %s\n(%.1fs, exit %d)\n--- stdout\n%s\n--- stderr\n%s"
        % (" ".join(str(c) for c in command), time.monotonic() - started, done.returncode, done.stdout, done.stderr),
        encoding="utf-8",
    )
    return done


def parse_motion(stdout: str | bytes, returncode: int, stderr: str | bytes = "") -> dict:
    """Read the complete motion result without promoting partial output to PASS."""
    if isinstance(stdout, bytes):
        stdout = stdout.decode("utf-8", errors="replace")
    if isinstance(stderr, bytes):
        stderr = stderr.decode("utf-8", errors="replace")
    result = {
        "verdict": "unverified" if returncode == 3 else "fail" if returncode else "inconclusive",
        "detail": "missing or invalid motion condition evidence",
        "returncode": returncode,
        "conditions": [],
    }
    if returncode:
        result["detail"] = "check_motion exit %d: %s" % (returncode, result["detail"])
        if stderr:
            result["detail"] += "; " + tail(stderr)[:120]
    lines = stdout.splitlines()
    start = next((i for i, line in enumerate(lines) if line.lstrip().startswith(("{", "["))), None)
    if start is None:
        return result
    try:
        # Never fall through to a nested object when the outer document is truncated.
        payload = json.loads("\n".join(lines[start:]))
    except json.JSONDecodeError:
        return result
    if isinstance(payload, dict):
        records = payload.get("results") if "results" in payload else payload.get("conditions")
        if "ok" in payload and not isinstance(payload["ok"], bool):
            return result
    else:
        records = payload
    if not isinstance(records, list) or not records:
        return result
    if any(
        not isinstance(record, dict)
        or not isinstance(record.get("id"), str) or not record["id"].strip()
        or record.get("status") not in ("pass", "fail", "inconclusive")
        or not isinstance(record.get("detail", ""), str)
        for record in records
    ):
        return result
    conditions = [
        {"id": record["id"], "status": record["status"], "detail": record.get("detail", "")}
        for record in records
    ]
    result["conditions"] = conditions
    statuses = [record["status"] for record in conditions]
    verdict = "fail" if "fail" in statuses else ("inconclusive" if "inconclusive" in statuses else "pass")
    if verdict == "pass":
        detail = "%d condition(s): all pass" % len(conditions)
    else:
        first = next(record for record in conditions if record["status"] == verdict)
        detail = "%s=%s: %s" % (first["id"], verdict, " ".join(first["detail"].split()))
    if isinstance(payload, dict) and payload.get("ok") is False and verdict == "pass":
        verdict, detail = "fail", "check_motion reports ok=false despite passing conditions"
    # Exit 1 is check_motion's documented result for failed or inconclusive checks.
    # Other nonzero exits, or exit 1 with all-pass evidence, are process failures.
    if returncode == 3 and "fail" not in statuses:
        verdict, detail = "unverified", "motion analysis cancelled or time allowance exhausted"
    elif returncode and (returncode != 1 or all(status == "pass" for status in statuses)):
        verdict, detail = "fail", "check_motion exit %d; %s" % (returncode, detail)
    result.update(verdict=verdict, detail=detail)
    return result


def resolve_reference(ref: str, project: Path):
    """A reference path as the Manager wrote it: absolute, project-relative,
    cwd-relative, or relative to the run workspace (the directory holding
    WISH.json above the project). The first that exists wins; None if none
    does. Round 27 of the goose run (2026-09-08) wrote a workspace-relative
    path and lost its score for it. A declared ``@AZ,EL[,TOL]`` camera is not
    part of the path."""

    candidate = Path(split_camera(ref)[0])
    if candidate.is_absolute():
        return candidate if candidate.is_file() else None
    roots = [project, Path.cwd()]
    workspace = run_root(project)
    if workspace is not None:
        roots.append(workspace)
    for root in roots:
        path = root / candidate
        if path.is_file():
            return path
    return None


def run_root(project: Path):
    """The run workspace holding WISH.json above the project, or None outside a run."""

    for parent in [project, *project.parents]:
        if (parent / "WISH.json").is_file():
            return parent
    return None


# Kept in step with WISH_REFERENCES_DIRECTORY and _REFERENCE_NAME in
# workshop/wish/contracts.py. This script is materialized into a run as a
# standalone tool and cannot import the host package.
WISH_REFERENCES_DIR = "wish-references"
SEALED_NAME = re.compile(r"^(ref-(?:0[1-9]|[1-9][0-9])-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)\.(?:png|jpg|webp)$")


def contract_reference_labels(wish: dict) -> dict:
    """Sealed file name -> Design Contract label, or ``{}`` outside Contract Mode.

    ADR 0072: in Contract Mode the Make round labels sealed references by the
    contract's ``shows`` field (``"assembly"`` or ``"geometry:<id>"``) instead
    of the sealed file's stem, since that is the vocabulary the contract and
    its review share.

    Runs sealed before the host kept a contract name intact hold
    ``ref-01-x.png`` as ``ref-01-ref-01-x.png``: the place prefix doubled,
    and only for the image's own place. That name maps to the same label.
    """

    context = wish.get("context") if isinstance(wish, dict) else None
    contract = context.get("design_contract") if isinstance(context, dict) else None
    if not isinstance(contract, dict):
        return {}
    labels = {}
    for reference in contract.get("references") or ():
        if isinstance(reference, dict) and isinstance(reference.get("file"), str) and isinstance(reference.get("shows"), str):
            name = reference["file"]
            labels[name] = reference["shows"]
            if SEALED_NAME.fullmatch(name):
                labels.setdefault(name[:len("ref-01-")] + name, reference["shows"])
    return labels


def sealed_contract(project: Path) -> dict | None:
    """The Design Contract the Wish sealed, or None outside Contract Mode or
    when the Wish cannot be read (the sealed references report that)."""

    root = run_root(project)
    if root is None:
        return None
    try:
        wish = json.loads((root / "WISH.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    context = wish.get("context") if isinstance(wish, dict) else None
    contract = context.get("design_contract") if isinstance(context, dict) else None
    return contract if isinstance(contract, dict) else None


def camera_contract(project: Path) -> bool:
    """Whether the sealed contract gives every reference a Reference Camera
    (schema 3 and later, ADR 0083). Earlier contracts keep the declared-camera
    rule."""

    return contract_schema(project) >= CAMERA_SCHEMA_VERSION


def contract_schema(project: Path) -> int:
    """The sealed Design Contract's schema version, 0 outside Contract Mode."""

    contract = sealed_contract(project)
    schema = contract.get("schema_version") if contract is not None else None
    return schema if type(schema) is int else 0


def camera_text(camera) -> str | None:
    """``"AZ,EL"`` for a usable ``[AZ, EL]`` Reference Camera, else None."""

    if (
        not isinstance(camera, list) or len(camera) != 2
        or any(isinstance(v, bool) or not isinstance(v, (int, float)) for v in camera)
        or not -180 <= camera[0] <= 180 or not -90 <= camera[1] <= 90
    ):
        return None
    return "%g,%g" % (camera[0], camera[1])


def reference_cameras(project: Path) -> tuple[dict, dict]:
    """``(cameras, amended)`` for a schema 3 contract: sealed file name ->
    ``"AZ,EL"``, each the contract's Reference Camera unless the host amended
    it, and file name -> the sealed camera it replaced. Both are empty before
    schema 3. Only the host writes the amendments file beside WISH.json; a
    file that does not parse amends nothing, and the host's own record of the
    amendment is what the run reports."""

    contract = sealed_contract(project)
    if contract_schema(project) < CAMERA_SCHEMA_VERSION:
        return {}, {}
    cameras = {}
    for reference in contract.get("references") or ():
        if isinstance(reference, dict) and isinstance(reference.get("file"), str):
            text = camera_text(reference.get("camera"))
            if text is not None:
                cameras[reference["file"]] = text
    amended = {}
    try:
        document = json.loads((run_root(project) / AMENDMENTS_NAME).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        document = None
    overrides = document.get("reference_cameras") if isinstance(document, dict) else None
    for name, camera in (overrides or {}).items() if isinstance(overrides, dict) else ():
        text = camera_text(camera)
        if name in cameras and text is not None and text != cameras[name]:
            amended[name] = cameras[name]
            cameras[name] = text
    return cameras, amended


def component_contract(project: Path, role: str) -> dict | None:
    """The Component's own Design Contract under a schema 4 contract (ADR
    0084): its Unique Geometry row, its requirement rows, and every Interface
    that names it (``<id>`` or ``<id>#<n>``) with that Interface's text. A
    component round writes it into its visual packet, for the reviewer, and
    its summary, for the worker. None before schema 4 and outside Contract
    Mode, where the Workshop Manager still sends the rows. Rows an applied
    Contract Amendment changed read as amended (ADR 0085)."""

    contract = current_contract(project)
    if contract is None or contract_schema(project) < INTERFACE_TEXT_SCHEMA_VERSION:
        return None
    scope = GEOMETRY_LABEL + role
    geometry = next((item for item in contract.get("geometries") or ()
                     if isinstance(item, dict) and item.get("id") == role), None)
    requirements = [{"id": item.get("id"), "text": item.get("text")}
                    for item in contract.get("requirements") or ()
                    if isinstance(item, dict) and item.get("scope") == scope]
    interfaces = [{key: item.get(key) for key in ("id", "kind", "components", "text")}
                  for item in contract.get("interfaces") or ()
                  if isinstance(item, dict) and isinstance(item.get("components"), list)
                  and role in reference_roles(item["components"])]
    return {"schema_version": contract_schema(project), "component": role, "geometry": geometry,
            "requirements": requirements, "interfaces": interfaces}


def place_hook_missing(part: Path) -> str:
    """Why ``part`` cannot be shown in its Display Pose, or "": a schema 3
    Component defines assembly_pose(shape, pose) (ADR 0083). Read from the
    source, so the refusal builds nothing."""

    try:
        tree = ast.parse(part.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError) as exc:
        return "%s cannot be read: %s" % (part.name, exc)
    if any(isinstance(node, ast.FunctionDef) and node.name == PLACE_FUNC for node in tree.body):
        return ""
    return ("%s defines no %s(shape, pose); under a schema 3 Design Contract every Component defines it, "
            "returning the shape placed in its Display Pose when pose is None, so its references can be "
            "compared from their Reference Cameras" % (part.name, PLACE_FUNC))


DISPLAY_POSE_ENTRY = '''"""Generated by make_round for one component round (ADR 0083).

The Component in its Display Pose: assembly_pose(shape, None) of its own
gen_step(), the first instance of a geometry whose count is above 1. Rendered
only to compare it with its references; never printed.
"""

import importlib.util
import inspect
import sys
from pathlib import Path

PRINTABLE = False
PROJECT = Path(%(project)r)
PART = %(part)r


def _takes_instance(function):
    try:
        return "instance" in inspect.signature(function).parameters
    except (TypeError, ValueError):
        return False


def gen_step():
    if str(PROJECT) not in sys.path:
        sys.path.insert(0, str(PROJECT))
    spec = importlib.util.spec_from_file_location("_display_pose_part", PROJECT / PART)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    place = module.assembly_pose
    if _takes_instance(place):
        built = module.gen_step(instance=1) if _takes_instance(module.gen_step) else module.gen_step()
        return place(built, None, instance=1)
    return place(module.gen_step(), None)
'''


def sealed_references(project: Path):
    """The references the Wish sealed, as ``(references, error)``.

    Each reference is ``{"label", "path", "sha256"}``. Outside Contract Mode
    the label is the sealed file's stem, so it names the same image in every
    round; in Contract Mode it is the contract's label for that file (ADR
    0072). Outside a run there is no Wish and no sealed reference. A Wish
    that cannot be read is an error, never an empty list: an empty list is
    how antisol-v01 scored nothing.
    """

    root = run_root(project)
    if root is None:
        return [], None
    try:
        wish = json.loads((root / "WISH.json").read_text(encoding="utf-8"))
        items = wish.get("references") or []
        if not isinstance(items, list):
            raise ValueError("references is not a list")
    except (OSError, ValueError, AttributeError) as exc:
        return [], "WISH.json unreadable: %s" % exc
    contract_labels = contract_reference_labels(wish)
    cameras, _amended = reference_cameras(project)
    sealed = []
    for item in items:
        name = item.get("name") if isinstance(item, dict) else None
        digest = item.get("sha256") if isinstance(item, dict) else None
        match = SEALED_NAME.fullmatch(name) if isinstance(name, str) else None
        if match is None or not isinstance(digest, str):
            return [], "WISH.json names an invalid reference: %r" % (name,)
        label = contract_labels.get(name, match.group(1))
        sealed.append({"label": label, "path": root / WISH_REFERENCES_DIR / name, "sha256": digest,
                       "camera": cameras.get(name)})
    return sealed, None


def current_passing_component_round(project: Path, role: str, digest: str | None) -> tuple[dict | None, str]:
    """The current, passing isolated round for one Component's evidence, or
    the reason it does not qualify.

    Both the assembly-review prerequisite and sealed-reference coverage need
    the same answer to "does this Component have a current, passing isolated
    round": a readable state and summary, a valid round number, a scope/entry/
    parts that agree with each other, a passing verdict, and an identity that
    has not moved since (``digest`` is the Component's current build identity,
    a B-rep hash whenever the build reported one, else the exported STEP's
    sha256 -- ADR 0073; ``None`` when it did not build this round). A Component
    whose STEP bytes differ from its recorded pass but whose B-rep identity
    still matches qualifies; the exporter's serialization is not the thing
    being checked. Returns ``(summary, "")`` when it qualifies, else
    ``(None, reason)``.
    """

    entry = "part_%s.step.py" % role
    scope = "component:%s" % role
    state_path = project / "measure" / COMPONENT_ROUNDS_DIR / role / STATE_NAME
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "%s has no isolated component round" % entry
    round_value = state.get("round") if isinstance(state, dict) else None
    if type(round_value) is not int or round_value < 1 or state.get("scope") != scope:
        return None, "%s has invalid component state" % entry
    summary_path = state_path.parent / ("r%04d" % round_value) / "summary.json"
    try:
        summary = json.loads(summary_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "%s has no component summary" % entry
    if (
        not isinstance(summary, dict)
        or summary.get("scope") != scope
        or summary.get("entry") != entry
        or summary.get("parts") != [role]
    ):
        return None, "%s has invalid component summary" % entry
    if not summary.get("ok"):
        return None, "%s latest component round did not pass" % entry
    # The recorded B-rep identity, or the STEP bytes the round wrote: a reader
    # without a fresh build (the final verifier on a part `gen` found current)
    # can only hash the file (ADR 0074).
    recorded = ((state.get("parts") or {}).get(role), (state.get("steps") or {}).get(role))
    if digest is None or digest not in recorded:
        return None, "%s changed after its component pass" % entry
    return summary, ""


def component_coverage(project: Path, digests: dict) -> dict[str, dict]:
    """Reference sha256 -> ``{"role", "accepted"}``, for every reference a
    current, passing component round showed its reviewer (ADR 0076), with
    ``reference_conflicts`` when its review recorded any for that reference
    (ADR 0084).

    ``accepted`` is None when the reviewer agreed, else the component
    acceptance recorded at the shape-repair limit: ``{"reviewer", "reason",
    "shape_rounds"}``. A reference that depicts one Component is shown in
    that Component's round (ADR 0063); this is how the assembly knows not to
    show it again against the whole object. A Component whose identity moved
    since its pass covers nothing, exactly as --require-component-passes
    treats it: both read ``current_passing_component_round``.
    """

    covered = {}
    rounds = project / "measure" / COMPONENT_ROUNDS_DIR
    for state_path in sorted(rounds.glob("*/" + STATE_NAME)) if rounds.is_dir() else ():
        role = state_path.parent.name
        # A Component that does not qualify covers nothing. That is never a
        # silent pass: its sealed image is then missing at assembly.
        summary, reason = current_passing_component_round(project, role, digests.get(role))
        if reason:
            continue
        accepted = summary.get("accepted")
        if accepted is not None:
            accepted = {key: accepted[key] for key in ("reviewer", "reason", "shape_rounds")}
        conflicts = summary.get("reference_conflicts") or []
        for _label, ref in summary.get("refs") or []:
            path = resolve_reference(ref, project)
            if path is not None:
                cover = {"role": role, "accepted": accepted}
                mine = [item for item in conflicts if item.get("file") == path.name]
                if mine:
                    cover["reference_conflicts"] = mine
                covered.setdefault(file_hash(path), cover)
    return covered


def sealed_file_error(item: dict) -> dict | None:
    """Why one sealed reference cannot be scored, or None when it can."""

    name = item["path"].name
    if not item["path"].is_file():
        return {"label": item["label"], "error": "sealed reference missing: %s" % name}
    if file_hash(item["path"]) != item["sha256"]:
        return {"label": item["label"], "error": "sealed reference %s does not match its sealed hash" % name}
    return None


def with_component_reference(project: Path, role: str, refs: list):
    """A component round's references: the sealed image of this Component's
    Unique Geometry, plus whatever it was explicitly given (ADR 0074).

    Only Contract Mode labels a sealed image ``geometry:<id>``, and a Component
    is built to the geometry whose id is its role. Outside Contract Mode, and
    for a Component no sealed image shows, this returns ``refs`` unchanged:
    ADR 0063's rule of scoring no implicit whole-object image still holds.
    """

    sealed, error = sealed_references(project)
    if error is not None:
        return refs, [], [{"label": "WISH.json", "error": error}]
    label = GEOMETRY_LABEL + role
    mine = [item for item in sealed if item["label"] == label]
    if not mine:
        return refs, [], []
    hashes = {item["sha256"] for item in mine}
    kept, cameras = split_sealed_copies(refs, hashes, project)
    to_score, report, errors = [], [], []
    for item in mine:
        problem = sealed_file_error(item)
        if problem is not None:
            errors.append(problem)
            continue
        to_score.append((label, str(item["path"]) + sealed_camera(item, cameras)))
        report.append({"label": label, "scored_by": "component:%s" % role})
    return to_score + kept, report, errors


def shown_cameras(project: Path, refs: list) -> list[dict]:
    """The Reference Camera each shown sealed reference was compared from:
    ``{"label", "file", "camera", "amended_from"}``, ``amended_from`` the
    sealed camera a host amendment replaced, else None."""

    cameras, amended = reference_cameras(project)
    shown = []
    for label, ref in refs:
        path = resolve_reference(ref, project)
        name = path.name if path is not None else None
        if name in cameras:
            shown.append({"label": label, "file": name,
                          "camera": [float(v) for v in cameras[name].split(",")],
                          "amended_from": ([float(v) for v in amended[name].split(",")]
                                           if name in amended else None)})
    return shown


def sealed_camera(item: dict, copies: dict) -> str:
    """``"@AZ,EL"`` a sealed image is shown from: its Reference Camera under a
    schema 3 contract (ADR 0083), else the camera a copy of it declared."""

    if item.get("camera"):
        return "@" + item["camera"]
    return copies.get(item["sha256"], "")


def split_sealed_copies(refs: list, hashes: set, project: Path) -> tuple[list, dict]:
    """``(kept refs, sealed sha256 -> "@AZ,EL[,TOL]")``.

    A reference that is a copy of a sealed image is not scored twice; the
    sealed image is scored instead, from the camera the copy declared. The
    Wish seals pixels, not where they were taken from, so a declared camera
    is the only way a sealed image reaches verify_project --image-derived.
    """

    kept, cameras = [], {}
    for label, ref in refs:
        path = resolve_reference(ref, project)
        digest = file_hash(path) if path is not None else None
        if digest in hashes:
            camera = split_camera(ref)[1]
            if camera is not None:
                cameras.setdefault(digest, "@" + camera)
            continue
        kept.append((label, ref))
    return kept, cameras


def with_sealed_references(project: Path, refs: list, digests: dict):
    """The assembly round's references: every sealed one not already shown to
    a Component's reviewer, plus the ledger's references the Wish did not seal.

    Returns ``(refs, sealed_report, errors)``. A sealed reference that is
    missing or no longer matches its hash is an error the round fails on,
    never a reference quietly dropped. A ledger entry that is a copy of a
    sealed image is not shown twice.
    """

    sealed, error = sealed_references(project)
    if error is not None:
        return refs, [], [{"label": "WISH.json", "error": error}]
    if not sealed:
        return refs, [], []
    sealed_hashes = {item["sha256"] for item in sealed}
    kept, cameras = split_sealed_copies(refs, sealed_hashes, project)
    covered = component_coverage(project, digests)
    to_show, report, errors = [], [], []
    for item in sealed:
        problem = sealed_file_error(item)
        if problem is not None:
            errors.append(problem)
            continue
        cover = covered.get(item["sha256"])
        if cover is not None:
            report.append({"label": item["label"], "scored_by": "component:%s" % cover["role"]})
            continue
        if item["label"].startswith(GEOMETRY_LABEL):
            # ADR 0074: an image of one Component is never judged against the
            # whole object. Without a current component pass it is missing.
            role = item["label"][len(GEOMETRY_LABEL):]
            errors.append({
                "label": item["label"],
                "error": "no current component round passed its checks and independent review; run "
                         "--component part_%s.step.py" % role,
            })
            report.append({"label": item["label"], "scored_by": "missing"})
            continue
        to_show.append((item["label"], str(item["path"]) + sealed_camera(item, cameras)))
        report.append({"label": item["label"], "scored_by": "assembly"})
    return to_show + kept, report, errors


def tail(text: str) -> str:
    return " ".join((text or "").split())[-MAX_TAIL_CHARS:]


def motion_policy():
    return runpy.run_path(str(Path(__file__).resolve().parents[2] / "cad/scripts/motion_policy.py"))


PREVIEW_DIR = "assembly-previews"


def preview_assembly(project: Path, entry: Path, parts: list, cad: Path) -> int:
    """Render the whole object once before its components are finished.

    Proportion between parts, pose and scale only show on the assembled
    object, and the gated assembly review comes after every component passes,
    by when a wrong-sized part has already cost its own rounds. This renders
    the same sheet an assembly round would, and nothing else: it builds no
    part evidence, runs no gate, touches no round history or state, and is
    never a pass.
    """
    if not parts:
        print("make_round: --preview-assembly needs part_<role>.step.py components", file=sys.stderr)
        return 2
    root = project / "measure" / PREVIEW_DIR
    root.mkdir(parents=True, exist_ok=True)
    index = 1 + sum(1 for p in root.glob("p[0-9][0-9][0-9][0-9]") if p.is_dir())
    out = root / ("p%04d" % index)
    out.mkdir()
    before = source_hashes(project)
    views = out / "visual"
    command = [sys.executable, str(cad / "render_review"), str(entry)]
    for view in VISUAL_VIEWS:
        command += ["--view", view]
    done = run([*command, "--sheet", "-o", str(views)], cwd=project, log=out / "visual-render.log")
    paths = [views / (v + ".png") for v in (*VISUAL_VIEWS, VISUAL_SHEET)]
    if done.returncode or not all(p.is_file() for p in paths) or before != source_hashes(project):
        print("make_round: assembly preview did not render; see %s" % (out / "visual-render.log"), file=sys.stderr)
        return 2
    sheet = (views / (VISUAL_SHEET + ".png")).resolve()
    record = {
        "kind": "assembly-preview", "schema_version": 1, "entry": entry.name,
        "components": sorted(p.name for p in parts), "sources": before,
        "images": {str(p.resolve()): file_hash(p) for p in paths}, "sheet": str(sheet),
        "verdict": "none: evidence only, never a pass or a round",
    }
    (out / "preview.json").write_text(json.dumps(record, sort_keys=True, indent=2) + "\n", encoding="utf-8")
    print("make_round assembly preview %s (%d components)" % (out.name, len(parts)))
    print("  inspect %s" % sheet)
    print("  judge silhouette, stance and shape language, then proportion and placement between parts;")
    print("  fix scale and placement in the component sources, then continue component rounds.")
    print("  not a round and not a pass: the gated assembly review still follows every component pass.")
    return 0


# ---------------------------------------------------------------------------
# the component round policy (ADR 0081): one pure function decides admission,
# Shape Round counting and the lock; make_round only gathers its inputs.

OPEN, AWAITING, DISAGREED, LOCKED = "open", "awaiting-review", "disagreed", "locked"


def round_policy(previous: dict, new: dict) -> dict:
    """Admit or refuse one component round, and what it leaves behind.

    ``previous`` is the Component's policy state: ``phase`` (open,
    awaiting-review, disagreed or locked), ``identity`` of its latest round,
    ``round`` its number, ``shape_rounds`` used, ``reviewed`` -- the review
    the phase rests on, ``{"round", "identity", "carry_key", "agrees",
    "accepted", "imported_helpers", ...}`` -- and ``unlocks``, the reasons a
    locked Component may change. ``new`` is the round: its B-rep
    ``identity`` (None when it did not build), ``helpers`` (current sha256
    of the Shared Helpers it imports), ``checks_ok`` (None to ask only
    whether it is admitted) and ``carry_key`` (identity, shown reference
    bytes and contract rows together).

    Returns ``{"admit", "refusal", "shape_round", "unlocks", "carried",
    "state"}``: ``carried`` is the review this round inherits, ``state`` the
    next policy state, or None when the round is refused or only asked about.
    """

    phase = previous.get("phase") or OPEN
    reviewed = previous.get("reviewed")
    shape_rounds = int(previous.get("shape_rounds") or 0)
    unlocks = list(previous.get("unlocks") or [])
    identity = new.get("identity")
    latest = previous.get("round")
    result = {"admit": True, "refusal": None, "shape_round": False, "unlocks": unlocks,
              "carried": None, "state": None}
    if phase == LOCKED:
        helpers = new.get("helpers") or {}
        changed = sorted(path for path, digest in (reviewed.get("imported_helpers") or {}).items()
                         if helpers.get(path) != digest)
        if changed and not any(item.get("kind") == "shared-helper" and item.get("paths") == changed
                               for item in unlocks):
            unlocks.append({"kind": "shared-helper", "paths": changed})
        # ADR 0085: an applied Contract Amendment that changed the rows the
        # review judged unlocks the Component as a Shared Helper change does.
        rows = new.get("contract_rows")
        if (rows is not None and reviewed.get("contract_rows") is not None and rows != reviewed["contract_rows"]
                and not any(item.get("kind") == "contract-amendment" and item.get("contract_rows") == rows
                            for item in unlocks)):
            unlocks.append({"kind": "contract-amendment", "contract_rows": rows})
        if not unlocks and identity != reviewed["identity"]:
            how = "an agreeing review" if reviewed.get("agrees") else "a Component Acceptance"
            result.update(admit=False, refusal=(
                "the Component is locked by %s of r%04d; its geometry may change only when a Shared "
                "Helper it imports changes, a Contract Amendment changes its rows, or the Workshop Manager "
                "records an assembly unlock. Revert "
                "your change; a rerun that leaves the geometry unchanged may run" % (how, reviewed["round"])))
    elif phase == AWAITING and identity != previous.get("identity"):
        result.update(admit=False, refusal=(
            "r%04d passed its build and print checks and has no Component Review; report it and wait. "
            "Change the geometry only after a recorded disagreeing review; revert your change, or rerun "
            "it unchanged" % latest))
    elif phase == DISAGREED and identity is not None and identity != reviewed["identity"]:
        result["shape_round"] = True
    checks_ok = new.get("checks_ok")
    if not result["admit"] or checks_ok is None:
        return result
    passed = checks_ok is True
    carry = (passed and reviewed is not None and identity == reviewed.get("identity")
             and new.get("carry_key") == reviewed.get("carry_key"))
    state = {"phase": phase, "identity": identity, "round": new.get("round"),
             "shape_rounds": shape_rounds + (1 if result["shape_round"] else 0),
             "reviewed": reviewed, "unlocks": unlocks}
    if phase == LOCKED:
        if passed and carry:
            # The reviewed B-rep came back: the review carries and relocks.
            result["carried"] = reviewed
            state.update(reviewed={**reviewed, "imported_helpers": new.get("helpers") or {}}, unlocks=[])
        elif passed:
            state.update(phase=AWAITING, reviewed=None, unlocks=[])
    elif phase == DISAGREED and not result["shape_round"]:
        if passed and carry:
            result["carried"] = reviewed
        elif passed and identity is not None:
            state.update(phase=AWAITING, reviewed=None)
    else:
        state.update(phase=AWAITING if passed else OPEN, reviewed=None)
    result["state"] = state
    return result


def review_policy(previous: dict, review: dict) -> dict:
    """The policy state after a Component Review of the latest round.

    Agreement locks the Component. A disagreement locks it as a Component
    Acceptance once its Shape Rounds are used, else it is the repair list for
    the next Shape Round. ``review`` holds ``agrees``, ``identity``,
    ``carry_key``, ``imported_helpers`` and the recorded review.
    """

    if previous.get("phase") != AWAITING:
        raise ValueError("r%04d is not awaiting a Component Review" % int(previous.get("round") or 0))
    shape_rounds = int(previous.get("shape_rounds") or 0)
    accepted = not review["agrees"] and shape_rounds >= SHAPE_REPAIR_LIMIT
    reviewed = {**review, "round": previous.get("round"), "accepted": accepted}
    return {**previous, "phase": LOCKED if review["agrees"] or accepted else DISAGREED,
            "reviewed": reviewed, "unlocks": []}


def legacy_policy(state: dict, summary: dict | None) -> dict:
    """The policy state of a Component whose rounds an earlier make_round ran
    (a run whose tools were refreshed): read from its latest round."""

    if not state.get("round"):
        return {"phase": OPEN}
    shape_rounds = min(int(state.get("shape_rounds") or 0), SHAPE_REPAIR_LIMIT)
    base = {"identity": state.get("identity"), "round": state.get("round"), "shape_rounds": shape_rounds,
            "unlocks": []}
    review = (summary or {}).get("review")
    if not state.get("checks_ok"):
        return {**base, "phase": OPEN, "reviewed": None}
    if review is None:
        return {**base, "phase": AWAITING, "reviewed": None}
    accepted = bool((summary or {}).get("accepted"))
    reviewed = {"round": state.get("round"), "identity": state.get("identity"), "carry_key": None,
                "agrees": bool(review.get("agrees")), "accepted": accepted, "imported_helpers": {},
                "review": review, "acceptance": (summary or {}).get("accepted")}
    phase = LOCKED if review.get("agrees") or accepted else DISAGREED
    return {**base, "phase": phase, "reviewed": reviewed}


def component_policy(state: dict, round_root: Path) -> dict:
    if isinstance(state.get("policy"), dict):
        return state["policy"]
    summary = None
    if state.get("round"):
        try:
            summary = json.loads((round_root / ("r%04d" % state["round"]) / "summary.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            summary = None
    return legacy_policy(state, summary)


def contract_rows(project: Path, role: str) -> str:
    """sha256 of the Component's own Design Contract rows: its Unique
    Geometry, the requirements and references scoped to it, and under schema
    4 the Interfaces that name it. Outside Contract Mode, of nothing."""

    rows = None
    root = run_root(project)
    if root is not None:
        # ADR 0085: the rows as every applied Contract Amendment left them.
        contract = current_contract(project)
        if isinstance(contract, dict):
            scope = GEOMETRY_LABEL + role
            rows = {
                "geometries": [g for g in contract.get("geometries") or () if isinstance(g, dict) and g.get("id") == role],
                "requirements": [r for r in contract.get("requirements") or () if isinstance(r, dict) and r.get("scope") == scope],
                "references": [r for r in contract.get("references") or () if isinstance(r, dict) and r.get("shows") == scope],
            }
            schema = contract.get("schema_version")
            if type(schema) is int and schema >= INTERFACE_TEXT_SCHEMA_VERSION:
                # ADR 0084: the Interfaces a schema 4 review read are its rows too.
                rows["interfaces"] = [i for i in contract.get("interfaces") or () if isinstance(i, dict)
                                      and isinstance(i.get("components"), list)
                                      and role in reference_roles(i["components"])]
            # An amended assembly row binds every Component (ADR 0085). The
            # key appears only then, so a run without one keeps its hashes.
            amended = amended_assembly_rows(project)
            if amended:
                rows["amended_assembly_rows"] = amended
    return hashlib.sha256(json.dumps(rows, sort_keys=True).encode()).hexdigest()


def amended_assembly_rows(project: Path) -> list:
    """``[amendment, row, text]`` of every applied Contract Amendment change
    to a row scoped to no single Component."""

    try:
        amendments = read_contract_amendments(project)
    except (OSError, UnicodeError, ValueError):
        return []
    return [[number, change["row"], change["to"]] for number, item in sorted(amendments.items())
            if item["status"] == "applied" for change in item["changes"]
            if not str(change.get("scope")).startswith((GEOMETRY_LABEL, "interface:"))]


def carry_key(identity: str | None, refs: list, project: Path, rows: str, rulings: list | None = None) -> str | None:
    """What a review judged: the B-rep, the shown reference bytes at their
    cameras, the Component's contract rows and the Blocked Report rulings
    its packet carried (issue #97). A review carries to a later round only
    when all of them are unchanged. Without rulings the key is what it was
    before them, so a Component with none keeps its keys."""

    if identity is None:
        return None
    shown = []
    for label, ref in refs:
        path = resolve_reference(ref, project)
        shown.append([label, split_camera(ref)[1], file_hash(path) if path is not None else None])
    judged = [identity, sorted(shown), rows]
    if rulings:
        judged.append(rulings)
    return hashlib.sha256(json.dumps(judged, sort_keys=True).encode()).hexdigest()


def record_unlock(project: Path, unlock_path, component: str) -> dict:
    """Record that an assembly round requires a change to one locked Component.

    The record cites the assembly round and one finding the Workshop Manager
    recorded there with --record-visual. It builds nothing; the Component's
    next rounds are admitted and are never Shape Rounds (ADR 0081).
    """

    role, _source = component_role(project, component)
    state_path, round_root = state_and_round_root(project, component)
    state = json.loads(state_path.read_text(encoding="utf-8"))
    if state.get("scope") != "component:%s" % role:
        raise ValueError("component round state is invalid")
    policy = component_policy(state, round_root)
    if policy.get("phase") != LOCKED:
        raise ValueError("part_%s.step.py is not locked; its rounds need no unlock" % role)
    record = json.loads(Path(unlock_path).read_text(encoding="utf-8"))
    if not isinstance(record, dict) or set(record) != {"assembly_round", "finding", "reason"}:
        raise ValueError("an unlock needs assembly_round, finding and reason")
    number, index = record["assembly_round"], record["finding"]
    if type(number) is not int or number < 1 or type(index) is not int or index < 0:
        raise ValueError("assembly_round and finding must be a round number and a finding index")
    reason = record["reason"]
    if not isinstance(reason, str) or not 1 <= len(reason.strip()) <= MAX_REASON:
        raise ValueError("an unlock needs a reason of 1 to %d characters" % MAX_REASON)
    assembly = project / "measure" / ROUNDS_DIR / ("r%04d" % number)
    try:
        feedback_bytes = (assembly / "visual-feedback.json").read_bytes()
        feedback = json.loads(feedback_bytes)
        findings = feedback["findings"]
    except (OSError, ValueError, KeyError, TypeError):
        raise ValueError("assembly round r%04d has no recorded visual finding" % number) from None
    if not isinstance(findings, list) or index >= len(findings):
        raise ValueError("assembly round r%04d has no finding %d" % (number, index))
    unlock = {"kind": "assembly", "assembly_round": number, "finding": findings[index],
              "visual_feedback_sha256": hashlib.sha256(feedback_bytes).hexdigest(),
              "reason": reason.strip()}
    policy = {**policy, "unlocks": [*(policy.get("unlocks") or []), unlock]}
    state["policy"] = policy
    with (round_root / "unlocks.jsonl").open("a", encoding="utf-8") as ledger:
        ledger.write(json.dumps(unlock, sort_keys=True) + "\n")
    state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    return unlock


# ---------------------------------------------------------------------------
# Blocked Reports (issue #88). A Component Worker that cannot proceed records
# a Blocked Report naming its contract rows verbatim; the Workshop Manager
# answers it with a Decision (perhaps waiting on another Component) or a
# need. While one is open, an assembly round and the final verifier refuse
# to run, and the host refuses the Make proposal and Make acceptance.


def blocked_ledger(project: Path) -> Path:
    return project / "measure" / BLOCKED_REPORTS_NAME


def _blocked_text(value, maximum: int) -> bool:
    return isinstance(value, str) and 1 <= len(value.strip()) <= maximum


def blocked_reports(content: str) -> dict:
    """Every Blocked Report in one ledger, by number. Kept in step with
    ``blocked_reports`` in workshop/make/make_round_guard.py, which the host
    uses; this script is standalone and cannot import it."""

    reports = {}
    for line in content.splitlines():
        event = json.loads(line)
        if not isinstance(event, dict):
            raise ValueError("a Blocked Report event is not an object")
        kind, number = event.get("event"), event.get("report")
        if type(number) is not int or not _blocked_text(event.get("at"), 64):
            raise ValueError("a Blocked Report event has no number or time")
        wish = event.get("wish_sha256")
        if wish is not None and not (isinstance(wish, str) and re.fullmatch(r"[0-9a-f]{64}", wish)):
            raise ValueError("a Blocked Report event has an invalid Wish binding")
        if kind == "report":
            rows, round_value = event.get("rows"), event.get("round")
            if (
                number != len(reports) + 1
                or not _blocked_text(event.get("component"), 200)
                or not (round_value is None or (type(round_value) is int and round_value >= 1))
                or not isinstance(rows, list) or not 1 <= len(rows) <= MAX_BLOCKED_ROWS
                or not all(_blocked_text(row, MAX_BLOCKED_TEXT) for row in rows)
                or not _blocked_text(event.get("reason"), MAX_BLOCKED_TEXT)
            ):
                raise ValueError("Blocked Report %s is invalid" % number)
            reports[number] = {
                "report": number, "component": event["component"], "round": round_value,
                "rows": list(rows), "reason": event["reason"], "opened_at": event["at"],
                "wish_sha256": wish, "status": "open", "answers": [],
            }
            continue
        report = reports.get(number)
        if report is None or report["status"] not in OPEN_BLOCKED:
            raise ValueError("Blocked Report %s is not open to answer" % number)
        if wish != report["wish_sha256"]:
            raise ValueError("Blocked Report %s is answered from another run" % number)
        if kind == "decision":
            waits_on, waits_round = event.get("waits_on"), event.get("waits_on_round")
            if not _blocked_text(event.get("ruling"), MAX_BLOCKED_TEXT) or not (
                (waits_on is None and waits_round is None)
                or (_blocked_text(waits_on, 200) and waits_on != report["component"]
                    and type(waits_round) is int and waits_round >= 0)
            ):
                raise ValueError("the decision on Blocked Report %s is invalid" % number)
            answer = {"kind": "decision", "ruling": event["ruling"], "waits_on": waits_on,
                      "waits_on_round": waits_round, "at": event["at"]}
            report["status"] = "waiting" if waits_on is not None else "decided"
        elif kind == "need":
            if not _blocked_text(event.get("need"), MAX_NEED_CHARS):
                raise ValueError("the need on Blocked Report %s is invalid" % number)
            answer = {"kind": "need", "need": event["need"], "at": event["at"]}
            report["status"] = "need"
        elif kind == "amendment":
            # ADR 0085: an applied Contract Amendment removed the contradiction.
            amendment = event.get("amendment")
            if type(amendment) is not int or amendment < 1 or not (
                    isinstance(event.get("amended_sha256"), str)
                    and re.fullmatch(r"[0-9a-f]{64}", event["amended_sha256"])):
                raise ValueError("the amendment answering Blocked Report %s is invalid" % number)
            answer = {"kind": "amendment", "amendment": amendment, "amended_sha256": event["amended_sha256"],
                      "at": event["at"]}
            report["status"] = "amended"
        else:
            raise ValueError("unknown Blocked Report event %r" % kind)
        report["answers"].append(answer)
    return reports


def read_blocked_reports(project: Path) -> dict:
    ledger = blocked_ledger(project)
    if not ledger.is_file():
        return {}
    return blocked_reports(ledger.read_text(encoding="utf-8"))


def _utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _wish_binding(project: Path) -> str | None:
    """sha256 of the run's WISH.json: what binds a Blocked Report to its run."""

    root = run_root(project)
    return None if root is None else file_hash(root / "WISH.json")


def _squash(text: str) -> str:
    return " ".join(text.split())


def _contract_strings(value) -> list:
    if isinstance(value, str):
        return [_squash(value)]
    if isinstance(value, dict):
        return [text for item in value.values() for text in _contract_strings(item)]
    if isinstance(value, list):
        return [text for item in value for text in _contract_strings(item)]
    return []


def _append_blocked(project: Path, event: dict) -> None:
    ledger = blocked_ledger(project)
    ledger.parent.mkdir(exist_ok=True)
    with ledger.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True) + "\n")


def latest_component_round(project: Path, role: str) -> int | None:
    try:
        state = json.loads((project / "measure" / COMPONENT_ROUNDS_DIR / role / STATE_NAME).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    value = state.get("round") if isinstance(state, dict) else None
    return value if type(value) is int and value >= 1 else None


def passing_round_after(project: Path, role: str, after: int) -> int | None:
    """The first round of a Component after ``after`` whose build and print
    checks passed: what wakes a Blocked Report waiting on it."""

    root = project / "measure" / COMPONENT_ROUNDS_DIR / role
    for path in sorted(root.glob("r[0-9][0-9][0-9][0-9]/summary.json")) if root.is_dir() else ():
        number = int(path.parent.name[1:])
        if number <= after:
            continue
        try:
            summary = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(summary, dict) and summary.get("checks_ok") is True:
            return number
    return None


def blocked_view(project: Path, report: dict) -> dict:
    """One report as its readers need it: a waiting report whose Component has
    passed a round since is ``woken``, and the Manager must wake its worker."""

    view = {key: report[key] for key in ("report", "component", "round", "rows", "reason",
                                         "opened_at", "status", "answers")}
    if report["status"] == "waiting":
        last = report["answers"][-1]
        woke = passing_round_after(project, last["waits_on"], last["waits_on_round"])
        if woke is not None:
            view["status"] = "woken"
            view["woken_by"] = {"component": last["waits_on"], "round": woke}
    return view


def component_rulings(project: Path, role: str) -> list:
    """The Workshop Manager's decided rulings on this Component's Blocked
    Reports (issue #97), oldest first: what binds its Component Reviewer.

    Each is ``{"report", "round", "rows", "request", "ruling", "decided_at"}``:
    the rows the worker quoted, its report (``request``: what it was asked
    and why it cannot be built) and the final decision. Only a report whose
    last answer is a decision that waits on nothing is a ruling; an open,
    waiting, need or amended report is not. Copied from the ledger, never
    judged. Raises ``ValueError`` for an invalid ledger."""

    rulings = []
    for number, report in sorted(read_blocked_reports(project).items()):
        if report["component"] != role or report["status"] != "decided":
            continue
        decision = report["answers"][-1]
        rulings.append({"report": number, "round": report["round"], "rows": list(report["rows"]),
                        "request": report["reason"], "ruling": decision["ruling"], "decided_at": decision["at"]})
    return rulings


def ruling_disputes(review: dict, summary: dict, rulings: list) -> list[dict]:
    """A review's Ruling Disputes (issue #97): the reviewer thinks a ruling in
    its packet is wrong. Each names one ruling of the packet by its report
    number and says why. A dispute is not a difference: it costs no Shape
    Round and never reaches the worker; the ruling stands until the Workshop
    Manager answers otherwise. Returned as recorded, with the round's
    Component."""

    disputes = review.get("ruling_disputes", [])
    if not isinstance(disputes, list) or len(disputes) > MAX_DIFFERENCES:
        raise ValueError("a review lists at most %d ruling_disputes" % MAX_DIFFERENCES)
    numbers = [item["report"] for item in rulings]
    recorded = []
    for item in disputes:
        if not isinstance(item, dict) or set(item) != {"report", "reason"}:
            raise ValueError("a ruling dispute needs report and reason: the Blocked Report number of a ruling "
                             "in the packet, and why the ruling is wrong")
        if type(item["report"]) is not int or item["report"] not in numbers:
            raise ValueError("a ruling dispute names one ruling of the packet: %s"
                             % (", ".join("Blocked Report %d" % n for n in numbers) or "the packet has none"))
        if not isinstance(item["reason"], str) or not 1 <= len(item["reason"].strip()) <= MAX_REASON:
            raise ValueError("a ruling dispute's reason is 1 to %d characters" % MAX_REASON)
        recorded.append({"component": summary["parts"][0], "report": item["report"], "round": summary["round"],
                         "reviewer": review["reviewer"].strip(), "reason": item["reason"].strip()})
    return recorded


def open_blocked(project: Path) -> list:
    return [blocked_view(project, report) for _, report in sorted(read_blocked_reports(project).items())
            if report["status"] in OPEN_BLOCKED]


def blocked_refusal(project: Path) -> str:
    """Why an assembly round or the final verifier may not run, or ''."""

    try:
        held = open_blocked(project)
    except (OSError, UnicodeError, ValueError) as exc:
        return "the Blocked Report ledger %s is invalid: %s" % (blocked_ledger(project), exc)
    if not held:
        return ""
    return ("Blocked Report %s is open; answer each with --clear-blocked before an assembly "
            "round (issue #88)" % ", ".join("%d (%s, %s)" % (item["report"], item["component"], item["status"])
                                           for item in held))


def report_blocked(project: Path, report_path, component: str) -> dict:
    """Record a Component Worker's Blocked Report: its Component, its latest
    round and the contract rows it names, verbatim."""

    role, _source = component_role(project, component)
    record = json.loads(Path(report_path).read_text(encoding="utf-8"))
    if not isinstance(record, dict) or set(record) != {"rows", "reason"}:
        raise ValueError("a Blocked Report needs rows (the contract rows, verbatim) and reason")
    rows, reason = record["rows"], record["reason"]
    if not isinstance(rows, list) or not 1 <= len(rows) <= MAX_BLOCKED_ROWS or not all(
            _blocked_text(row, MAX_BLOCKED_TEXT) for row in rows):
        raise ValueError("a Blocked Report names 1 to %d contract rows of 1 to %d characters"
                         % (MAX_BLOCKED_ROWS, MAX_BLOCKED_TEXT))
    if not _blocked_text(reason, MAX_BLOCKED_TEXT):
        raise ValueError("a Blocked Report needs a reason of 1 to %d characters" % MAX_BLOCKED_TEXT)
    contract = current_contract(project)
    if contract is not None:
        texts = _contract_strings(contract)
        for row in rows:
            if not any(_squash(row) in text for text in texts):
                raise ValueError("row %r is not in the sealed Design Contract; quote each row verbatim" % row[:80])
    reports = read_blocked_reports(project)
    for number, item in sorted(reports.items()):
        if item["component"] == role and item["status"] in OPEN_BLOCKED:
            raise ValueError("Blocked Report %d of %s is still open; wait for the Manager's answer"
                             % (number, role))
    event = {"event": "report", "report": len(reports) + 1, "component": role,
             "round": latest_component_round(project, role), "rows": [row.strip() for row in rows],
             "reason": reason.strip(), "at": _utc_now(), "wish_sha256": _wish_binding(project)}
    _append_blocked(project, event)
    return event


def clear_blocked(project: Path, answer_path) -> dict:
    """Record the Workshop Manager's answer to one open Blocked Report:
    ``{"report", "decision", "waits_on"?}``, ``{"report", "need"}`` or
    ``{"report", "amendment"}``, an applied Contract Amendment that names
    this report (ADR 0085)."""

    record = json.loads(Path(answer_path).read_text(encoding="utf-8"))
    if not isinstance(record, dict) or set(record) not in (
            {"report", "decision"}, {"report", "decision", "waits_on"}, {"report", "need"},
            {"report", "amendment"}):
        raise ValueError('an answer is {"report", "decision"} with an optional "waits_on", '
                         '{"report", "need"} or {"report", "amendment"}')
    reports = read_blocked_reports(project)
    number = record["report"]
    report = reports.get(number) if type(number) is int else None
    if report is None:
        raise ValueError("there is no Blocked Report %r" % (number,))
    if report["status"] not in OPEN_BLOCKED:
        raise ValueError("Blocked Report %d is already answered (%s)" % (number, report["status"]))
    event = {"report": number, "at": _utc_now(), "wish_sha256": report["wish_sha256"]}
    if "amendment" in record:
        amendment = record["amendment"]
        item = read_contract_amendments(project).get(amendment) if type(amendment) is int else None
        if item is None:
            raise ValueError("there is no Contract Amendment %r" % (amendment,))
        if item["report"] != number:
            raise ValueError("Contract Amendment %d does not name Blocked Report %d; propose one that does"
                             % (amendment, number))
        if item["status"] != "applied":
            raise ValueError("Contract Amendment %d is %s, not applied; answer the report with a need quoting "
                             "its rows" % (amendment, item["status"]))
        event.update(event="amendment", amendment=amendment, amended_sha256=item["amended_sha256"])
    elif "need" in record:
        need = record["need"]
        if not isinstance(need, str) or not 1 <= len(need.strip()) <= MAX_NEED_CHARS or any(
                ord(character) < 32 or ord(character) == 127 for character in need):
            raise ValueError("a need is one line of 1 to %d characters" % MAX_NEED_CHARS)
        missing = [row for row in report["rows"] if _squash(row) not in _squash(need)]
        if missing:
            raise ValueError("a need quotes every row of the report verbatim; it lacks %r" % missing[0][:80])
        event.update(event="need", need=need.strip())
    else:
        ruling = record["decision"]
        if not _blocked_text(ruling, MAX_BLOCKED_TEXT):
            raise ValueError("a decision is a ruling of 1 to %d characters" % MAX_BLOCKED_TEXT)
        waits_on, waits_round = None, None
        if record.get("waits_on") is not None:
            waits_on, _ = component_role(project, record["waits_on"])
            if waits_on == report["component"]:
                raise ValueError("a decision waits on another Component, not the blocked one")
            waits_round = latest_component_round(project, waits_on) or 0
        event.update(event="decision", ruling=ruling.strip(), waits_on=waits_on, waits_on_round=waits_round)
    _append_blocked(project, event)
    blocked_reports(blocked_ledger(project).read_text(encoding="utf-8"))
    return event


def render_blocked(views: list) -> str:
    if not views:
        return "make_round: no Blocked Reports"
    lines = []
    for item in views:
        lines.append("blocked %d  %s  %s  round %s  opened %s" % (
            item["report"], item["component"], item["status"].upper(),
            "r%04d" % item["round"] if item["round"] else "-", item["opened_at"]))
        for row in item["rows"]:
            lines.append("  row  %s" % row)
        lines.append("  why  %s" % item["reason"])
        for answer in item["answers"]:
            if answer["kind"] == "need":
                lines.append("  need %s  %s" % (answer["at"], answer["need"]))
            elif answer["kind"] == "amendment":
                lines.append("  amendment %s  Contract Amendment %d applied" % (answer["at"], answer["amendment"]))
            else:
                lines.append("  decision %s%s  %s" % (
                    answer["at"], "  waits on %s" % answer["waits_on"] if answer["waits_on"] else "",
                    answer["ruling"]))
        if item.get("woken_by"):
            lines.append("  WAKE %s passed r%04d: send the %s worker its decision again"
                         % (item["woken_by"]["component"], item["woken_by"]["round"], item["component"]))
    return "\n".join(lines)


def waking_reports(project: Path, role: str) -> list:
    """The waiting Blocked Reports this Component's passing round wakes."""

    try:
        held = open_blocked(project)
    except (OSError, UnicodeError, ValueError):
        return []
    return [{"report": item["report"], "component": item["component"]} for item in held
            if item.get("woken_by", {}).get("component") == role]


# ---------------------------------------------------------------------------
# Contract Amendments (ADR 0085). Where a Contract Contradiction's smallest
# fix changes nothing a sealed reference image shows, the Workshop Manager
# may propose an amendment instead of a need. A fresh Contract Reviewer
# confirms that the quoted rows cannot both hold, that the amendment is the
# smallest change that removes the contradiction and that every sealed
# reference shows nothing of it; only then does the amendment apply. Each
# event is bound to the run by the sha256 of WISH.json and to the contract
# hash it was proposed against. WISH.json and the images keep their bytes:
# make_round reads the sealed contract with every applied amendment, and the
# host re-derives the same chain before it accepts Make. Kept in step with
# workshop/make/contract_amendments.py, which the host uses; this script is
# standalone and cannot import it.
#
# Issue #96: a refusal whose reviewer confirmed the contradiction, found it
# invisible and named a smaller change allows one Smaller Retry: the same
# rows, each change the refused change's ``from`` with only deletions
# applied, to another fresh contract-reviewer. Any other proposal quoting
# rows an earlier amendment quoted is refused; the run stops on the need.

AMENDMENT_LEDGER_NAME = "contract-amendments.jsonl"
AMENDMENT_PACKETS_DIR = "contract-amendments"
CONTRACT_REVIEWER = "contract-reviewer"
MAX_AMENDMENT_CHANGES = 4
AMENDMENT_VERDICT = ("contradiction", "smallest", "visible_in", "references_checked")


def amendment_ledger(project: Path) -> Path:
    return project / "measure" / AMENDMENT_LEDGER_NAME


def contract_digest(contract) -> str:
    """sha256 of a Design Contract's canonical JSON: the contract hash an
    amendment is proposed against and the one it leaves."""

    return hashlib.sha256(json.dumps(contract, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def amendable_rows(contract: dict) -> list:
    """``(locator, scope, text)`` of every row an amendment may change: each
    requirement's text, and each Interface's text under schema 4. A
    reference, a geometry's name, count or dimensions and an Interface's
    kind, envelope or poses are not rows an in-run amendment reaches."""

    rows = []
    for index, item in enumerate(contract.get("requirements") or ()):
        if isinstance(item, dict) and isinstance(item.get("text"), str):
            rows.append((item.get("id") if isinstance(item.get("id"), str) else "requirements[%d]" % index,
                         item.get("scope"), item["text"]))
    for item in contract.get("interfaces") or ():
        if isinstance(item, dict) and isinstance(item.get("text"), str) and isinstance(item.get("id"), str):
            rows.append(("interface:%s" % item["id"], "interface:%s" % item["id"], item["text"]))
    return rows


def apply_amendment(contract: dict, changes: list) -> dict:
    """The contract with each change's row text replaced. Pure: ``changes``
    are ``{"row", "from", "to"}`` already resolved against ``contract``."""

    amended = json.loads(json.dumps(contract))
    for change in changes:
        row = change["row"]
        if row.startswith("interface:"):
            items = [item for item in amended.get("interfaces") or ()
                     if isinstance(item, dict) and "interface:%s" % item.get("id") == row]
        else:
            items = [item for index, item in enumerate(amended.get("requirements") or ())
                     if isinstance(item, dict) and (item.get("id") == row or "requirements[%d]" % index == row)]
        scope = row if row.startswith("interface:") else (items[0].get("scope") if len(items) == 1 else None)
        if len(items) != 1 or items[0].get("text") != change["from"] or change.get("scope", scope) != scope:
            raise ValueError("amended row %s no longer reads as the amendment quoted it" % row)
        items[0]["text"] = change["to"]
    return amended


def amendment_affects(contract: dict, changes: list) -> list:
    """The Components an amendment's rows bind: the geometry a requirement is
    scoped to, every Component an Interface joins, and every Component for
    an assembly row."""

    every = sorted(item["id"] for item in contract.get("geometries") or ()
                   if isinstance(item, dict) and isinstance(item.get("id"), str))
    affected = set()
    for change in changes:
        if change["row"].startswith("interface:"):
            for item in contract.get("interfaces") or ():
                if isinstance(item, dict) and "interface:%s" % item.get("id") == change["row"]:
                    affected.update(reference_roles(item.get("components") or []))
        elif isinstance(change.get("scope"), str) and change["scope"].startswith(GEOMETRY_LABEL):
            affected.add(change["scope"][len(GEOMETRY_LABEL):])
        else:
            affected.update(every)
    return sorted(affected)


def amendment_status(verdict: dict) -> str:
    """``applied`` only when the reviewer confirmed all three: the rows
    contradict, the change is the smallest, and no reference shows it."""

    agrees = verdict["contradiction"] is True and verdict["smallest"] is True and not verdict["visible_in"]
    return "applied" if agrees else "refused"


def deletions_only(old: str, new: str) -> bool:
    """``new`` is ``old`` with only deletions applied: strictly shorter, a
    character subsequence of ``old``, and every word of ``new`` a word of
    ``old`` in the same order, so no word is added or respelled."""

    if not isinstance(old, str) or not isinstance(new, str) or len(new) >= len(old):
        return False
    characters = iter(old)
    if not all(character in characters for character in new):
        return False
    words = iter(re.findall(r"\w+", old))
    return all(word in words for word in re.findall(r"\w+", new))


def smaller_change_refusal(verdict: dict) -> bool:
    """The one refusal kind that allows a Smaller Retry (issue #96): the rows
    contradict and no reference shows the change, but a smaller one exists."""

    return (verdict.get("contradiction") is True and verdict.get("smallest") is False
            and not verdict.get("visible_in"))


def _row_key(rows: list) -> list:
    return sorted(_squash(row) for row in rows)


def retry_refusal(earlier: list, rows: list, changes: list) -> tuple:
    """``(retry_of, refusal)`` for a proposal quoting ``rows`` after the
    ``earlier`` amendments, oldest first (issue #96). ``retry_of`` is the
    refused amendment a Smaller Retry follows, or None when no earlier
    amendment quotes the same rows; ``refusal`` says why the proposal may not
    be made, or is None. Kept in step with the host's retry_refusal."""

    same = [item for item in earlier if _row_key(item["rows"]) == _row_key(rows)]
    if not same:
        return None, None
    number = same[0]["amendment"]
    if len(same) > 1:
        return number, ("Contract Amendments %s already quote these rows; a contradiction gets one Smaller "
                        "Retry at most, so stop the run on the need" % ", ".join(str(i["amendment"]) for i in same))
    first = same[0]
    if first["status"] != "refused" or not smaller_change_refusal((first.get("review") or {}).get("verdict") or {}):
        return number, ("Contract Amendment %d already quotes these rows and was %s; only a refusal that names "
                        "a smaller change (contradiction true, nothing visible, smallest false) allows one "
                        "Smaller Retry" % (number, first["status"]))
    refused = {change["row"]: change for change in first["changes"]}
    for change in changes:
        before = refused.get(change["row"])
        if before is None or before["from"] != change["from"]:
            return number, ("a Smaller Retry of Contract Amendment %d changes only rows it changed, from the same "
                            "text; %s is not one" % (number, change["row"]))
        if not deletions_only(change["from"], change["to"]):
            return number, ("a Smaller Retry of Contract Amendment %d only deletes words from %s's text; %r adds "
                            "or respells text" % (number, change["row"], change["to"][:80]))
    if {c["row"]: c["to"] for c in changes} == {row: c["to"] for row, c in refused.items()}:
        return number, "a Smaller Retry of Contract Amendment %d repeats the refused change" % number
    return number, None


def retry_open(amendments: dict, item: dict) -> bool:
    """Whether refused ``item`` still allows its one Smaller Retry: it was a
    smaller-change refusal and no other amendment quotes its rows."""

    if item["status"] != "refused" or not smaller_change_refusal((item.get("review") or {}).get("verdict") or {}):
        return False
    return [other["amendment"] for _, other in sorted(amendments.items())
            if _row_key(other["rows"]) == _row_key(item["rows"])] == [item["amendment"]]


def contract_amendments(content: str, contract: dict | None) -> dict:
    """Every Contract Amendment in one ledger, by number, replayed against the
    sealed ``contract``: each proposal must name the contract hash the
    applied amendments before it leave, and each change the row text as it
    then reads. A status is derived from the review's verdict, never read."""

    amendments = {}
    current = contract
    for line in content.splitlines():
        event = json.loads(line)
        if not isinstance(event, dict):
            raise ValueError("a Contract Amendment event is not an object")
        kind, number = event.get("event"), event.get("amendment")
        if type(number) is not int or not _blocked_text(event.get("at"), 64):
            raise ValueError("a Contract Amendment event has no number or time")
        wish = event.get("wish_sha256")
        if wish is not None and not (isinstance(wish, str) and re.fullmatch(r"[0-9a-f]{64}", wish)):
            raise ValueError("a Contract Amendment event has an invalid Wish binding")
        if kind == "proposal":
            if number != len(amendments) + 1 or any(item["status"] == "proposed" for item in amendments.values()):
                raise ValueError("Contract Amendment %s is out of order" % number)
            if current is None:
                raise ValueError("a Contract Amendment needs a sealed Design Contract")
            rows, changes = event.get("rows"), event.get("changes")
            if (not isinstance(rows, list) or not 2 <= len(rows) <= MAX_BLOCKED_ROWS
                    or not all(_blocked_text(row, MAX_BLOCKED_TEXT) for row in rows)
                    or not isinstance(changes, list) or not 1 <= len(changes) <= MAX_AMENDMENT_CHANGES
                    or not all(isinstance(c, dict) and set(c) == {"row", "scope", "from", "to"}
                               and _blocked_text(c["row"], 200) and _blocked_text(c["to"], MAX_BLOCKED_TEXT)
                               and isinstance(c["from"], str) for c in changes)
                    or not _blocked_text(event.get("reason"), MAX_BLOCKED_TEXT)):
                raise ValueError("Contract Amendment %s is invalid" % number)
            if event.get("contract_sha256") != contract_digest(current):
                raise ValueError("Contract Amendment %s was proposed against contract %s, but the contract "
                                 "then was %s" % (number, str(event.get("contract_sha256"))[:12],
                                                  contract_digest(current)[:12]))
            retry_of, refusal = retry_refusal([amendments[n] for n in sorted(amendments)], rows, changes)
            if refusal is not None:
                raise ValueError("Contract Amendment %s: %s" % (number, refusal))
            if event.get("retry_of") != retry_of:
                raise ValueError("Contract Amendment %s names retry_of %r, but the ledger makes it %r"
                                 % (number, event.get("retry_of"), retry_of))
            amended = apply_amendment(current, changes)
            if event.get("amended_sha256") != contract_digest(amended):
                raise ValueError("Contract Amendment %s names the wrong amended contract hash" % number)
            amendments[number] = {
                "amendment": number, "rows": list(rows), "changes": [dict(c) for c in changes],
                "reason": event["reason"], "report": event.get("report"), "affects": event.get("affects"),
                "retry_of": retry_of,
                "packet": event.get("packet"), "packet_sha256": event.get("packet_sha256"),
                "contract_sha256": event["contract_sha256"], "amended_sha256": event["amended_sha256"],
                "proposed_at": event["at"], "wish_sha256": wish, "status": "proposed", "review": None,
                "_amended": amended,
            }
            continue
        item = amendments.get(number)
        if kind != "review":
            raise ValueError("unknown Contract Amendment event %r" % kind)
        if item is None or item["status"] != "proposed":
            raise ValueError("Contract Amendment %s is not awaiting review" % number)
        if wish != item["wish_sha256"]:
            raise ValueError("Contract Amendment %s is reviewed from another run" % number)
        verdict = event.get("verdict")
        if (not isinstance(verdict, dict) or set(verdict) != set(AMENDMENT_VERDICT) | {"reason"}
                or type(verdict["contradiction"]) is not bool or type(verdict["smallest"]) is not bool
                or not isinstance(verdict["visible_in"], list) or not isinstance(verdict["references_checked"], list)
                or not _blocked_text(verdict["reason"], MAX_REASON)
                or not _blocked_text(event.get("reviewer"), 200)):
            raise ValueError("the review of Contract Amendment %s is invalid" % number)
        item["review"] = {"reviewer": event["reviewer"], "verdict": verdict, "at": event["at"]}
        item["status"] = amendment_status(verdict)
        if item["status"] == "applied":
            current = item["_amended"]
    return amendments


def read_contract_amendments(project: Path) -> dict:
    ledger = amendment_ledger(project)
    if not ledger.is_file():
        return {}
    return contract_amendments(ledger.read_text(encoding="utf-8"), sealed_contract(project))


def owner_amendments(project: Path) -> list:
    """Every Owner Contract Amendment the host recorded on resume (issue
    #100), oldest first, from the run root's CONTRACT-AMENDMENTS.json. Only
    the host writes that file; one that does not parse amends nothing."""

    root = run_root(project)
    if root is None:
        return []
    try:
        document = json.loads((root / AMENDMENTS_NAME).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    items = document.get("owner_amendments") if isinstance(document, dict) else None
    return [item for item in items if isinstance(item, dict) and isinstance(item.get("changes"), list)] \
        if isinstance(items, list) else []


def apply_owner_amendments(contract: dict, owners: list) -> dict:
    """``contract`` with each Owner Contract Amendment's row texts set, in
    order. The host checked every row against the contract it amended."""

    if not owners:
        return contract
    amended = json.loads(json.dumps(contract))
    for owner in owners:
        for change in owner["changes"]:
            row = change.get("row") if isinstance(change, dict) else None
            if not isinstance(row, str) or not isinstance(change.get("to"), str):
                continue
            if row.startswith("interface:"):
                items = [item for item in amended.get("interfaces") or ()
                         if isinstance(item, dict) and "interface:%s" % item.get("id") == row]
            else:
                items = [item for index, item in enumerate(amended.get("requirements") or ())
                         if isinstance(item, dict) and (item.get("id") == row or "requirements[%d]" % index == row)]
            if len(items) == 1:
                items[0]["text"] = change["to"]
    return amended


def current_contract(project: Path) -> dict | None:
    """The sealed Design Contract with every applied Contract Amendment, then
    every Owner Contract Amendment (issue #100): what a component round
    delivers and its contract rows hash. A ledger that does not replay
    amends nothing here; --contract-amendments, the finalizer and the host
    refuse it."""

    contract = sealed_contract(project)
    if contract is None:
        return None
    owners = owner_amendments(project)
    try:
        amendments = read_contract_amendments(project)
    except (OSError, UnicodeError, ValueError):
        return apply_owner_amendments(contract, owners)
    for _, item in sorted(amendments.items()):
        if item["status"] == "applied":
            contract = item["_amended"]
    return apply_owner_amendments(contract, owners)


def amendment_view(item: dict) -> dict:
    return {key: value for key, value in item.items() if not key.startswith("_")}


def amendment_refusal(project: Path) -> str:
    """Why an assembly round or the final verifier may not run, or ''."""

    try:
        amendments = read_contract_amendments(project)
    except (OSError, UnicodeError, ValueError) as exc:
        return "the Contract Amendment ledger %s is invalid: %s" % (amendment_ledger(project), exc)
    held = [number for number, item in sorted(amendments.items()) if item["status"] == "proposed"]
    if not held:
        return ""
    return ("Contract Amendment %s awaits its Contract Reviewer; record the review with "
            "--record-amendment-review before an assembly round (ADR 0085)" % ", ".join(map(str, held)))


def propose_amendment(project: Path, proposal_path) -> dict:
    """Record the Workshop Manager's Contract Amendment proposal and write the
    packet its Contract Reviewer reads: the rows that contradict, each
    changed row before and after, the reason, and every sealed reference
    image by path and sha256."""

    contract = current_contract(project)
    if contract is None:
        raise ValueError("a Contract Amendment needs a run sealed with a Design Contract")
    owners = owner_amendments(project)
    if owners:
        # Issue #100: once the owner amended the contract, the owner answers
        # every later contradiction too.
        raise ValueError("the owner amended this contract on resume (owner amendment %d); an in-run "
                         "amendment is closed, so stop the run with a need quoting the rows"
                         % len(owners))
    record = json.loads(Path(proposal_path).read_text(encoding="utf-8"))
    if not isinstance(record, dict) or set(record) not in (
            {"rows", "changes", "reason"}, {"rows", "changes", "reason", "report"}):
        raise ValueError('a proposal is {"rows", "changes", "reason"} with an optional "report"')
    rows, changes, reason = record["rows"], record["changes"], record["reason"]
    if not isinstance(rows, list) or not 2 <= len(rows) <= MAX_BLOCKED_ROWS or not all(
            _blocked_text(row, MAX_BLOCKED_TEXT) for row in rows):
        raise ValueError("a proposal quotes the 2 to %d contract statements that cannot both hold"
                         % MAX_BLOCKED_ROWS)
    texts = _contract_strings(contract)
    for row in rows:
        if not any(_squash(row) in text for text in texts):
            raise ValueError("row %r is not in the Design Contract; quote each row verbatim" % row[:80])
    if not _blocked_text(reason, MAX_BLOCKED_TEXT):
        raise ValueError("a proposal needs a reason of 1 to %d characters" % MAX_BLOCKED_TEXT)
    if not isinstance(changes, list) or not 1 <= len(changes) <= MAX_AMENDMENT_CHANGES:
        raise ValueError("a proposal changes 1 to %d rows" % MAX_AMENDMENT_CHANGES)
    candidates = amendable_rows(contract)
    resolved = []
    for change in changes:
        if not isinstance(change, dict) or set(change) != {"from", "to"}:
            raise ValueError('each change is {"from": "<the whole row, verbatim>", "to": "<its new text>"}')
        old, new = change["from"], change["to"]
        if not _blocked_text(old, MAX_BLOCKED_TEXT) or not _blocked_text(new, MAX_BLOCKED_TEXT):
            raise ValueError("a change's from and to are 1 to %d characters" % MAX_BLOCKED_TEXT)
        matches = [item for item in candidates if _squash(item[2]) == _squash(old)]
        if len(matches) != 1:
            if any(_squash(old) in text for text in texts):
                raise ValueError(
                    "%r is not one whole requirement or Interface text. A reference, a geometry's "
                    "dimensions and an Interface's kind, envelope or poses are beyond an in-run amendment, "
                    "and a reference image shows them: stop with a need quoting the rows" % old[:80])
            raise ValueError("%r is not a row of the Design Contract; quote the whole row verbatim" % old[:80])
        locator, scope, text = matches[0]
        if _squash(new) == _squash(text):
            raise ValueError("the change to %s leaves its text as it is" % locator)
        if any(item["row"] == locator for item in resolved):
            raise ValueError("%s is changed twice; write one change per row" % locator)
        resolved.append({"row": locator, "scope": scope, "from": text, "to": new.strip()})
    report = record.get("report")
    if report is not None:
        held = read_blocked_reports(project).get(report) if type(report) is int else None
        if held is None or held["status"] not in OPEN_BLOCKED:
            raise ValueError("Blocked Report %r is not open; a proposal names only an open report" % (report,))
    amendments = read_contract_amendments(project)
    pending = [number for number, item in sorted(amendments.items()) if item["status"] == "proposed"]
    if pending:
        raise ValueError("Contract Amendment %d still awaits its review; record it first" % pending[0])
    sealed, error = sealed_references(project)
    if error:
        raise ValueError(error)
    references = []
    for item in sealed:
        problem = sealed_file_error(item)
        if problem is not None:
            raise ValueError(problem["error"])
        references.append({"file": item["path"].name, "label": item["label"], "path": str(item["path"]),
                           "sha256": item["sha256"]})
    if not references:
        raise ValueError("a Contract Amendment needs the sealed reference images its reviewer checks")
    retry_of, refusal = retry_refusal([amendments[n] for n in sorted(amendments)],
                                      [row.strip() for row in rows], resolved)
    if refusal is not None:
        raise ValueError(refusal)
    number = len(amendments) + 1
    amended = apply_amendment(contract, resolved)
    packet = {
        "kind": "contract-amendment-packet", "amendment": number, "rows": [row.strip() for row in rows],
        "retry_of": retry_of,
        "changes": [{key: item[key] for key in ("row", "from", "to")} for item in resolved],
        "reason": reason.strip(), "references": references,
        "contract_sha256": contract_digest(contract), "amended_sha256": contract_digest(amended),
        "affects": amendment_affects(contract, resolved),
    }
    directory = project / "measure" / AMENDMENT_PACKETS_DIR / ("a%02d" % number)
    directory.mkdir(parents=True, exist_ok=True)
    packet_bytes = (json.dumps(packet, sort_keys=True, indent=1) + "\n").encode("utf-8")
    (directory / "packet.json").write_bytes(packet_bytes)
    event = {"event": "proposal", "amendment": number, "rows": packet["rows"], "changes": resolved,
             "reason": packet["reason"], "report": report, "affects": packet["affects"], "retry_of": retry_of,
             "packet": str(directory / "packet.json"), "packet_sha256": hashlib.sha256(packet_bytes).hexdigest(),
             "contract_sha256": packet["contract_sha256"], "amended_sha256": packet["amended_sha256"],
             "at": _utc_now(), "wish_sha256": _wish_binding(project)}
    ledger = amendment_ledger(project)
    ledger.parent.mkdir(exist_ok=True)
    with ledger.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True) + "\n")
    read_contract_amendments(project)
    return event


def _component_reviewer_ids(project: Path) -> set:
    root = project / "measure" / COMPONENT_ROUNDS_DIR
    ids = set()
    for path in sorted(root.glob("*/" + STATE_NAME)) if root.is_dir() else ():
        try:
            value = json.loads(path.read_text(encoding="utf-8")).get("reviewer_id")
        except (OSError, ValueError, AttributeError):
            continue
        if isinstance(value, str):
            ids.add(value)
    return ids


def record_amendment_review(project: Path, review_path) -> dict:
    """Record the Contract Reviewer's verdict on the pending amendment. It
    applies only when the reviewer confirmed all three; otherwise it is
    refused and the Workshop Manager stops the run with a need."""

    record = json.loads(Path(review_path).read_text(encoding="utf-8"))
    required = {"amendment", "packet_sha256", "reviewer", "reason", *AMENDMENT_VERDICT}
    if not isinstance(record, dict) or set(record) != required:
        raise ValueError("an amendment review needs amendment, packet_sha256, reviewer, contradiction, "
                         "smallest, visible_in, references_checked and reason")
    amendments = read_contract_amendments(project)
    number = record["amendment"]
    item = amendments.get(number) if type(number) is int else None
    if item is None or item["status"] != "proposed":
        raise ValueError("Contract Amendment %r is not awaiting a review" % (number,))
    if record["packet_sha256"] != item["packet_sha256"]:
        raise ValueError("the review belongs to a different amendment packet")
    try:
        packet_bytes = Path(item["packet"]).read_bytes()
    except OSError:
        packet_bytes = b""
    if hashlib.sha256(packet_bytes).hexdigest() != item["packet_sha256"]:
        raise ValueError("Contract Amendment %d's packet changed after it was proposed; propose it again" % number)
    if contract_digest(current_contract(project)) != item["contract_sha256"]:
        raise ValueError("the Design Contract changed after Contract Amendment %d was proposed" % number)
    reviewer = record["reviewer"]
    if not isinstance(reviewer, str) or not 1 <= len(reviewer.strip()) <= 200:
        raise ValueError("an amendment review needs the reviewer's name")
    reviewer = reviewer.strip()
    if reviewer.lower() in MANAGER_NAMES:
        raise ValueError("the Workshop Manager cannot confirm its own amendment; ask a fresh contract-reviewer")
    runtime = os.environ.get(REVIEWER_RUNTIME_ENV)
    if runtime in REVIEWER_ID_FORMATS:
        pattern, shape = REVIEWER_ID_FORMATS[runtime]
        if not pattern.fullmatch(reviewer):
            raise ValueError("reviewer must be the contract-reviewer's native agent id (%s), exactly as the "
                             "runtime returned it when you spawned it; got %r" % (shape, reviewer[:40]))
    earlier = {other["review"]["reviewer"] for other in amendments.values() if other["review"] is not None}
    if reviewer in earlier or reviewer in _component_reviewer_ids(project):
        raise ValueError("%s has already reviewed in this run; spawn a fresh contract-reviewer for each "
                         "amendment" % reviewer)
    for key in ("contradiction", "smallest"):
        if type(record[key]) is not bool:
            raise ValueError("an amendment review's %s must be true or false" % key)
    files = {reference["file"] for reference in json.loads(packet_bytes)["references"]}
    for key in ("visible_in", "references_checked"):
        value = record[key]
        if not isinstance(value, list) or not all(isinstance(name, str) for name in value) \
                or not set(value) <= files or len(set(value)) != len(value):
            raise ValueError("%s lists sealed reference files from the packet: %s" % (key, ", ".join(sorted(files))))
    if set(record["references_checked"]) != files:
        raise ValueError("the reviewer checks every sealed reference; references_checked lacks %s"
                         % ", ".join(sorted(files - set(record["references_checked"]))))
    if not _blocked_text(record["reason"], MAX_REASON):
        raise ValueError("an amendment review needs a reason of 1 to %d characters" % MAX_REASON)
    verdict = {"contradiction": record["contradiction"], "smallest": record["smallest"],
               "visible_in": sorted(record["visible_in"]), "references_checked": sorted(files),
               "reason": record["reason"].strip()}
    event = {"event": "review", "amendment": number, "reviewer": reviewer, "verdict": verdict,
             "at": _utc_now(), "wish_sha256": item["wish_sha256"]}
    with amendment_ledger(project).open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True) + "\n")
    reviewed = read_contract_amendments(project)[number]
    return amendment_view(reviewed)


def amendment_need(item: dict) -> str:
    """The one-line need a refused amendment becomes, quoting every row."""

    verdict = (item.get("review") or {}).get("verdict") or {}
    if verdict.get("visible_in"):
        why = "a Visible Change: %s would show it" % ", ".join(verdict["visible_in"])
    elif verdict.get("contradiction") is False:
        why = "the Contract Reviewer found the rows can both hold"
    else:
        why = "the Contract Reviewer found a smaller change"
    need = "Contract Contradiction: %s. Amendment %d refused (%s)" % (
        " vs ".join("'%s'" % _squash(row) for row in item["rows"]), item["amendment"], why)
    return need[:MAX_NEED_CHARS]


def owner_view(number: int, item: dict) -> dict:
    """An Owner Contract Amendment as --contract-amendments lists it."""

    return {"kind": "owner-contract-amendment", "owner_amendment": number, "status": "applied",
            "source": "owner", "changes": [{key: change.get(key) for key in ("row", "from", "to")}
                                           for change in item["changes"] if isinstance(change, dict)],
            "affects": list(item.get("affects") or ()), "contract_sha256": item.get("contract_sha256"),
            "amended_sha256": item.get("amended_sha256"), "prose_diff": item.get("prose_diff"),
            "at": item.get("at")}


def render_amendments(views: list) -> str:
    if not views:
        return "make_round: no Contract Amendments"
    lines = []
    for item in views:
        if item.get("kind") == "owner-contract-amendment":
            continue
        lines.append("amendment %d  %s  contract %s -> %s  affects %s" % (
            item["amendment"], item["status"].upper(), item["contract_sha256"][:12], item["amended_sha256"][:12],
            ", ".join(item.get("affects") or ()) or "-"))
        if item.get("retry_of"):
            lines.append("  Smaller Retry of amendment %d" % item["retry_of"])
        for row in item["rows"]:
            lines.append("  row  %s" % row)
        for change in item["changes"]:
            lines.append("  %s  %s\n    -> %s" % (change["row"], change["from"], change["to"]))
        if item["review"]:
            verdict = item["review"]["verdict"]
            lines.append("  review %s  contradiction %s, smallest %s, visible in %s  %s" % (
                item["review"]["reviewer"], verdict["contradiction"], verdict["smallest"],
                ", ".join(verdict["visible_in"]) or "none", verdict["reason"]))
        else:
            lines.append("  packet %s  sha256 %s: ask a fresh contract-reviewer" % (item["packet"], item["packet_sha256"]))
    # Issue #100: the owner's amendments apply after every in-run amendment.
    for item in views:
        if item.get("kind") != "owner-contract-amendment":
            continue
        lines.append("owner amendment %d  APPLIED by the owner  contract %s -> %s  unlocks %s" % (
            item["owner_amendment"], str(item["contract_sha256"])[:12], str(item["amended_sha256"])[:12],
            ", ".join(item["affects"]) or "no Component"))
        for change in item["changes"]:
            lines.append("  %s  %s\n    -> %s" % (change["row"], change["from"], change["to"]))
        if item.get("prose_diff"):
            lines.append("  prose (CONTRACT-AMENDMENTS.json's objective replaces WISH.json's):")
            lines.extend("    " + line for line in str(item["prose_diff"]).splitlines())
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Interfaces between Components (ADR 0082): the Shared Helper freeze, Keep-out
# Envelopes and Coupled Interface checks. Only the round mechanics live here;
# every verdict comes from the print gates, check_envelope and check_motion.


def contract_interfaces(project: Path) -> tuple[list | None, str | None]:
    """``(interfaces, error)`` from the sealed Design Contract.

    ``interfaces`` is None when the run has no contract or its contract has no
    Interfaces section (schema 1, or a run sealed before ADR 0082): such runs
    keep the protocol without a freeze. An unreadable Wish is an error.
    """

    root = run_root(project)
    if root is None:
        return None, None
    try:
        wish = json.loads((root / "WISH.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return None, "WISH.json unreadable: %s" % exc
    context = wish.get("context") if isinstance(wish, dict) else None
    contract = context.get("design_contract") if isinstance(context, dict) else None
    if not isinstance(contract, dict) or "interfaces" not in contract:
        return None, None
    interfaces = contract["interfaces"]
    if not isinstance(interfaces, list) or not all(
            isinstance(item, dict) and isinstance(item.get("id"), str) for item in interfaces):
        return None, "the sealed contract's interfaces are invalid"
    return interfaces, None


def shared_helpers(project: Path) -> dict[str, str]:
    """Project-relative path -> sha256 of every Shared Helper: each importable
    project-local ``.py`` module that is not an entry, a sample or evidence."""

    project = project.resolve()
    found = {}
    for path in sorted(project.rglob("*.py")):
        relative = path.relative_to(project)
        if path.name.endswith(".step.py") or any(part in NOT_HELPERS for part in relative.parts[:-1]):
            continue
        if path.is_file():
            found[relative.as_posix()] = file_hash(path)
    return found


def helper_importers(project: Path) -> dict[str, list[str]]:
    """Shared Helper path -> the Components whose source imports it."""

    importers: dict[str, list[str]] = {}
    for source in sorted(project.glob("part_*.step.py")):
        role = source.name[len("part_"):-len(".step.py")]
        for path in imported_helpers(project, source):
            importers.setdefault(path, []).append(role)
    return importers


def read_freeze(project: Path) -> dict | None:
    try:
        record = json.loads((project / "measure" / HELPER_FREEZE_NAME).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) and isinstance(record.get("helpers"), dict) else None


def freeze_report(project: Path, freeze: dict, helpers: dict[str, str]) -> dict:
    """What changed in the Shared Helpers one Component imports since the
    freeze, and every Component that imports each changed file (ADR 0082).
    Detection only: the round policy's import-scoped unlock acts on it."""

    frozen = freeze["helpers"]
    changed = sorted(path for path, digest in helpers.items() if frozen.get(path) != digest)
    importers = helper_importers(project) if changed else {}
    return {"round": freeze.get("round"), "changed": changed,
            "affected": {path: importers.get(path, []) for path in changed}}


WIKI_CITATION = re.compile(r"#\s*wiki:\s*([A-Za-z0-9_./-]+)(?:#[A-Za-z0-9_-]+)?")
DESIGN_VALUE_NAME = re.compile(r"[A-Z][A-Z0-9_]*")
# Name parts of a standard element that bd_warehouse or py_gearworks builds.
STANDARD_ELEMENT_WORDS = frozenset({
    "gear", "gears", "pinion", "rack", "sprocket", "bearing", "bearings", "screw", "screws", "bolt",
    "bolts", "nut", "nuts", "washer", "washers", "circlip", "snapring", "oring", "thread", "threads"})
STANDARD_ELEMENT_LIBRARIES = ("bd_warehouse", "py_gearworks")
PRINT_DETAILS_INSTALL = "features/print_details.py"


def _number_literal(node) -> bool:
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.USub, ast.UAdd)):
        node = node.operand
    if isinstance(node, (ast.Tuple, ast.List)):
        return bool(node.elts) and all(_number_literal(item) for item in node.elts)
    return isinstance(node, ast.Constant) and type(node.value) in (int, float)


def _name_words(name: str) -> list[str]:
    spaced = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
    return [word for word in spaced.lower().split("_") if word]


def helper_rule_failures(path: Path, relative: str, wiki_pages: set[str]) -> list[str]:
    """What breaks the Shared Helper rules of ADR 0082 in one helper.

    Every design value -- a module-level UPPER_CASE name bound to a number or
    a tuple of numbers -- cites ``# wiki: <slug>`` on its line or in the
    comment lines directly above, the cited page exists in the run's wiki, and
    the value appears in an ``assert`` of the module. A function or class
    named for a standard element needs bd_warehouse or py_gearworks, and no
    helper writes its own involute. Values derived from cited values need no
    citation of their own.
    """

    try:
        text = path.read_text(encoding="utf-8")
        tree = ast.parse(text)
    except (OSError, SyntaxError, UnicodeError, ValueError) as exc:
        return ["%s: unreadable (%s)" % (relative, exc)]
    lines = text.splitlines()
    asserted = {node.id for test in ast.walk(tree) if isinstance(test, ast.Assert)
                for node in ast.walk(test) if isinstance(node, ast.Name)}
    failures = []
    for node in tree.body:
        if isinstance(node, ast.Assign):
            targets, value = node.targets, node.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            targets, value = [node.target], node.value
        else:
            continue
        names = [target.id for target in targets if isinstance(target, ast.Name)]
        if len(names) != len(targets) or not all(DESIGN_VALUE_NAME.fullmatch(name) for name in names) \
                or not _number_literal(value):
            continue
        cited = WIKI_CITATION.search(lines[node.lineno - 1])
        above = node.lineno - 2
        while cited is None and above >= 0 and lines[above].lstrip().startswith("#"):
            cited = WIKI_CITATION.search(lines[above])
            above -= 1
        for name in names:
            where = "%s:%d %s" % (relative, node.lineno, name)
            if cited is None:
                failures.append("%s cites no wiki page; add `# wiki: <slug>` from `wiki search`" % where)
            elif cited.group(1).rsplit("/", 1)[-1] not in wiki_pages:
                failures.append("%s cites %s, which is not a page of this wiki" % (where, cited.group(1)))
            if name not in asserted:
                failures.append("%s is in no assert; add the cited page's assert" % where)
    libraries = any(
        (isinstance(node, ast.Import) and any(alias.name.split(".")[0] in STANDARD_ELEMENT_LIBRARIES
                                              for alias in node.names))
        or (isinstance(node, ast.ImportFrom) and (node.module or "").split(".")[0] in STANDARD_ELEMENT_LIBRARIES)
        for node in ast.walk(tree))
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            name, line = node.name, node.lineno
        elif isinstance(node, ast.Name):
            name, line = node.id, node.lineno
        else:
            continue
        words = _name_words(name)
        if "involute" in words:
            failures.append("%s:%d %s writes an involute by hand; take the gear from stdpart (py_gearworks, "
                            "bd_warehouse)" % (relative, line, name))
        elif not libraries and not isinstance(node, ast.Name) and STANDARD_ELEMENT_WORDS.intersection(words):
            failures.append("%s:%d %s builds a standard element by hand; take it from stdpart (bd_warehouse, "
                            "py_gearworks)" % (relative, line, name))
    return sorted(set(failures), key=failures.index)


def shared_helper_rules(project: Path, samples: list[Path], roots) -> list[str]:
    """Check the Shared Helper rules on every helper a Component or sample
    imports. The installed print-details library is a standard element: its
    exact bytes are exempt, an edited copy is refused."""

    try:
        wiki = Path(roots / "wiki" / "pages")
        library = Path(roots / "print-details" / "scripts" / "print_details.py")
    except (KeyError, TypeError):
        wiki = library = None
    if wiki is None or not wiki.is_dir():
        return ["cannot locate the wiki skill's pages to check Shared Helper citations"]
    wiki_pages = {page.stem for page in wiki.rglob("*.md")}
    library_sha = file_hash(library) if library.is_file() else None
    imported: dict[str, None] = {}
    for source in [*sorted(project.glob("part_*.step.py")), *samples]:
        for path in imported_helpers(project, source):
            imported.setdefault(path, None)
    failures = []
    for relative in sorted(imported):
        path = project / relative
        if relative == PRINT_DETAILS_INSTALL:
            if file_hash(path) != library_sha:
                failures.append("%s differs from the print-details library; reinstall it with "
                                "print_details.py --install and never edit it" % relative)
            continue
        failures.extend(helper_rule_failures(path, relative, wiki_pages))
    return failures


def shared_helper_check(project: Path, args, cad: Path) -> int:
    """Check the Shared Helper rules, build the Manager's samples under
    samples/, run both print gates on each, and freeze the Shared Helpers
    when the rules hold and every sample passes."""

    interfaces, error = contract_interfaces(project)
    if error is not None:
        print("make_round: %s" % error, file=sys.stderr)
        return 2
    samples = sorted((project / SAMPLES_DIR).glob("*.step.py")) if (project / SAMPLES_DIR).is_dir() else []
    if interfaces and not samples:
        print("make_round: the contract has Interfaces but %s/ holds no sample <name>.step.py; build each "
              "joint section, gear pair or standard profile there from the Shared Helpers" % SAMPLES_DIR,
              file=sys.stderr)
        return 2
    rule_failures = shared_helper_rules(project, samples, skills_root())
    if rule_failures:
        # Cheap to fix and checked before any sample is built or frozen.
        print("make_round: the Shared Helpers break the rules of ADR 0082; nothing was built or frozen:\n  %s"
              % "\n  ".join(rule_failures), file=sys.stderr)
        return 1
    measure = project / "measure"
    root = measure / HELPER_ROUNDS_DIR
    root.mkdir(parents=True, exist_ok=True)
    state_path = root / STATE_NAME
    state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    number = int(state.get("round", 0)) + 1
    out = root / ("r%04d" % number)
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    before = shared_helpers(project)
    # A sample sits in samples/ and imports the Shared Helpers from the project.
    path_env = {"PYTHONPATH": os.pathsep.join(filter(None, [str(project), os.environ.get("PYTHONPATH")]))}
    python = sys.executable
    results = {}
    for sample in samples:
        name = sample.name[:-len(".step.py")]
        imported = imported_helpers(project, sample)
        item = {"source_sha256": file_hash(sample), "imports": sorted(imported)}
        if not imported:
            item.update(verdict="FAIL", failures=["imports no Shared Helper; a sample tests the helpers it imports"])
            results[name] = item
            continue
        done = run([python, str(cad / "gen"), str(sample), "--write", "--json"], cwd=project,
                   log=out / ("gen-%s.log" % name), extra_env=path_env)
        build = parse_build(done.stdout, done.stderr, done.returncode)
        if build["verdict"] == "PASS" and not sample.with_name(sample.name[:-len(".py")]).is_file():
            build = {"verdict": "FAIL", "failures": ["gen reported success but wrote no STEP"]}
        item["build"] = build
        if build["verdict"] != "PASS":
            item.update(verdict="FAIL", failures=build["failures"])
            results[name] = item
            continue
        gates = {}
        for gate, extra in (("thickness", ["--nozzle", str(args.nozzle)]),
                            ("overhang", ["--angle", str(args.overhang_angle)])):
            done = run([python, str(cad / ("check_" + gate)), str(sample), *extra,
                        "--report", str(out / ("%s-%s.md" % (gate, name)))],
                       cwd=project, log=out / ("%s-%s.log" % (gate, name)), extra_env=path_env)
            parsed = (parse_thickness if gate == "thickness" else parse_overhang)(done.stdout)
            if done.returncode == GATE_UNMEASURABLE:
                unmeasurable(parsed, done.stdout)
            elif done.returncode not in (0, 1):
                # A gate that could not measure never passes a sample.
                parsed["verdict"] = "FAIL"
                parsed["failures"] = (["check_%s exit %d" % (gate, done.returncode)] + parsed["failures"])[:4]
            gates[gate] = parsed
        item.update(gates)
        failures = [f for gate in gates.values() if gate["verdict"] != "PASS" for f in gate["failures"]]
        item.update(verdict="PASS" if all(g["verdict"] == "PASS" for g in gates.values()) else "FAIL",
                    failures=failures[:4])
        results[name] = item
    after = shared_helpers(project)
    errors = [] if before == after else ["the Shared Helpers changed while their samples were checked"]
    ok = not errors and all(item["verdict"] == "PASS" for item in results.values())
    previous = read_freeze(project)
    summary = {"round": number, "scope": "shared-helpers", "project": str(project), "samples": results,
               "helpers": after, "errors": errors, "ok": ok, "frozen": False, "out": str(out),
               "nozzle": args.nozzle, "overhang_angle": args.overhang_angle}
    if ok:
        changed = sorted(path for path in set(after) | set((previous or {}).get("helpers", {}))
                         if after.get(path) != (previous or {}).get("helpers", {}).get(path))
        importers = helper_importers(project)
        freeze = {"schema_version": 1, "round": number, "helpers": after,
                  "samples": {name: item["source_sha256"] for name, item in results.items()},
                  "summary_sha256": None}
        event = {"round": number, "refreeze_of": (previous or {}).get("round"),
                 "changed": changed if previous is not None else [],
                 "affected": {path: importers.get(path, []) for path in changed} if previous is not None else {}}
        summary.update(frozen=True, freeze_event=event)
    (out / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    if ok:
        freeze["summary_sha256"] = file_hash(out / "summary.json")
        (measure / HELPER_FREEZE_NAME).write_text(json.dumps(freeze, indent=1, sort_keys=True) + "\n",
                                                  encoding="utf-8")
        with (measure / HELPER_FREEZE_LOG).open("a", encoding="utf-8") as ledger:
            ledger.write(json.dumps(event, sort_keys=True) + "\n")
    state_path.write_text(json.dumps({"round": number, "last_out": str(out), "ok": ok}, indent=1) + "\n",
                          encoding="utf-8")
    print(json.dumps(summary, sort_keys=True) if args.json else render_helper_summary(summary))
    return 0 if ok else 1


def render_helper_summary(summary: dict) -> str:
    lines = ["make_round r%04d  shared-helpers  %s  %d sample(s)"
             % (summary["round"], summary["project"], len(summary["samples"]))]
    for name, item in summary["samples"].items():
        why = ("  " + "; ".join(item["failures"])) if item["verdict"] != "PASS" and item["failures"] else ""
        lines.append("  sample %-4s %-24s imports %s%s" % (item["verdict"], name, ", ".join(item["imports"]) or "-", why))
    for error in summary["errors"]:
        lines.append("  error %s" % error)
    if summary["frozen"]:
        event = summary["freeze_event"]
        lines.append("  freeze %d Shared Helper(s) frozen at r%04d" % (len(summary["helpers"]), summary["round"]))
        for path in event["changed"]:
            lines.append("  refreeze %s changed since r%04d; imported by %s"
                         % (path, event["refreeze_of"], ", ".join(event["affected"].get(path, [])) or "no Component"))
    lines.append("  %s  reports under %s" % ("PASS" if summary["ok"] else "FAIL", summary["out"]))
    return "\n".join(lines)


def reference_role(reference: str) -> tuple[str, int | None]:
    """``(component, instance)`` of an Interface Component reference:
    ``("wing", 2)`` for ``wing#2``, ``("body", None)`` for ``body``."""

    match = INSTANCE_REFERENCE.fullmatch(reference)
    return (match.group(1), int(match.group(2))) if match is not None else (reference, None)


def reference_roles(references) -> list[str]:
    """The distinct Components behind Interface references, in order: the
    two instances ``wing#1`` and ``wing#2`` are one Component."""

    return list(dict.fromkeys(reference_role(reference)[0] for reference in references))


def instance_hook_missing(part: Path) -> str:
    """Why ``part`` cannot place one instance of its geometry, or "".

    Read from the source, so a refusal never builds anything: the module's
    placement hook must take the instance number (issue #80)."""

    try:
        tree = ast.parse(part.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError) as exc:
        return "%s cannot be read: %s" % (part.name, exc)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name == PLACE_FUNC:
            names = [arg.arg for arg in (*node.args.posonlyargs, *node.args.args, *node.args.kwonlyargs)]
            if INSTANCE_PARAM in names:
                return ""
            return ("an Interface names an instance of %s, but its %s takes no %s; %s"
                    % (part.name, PLACE_FUNC, INSTANCE_PARAM, INSTANCE_CONVENTION))
    return "an Interface names an instance of %s, which defines no %s; %s" % (part.name, PLACE_FUNC, INSTANCE_CONVENTION)


def separable_roles(interfaces: list, role: str) -> list[tuple[dict, str, str]]:
    """``(interface, "inside"|"outside", reference)`` for each side of a
    separable Interface this Component keeps a Keep-out Envelope on: the
    Component itself, or one of its instances. Instances of one geometry on
    both sides give both sides."""

    found = []
    for item in interfaces or ():
        envelope = item.get("envelope") if item.get("kind") == SEPARABLE else None
        if isinstance(envelope, dict):
            for side in ("inside", "outside"):
                reference = envelope.get(side)
                if isinstance(reference, str) and reference_role(reference)[0] == role:
                    found.append((item, side, reference))
    return found


def parse_envelope(stdout: str, returncode: int) -> dict:
    """A check_envelope result; anything but a complete PASS fails."""

    try:
        payload = json.loads((stdout or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        payload = None
    if not isinstance(payload, dict) or not isinstance(payload.get("ok"), bool):
        return {"verdict": "FAIL", "poses": [], "detail": "check_envelope exit %d without a result" % returncode}
    verdict = "PASS" if payload["ok"] and returncode == 0 else "FAIL"
    return {"verdict": verdict, "poses": payload.get("poses") or [], "detail": str(payload.get("detail", ""))[:300]}


def check_envelopes(project: Path, role: str, part: Path, out: Path, interfaces: list) -> dict:
    """Run check_envelope for every separable Interface this Component joins."""

    results = {}
    for item, side, reference in separable_roles(interfaces, role):
        _role, instance = reference_role(reference)
        # A side that is one instance is reported as "<interface> <id>#<n>".
        key = item["id"] if instance is None else "%s %s" % (item["id"], reference)
        stem = "envelope-%s" % item["id"] + ("" if instance is None else "-%d" % instance)
        missing = instance_hook_missing(part) if instance is not None else ""
        if missing:
            results[key] = {"role": side, "component": reference, "verdict": "FAIL", "poses": [], "detail": missing}
            continue
        envelope_path = out / ("envelope-%s.json" % item["id"])
        envelope_path.write_text(json.dumps(item["envelope"], sort_keys=True) + "\n", encoding="utf-8")
        command = [sys.executable, str(Path(__file__).resolve().parent / "check_envelope"), str(part),
                   "--envelope", str(envelope_path), "--role", side, "--json"]
        if instance is not None:
            command += ["--instance", str(instance)]
        done = run(command, cwd=project, log=out / ("%s.log" % stem))
        results[key] = {"role": side, "component": reference, **parse_envelope(done.stdout, done.returncode)}
    return results


def interface_state_path(project: Path, interface_id: str) -> Path:
    return project / "measure" / INTERFACE_ROUNDS_DIR / interface_id / STATE_NAME


def component_identity(project: Path, role: str, out: Path, cad: Path) -> str | None:
    """The current B-rep identity of one Component, built now, or None."""

    part = project / ("part_%s.step.py" % role)
    if not part.is_file():
        return None
    done = run([sys.executable, str(cad / "gen"), str(part), "--write", "--json"], cwd=project,
               log=out / ("gen-%s.log" % role))
    step = part.with_name(part.name[:-len(".py")])
    if parse_build(done.stdout, done.stderr, done.returncode)["verdict"] != "PASS" or not step.is_file():
        return None
    return parse_identity(done.stdout) or file_hash(step)


def locked_at(project: Path, role: str, digest: str | None) -> str:
    """Why one Component is not locked at its current identity, or ""."""

    _summary, reason = current_passing_component_round(project, role, digest)
    if reason:
        return reason
    state_path, round_root = state_and_round_root(project, "part_%s.step.py" % role)
    policy = component_policy(json.loads(state_path.read_text(encoding="utf-8")), round_root)
    if policy.get("phase") != LOCKED:
        return "part_%s.step.py is not locked by an agreeing review or a Component Acceptance" % role
    return ""


INTERFACE_ENTRY = '''"""Generated by make_round --interface %(id)s (ADR 0082).

Places the Interface's Components in assembly coordinates, each through its
own assembly_pose(shape, None), labelled by its Interface reference. An
instance <id>#<n> is built by gen_step(instance=n) when gen_step takes it and
placed by assembly_pose(shape, None, instance=n) (issue #80). No geometry of
its own; never printed.
"""

import importlib.util
import inspect
import sys
from pathlib import Path

PRINTABLE = False
PROJECT = Path(%(project)r)
COMPONENTS = %(components)r


def _takes_instance(function):
    try:
        return "instance" in inspect.signature(function).parameters
    except (TypeError, ValueError):
        return False


def _component(reference):
    if str(PROJECT) not in sys.path:
        sys.path.insert(0, str(PROJECT))
    role, _, number = reference.partition("#")
    path = PROJECT / ("part_%%s.step.py" %% role)
    spec = importlib.util.spec_from_file_location(
        "_interface_part_" + reference.replace("-", "_").replace("#", "_"), path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    place = getattr(module, "assembly_pose", None)
    if place is None:
        raise ValueError("%%s defines no assembly_pose(shape, pose)" %% path.name)
    if not number:
        shape = place(module.gen_step(), None)
    else:
        instance = int(number)
        if not _takes_instance(place):
            raise ValueError("%%s: assembly_pose takes no instance" %% path.name)
        built = module.gen_step(instance=instance) if _takes_instance(module.gen_step) else module.gen_step()
        shape = place(built, None, instance=instance)
    shape.label = reference
    return shape


def gen_step():
    from build123d import Compound

    return Compound(label="interface", children=[_component(reference) for reference in COMPONENTS])
'''


def interface_condition(project: Path, interface: dict) -> dict:
    """The one coupled_motion_collision condition this Interface is checked
    with: its sealed pose table, or the motion-manifest condition it names."""

    components = list(interface["components"])
    if interface.get("poses") is not None:
        poses = interface["poses"]
        movers = []
        for mover in poses["movers"]:
            entry = {"part": mover["component"]}
            entry.update({key: mover[key] for key in ("rotation", "translation", "driven") if key in mover})
            movers.append(entry)
        inputs = {"steps": poses["steps"], "movers": movers}
    else:
        try:
            manifest = json.loads((project / "measure" / "motion.json").read_text(encoding="utf-8"))
            conditions = manifest["conditions"]
        except (OSError, ValueError, KeyError, TypeError):
            raise ValueError("%s takes its poses from measure/motion.json condition %r, which cannot be read"
                             % (interface["id"], interface["poses_from"])) from None
        found = [item for item in conditions if isinstance(item, dict) and item.get("id") == interface["poses_from"]]
        if len(found) != 1 or found[0].get("check") != "coupled_motion_collision":
            raise ValueError("measure/motion.json has no single coupled_motion_collision condition %r"
                             % interface["poses_from"])
        inputs = dict(found[0].get("inputs") or {})
    moving = {mover.get("part") for mover in inputs.get("movers") or () if isinstance(mover, dict)}
    unknown = sorted(str(name) for name in moving if name not in components)
    if unknown:
        raise ValueError("the pose table of %s moves %s, which the Interface does not join"
                         % (interface["id"], ", ".join(unknown)))
    # Only the Interface's own Components are built; the ones that do not
    # move are its obstacles, on the record.
    inputs["obstacle_parts"] = [role for role in components if role not in moving]
    return {"id": interface["id"], "check": "coupled_motion_collision", "expect": "clear", "inputs": inputs}


def interface_check(project: Path, interface_id: str, args, cad: Path) -> int:
    """``--interface ID``: the coupled motion check of one Coupled Interface on
    its locked Components (ADR 0082). A failure unlocks the yielding
    Component with the check's evidence as its repair input."""

    interfaces, error = contract_interfaces(project)
    if error is not None or interfaces is None:
        print("make_round: %s" % (error or "the sealed Design Contract has no Interfaces section"), file=sys.stderr)
        return 2
    interface = next((item for item in interfaces if item.get("id") == interface_id), None)
    if interface is None:
        print("make_round: the sealed contract has no Interface %r" % interface_id, file=sys.stderr)
        return 2
    if interface.get("kind") != COUPLED:
        print("make_round: %s is a %s Interface; only a Coupled Interface has an interface check%s"
              % (interface_id, interface.get("kind"),
                 " (its Keep-out Envelope is checked in each component round)" if interface.get("kind") == SEPARABLE else ""),
              file=sys.stderr)
        return 2
    root = project / "measure" / INTERFACE_ROUNDS_DIR / interface_id
    root.mkdir(parents=True, exist_ok=True)
    state_path = root / STATE_NAME
    state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    number = int(state.get("round", 0)) + 1
    out = root / ("r%04d" % number)
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    components = list(interface["components"])
    # Locking and identity belong to the Component: the two instances wing#1
    # and wing#2 are one source file, built and judged once (issue #80).
    roles = reference_roles(components)
    instanced = reference_roles(reference for reference in components if reference_role(reference)[1] is not None)
    hooks = [reason for role in instanced if (project / ("part_%s.step.py" % role)).is_file()
             for reason in [instance_hook_missing(project / ("part_%s.step.py" % role))] if reason]
    if hooks:
        shutil.rmtree(out)
        print("make_round: interface %s: %s" % (interface_id, "; ".join(hooks)), file=sys.stderr)
        return 2
    identities = {role: component_identity(project, role, out, cad) for role in roles}
    refusals = [reason for role in roles for reason in [locked_at(project, role, identities[role])] if reason]
    if refusals:
        shutil.rmtree(out)
        print("make_round: interface %s judges locked geometry only: %s" % (interface_id, "; ".join(refusals)),
              file=sys.stderr)
        return 2
    try:
        condition = interface_condition(project, interface)
    except ValueError as exc:
        shutil.rmtree(out)
        print("make_round: %s" % exc, file=sys.stderr)
        return 2
    entry = out / ("interface_%s.step.py" % interface_id.replace("-", "_"))
    entry.write_text(INTERFACE_ENTRY % {"id": interface_id, "project": str(project), "components": components},
                     encoding="utf-8")
    manifest = out / "motion.json"
    manifest.write_text(json.dumps({"assembly": entry.relative_to(project).as_posix(), "conditions": [condition]},
                                   indent=1, sort_keys=True) + "\n", encoding="utf-8")
    done = run([sys.executable, str(cad / "check_motion"), str(project), "--manifest", str(manifest), "--json"],
               cwd=project, log=out / "motion.log")
    motion = parse_motion(done.stdout, done.returncode, done.stderr)
    passed = motion["verdict"] == "pass"
    summary = {"round": number, "scope": "interface:%s" % interface_id, "project": str(project),
               "interface": interface_id, "kind": COUPLED, "components": components,
               "yielding": interface.get("yielding"), "identities": identities, "motion": motion,
               "ok": passed, "unlocked": None, "out": str(out)}
    if motion["verdict"] == "fail":
        summary["unlocked"] = interface_unlock(project, interface, number, out, motion)
    (out / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    steps = {role: file_hash(project / ("part_%s.step" % role)) for role in roles
             if (project / ("part_%s.step" % role)).is_file()}
    state_path.write_text(json.dumps({"round": number, "last_out": str(out), "identities": identities,
                                      "steps": steps, "ok": passed, "verdict": motion["verdict"]},
                                     indent=1, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(summary, sort_keys=True) if args.json else render_interface_summary(summary))
    return 0 if passed else 1


def interface_unlock(project: Path, interface: dict, number: int, out: Path, motion: dict) -> str:
    """Unlock the contract's yielding Component of a failed Interface check,
    with the check's evidence as its repair input. Its rounds after the
    unlock are admitted and are never Shape Rounds (ADR 0081, ADR 0082)."""

    # A yielding instance (wing#2) unlocks its Component, whose one worker
    # owns every instance (issue #80).
    role = reference_role(interface["yielding"])[0]
    state_path, round_root = state_and_round_root(project, "part_%s.step.py" % role)
    state = json.loads(state_path.read_text(encoding="utf-8"))
    policy = component_policy(state, round_root)
    unlock = {"kind": "interface", "interface": interface["id"], "interface_round": number,
              "evidence": {"round": str(out), "motion_log_sha256": file_hash(out / "motion.log"),
                           "detail": motion["detail"], "conditions": motion["conditions"]},
              "reason": "Interface %s failed its coupled motion check: %s" % (interface["id"], motion["detail"])}
    state["policy"] = {**policy, "unlocks": [*(policy.get("unlocks") or []), unlock]}
    with (round_root / "unlocks.jsonl").open("a", encoding="utf-8") as ledger:
        ledger.write(json.dumps(unlock, sort_keys=True) + "\n")
    state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    return role


def render_interface_summary(summary: dict) -> str:
    motion = summary["motion"]
    lines = ["make_round r%04d  %s  %s  %s" % (summary["round"], summary["scope"], summary["project"],
                                               " + ".join(summary["components"])),
             "  move  %-4s %s" % (motion["verdict"].upper()[:4], motion["detail"][:160])]
    if summary.get("unlocked"):
        lines.append("  unlock part_%s.step.py (the yielding Component); send this round to its worker"
                     % summary["unlocked"])
    lines.append("  %s  reports under %s" % ("PASS" if summary["ok"] else "FAIL", summary["out"]))
    return "\n".join(lines)


def interface_report(project: Path, interfaces: list | None, digests: dict) -> list[dict]:
    """Each Interface with its Kind, Components and how it was proven, for
    the run report (ADR 0082). ``digests`` holds each Component's current
    identity. A Coupled Interface's ``check`` is ``pass`` only while its
    latest --interface check passed on those exact identities; else
    ``fail``, ``stale`` or ``not-run``. A separable Interface is proven by
    each side's component round, a static one by the Shared Helper samples."""

    report = []
    for interface in interfaces or ():
        item = {"id": interface["id"], "kind": interface.get("kind"), "components": list(interface["components"])}
        if interface.get("kind") == COUPLED:
            try:
                state = json.loads(interface_state_path(project, interface["id"]).read_text(encoding="utf-8"))
            except (OSError, ValueError):
                state = None
            if state is None:
                check = "not-run"
            elif not state.get("ok"):
                check = "fail"
            elif any(digests.get(role) is None or digests.get(role) not in (
                    (state.get("identities") or {}).get(role), (state.get("steps") or {}).get(role))
                     for role in reference_roles(item["components"])):
                # Either recorded form names the same geometry: the B-rep
                # identity gen reported, or the STEP a reader without a fresh
                # build can only hash (ADR 0073).
                check = "stale"
            else:
                check = "pass"
            item.update(check=check, yielding=interface.get("yielding"),
                        round=state.get("round") if state is not None else None)
        elif interface.get("kind") == SEPARABLE:
            item["check"] = "keep-out-envelope"
        else:
            item["check"] = "shared-helper-samples"
        report.append(item)
    return report


def interface_failures(project: Path, interfaces: list | None, digests: dict) -> list[str]:
    """Why assembly may not start on the Coupled Interfaces: each needs a
    current passing check on its Components' present geometry."""

    why = {"not-run": "has no --interface check", "fail": "failed its latest --interface check",
           "stale": "is stale: a Component it joins changed after its check"}
    return ["interface %s %s" % (item["id"], why[item["check"]])
            for item in interface_report(project, interfaces, digests)
            if item["kind"] == COUPLED and item["check"] != "pass"]


def make_round(args) -> int:
    project = Path(args.project).resolve()
    if not project.is_dir():
        print("make_round: not a directory: %s" % project, file=sys.stderr)
        return 2
    try:
        option = getattr(args, "check_motion", None)
        if args.no_motion:
            if option is True:
                raise ValueError("--no-motion conflicts with --check-motion true")
            option = False
        check_motion = motion_policy()["enabled"](option)
    except (OSError, ValueError) as exc:
        print("make_round: %s" % exc, file=sys.stderr)
        return 2
    if getattr(args, "blocked_reports", False):
        try:
            views = [blocked_view(project, report) for _, report in sorted(read_blocked_reports(project).items())]
        except (OSError, UnicodeError, ValueError) as exc:
            print("make_round: the Blocked Report ledger is invalid: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(views, sort_keys=True) if args.json else render_blocked(views))
        return 1 if any(item["status"] in ("open", "waiting", "woken") for item in views) else 0
    if getattr(args, "report_blocked", None):
        try:
            event = report_blocked(project, args.report_blocked, args.component)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(event, sort_keys=True) if args.json else
              "make_round: Blocked Report %d recorded for %s; report blocked to the Manager and wait for its answer"
              % (event["report"], event["component"]))
        return 0
    if getattr(args, "clear_blocked", None):
        try:
            event = clear_blocked(project, args.clear_blocked)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(event, sort_keys=True))
        elif event["event"] == "need":
            print("make_round: Blocked Report %d became a need; stop the run with it now: "
                  "stage_proposal.py --run-root . need --stage make --status waiting --reason %s"
                  % (event["report"], json.dumps(event["need"])))
        elif event["event"] == "amendment":
            print("make_round: Blocked Report %d cleared by Contract Amendment %d; tell the worker its rows "
                  "changed and to rerun its round" % (event["report"], event["amendment"]))
        elif event["waits_on"]:
            print("make_round: Blocked Report %d waits on %s; it stays open until %s passes a round, "
                  "then send the worker this decision again" % (event["report"], event["waits_on"], event["waits_on"]))
        else:
            print("make_round: Blocked Report %d decided; send the worker this ruling unchanged. It "
                  "follows it with a new component round or a new Blocked Report" % event["report"])
        return 0
    if getattr(args, "contract_amendments", False):
        try:
            views = [amendment_view(item) for _, item in sorted(read_contract_amendments(project).items())]
            # Issue #100: the owner's amendments follow, as the rounds apply them.
            views += [owner_view(number, item) for number, item in enumerate(owner_amendments(project), 1)]
        except (OSError, UnicodeError, ValueError) as exc:
            print("make_round: the Contract Amendment ledger is invalid: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(views, sort_keys=True) if args.json else render_amendments(views))
        return 1 if any(item["status"] == "proposed" for item in views) else 0
    if getattr(args, "propose_amendment", None):
        try:
            event = propose_amendment(project, args.propose_amendment)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(event, sort_keys=True) if args.json else
              "make_round: Contract Amendment %d proposed. Spawn a fresh contract-reviewer and send it only: "
              "packet %s sha256 %s. Record its answer with --record-amendment-review"
              % (event["amendment"], event["packet"], event["packet_sha256"]))
        return 0
    if getattr(args, "record_amendment_review", None):
        try:
            item = record_amendment_review(project, args.record_amendment_review)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(item, sort_keys=True))
        elif item["status"] == "applied":
            print("make_round: Contract Amendment %d applied; the contract is now %s. Rounds of %s read the "
                  "amended rows and unlock if locked%s" % (
                      item["amendment"], item["amended_sha256"][:12], ", ".join(item["affects"]) or "no Component",
                      "; clear Blocked Report %d with {\"report\": %d, \"amendment\": %d}"
                      % (item["report"], item["report"], item["amendment"]) if item["report"] else ""))
        elif retry_open(read_contract_amendments(project), item):
            # Issue #96: one Smaller Retry before the need.
            print("make_round: Contract Amendment %d refused; nothing changed. The reviewer found a smaller "
                  "change: %s\nYou may propose it once with --propose-amendment: the same rows, each change's "
                  "\"to\" the same \"from\" with only words deleted (nothing added), then ask a fresh "
                  "contract-reviewer. If you cannot, or that retry is refused, stop the run with this need%s: "
                  "stage_proposal.py --run-root . need --stage make --status waiting --reason %s" % (
                      item["amendment"], item["review"]["verdict"]["reason"],
                      " (first clear Blocked Report %d with {\"report\": %d, \"need\": <the need>})"
                      % (item["report"], item["report"]) if item["report"] else "",
                      json.dumps(amendment_need(item))))
        else:
            need = amendment_need(item)
            print("make_round: Contract Amendment %d refused; nothing changed. Stop the run with a need now%s: "
                  "stage_proposal.py --run-root . need --stage make --status waiting --reason %s" % (
                      item["amendment"],
                      " (first clear Blocked Report %d with {\"report\": %d, \"need\": <the need>})"
                      % (item["report"], item["report"]) if item["report"] else "", json.dumps(need)))
        return 0 if item["status"] == "applied" else 1
    if args.component is None and not getattr(args, "shared_helpers", False) and not getattr(args, "interface", None) \
            and (args.full or not args.record_visual):
        # ADR 0085: nor while a Contract Amendment awaits its review.
        refusal = amendment_refusal(project)
        if refusal:
            print("make_round: %s" % refusal, file=sys.stderr)
            return 2
        # Issue #88: no assembly round and no final verifier while a Blocked
        # Report is open.
        refusal = blocked_refusal(project)
        if refusal:
            print("make_round: %s" % refusal, file=sys.stderr)
            return 2
    if args.record_visual:
        try:
            summary = record_visual(project, args.record_visual, args.full, args.component,
                                    check_motion=check_motion)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
        return 0 if summary["ok"] else 1
    if getattr(args, "record_review", None):
        try:
            summary = record_review(project, args.record_review, args.component)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
        return 0 if summary["ok"] else 1
    if getattr(args, "record_unlock", None):
        try:
            unlock = record_unlock(project, args.record_unlock, args.component)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(unlock, sort_keys=True) if args.json else
              "make_round: %s unlocked by assembly r%04d: %s" % (args.component, unlock["assembly_round"], unlock["reason"]))
        return 0
    if args.full:
        print("make_round: --full requires --record-visual after inspection and independent blind review", file=sys.stderr)
        return 2
    roots = skills_root()
    if roots is None:
        print("make_round: cannot locate the cad and image-to-cad skills", file=sys.stderr)
        return 2
    cad = roots / "cad" / "scripts"
    if getattr(args, "shared_helpers", False):
        (project / "measure").mkdir(exist_ok=True)
        return shared_helper_check(project, args, cad)
    if getattr(args, "interface", None):
        return interface_check(project, args.interface, args, cad)
    # An unreadable Wish fails the round through its sealed references.
    interfaces, _interface_error = contract_interfaces(project)
    freeze = read_freeze(project) if interfaces is not None else None
    if args.component and interfaces is not None and freeze is None:
        # ADR 0082: workers never build on untested Shared Helpers.
        print("make_round: the Shared Helpers are not frozen; the Workshop Manager runs make_round "
              "--shared-helpers on the samples under %s/ before any component round" % SAMPLES_DIR,
              file=sys.stderr)
        return 2
    python = sys.executable
    generators = sorted(project.glob("*.step.py"))
    all_parts = [g for g in generators if g.name.startswith("part_")]
    entries = [g for g in generators if not g.name.startswith("part_")]
    component = None
    display_pose = False
    delivered = None
    rulings = []
    if args.component:
        try:
            role, entry = component_role(project, args.component)
        except ValueError as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        component = role
        parts = [entry]
        display_pose = camera_contract(project)
        delivered = component_contract(project, role)
        try:
            # Issue #97: the Manager's rulings on this Component's Blocked
            # Reports bind its reviewer, so they travel in the packet.
            rulings = component_rulings(project, role)
        except (OSError, UnicodeError, ValueError) as exc:
            print("make_round: the Blocked Report ledger %s is invalid: %s" % (blocked_ledger(project), exc),
                  file=sys.stderr)
            return 2
        missing = place_hook_missing(entry) if display_pose else ""
        if missing:
            print("make_round: %s" % missing, file=sys.stderr)
            return 2
    elif args.entry:
        parts = all_parts
        entry = project / args.entry
    elif len(entries) == 1:
        parts = all_parts
        entry = entries[0]
    else:
        print("make_round: expected exactly one entry *.step.py (found %d); pass --entry" % len(entries), file=sys.stderr)
        return 2
    if getattr(args, "preview_assembly", False):
        return preview_assembly(project, entry, all_parts, cad)
    measure = project / "measure"
    measure.mkdir(exist_ok=True)
    try:
        state_path, round_root = state_and_round_root(project, args.component)
    except ValueError as exc:
        print("make_round: %s" % exc, file=sys.stderr)
        return 2
    state_path.parent.mkdir(parents=True, exist_ok=True)
    state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    previous_state = state
    policy = component_policy(state, round_root) if component is not None else None
    round_index = int(state.get("round", 0)) + 1
    out = Path(args.out) if args.out else round_root / ("r%04d" % round_index)
    if component is not None and out.exists():
        # A refused round left nothing; an earlier interrupted one is redone.
        shutil.rmtree(out)
    out.mkdir(parents=True, exist_ok=True)

    # A one-piece project exposes its buildable geometry through the entry.
    if not parts:
        parts = [entry]

    # 1. build every part once. Identity is the B-rep hash `gen --json` reports for
    # the shape it just built from source (ADR 0073); a part built from an
    # imported STEP, or reported by a tool too old to say, falls back to hashing
    # the exported STEP bytes so it still has an identity to compare next round.
    digests: dict[str, str] = {}
    build: dict[str, dict] = {}
    build_failures: dict[str, dict] = {}
    # A refused component round puts back the STEP it overwrote, so the
    # pending packet still shows what is on disk.
    built_step = entry.with_name(entry.name[:-len(".py")])
    earlier_step = built_step.read_bytes() if component is not None and built_step.is_file() else None
    for part in parts:
        role = part.name.removeprefix("part_").removesuffix(".step.py")
        step = part.with_name(part.name[:-len(".py")])
        done = run([python, str(cad / "gen"), str(part), "--write", "--json"], cwd=project, log=out / ("gen-%s.log" % role))
        parsed = parse_build(done.stdout, done.stderr, done.returncode)
        if parsed["verdict"] == "PASS" and not step.is_file():
            parsed = {"verdict": "FAIL", "failures": ["gen reported success but wrote no %s" % step.name]}
        if parsed["verdict"] == "FAIL":
            build_failures[role] = parsed
            continue
        identity = parse_identity(done.stdout)
        # Issue #102: a component round shows its source builds one B-rep.
        unreproduced = (reproduction_check(python, part, project, out, identity)
                        if component is not None and identity is not None else None)
        if unreproduced is not None:
            build_failures[role] = unreproduced
            continue
        digests[role] = identity or hashlib.sha256(step.read_bytes()).hexdigest()
    changed = diff_parts(state.get("parts", {}), digests) if not args.all_parts else sorted(digests)
    # The geometry this round scored: the Component's identity, or every
    # part's for the assembly. None when it did not build.
    if component is not None:
        round_identity = digests.get(component)
        helpers = imported_helpers(project, entry)
        locked_helpers = ((policy.get("reviewed") or {}).get("imported_helpers") or {})
        current_helpers = {**helpers, **{path: file_hash(project / path) if (project / path).is_file() else None
                                         for path in locked_helpers if path not in helpers}}
        rows_digest = contract_rows(project, component)
        admission = round_policy(policy, {"identity": round_identity, "helpers": current_helpers,
                                          "contract_rows": rows_digest})
        if not admission["admit"]:
            shutil.rmtree(out)
            if earlier_step is not None:
                built_step.write_bytes(earlier_step)
            elif built_step.is_file():
                built_step.unlink()
            print("make_round: %s" % admission["refusal"], file=sys.stderr)
            return 2
    else:
        round_identity = None if build_failures else hashlib.sha256(
            json.dumps(digests, sort_keys=True).encode()).hexdigest()

    # Spark can make assembly review contingent on current, passing isolated
    # component evidence. Comparing B-rep identity, not STEP bytes, catches
    # edits in the component file and in any shared helper it imports without
    # refusing a part the exporter merely serialized differently (ADR 0073).
    if args.require_component_passes:
        failures = []
        if not all_parts:
            failures.append("no part_<role>.step.py component sources exist")
        for part in all_parts:
            part_role = part.name[len("part_"):-len(".step.py")]
            _, reason = current_passing_component_round(project, part_role, digests.get(part_role))
            if reason:
                failures.append(reason)
        # ADR 0082: no assembly with a known or unproven Coupled Interface.
        failures += interface_failures(project, interfaces, digests)
        prerequisite_log = out / "component-prerequisites.log"
        if failures:
            prerequisite_log.write_text("\n".join(failures) + "\n", encoding="utf-8")
            print("make_round: assembled-object review requires current passing component rounds: %s" % "; ".join(failures), file=sys.stderr)
            return 1
        if prerequisite_log.is_file():
            prerequisite_log.unlink()

    # 2. record the build verdict for what moved.
    for role in changed:
        build[role] = {"verdict": "PASS", "failures": []}
    for role, parsed in build_failures.items():
        build[role] = parsed
        again = repeated_refusals((state.get("refusals") or {}).get(role), parsed)
        if again:
            parsed["repeated_refusals"] = again
        if role not in changed:
            changed.append(role)

    # 2b. gate the parts that built, from source. Reuse only a passing pair
    # measured from the same bytes under the same conditions: a failed or
    # legacy entry is re-measured even when its STEP did not change.
    context = print_context(cad, args.nozzle, args.overhang_angle)
    previous_print = state.get("print") or {}
    same_context = context is not None and context == state.get("print_context")
    printing: dict[str, dict] = {}
    for role in sorted(digests):
        prior = previous_print.get(role)
        if (
            not args.all_parts and role not in changed and same_context
            and reusable_print(prior)
        ):
            printing[role] = prior
            continue
        part = next(p for p in parts if p.name.removeprefix("part_").removesuffix(".step.py") == role)
        logs = {}
        gates = {}
        for gate, extra in (
            ("thickness", ["--nozzle", str(args.nozzle)]),
            ("overhang", ["--angle", str(args.overhang_angle)]),
        ):
            log = out / ("%s-%s.log" % (gate, role))
            done = run(
                [python, str(cad / ("check_" + gate)), str(part), *extra,
                 "--report", str(out / ("%s-%s.md" % (gate, role)))],
                cwd=project,
                log=log,
            )
            parsed = (parse_thickness if gate == "thickness" else parse_overhang)(done.stdout)
            if done.returncode == 3:
                parsed["verdict"] = "UNVERIFIED"
                parsed["failures"] = ["geometry analysis cancelled or its time allowance exhausted"]
            elif done.returncode == GATE_UNMEASURABLE:
                unmeasurable(parsed, done.stdout)
            elif done.returncode not in (0, 1):
                # 0 pass, 1 measured-and-failed; anything else is the tool
                # failing to measure, which is never a printability verdict.
                parsed["verdict"] = "FAIL"
                parsed["failures"] = (
                    ["check_%s exit %d: %s" % (gate, done.returncode, tail(done.stderr)[:60])]
                    + parsed["failures"]
                )[:4]
            gates[gate] = parsed
            if log.is_file():
                logs[str(log.resolve())] = hashlib.sha256(log.read_bytes()).hexdigest()
        verdicts = {g["verdict"] for g in gates.values()}
        printing[role] = {
            "verdict": next((v for v in ("FAIL", "UNMEASURABLE", "UNVERIFIED") if v in verdicts), "PASS"),
            "thickness": gates["thickness"],
            "overhang": gates["overhang"],
            "measured_round": round_index,
            "logs": logs,
        }
        repeated = repeated_defects(prior, printing[role])
        if repeated:
            printing[role]["repeated_defects"] = repeated
        if printing[role]["verdict"] in ("FAIL", "UNMEASURABLE") and role not in changed:
            changed.append(role)
    for role in build_failures:
        # A part that did not build has no solid to measure. Say that, rather
        # than reporting an absent gate as a pass.
        printing[role] = {
            "verdict": "FAIL",
            "thickness": {"verdict": "FAIL", "thinnest_mm": None, "failures": ["build failed"]},
            "overhang": {"verdict": "FAIL", "overhang_mm2": None, "failures": ["build failed"]},
            "measured_round": round_index,
            "logs": {},
        }

    # 2c. a separable Interface's Keep-out Envelope, checked on this
    # Component alone: either side repairs without touching the other (ADR 0082).
    envelopes = {}
    if component is not None and component in digests:
        envelopes = check_envelopes(project, component, entry, out, interfaces)

    # 3. the references this round shows its reader, each composed beside the
    # model at the reference's declared camera. Nothing is scored (ADR 0076).
    refs = parse_refs(args.refs, [] if component is not None else sorted(project.glob("*_spec.md")))
    if component is not None:
        refs, sealed, reference_errors = with_component_reference(project, component, refs)
    else:
        # ADR 0072: the Wish's sealed references are shown whether or not any
        # ledger names them. A component round shows only its own sealed image
        # and what it is explicitly given (ADR 0063, ADR 0074).
        refs, sealed, reference_errors = with_sealed_references(project, refs, digests)
    shown = []
    for label, ref in refs:
        if resolve_reference(ref, project) is None:
            reference_errors.append({"label": label, "error": "reference missing: %s" % ref})
        else:
            shown.append((label, ref))
    refs = shown

    # 4. motion gate when the project declares a manifest.
    motion = None
    manifest = measure / "motion.json"
    if component is None and manifest.is_file() and check_motion:
        done = run([python, str(cad / "check_motion"), str(project), "--manifest", str(manifest), "--json"], cwd=project, log=out / "motion.log")
        motion = parse_motion(done.stdout, done.returncode, done.stderr)
    full = None

    ok = (
        all(item["verdict"] == "PASS" for item in build.values())
        and all(item["verdict"] in ("PASS", "UNVERIFIED") for item in printing.values())
        and all(item["verdict"] == "PASS" for item in envelopes.values())
        and not reference_errors
        and (motion is None or motion["verdict"] in ("pass", "unverified"))
        and (full is None or full["ok"])
    )

    # The round policy (ADR 0081): whether this is a Shape Round, whether an
    # earlier review carries to it, and the lock it leaves.
    outcome = None
    if component is not None:
        key = carry_key(round_identity, refs, project, rows_digest, rulings)
        outcome = round_policy(policy, {"identity": round_identity, "helpers": current_helpers,
                                        "checks_ok": ok, "carry_key": key, "round": round_index,
                                        "contract_rows": rows_digest})

    # 5. Visual inspection is a separate evidence submission, not a model call.
    # A component round that failed its checks is not rendered: nobody reviews
    # it. One an earlier review carries to needs no new review.
    if component is not None and not ok:
        visual = {"status": "not-rendered", "findings": [],
                  "detail": "build and print checks failed; repair them first. Nothing was rendered"}
    elif outcome is not None and outcome["carried"] is not None:
        visual = {"status": "carried", "findings": [],
                  "detail": "the reviewed B-rep, references and contract rows of r%04d are unchanged"
                            % outcome["carried"]["round"]}
    else:
        visual = prepare_visual(project, entry, out, cad, refs, component,
                                display_pose=component is not None and display_pose, contract=delivered,
                                rulings=rulings)
    summary = {
        "round": round_index,
        "scope": "component:%s" % component if component is not None else "assembly",
        "project": str(project),
        "entry": entry.name,
        "parts": sorted(set(digests) | set(build_failures)),
        "changed": changed,
        "checked": sorted(build),
        "build": build,
        "print": printing,
        # Repeated Print Defects (issue #82): what run comparisons count.
        "repeated_print_defects": {role: item["repeated_defects"] for role, item in printing.items()
                                   if item.get("repeated_defects")},
        # Repeated Detail Refusals (issue #86), counted apart from print defects.
        "repeated_detail_refusals": {role: item["repeated_refusals"] for role, item in build.items()
                                     if item.get("repeated_refusals")},
        "reused": sorted(role for role in printing if printing[role].get("measured_round") != round_index),
        "nozzle": args.nozzle,
        "overhang_angle": args.overhang_angle,
        "reference_errors": reference_errors,
        "motion": motion,
        "check_motion": check_motion,
        "motion_status": (motion["verdict"] if motion is not None else "not-run"),
        "full": full,
        "checks_ok": ok,
        "visual": visual,
        "refs": refs,
        "sealed": sealed,
        "ok": False,
        "out": str(out),
    }
    if component is not None:
        next_policy = outcome["state"]
        carried = outcome["carried"]
        review = None
        if carried is not None:
            review = {**carried["review"], "carried_from": carried["round"]}
            if carried.get("acceptance"):
                summary["accepted"] = carried["acceptance"]
            if carried.get("reference_conflicts"):
                summary["reference_conflicts"] = carried["reference_conflicts"]
            if carried.get("ruling_disputes"):
                summary["ruling_disputes"] = carried["ruling_disputes"]
            summary["ok"] = next_policy["phase"] == LOCKED
        summary.update(
            review=review, shape_round=outcome["shape_round"],
            shape_rounds=next_policy["shape_rounds"], shape_rounds_used=next_policy["shape_rounds"],
            shape_limit=SHAPE_REPAIR_LIMIT, phase=next_policy["phase"], locked=lock_record(next_policy),
            unlock=outcome["unlocks"], imported_helpers=helpers, carry_key=key, contract_rows=rows_digest,
            worker_nonce=getattr(args, "worker_nonce", None),
            # Issue #98: the B-rep identity the Component Worker reports.
            identity=round_identity,
        )
        if envelopes:
            summary["envelopes"] = envelopes
        if display_pose:
            summary["reference_cameras"] = shown_cameras(project, refs)
        if delivered is not None:
            # ADR 0084: the worker reads its rows from the sealed contract.
            summary["contract"] = delivered
        if rulings:
            summary["rulings"] = rulings
        if freeze is not None:
            summary["helper_freeze"] = freeze_report(project, freeze, helpers)
        if ok:
            # Issue #88: a passing round wakes every Blocked Report waiting on it.
            woken = waking_reports(project, component)
            if woken:
                summary["wakes_blocked"] = woken
    if any(item["verdict"] == "UNVERIFIED" for item in printing.values()) or (motion and motion["verdict"] == "unverified"):
        summary["geometry_status"] = "unverified"
        summary["print_ready_claim"] = False
    (out / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    state = {
        "round": round_index,
        "scope": summary["scope"],
        "parts": digests,
        "print": printing,
        "print_context": context,
        "refusals": {role: refusal_keys(item) for role, item in build.items() if refusal_keys(item)},
        "identity": round_identity,
        "steps": {
            role: file_hash(part.with_name(part.name[:-len(".py")]))
            for part in parts
            for role in [part.name.removeprefix("part_").removesuffix(".step.py")]
            if role in digests and part.with_name(part.name[:-len(".py")]).is_file()
        },
        "checks_ok": ok,
        "last_out": str(out),
    }
    if component is not None:
        state.update(shape_rounds=next_policy["shape_rounds"], policy=next_policy)
        # The Component's reviewer binding outlives its rounds (issue #77).
        if previous_state.get("reviewer_id") is not None:
            state["reviewer_id"] = previous_state["reviewer_id"]
    state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
    # Pending or failed visual evidence cannot report a complete round; a
    # carried review can.
    return 0 if summary["ok"] else 1


# ---------------------------------------------------------------------------
# self-check: the pure parts, without CAD


def self_check() -> int:
    ok = True

    def check(hit, text):
        nonlocal ok
        print(("ok   " if hit else "FAIL ") + text)
        ok &= hit

    parsed = parse_build(
        '{"ok":false}\n',
        "Traceback (most recent call last):\n  File \"part_frame.step.py\", line 12\nValueError: wall must be positive\n",
        1,
    )
    check(parsed["verdict"] == "FAIL" and parsed["failures"][-1].startswith("ValueError"), "a failing build yields FAIL and the reason")
    check(parse_build('{"ok":true}\n', "", 0) == {"verdict": "PASS", "failures": []}, "a clean build yields PASS")
    check(parse_build("", "", 3)["failures"] == ["gen exit 3"], "a silent non-zero build still names its exit code")
    again = subprocess.CompletedProcess([], 0, '{"identitySha256": "a1"}\n', "")
    check(reproduction_failure("a1", again) is None, "a second build with the same identity reproduces")
    moved = reproduction_failure("a1", subprocess.CompletedProcess([], 0, '{"identitySha256": "b2"}\n', ""))
    check(moved is not None and moved["verdict"] == "FAIL" and moved["identities"] == ["a1", "b2"]
          and moved["failures"][0].startswith("not reproducible"), "a second build with another identity fails the build")
    refused = reproduction_failure("a1", subprocess.CompletedProcess([], 1, "", 'detail-refusal {"feature": "rivet", '
                                   '"site": "part_a.step.py:9", "reason": "r", "passes": "p"}\n'))
    check(refused is not None and "rivet at part_a.step.py:9" in refused["failures"][0],
          "a second build that refuses a detail fails the build and names it")
    thin = parse_thickness(
        "part_frame.step.py: 4.20 cm3 solid, grid 0.100 mm\n"
        "  FAIL  wall >= 0.80 mm (+/-0.10)        2.1% of surface below\n"
        "        1. [wall ] 0.42 mm at (1.0, 2.0, 3.0)  12 samples\n"
        "RESULT: WALL BELOW MINIMUM\n"
    )
    check(thin["verdict"] == "FAIL" and thin["thinnest_mm"] == 0.42, "a thin wall yields FAIL and the thinnest region")
    passing = parse_thickness(
        "part_frame.step.py: 4.20 cm3 solid\n"
        "  PASS  wall >= 0.80 mm (+/-0.10)        0.0% of surface below\n"
        "RESULT: printable at this wall\n"
    )
    check(passing["verdict"] == "PASS" and passing["failures"] == [], "a sound wall yields PASS")
    check(parse_thickness("")["verdict"] == "FAIL", "a silent thickness run is never a pass")
    over = parse_overhang(
        "part_frame.step.py: 13.8 cm2 of surface\n"
        "  FAIL  unsupported area                  473.9 mm2\n"
        "        1. [overhang] 473.9 mm2 at (0.0, 0.0, 6.0)  span 20.0 mm\n"
        "RESULT: NEEDS SUPPORT\n"
    )
    check(over["verdict"] == "FAIL" and over["overhang_mm2"] == 473.9, "an unsupported region yields FAIL and its area")
    bridged = parse_overhang(
        "part_frame.step.py: 13.8 cm2 of surface\n"
        "        1. [bridge  ] 192.3 mm2 at (0.0, 0.0, 6.0)  span 9.7 mm\n"
        "RESULT: prints unsupported\n"
    )
    check(
        bridged["verdict"] == "PASS" and bridged["overhang_mm2"] is None,
        "a spannable bridge is not an overhang failure",
    )
    check(parse_overhang("")["verdict"] == "FAIL", "a silent overhang run is never a pass")
    with tempfile.TemporaryDirectory() as tmp:
        log = Path(tmp) / "thickness-frame.log"
        log.write_text("RESULT: printable at this wall\n", encoding="utf-8")
        digest = hashlib.sha256(log.read_bytes()).hexdigest()
        record = {
            "verdict": "PASS", "measured_round": 2,
            "thickness": {"verdict": "PASS", "thinnest_mm": 1.2, "failures": []},
            "overhang": {"verdict": "PASS", "overhang_mm2": None, "failures": []},
            "logs": {str(log): digest},
        }
        check(reusable_print(record), "a passing pair with intact logs is reusable")
        check(not reusable_print({**record, "verdict": "FAIL"}), "a failed record is never reused")
        check(
            not reusable_print({**record, "overhang": {"verdict": "FAIL", "failures": []}}),
            "a pair is only reusable when both gates passed",
        )
        check(not reusable_print({**record, "logs": {}}), "a record without its tool log is not reused")
        log.write_text("tampered\n", encoding="utf-8")
        check(not reusable_print(record), "an edited tool log invalidates the record")
    check(diff_parts({}, {"a": "1", "b": "2"}) == ["a", "b"], "the first round checks every part")
    check(diff_parts({"a": "1", "b": "2"}, {"a": "1", "b": "3", "c": "4"}) == ["b", "c"], "later rounds check only changed or new parts")
    check(parse_refs(["hero=ref/hero.png", "side=/abs/side.png"], []) == [("hero", "ref/hero.png"), ("side", "/abs/side.png")], "--ref pairs parse")
    check(parse_refs(["hero=ref/hero.png@-60,20"], []) == [("hero", "ref/hero.png@-60,20")], "a declared camera stays on the reference, the form verify_project reads")
    check(split_camera("ref/hero.png@-60.5,20,15") == ("ref/hero.png", "-60.5,20,15") and split_camera("ref/hero@2x.png") == ("ref/hero@2x.png", None), "a camera splits off the path; an @ inside a file name is not one")
    for bad in ("hero=ref/hero.png@-60,20,90", "hero=ref/hero.png@0,95", "hero=ref/hero.png@front"):
        try:
            parse_refs([bad], [])
            check(False, "an unusable camera is refused before any render: %s" % bad)
        except ValueError:
            check(True, "an unusable camera is refused before any render: %s" % bad)
    check(reference_view("ref/hero.png@-60,20,15") == ("-60,20", "az-60_el20", "-60,20"), "a reference is compared at its declared camera, without the search tolerance")
    check(reference_view("ref/hero.png")[:2] == ("front", "front"), "a reference without a declared camera is compared from the front")
    with tempfile.TemporaryDirectory() as tmp:
        workspace = Path(tmp); project = workspace / "artifacts" / "make" / "r0001" / "product" / "goose"
        (project / "ref").mkdir(parents=True); (workspace / "WISH.json").write_text("{}", encoding="utf-8")
        (project / "ref" / "hero.jpg").write_bytes(b"x")
        check(resolve_reference("ref/hero.jpg", project) == project / "ref" / "hero.jpg", "a project-relative reference resolves")
        check(resolve_reference("artifacts/make/r0001/product/goose/ref/hero.jpg", project) == project / "ref" / "hero.jpg", "a workspace-relative reference resolves through WISH.json")
        check(resolve_reference("ref/missing.jpg", project) is None, "a missing reference stays missing")
        check(resolve_reference("ref/hero.jpg@-60,20", project) == project / "ref" / "hero.jpg", "a declared camera is not part of the path")
    with tempfile.TemporaryDirectory() as tmp:
        spec = Path(tmp) / "duck_spec.md"
        spec.write_text("# spec\n- `hero=ref/hero.png`\nfront=ref/front.png\nnot a ref line\n", encoding="utf-8")
        refs = parse_refs([], [spec])
        check([r[0] for r in refs] == ["hero", "front"] and refs[0][1].endswith("ref/hero.png"), "the spec ledger supplies references when --ref is absent")
    try:
        parse_refs(["nolabel"], [])
        check(False, "a malformed --ref is refused")
    except ValueError:
        check(True, "a malformed --ref is refused")
    with tempfile.TemporaryDirectory() as tmp:
        spec = Path(tmp) / "toy_spec.md"
        spec.write_text("| Label | Project-local reference | Minimum IoU |\n|---|---|---:|\n| <> | `ref/<file>` | 0.90 |\n| hero | `ref/hero.png` | 0.90 |\n", encoding="utf-8")
        check([r[0] for r in parse_refs([], [spec])] == ["hero"], "the template's Likeness handoff row is a ledger entry; its header and placeholder are not")
        spec.write_text("| Label | Project-local reference | Camera AZ,EL (±TOL) | Minimum IoU | Why |\n|---|---|---|---:|---|\n| <> | `ref/<file>` | <az>,<el> (±30) | 0.90 | <> |\n| hero | `ref/hero.png` | -60,20 (±15) | 0.90 | x |\n| side | `ref/side.png` | 0,0 | 0.90 | x |\n", encoding="utf-8")
        check([(r[0], r[1][len(str(spec.parent)) + 1:]) for r in parse_refs([], [spec])] == [("hero", "ref/hero.png@-60,20,15"), ("side", "ref/side.png@0,0")], "the handoff table's camera column travels with its reference")
    with tempfile.TemporaryDirectory() as tmp:
        run_dir = Path(tmp)
        project = run_dir / "artifacts" / "cad"
        project.mkdir(parents=True)
        check(sealed_references(project) == ([], None), "a project outside any run has no sealed reference")
        (run_dir / "wish-references").mkdir()
        (run_dir / "wish-references" / "ref-01-hero.png").write_bytes(b"hero")
        (run_dir / "wish-references" / "ref-02-side.png").write_bytes(b"side")
        (run_dir / "WISH.json").write_text(json.dumps({"references": [
            {"name": "ref-01-hero.png", "sha256": hashlib.sha256(b"hero").hexdigest()},
            {"name": "ref-02-side.png", "sha256": hashlib.sha256(b"other").hexdigest()},
            {"name": "ref-03-gone.png", "sha256": hashlib.sha256(b"gone").hexdigest()},
        ]}), encoding="utf-8")
        sealed, error = sealed_references(project)
        check(error is None and [s["label"] for s in sealed] == ["ref-01-hero", "ref-02-side", "ref-03-gone"], "a sealed reference is labelled by its file stem")
        (project / "ref").mkdir()
        (project / "ref" / "copy.png").write_bytes(b"hero")
        refs, report, errors = with_sealed_references(project, [("copy", "ref/copy.png")], {})
        check([label for label, _ in refs] == ["ref-01-hero"], "a ledger copy of a sealed image is shown once, under its sealed label")
        check(report == [{"label": "ref-01-hero", "scored_by": "assembly"}], "an uncovered sealed reference is shown to the assembly review")
        check([e["label"] for e in errors] == ["ref-02-side", "ref-03-gone"] and "sealed hash" in errors[0]["error"] and "missing" in errors[1]["error"], "a changed or missing sealed reference is an error, never a silent drop")
        refs, _, _ = with_sealed_references(project, [("copy", "ref/copy.png@-60,20")], {})
        check(refs == [("ref-01-hero", str(run_dir / "wish-references" / "ref-01-hero.png") + "@-60,20")], "a copy of a sealed image lends it the camera it declared")
        (run_dir / "WISH.json").write_text("{not json", encoding="utf-8")
        _, _, errors = with_sealed_references(project, [], {})
        check(len(errors) == 1 and "WISH.json unreadable" in errors[0]["error"], "an unreadable Wish fails the round instead of showing nothing")
    text = render_summary({
        "round": 1, "project": "/p", "parts": ["a"], "changed": ["a"], "checked": ["a"],
        "build": {"a": {"verdict": "PASS", "failures": []}},
        "reference_errors": [{"label": "geometry:body", "error": "no current component round passed its checks and independent review; run --component part_body.step.py"}],
        "sealed": [{"label": "geometry:body", "scored_by": "missing"}],
        "motion": None, "full": None, "ok": False, "out": "/p/measure/rounds/r0001",
    })
    check("seal  geometry:body" in text and "--component part_body.step.py" in text, "a sealed component image missing at assembly points at the component round")
    text = render_summary({
        "round": 6, "scope": "component:body", "project": "/p", "parts": ["body"], "changed": ["body"], "checked": ["body"],
        "build": {"body": {"verdict": "PASS", "failures": []}}, "reference_errors": [], "sealed": [],
        "motion": None, "full": None, "ok": True, "checks_ok": True, "out": "/p/measure/component-rounds/body/r0006",
        "shape_rounds": 5, "shape_limit": 5, "visual": {"status": "reviewed", "findings": [], "detail": "d"},
        "review": {"reviewer": "fresh-reviewer", "agrees": False, "reason": "arms thinner", "round": 6,
                   "differences": [{"feature": "arm", "reference": "thick", "model": "thin"}]},
        "accepted": {"reviewer": "fresh-reviewer", "reason": "arms thinner", "shape_rounds": 5},
    })
    check("shape 5/5" in text and "DISAGREES" in text and "differs arm" in text and "ACCEPTED at the shape-repair limit" in text,
          "a component accepted at the shape-repair limit says so with the reviewer's differences")
    awaiting = {"phase": AWAITING, "identity": "A", "round": 3, "shape_rounds": 1}
    check(not round_policy(awaiting, {"identity": "B"})["admit"] and round_policy(awaiting, {"identity": "A"})["admit"],
          "an unreviewed passing round refuses a geometry change and admits an unchanged rerun")
    disagreed = review_policy(awaiting, {"agrees": False, "identity": "A", "carry_key": "k", "imported_helpers": {}, "review": {}})
    first = round_policy(disagreed, {"identity": "B", "checks_ok": False, "round": 4})
    repair = round_policy(first["state"], {"identity": "C", "checks_ok": True, "round": 5})
    check(first["shape_round"] and not repair["shape_round"] and repair["state"]["shape_rounds"] == 2,
          "the first change after a disagreeing review is a shape round; the print repair after it is not")
    at_cap = review_policy({**awaiting, "shape_rounds": SHAPE_REPAIR_LIMIT},
                           {"agrees": False, "identity": "A", "carry_key": "k", "imported_helpers": {"h.py": "1"}, "review": {}})
    check(at_cap["phase"] == LOCKED and at_cap["reviewed"]["accepted"], "a disagreeing review at the cap is an accepted lock")
    check(not round_policy(at_cap, {"identity": "B", "helpers": {"h.py": "1"}})["admit"], "a locked Component refuses a change")
    carried = round_policy(at_cap, {"identity": "A", "helpers": {"h.py": "2"}, "checks_ok": True, "carry_key": "k", "round": 4})
    check(carried["carried"] is not None and carried["state"]["phase"] == LOCKED,
          "a Shared Helper change unlocks; the same B-rep carries the acceptance and relocks")
    def refused(state, reviewer, runtime):
        try:
            reviewer_binding(state, reviewer, runtime)
        except ValueError:
            return True
        return False
    check(refused({}, "fresh-reviewer", "claude") and reviewer_binding({}, "fresh-reviewer", "") is None,
          "on Claude Code a reviewer is a native agent id; elsewhere it stays a name")
    check(parse_envelope("not json", 1)["verdict"] == "FAIL"
          and parse_envelope('{"ok": true, "poses": [], "detail": "1 pose(s)"}', 1)["verdict"] == "FAIL"
          and parse_envelope('{"ok": true, "poses": [], "detail": "1 pose(s)"}', 0)["verdict"] == "PASS",
          "a Keep-out Envelope passes only on a complete passing result")
    check(separable_roles([{"id": "s", "kind": "separable", "envelope": {"inside": "arm", "outside": "body"}},
                           {"id": "c", "kind": "coupled", "components": ["arm", "body"]}], "body")
          == [({"id": "s", "kind": "separable", "envelope": {"inside": "arm", "outside": "body"}}, "outside", "body")],
          "a Component keeps the envelope of each separable Interface it joins, on its own side")
    check([side for _item, side, _reference in separable_roles(
              [{"id": "f", "kind": "separable", "envelope": {"inside": "wing#2", "outside": "wing#1"}}], "wing")]
          == ["inside", "outside"] and reference_roles(["wing#1", "wing#2", "body"]) == ["wing", "body"],
          "instances of one geometry on both sides of an envelope are both checked in its round")
    check(reviewer_binding({}, "a1f355b61d99918ed", "claude") == "a1f355b61d99918ed"
          and refused({"reviewer_id": "a1f355b61d99918ed"}, "a7740f58e37677176", "claude"),
          "a Component's first reviewer id binds it; another id is refused")
    with tempfile.TemporaryDirectory() as tmp:
        project = Path(tmp)
        (project / "measure").mkdir()
        events = [
            {"event": "report", "report": 1, "at": "t1", "component": "legs", "round": 5, "rows": ["R18"],
             "reason": "the review asks for a shield over open space"},
            {"event": "decision", "report": 1, "at": "t2", "ruling": "keep the arch struts",
             "waits_on": None, "waits_on_round": None},
            {"event": "report", "report": 2, "at": "t3", "component": "legs", "round": 6, "rows": ["R18"],
             "reason": "still open"},
            {"event": "report", "report": 3, "at": "t4", "component": "wing", "round": 2, "rows": ["R26"],
             "reason": "another Component"},
            {"event": "decision", "report": 3, "at": "t5", "ruling": "keep the table",
             "waits_on": None, "waits_on_round": None},
        ]
        blocked_ledger(project).write_text("".join(json.dumps(e) + "\n" for e in events), encoding="utf-8")
        check([item["report"] for item in component_rulings(project, "legs")] == [1]
              and component_rulings(project, "legs")[0]["ruling"] == "keep the arch struts",
              "a Component's packet carries only its own decided Blocked Report rulings")
        check(carry_key("a", [], project, "rows", []) == carry_key("a", [], project, "rows")
              != carry_key("a", [], project, "rows", component_rulings(project, "legs")),
              "a ruling is part of what a review judged; without one the key is unchanged")
    summary = {
        "round": 3, "scope": "assembly", "project": "/p/cad", "parts": ["frame", "knob", "lens"], "changed": ["frame"], "checked": ["frame"],
        "build": {"frame": {"verdict": "PASS", "failures": []}},
        "print": {"frame": {
            "verdict": "FAIL",
            "thickness": {"verdict": "FAIL", "thinnest_mm": 0.42, "failures": ["wall >= 0.80 mm"]},
            "overhang": {"verdict": "PASS", "overhang_mm2": None, "failures": []},
        }},
        "reused": ["knob"],
        "reference_errors": [],
        "motion": {"verdict": "pass", "detail": "47 conditions"}, "full": None, "ok": False, "out": "/p/cad/measure/rounds/r0003",
    }
    text = render_summary(summary)
    check("build PASS frame" in text and "skip 2 unchanged" in text and text.splitlines()[-1].startswith("  FAIL"), "the summary names the changed part and the verdict")
    check("wall  FAIL" in text and "thinnest 0.42 mm" in text, "a failing wall gate reaches the summary with its measurement")
    check("over  PASS" in text, "the overhang gate reports beside the wall gate")
    check("(retained PASS evidence)" in text, "reused gate evidence is named rather than implied")
    check(len(text.splitlines()) <= 10, "the summary stays short")
    print("\nall fixtures pass" if ok else "\nself-check FAILED")
    return 0 if ok else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("project", nargs="?", help="the cad directory holding *.step.py sources")
    parser.add_argument("--entry", help="entry generator name when more than one non-part *.step.py exists")
    parser.add_argument("--component", help="review one isolated part_<role>.step.py using its own round history")
    parser.add_argument("--require-component-passes", action="store_true", help="before assembly review, require current passing isolated rounds for every part")
    parser.add_argument("--ref", dest="refs", action="append", metavar="LABEL=PATH[@AZ,EL[,TOL]]", help="reference view and the camera it was taken from; repeatable; default from the spec ledger. The model is rendered beside it at that camera, else from the front. The Wish's sealed references are always shown at assembly scope; a --ref that copies one lends it its camera")
    parser.add_argument("--preview-assembly", action="store_true", help="render the assembled object's review sheet once, before components pass; evidence only, never a round or a pass")
    parser.add_argument("--nozzle", type=float, default=0.4, help="nozzle diameter for the wall gate (default 0.4 mm)")
    parser.add_argument("--overhang-angle", type=float, default=45.0, help="slope from vertical the printer bridges unsupported (default 45 deg)")
    parser.add_argument("--all-parts", action="store_true", help="report every built part, not only the changed ones")
    parser.add_argument("--check-motion", type=motion_policy()["boolean"], default=None,
                        metavar="true|false", help="enable motion checks (default: false, or frozen Make option)")
    parser.add_argument("--no-motion", action="store_true", help="skip check_motion even when measure/motion.json exists")
    parser.add_argument("--record-visual", help="record native Manager feedback for the last assembly round without rebuilding")
    parser.add_argument("--record-review", metavar="REVIEW.json", help="with --component: record an independent reviewer's judgement of the latest round without rebuilding")
    parser.add_argument("--record-unlock", metavar="UNLOCK.json", help="with --component: record that an assembly round's recorded finding requires a change to this locked Component, as {assembly_round, finding, reason}; builds nothing")
    parser.add_argument("--shared-helpers", action="store_true", help="Workshop Manager: build the samples under samples/, run the print gates on them, and freeze the Shared Helpers on a pass (ADR 0082)")
    parser.add_argument("--interface", metavar="ID", help="Workshop Manager: run the coupled motion check of one sealed Coupled Interface on its locked Components (ADR 0082)")
    parser.add_argument("--report-blocked", metavar="BLOCKED.json", help="Component Worker, with --component: record a Blocked Report, {rows, reason}, quoting the contract rows verbatim; builds nothing (issue #88)")
    parser.add_argument("--clear-blocked", metavar="ANSWER.json", help="Workshop Manager: answer one open Blocked Report, {report, decision[, waits_on]}, {report, need} or {report, amendment}")
    parser.add_argument("--blocked-reports", action="store_true", help="list every Blocked Report and its answers; exit 1 while one is open")
    parser.add_argument("--propose-amendment", metavar="PROPOSAL.json", help="Workshop Manager: propose a Contract Amendment, {rows, changes: [{from, to}], reason[, report]}, for a fresh contract-reviewer to confirm; builds nothing (ADR 0085)")
    parser.add_argument("--record-amendment-review", metavar="REVIEW.json", help="Workshop Manager: record the contract-reviewer's verdict on the pending amendment; it applies only if the reviewer confirmed all three")
    parser.add_argument("--contract-amendments", action="store_true", help="list every Contract Amendment and its review; exit 1 while one awaits review")
    parser.add_argument("--full", action="store_true", help="with --record-visual: run final verifier after the independent blind review")
    parser.add_argument("--out", help="round directory (default measure/rounds/rNNNN)")
    parser.add_argument("--json", action="store_true", help="print the summary as one JSON line")
    parser.add_argument("--worker-nonce", help=argparse.SUPPRESS)  # issued by the Workshop guard hook only
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)
    if args.self_check:
        return self_check()
    if not args.project:
        parser.error("project is required")
    if args.component and args.require_component_passes:
        parser.error("--component and --require-component-passes are mutually exclusive")
    if args.preview_assembly and (args.component or args.require_component_passes or args.record_visual
                                  or args.record_review or args.record_unlock or args.shared_helpers
                                  or args.interface or args.report_blocked or args.clear_blocked
                                  or args.blocked_reports or args.propose_amendment
                                  or args.record_amendment_review or args.contract_amendments
                                  or args.full or args.refs or args.out):
        parser.error("--preview-assembly takes only the project and --entry")
    if args.component and args.entry:
        parser.error("--component and --entry are mutually exclusive")
    if args.component and args.out:
        parser.error("--out is not supported for canonical component round evidence")
    if args.record_review and not args.component:
        parser.error("--record-review requires --component; the assembly is reviewed with --record-visual")
    if args.record_review and (args.record_visual or args.full):
        parser.error("--record-review cannot be combined with --record-visual or --full")
    if args.component and args.record_visual:
        parser.error("a component round is judged by an independent reviewer: use --record-review")
    if args.record_unlock and not args.component:
        parser.error("--record-unlock requires --component")
    if args.record_unlock and (args.record_review or args.record_visual or args.full):
        parser.error("--record-unlock cannot be combined with --record-review, --record-visual or --full")
    blocked_modes = [flag for flag, value in (("--report-blocked", args.report_blocked),
                                               ("--clear-blocked", args.clear_blocked),
                                               ("--blocked-reports", args.blocked_reports),
                                               ("--propose-amendment", args.propose_amendment),
                                               ("--record-amendment-review", args.record_amendment_review),
                                               ("--contract-amendments", args.contract_amendments)) if value]
    if blocked_modes:
        if len(blocked_modes) > 1:
            parser.error("%s are separate records" % " and ".join(blocked_modes))
        if (args.entry or args.require_component_passes or args.record_visual or args.record_review
                or args.record_unlock or args.full or args.out or args.refs or args.shared_helpers
                or args.interface or args.worker_nonce):
            parser.error("%s builds nothing and takes no round options" % blocked_modes[0])
        if args.report_blocked and not args.component:
            parser.error("--report-blocked requires --component")
        if not args.report_blocked and args.component:
            parser.error("%s takes no --component" % blocked_modes[0])
    if args.shared_helpers or args.interface:
        if args.shared_helpers and args.interface:
            parser.error("--shared-helpers and --interface are separate checks")
        if (args.component or args.entry or args.require_component_passes or args.record_visual
                or args.record_review or args.record_unlock or args.full or args.out or args.refs):
            parser.error("--shared-helpers and --interface take no component, assembly or record options")
    if args.worker_nonce is not None:
        if not args.component or args.record_review or args.record_unlock:
            parser.error("--worker-nonce belongs only to a component build round")
        if not re.fullmatch(r"[0-9a-f]{32}", args.worker_nonce):
            parser.error("--worker-nonce is invalid")
    return make_round(args)


if __name__ == "__main__":
    sys.exit(main())
