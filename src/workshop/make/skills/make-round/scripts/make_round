    ("packet_sha256", "status", "findings", "observation", "matches_plan", "matches_reference"))
# A packet binds the sheet alone: it holds every rendered view, so a reader
# whose reads the host checks opens one image per round, not ten. The single
# views stay on disk beside it.
# What the Manager is told to do with a pending assembly packet. Kept short:
# it is printed in every round summary.
VISUAL_REVIEW_STEPS = (
    "The build and gates are not a form verdict. Open sheet.png and judge in order: "
    "silhouette, stance and shape language first, then proportion between parts, then "
    "whether surface detail reads at render scale. Judge against the plan (WISH-EXPANSION.md, the sealed "
    "concept or the Design Contract) and, separately, against the reference images when "
    "the round has any. Name a defect whenever the render falls short: round or boxy "
    "massing where the form should be sculpted, a shape language the plan did not ask "
    "for, a silhouette that reads as a different "
    "object, relief too shallow to see, a part that lost its shape. Reporting a real "
    "defect is the intended outcome, not a failure. Record matches_plan, matches_reference "
    "(null without references), findings and observation with --record-visual."
)
# What a Component Reviewer is told to do first with a pending component packet.
COMPONENT_REVIEW_STEPS = (
    "; it opens sheet.png first and judges silhouette, stance and shape language, then proportion, then "
    "whether surface detail reads at render scale, and records matches_plan (against the Component's contract "
    "rows or the plan it was given) and matches_reference (null without a reference image) beside agrees"
)
# On a runtime that proves who reviewed (issue #77), a review names its
# Component Reviewer by the native agent id the runtime returned when it was
# spawned, and a Component's first review binds that id. The Workshop host
# sets the runtime; without one a review keeps the free-text reviewer name.
REVIEWER_RUNTIME_ENV = "WORKSHOP_REVIEWER_RUNTIME"
REVIEWER_ID_FORMATS = {"claude": (re.compile(r"[0-9a-f]{17}"), "17 lowercase hex characters")}
_GEOMETRY_DEADLINES = {}
