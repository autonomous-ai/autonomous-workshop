#!/usr/bin/env python3
"""One Make iteration: build, print gates, motion, comparison images, review.

    make_round <project>/cad [--component part_<role>.step.py]
               [--require-component-passes] [--ref LABEL=PATH[@AZ,EL[,TOL]] ...]
               [--nozzle 0.4] [--overhang-angle 45] [--all-parts] [--no-motion]
               [--full] [--out DIR] [--json] [--record-visual FEEDBACK.json]
               [--record-review REVIEW.json] [--self-check]

Every verdict comes from the original cad tools, run unchanged; this script
only sequences them, remembers what changed between rounds, and prints a
summary short enough to read instead of the logs. It never lowers a threshold
or edits source. No silhouette score is computed: every reference is composed
beside the model, rendered at the camera the reference declares, and a reader
compares their form (ADR 0076).

An assembly round shows every reference the Wish sealed, unless a current
component round already showed it; it never passes on an empty reference list
when the Wish has references. In Contract Mode a component round shows the
sealed image of its own Unique Geometry, and the assembly never shows that
image against the whole object.

A component round passes on build, print gates and an independent reviewer's
recorded agreement (--record-review). A round that changes the geometry of a
component whose previous round passed its checks is a shape round; after
SHAPE_REPAIR_LIMIT of them a disagreeing review is recorded as a component
acceptance the run reports when it ends. The assembly round keeps the
Workshop Manager's --record-visual, the blind review and --full.
This tool makes no model calls.

Exit 0: all checks and the recorded review passed. Exit 1: failed or pending.
Exit 2: the round could not run.
"""

from __future__ import annotations

import argparse
import hashlib
from importlib.metadata import PackageNotFoundError, version as package_version
import json
import os
import re
import signal
import runpy
import subprocess
import sys
import tempfile
import time
from pathlib import Path

STATE_NAME = "make-round-state.json"
ROUNDS_DIR = "rounds"
COMPONENT_ROUNDS_DIR = "component-rounds"
TOOL_TIMEOUT_SECONDS = 900
FULL_TIMEOUT_SECONDS = 1800
MAX_TAIL_CHARS = 600
# A component gets this many shape rounds before a disagreeing review becomes
# a recorded component acceptance instead of another repair (ADR 0076).
SHAPE_REPAIR_LIMIT = 5
GEOMETRY_LABEL = "geometry:"
MAX_REASON = 1000
MAX_DIFFERENCES = 12
# An observation that repeats the previous round's at least this long was
# copied, not made (ADR 0075).
COPIED_OBSERVATION_CHARS = 40
COMPARISON_HEIGHT = 480
# Names that identify the Workshop Manager; a component review must come from
# someone else (ADR 0075, ADR 0076).
MANAGER_NAMES = frozenset({"workshop-manager", "manager", "workshop manager"})
_GEOMETRY_DEADLINES = {}


def file_hash(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def other_component_file(name: str, role: str | None) -> bool:
    """Whether ``name`` is another Component's own source or STEP.

    Component Workers repair Components in parallel (ADR 0077), so a component
    round binds its own source and every shared file, never a sibling's.
    """

    if role is None or not name.startswith("part_"):
        return False
    for suffix in (".step.py", ".step", ".stp"):
        if name.endswith(suffix):
            return name[len("part_"):-len(suffix)] != role
    return False


def source_hashes(project, role=None):
    """Bind helpers and design constraints as well as entry generators; a
    component round (``role``) leaves out other Components' own files."""
    return {
        p.relative_to(project).as_posix(): file_hash(p)
        for p in sorted(project.rglob("*"))
        if p.is_file() and p.suffix in (".py", ".md", ".json", ".step", ".stp")
        and not other_component_file(p.name, role)
        and not any(v in ("rounds", "__cadgen__", "__pycache__", ".git", ".venv")
                    for v in p.relative_to(project).parts)
        and (p.suffix in (".py", ".step", ".stp") or not any(
            v in ("measure", "snap", "review") for v in p.relative_to(project).parts))
    }


def compose_comparison(reference: Path, render: Path, out_path: Path, caption: str) -> None:
    """The reference beside the model at the reference's camera, both scaled to
    one height, so a thinner limb, a blockier body or a missing opening shows
    as a difference of form (ADR 0075)."""

    from PIL import Image, ImageDraw

    panels = []
    for path in (reference, render):
        image = Image.open(path)
        image.load()
        flat = Image.new("RGBA", image.size, (255, 255, 255, 255))
        flat.alpha_composite(image.convert("RGBA"))
        width = max(1, round(flat.width * COMPARISON_HEIGHT / flat.height))
        panels.append(flat.convert("RGB").resize((width, COMPARISON_HEIGHT)))
    gap, header = 16, 24
    canvas = Image.new("RGB", (sum(p.width for p in panels) + gap, COMPARISON_HEIGHT + header), "white")
    canvas.paste(panels[0], (0, header))
    canvas.paste(panels[1], (panels[0].width + gap, header))
    ImageDraw.Draw(canvas).text((4, 4), caption, fill="black")
    canvas.save(out_path)


def reference_view(ref: str) -> tuple[str, str, str]:
    """``(render_review --view value, output stem, caption camera)`` for one
    reference: its declared ``@AZ,EL`` camera, else the front view. A declared
    tolerance only mattered to the removed pose search."""

    camera = split_camera(ref)[1]
    if camera is None:
        return "front", "front", "front (no declared camera)"
    az, el = (float(v) for v in camera.split(",")[:2])
    # render_review names an AZ,EL view az{:g}_el{:g}.
    return "%g,%g" % (az, el), "az%g_el%g" % (az, el), "%g,%g" % (az, el)


def prepare_comparisons(project, out, refs):
    """``(comparisons, error)``: one composed image per shown reference."""

    views = out / "visual"
    comparisons = {}
    for index, (label, ref) in enumerate(refs):
        reference = resolve_reference(ref, project)
        _view, stem, caption_camera = reference_view(ref)
        render = views / (stem + ".png")
        if reference is None or not render.is_file():
            return {}, "no model render at the declared camera for %s" % label
        target = views / ("compare-%02d.png" % index)
        caption = "%s  reference | model at declared camera %s" % (label, caption_camera)
        try:
            compose_comparison(reference, render, target, caption)
        except Exception as exc:  # noqa: BLE001 - any unreadable image leaves no evidence
            return {}, "could not compose the comparison for %s: %s" % (label, exc)
        comparisons[str(target.resolve())] = {"label": label, "sha256": file_hash(target)}
    return comparisons, None


def prepare_visual(project, entry, out, cad, refs, component=None):
    """Render evidence for native inspection; never infer a visual verdict.
    ``component`` is the role of a component round, else None."""
    before = source_hashes(project, component)
    views = out / "visual"
    command = [sys.executable, str(cad / "render_review"), str(entry),
               "--view", "front", "--view", "top", "--view", "iso"]
    for view in dict.fromkeys(reference_view(ref)[0] for _label, ref in refs):
        if view not in ("front", "top", "iso"):
            # the = form: argparse reads a leading "-" as a new option
            command.append("--view=%s" % view)
    done = run(command + ["-o", str(views)], cwd=project, log=out / "visual-render.log")
    paths = [views / (v + ".png") for v in ("front", "top", "iso")]
    if done.returncode or not all(p.is_file() for p in paths) or before != source_hashes(project, component):
        return {"status": "error", "findings": [], "detail": "Visual render failed or source changed; inspect visual-render.log"}
    comparisons, error = prepare_comparisons(project, out, refs)
    if error is not None:
        return {"status": "error", "findings": [], "detail": error}
    references = {}
    for label, ref in refs:
        path = resolve_reference(ref, project)
        if path is not None:
            references[str(path.resolve())] = file_hash(path)
    packet = {"schema_version": 3, "sources": before,
              "images": {str(p.resolve()): file_hash(p) for p in paths},
              "references": references,
              "comparisons": comparisons}
    packet_path = out / "visual-packet.json"
    packet_path.write_text(json.dumps(packet, sort_keys=True, indent=2) + "\n", encoding="utf-8")
    if component:
        detail = ("An independent reviewer (not the Workshop Manager) compares each reference with the model "
                  "beside it and all views; record the review with --record-review <review.json>")
    else:
        detail = "Manager must inspect all views for placement, proportions, missing/extra parts and visible intersections"
        if comparisons:
            detail += "; compare each reference with the model beside it and list every difference of form"
    return {"status": "pending", "findings": [], "packet": str(packet_path),
            "packet_sha256": file_hash(packet_path), "detail": detail}


def component_role(project: Path, value: str) -> tuple[str, Path]:
    """Resolve one canonical component source without accepting path traversal."""
    name = Path(value).name
    if value != name or not name.startswith("part_") or not name.endswith(".step.py"):
        raise ValueError("--component must name one part_<role>.step.py in the CAD project")
    role = name[len("part_"):-len(".step.py")]
    if not role or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", role):
        raise ValueError("--component has an invalid role")
    source = project / name
    if not source.is_file():
        raise ValueError("component source does not exist: %s" % name)
    return role, source


def state_and_round_root(project: Path, component: str | None) -> tuple[Path, Path]:
    measure = project / "measure"
    if component is None:
        return measure / STATE_NAME, measure / ROUNDS_DIR
    role, _ = component_role(project, component)
    root = measure / COMPONENT_ROUNDS_DIR / role
    return root / STATE_NAME, root


def packet_error(visual: dict, project: Path, role: str | None = None) -> str | None:
    """Why a round's visual packet no longer shows the current evidence, or
    None. ``role`` names a component round's Component."""

    packet_path = Path(visual["packet"])
    if file_hash(packet_path) != visual["packet_sha256"]:
        return "visual packet changed"
    packet = json.loads(packet_path.read_text())
    if packet["sources"] != source_hashes(project, role):
        return "stale CAD sources or design constraints"
    comparisons = packet.get("comparisons") or {}
    bound = {**packet["images"], **packet["references"],
             **{path: item["sha256"] for path, item in comparisons.items()}}
    for path, digest in bound.items():
        if not Path(path).is_file() or file_hash(path) != digest:
            return "stale images or references"
    return None


def record_visual(project, feedback_path, full=False, component=None, check_motion=None):
    """Attach native observations to the last assembly round without rebuilding it."""
    if component is not None:
        raise ValueError("a component round is judged by an independent reviewer: use --record-review")
    state_path, _ = state_and_round_root(project, None)
    state = json.loads(state_path.read_text())
    out = Path(state["last_out"])
    summary_path = out / "summary.json"
    summary = json.loads(summary_path.read_text())
    visual = summary["visual"]
    if visual["status"] != "pending":
        raise ValueError("visual feedback is only accepted once for a pending round")
    stale = packet_error(visual, project)
    if stale is not None:
        raise ValueError("visual packet changed" if stale == "visual packet changed" else "visual feedback has %s" % stale)
    feedback = json.loads(Path(feedback_path).read_text())
    required = {"packet_sha256", "status", "findings", "observation"}
    if not required <= set(feedback) or not set(feedback) <= required | {"differences"}:
        raise ValueError("invalid visual feedback fields")
    if feedback["packet_sha256"] != visual["packet_sha256"]:
        raise ValueError("visual feedback belongs to a different round")
    if feedback["status"] not in ("pass", "fail", "inconclusive"):
        raise ValueError("invalid visual feedback status")
    findings = feedback["findings"]
    if not isinstance(findings, list) or len(findings) > 12:
        raise ValueError("visual feedback needs at most 12 findings")
    for item in findings:
        if not isinstance(item, dict) or set(item) != {"part", "defect", "evidence", "repair"}:
            raise ValueError("visual findings need part, defect, evidence and repair")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("visual finding text must be nonempty and bounded")
    if (feedback["status"] == "pass" and findings) or (feedback["status"] == "fail" and not findings):
        raise ValueError("visual status contradicts findings")
    if not isinstance(feedback["observation"], str) or not 1 <= len(feedback["observation"].strip()) <= 2000:
        raise ValueError("visual feedback needs a bounded observation, including uncertainty")
    check_differences(feedback)
    previous = previous_observation(out, summary)
    if previous is not None and " ".join(previous.split()) in " ".join(feedback["observation"].split()):
        raise ValueError("visual feedback repeats the previous round's observation; inspect this round's images")
    visual.update(feedback)
    summary["ok"] = summary["checks_ok"] and feedback["status"] == "pass"
    if full:
        if not summary["ok"]:
            raise ValueError("final verification requires a clean round and visual pass")
        cad = skills_root() / "cad" / "scripts"
        # The final verifier independently requires the separate blind review.
        command = [sys.executable, str(cad / "verify_project"), str(project),
                   "--strict-fit", "--print-gates", "--nozzle", str(summary.get("nozzle", 0.4)),
                   "--report", str(project / "measure/verification-pipeline.md")]
        motion_option = summary.get("check_motion") if check_motion is None else check_motion
        if motion_option is not None:
            command += ["--check-motion", str(motion_option).lower()]
        if summary["refs"] or summary.get("sealed"):
            command.append("--image-derived")
        done = run(command, cwd=project, log=out / "verify.log", timeout=FULL_TIMEOUT_SECONDS)
        summary["full"] = {"ok": done.returncode == 0, "returncode": done.returncode, "tail": tail(done.stdout or done.stderr)}
        summary["ok"] = done.returncode == 0
        report = project / "measure/geometry-inspection.json"
        if report.is_file() and json.loads(report.read_bytes()).get("status") == "unverified":
            summary["geometry_status"] = "unverified"
            summary["print_ready_claim"] = False
            summary["full"]["status"] = "unverified"
    (out / "visual-feedback.json").write_text(json.dumps(feedback, sort_keys=True, indent=2) + "\n")
    summary_path.write_text(json.dumps(summary, sort_keys=True, indent=1) + "\n")
    return summary


def check_differences(feedback: dict) -> None:
    """Differences from a reference are named, and one still to repair cannot
    pass (ADR 0075)."""

    differences = feedback.get("differences", [])
    if not isinstance(differences, list) or len(differences) > MAX_DIFFERENCES:
        raise ValueError("visual feedback needs at most %d differences" % MAX_DIFFERENCES)
    for item in differences:
        if not isinstance(item, dict) or set(item) != {"feature", "reference", "model", "decision", "reason"}:
            raise ValueError("a difference needs feature, reference, model, decision and reason")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("difference text must be nonempty and bounded")
        if item["decision"] not in ("repair", "keep"):
            raise ValueError("a difference is either repaired or kept with a reason")
    if feedback["status"] == "pass" and any(item["decision"] == "repair" for item in differences):
        raise ValueError("a difference still to repair cannot pass")


def record_review(project: Path, review_path, component: str) -> dict:
    """Attach an independent reviewer's judgement to the latest component
    round without rebuilding it (ADR 0076).

    The reviewer saw the round's packet, so the packet, its images and the
    sources must be exactly what it saw. Agreement passes the component. A
    disagreement at the shape-repair limit is recorded as a component
    acceptance the run reports when it ends; before the limit it is the
    repair list for the next shape round.
    """

    role, source = component_role(project, component)
    state_path, round_root = state_and_round_root(project, component)
    state = json.loads(state_path.read_text())
    latest = state.get("round")
    if type(latest) is not int or latest < 1 or state.get("scope") != "component:%s" % role:
        raise ValueError("component round state is invalid")
    out = round_root / ("r%04d" % latest)
    summary_path = out / "summary.json"
    summary = json.loads(summary_path.read_text())
    if (
        summary.get("scope") != "component:%s" % role
        or summary.get("entry") != source.name
        or summary.get("parts") != [role]
    ):
        raise ValueError("component round summary is invalid")
    review = json.loads(Path(review_path).read_text(encoding="utf-8"))
    required = {"round", "packet_sha256", "reviewer", "agrees", "reason"}
    if not isinstance(review, dict) or not required <= set(review) or not set(review) <= required | {"differences"}:
        raise ValueError("a review needs round, packet_sha256, reviewer, agrees and reason, and optional differences")
    if type(review["round"]) is not int or review["round"] != latest:
        raise ValueError("a review must judge the latest round, r%04d" % latest)
    if summary.get("review") is not None:
        raise ValueError("r%04d already has a recorded review" % latest)
    if not summary.get("checks_ok"):
        raise ValueError("r%04d did not pass its build and print checks; repair them before review" % latest)
    visual = summary.get("visual") or {}
    if visual.get("status") != "pending" or not visual.get("packet"):
        raise ValueError("r%04d has no visual packet to review" % latest)
    if review["packet_sha256"] != visual["packet_sha256"]:
        raise ValueError("the review belongs to a different visual packet")
    stale = packet_error(visual, project, role)
    if stale is not None:
        raise ValueError("the reviewed round has %s" % stale if stale != "visual packet changed" else stale)
    reviewer = review["reviewer"]
    if not isinstance(reviewer, str) or not 1 <= len(reviewer.strip()) <= 200:
        raise ValueError("a review needs the reviewer's name")
    if reviewer.strip().lower() in MANAGER_NAMES:
        raise ValueError("the Workshop Manager cannot review its own component")
    if type(review["agrees"]) is not bool:
        raise ValueError("a review's agrees must be true or false")
    if not isinstance(review["reason"], str) or not 1 <= len(review["reason"].strip()) <= MAX_REASON:
        raise ValueError("a review needs a reason of 1 to %d characters" % MAX_REASON)
    differences = review.get("differences", [])
    if not isinstance(differences, list) or len(differences) > MAX_DIFFERENCES:
        raise ValueError("a review lists at most %d differences" % MAX_DIFFERENCES)
    for item in differences:
        if not isinstance(item, dict) or set(item) != {"feature", "reference", "model"}:
            raise ValueError("a difference needs feature, reference and model")
        if any(not isinstance(v, str) or not 1 <= len(v.strip()) <= 1000 for v in item.values()):
            raise ValueError("difference text must be nonempty and bounded")
    if not review["agrees"] and not differences:
        raise ValueError("a disagreeing review must list how the model differs from its reference")
    recorded = {
        "reviewer": reviewer.strip(), "agrees": review["agrees"], "reason": review["reason"].strip(),
        "round": latest, "differences": differences,
    }
    summary["review"] = recorded
    visual["status"] = "reviewed"
    shape_rounds = int(summary.get("shape_rounds", 0))
    if review["agrees"]:
        summary["ok"] = True
    elif shape_rounds >= SHAPE_REPAIR_LIMIT:
        summary["accepted"] = {"reviewer": recorded["reviewer"], "reason": recorded["reason"],
                               "shape_rounds": shape_rounds}
        summary["ok"] = True
    else:
        summary["ok"] = False
    (out / "review.json").write_text(json.dumps(review, sort_keys=True, indent=2) + "\n")
    summary_path.write_text(json.dumps(summary, sort_keys=True, indent=1) + "\n")
    return summary


def previous_observation(out: Path, summary: dict) -> str | None:
    """The previous round's recorded observation, when it is long enough that
    repeating it can only be a copy."""

    round_value = summary.get("round")
    if type(round_value) is not int or round_value < 2:
        return None
    try:
        earlier = json.loads((out.parent / ("r%04d" % (round_value - 1)) / "visual-feedback.json").read_text())
    except (OSError, ValueError):
        return None
    text = earlier.get("observation") if isinstance(earlier, dict) else None
    if not isinstance(text, str) or len(text.strip()) < COPIED_OBSERVATION_CHARS:
        return None
    return text


# ---------------------------------------------------------------------------
# locating the sibling skills


def skills_root() -> Path | None:
    """``.agents/skills`` in a run; the installed component roots in a checkout."""
    here = Path(__file__).resolve()
    candidate = here.parents[2]
    if (candidate / "cad" / "scripts").is_dir() and (candidate / "image-to-cad" / "scripts").is_dir():
        return candidate
    try:
        from workshop.runtime.package_data import product_run_domain_skill_roots
    except Exception:  # noqa: BLE001 - outside a Workshop install there is no fallback
        return None
    roots = product_run_domain_skill_roots()
    if "cad" in roots and "image-to-cad" in roots:
        return _RootsView(roots)
    return None


class _RootsView:
    """A mapping of skill name -> root that answers ``root / name`` like a Path."""

    def __init__(self, roots):
        self._roots = dict(roots)

    def __truediv__(self, name: str) -> Path:
        return Path(self._roots[name])


# ---------------------------------------------------------------------------
# pure helpers (self-checked without CAD)


def parse_build(stdout: str, stderr: str, returncode: int) -> dict:
    """The verdict and the reason from one part's `gen --write` run.

    Nothing here measures a wall: the toolchain writes STEP only and has no
    mesh, overhang or thickness gate, so a part that builds is *built*, never
    printable.
    """
    if returncode == 0:
        return {"verdict": "PASS", "failures": []}
    fails = []
    for line in (stderr or stdout).splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("{"):
            fails.append(stripped[:80])
    return {"verdict": "FAIL", "failures": fails[-4:] or ["gen exit %d" % returncode]}


def parse_identity(stdout: str) -> str | None:
    """A built part's B-rep hash from `gen --json`, when the tool reported one.

    `gen` emits `identitySha256` only for a shape it just built from a
    `gen_step()` source (ADR 0073: never for a shape reloaded from STEP).
    Absent for a component sourced by another cadgen build, an older cadgen
    without the field, or a mocked `run` in a test -- callers fall back to
    hashing the exported STEP bytes.
    """
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            payload = json.loads(line)
        except ValueError:
            continue
        value = payload.get("identitySha256") if isinstance(payload, dict) else None
        if isinstance(value, str) and value:
            return value
    return None


def parse_thickness(stdout: str) -> dict:
    """The verdict and the thinnest region from a check_thickness run."""
    verdict = "PASS" if "RESULT: printable at this wall" in stdout else "FAIL"
    fails = []
    wall_pass = False
    thinnest = None
    for line in stdout.splitlines():
        stripped = line.strip()
        if re.match(r"PASS\s+wall\s+>=", stripped):
            wall_pass = True
        if stripped.startswith("FAIL"):
            verdict = "FAIL"
            fails.append(" ".join(stripped.split()[1:])[:80])
        match = re.match(r"\d+\.\s+\[[a-z ]+\]\s+([0-9.]+) mm", stripped)
        if match:
            value = float(match.group(1))
            thinnest = value if thinnest is None else min(thinnest, value)
    if "RESULT: WALL BELOW MINIMUM" in stdout:
        verdict = "FAIL"
    if not fails and "RESULT: WALL BELOW MINIMUM" not in stdout and wall_pass:
        verdict = "PASS"
    if verdict == "FAIL" and not fails:
        fails.append("no passing wall result" if "RESULT: WALL BELOW MINIMUM" not in stdout else "wall below minimum")
    return {"verdict": verdict, "thinnest_mm": thinnest, "failures": fails[:4]}


def parse_overhang(stdout: str) -> dict:
    """The verdict and the largest unsupported region from a check_overhang run.

    A `bridge` is spannable and does not fail the gate; only an `overhang`
    does. The gate has already decided that, so read its RESULT rather than
    re-deciding here, and keep the region rows for the repair prompt.
    """
    verdict = "PASS" if "RESULT: prints unsupported" in stdout else "FAIL"
    fails = []
    largest = None
    for line in stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("FAIL"):
            verdict = "FAIL"
            fails.append(" ".join(stripped.split()[1:])[:80])
        match = re.match(r"\d+\.\s+\[([a-z ]+)\]\s+([0-9.]+) mm2", stripped)
        if match and match.group(1).strip() == "overhang":
            area = float(match.group(2))
            largest = area if largest is None else max(largest, area)
    if "RESULT: NEEDS SUPPORT" in stdout:
        verdict = "FAIL"
    if verdict == "FAIL" and not fails:
        fails.append("needs support" if "RESULT: NEEDS SUPPORT" in stdout else "no overhang result")
    return {"verdict": verdict, "overhang_mm2": largest, "failures": fails[:4]}


def print_context(cad: Path, nozzle: float, angle: float) -> dict | None:
    """Inputs to this print measurement, without importing numerical libraries.

    An unavailable identity disables reuse; it never supplies passing evidence.
    The wrapper hash also invalidates results after a parsing/cache-rule change,
    and `printlib.py` is in here because it owns the tessellation both gates
    measure -- a change to the deviation would change every verdict.
    """
    try:
        sources = {
            name: hashlib.sha256(path.read_bytes()).hexdigest()
            for name, path in (
                ("check_thickness", cad / "check_thickness"),
                ("check_overhang", cad / "check_overhang"),
                ("meshlib.py", cad / "meshlib.py"),
                ("printlib.py", cad / "printlib.py"),
                ("make_round", Path(__file__)),
            )
        }
        packages = {name: package_version(name) for name in ("numpy", "scipy")}
    except (OSError, PackageNotFoundError):
        return None
    return {
        "nozzle": nozzle, "overhang_angle": angle, "sources": sources,
        "packages": packages,
        "python": str(Path(sys.executable).resolve()), "python_version": sys.version,
        "platform": sys.platform,
    }


def reusable_print(item: dict | None) -> bool:
    """Only a recorded PASS of both gates, with its original tool logs, reuses."""
    if not isinstance(item, dict) or item.get("verdict") != "PASS":
        return False
    if not {"thickness", "overhang", "measured_round", "logs"} <= item.keys():
        return False
    if not isinstance(item["logs"], dict) or not item["logs"]:
        return False
    for path, digest in item["logs"].items():
        try:
            if hashlib.sha256(Path(path).read_bytes()).hexdigest() != digest:
                return False
        except (OSError, TypeError, ValueError):
            return False
    return all(
        isinstance(item.get(gate), dict) and item[gate].get("verdict") == "PASS"
        for gate in ("thickness", "overhang")
    )


def diff_parts(previous: dict, current: dict) -> list[str]:
    """Roles whose identity changed, or every role when nothing was recorded."""
    if not previous:
        return sorted(current)
    return sorted(role for role, digest in current.items() if previous.get(role) != digest)


LEDGER_LINE = re.compile(r"^\s*[-*]?\s*`?([A-Za-z][A-Za-z0-9_-]*)=(ref/[^`\s]+)`?\s*$")
# The Likeness handoff table in image-to-cad's build_spec.md template. A filled
# template produced no reference at all until this row was read too (ADR 0072).
LEDGER_ROW = re.compile(r"^\s*\|\s*([A-Za-z][A-Za-z0-9_-]*)\s*\|\s*`?(ref/[^`\s|]+)`?\s*\|")
# The template's camera column, `AZ,EL` optionally followed by `(±TOL)`.
LEDGER_CAMERA = re.compile(
    r"^\s*`?(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)`?\s*(?:\(\s*±\s*(\d+(?:\.\d+)?)\s*\))?\s*$"
)
# `@AZ,EL[,TOL]` after a reference path: where the image was taken from. It
# travels on the reference string, which is the form verify_project reads, and
# render_views gets it as --camera. Both own the rules; this only checks them
# early so a bad camera costs no render.
CAMERA_SUFFIX = re.compile(r"@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)(?:,(\d+(?:\.\d+)?))?$")


def split_camera(ref: str) -> tuple[str, str | None]:
    """``PATH[@AZ,EL[,TOL]]`` -> (path, camera text or None)."""
    match = CAMERA_SUFFIX.search(ref)
    if match is None:
        return ref, None
    return ref[:match.start()].strip(), ",".join(v for v in match.groups() if v is not None)


def checked_camera(ref: str) -> str:
    """The reference unchanged, or ValueError when its camera cannot be used."""
    if "@" not in ref:
        return ref
    _path, camera = split_camera(ref)
    if camera is None:
        raise ValueError("a reference camera must be @AZ,EL or @AZ,EL,TOL in degrees: %r" % (ref,))
    values = [float(v) for v in camera.split(",")]
    if not -90.0 <= values[1] <= 90.0:
        raise ValueError("reference camera elevation %g is outside -90..90: %r" % (values[1], ref))
    if len(values) == 3 and not 0.0 < values[2] < 90.0:
        raise ValueError("reference camera tolerance %g must be above 0 and below 90: %r" % (values[2], ref))
    return ref


def ledger_camera(line: str, match) -> str:
    """``@AZ,EL[,TOL]`` from a Likeness handoff row's camera column, or ""."""
    cells = line[match.end():].split("|")
    camera = LEDGER_CAMERA.match(cells[0]) if cells else None
    if camera is None:
        return ""
    return "@" + ",".join(v for v in camera.groups() if v is not None)


def parse_refs(values, spec_paths) -> list[tuple[str, str]]:
    """``LABEL=PATH[@AZ,EL[,TOL]]`` pairs from the command line, else from the
    spec's ledger. A declared camera stays on the path string."""
    refs = []
    for value in values or ():
        label, _, path = str(value).partition("=")
        if not label or not path:
            raise ValueError("--ref must be LABEL=PATH: %r" % (value,))
        refs.append((label.strip(), checked_camera(path.strip())))
    if refs:
        return refs
    for spec in spec_paths:
        for line in Path(spec).read_text(encoding="utf-8", errors="replace").splitlines():
            match = LEDGER_LINE.match(line)
            camera = ""
            if match is None:
                match = LEDGER_ROW.match(line)
                if match is not None:
                    camera = ledger_camera(line, match)
            if match:
                ref = str(Path(spec).parent / match.group(2)) + camera
                refs.append((match.group(1), checked_camera(ref)))
    return refs


def render_summary(summary: dict) -> str:
    lines = [
        "make_round r%04d  %s  %s  changed %d/%d part(s)"
        % (summary["round"], summary.get("scope", "assembly"), summary["project"], len(summary["changed"]), len(summary["parts"]))
    ]
    for role in summary["checked"]:
        item = summary["build"][role]
        extra = ("  " + "; ".join(item["failures"])) if item["verdict"] == "FAIL" and item["failures"] else ""
        lines.append("  build %-4s %-28s%s" % (item["verdict"], role, extra))
        gates = (summary.get("print") or {}).get(role)
        if gates is None:
            continue
        wall = gates["thickness"]
        thin = "" if wall.get("thinnest_mm") is None else "  thinnest %.2f mm" % wall["thinnest_mm"]
        why = ("  " + "; ".join(wall["failures"])) if wall["verdict"] == "FAIL" and wall["failures"] else ""
        lines.append("  wall  %-4s %-28s%s%s" % (wall["verdict"], role, thin, why))
        over = gates["overhang"]
        area = "" if over.get("overhang_mm2") is None else "  largest %.0f mm2" % over["overhang_mm2"]
        why = ("  " + "; ".join(over["failures"])) if over["verdict"] == "FAIL" and over["failures"] else ""
        lines.append("  over  %-4s %-28s%s%s" % (over["verdict"], role, area, why))
    unchecked = [r for r in summary["parts"] if r not in summary["checked"]]
    if unchecked:
        lines.append("  build skip %d unchanged part(s): %s" % (len(unchecked), ", ".join(unchecked[:6]) + (" ..." if len(unchecked) > 6 else "")))
        if summary.get("reused"):
            lines[-1] += "  (retained PASS evidence)"
    for item in summary.get("reference_errors") or []:
        lines.append("  ref   FAIL %-14s %s" % (item["label"], item["error"][:160]))
    for item in summary.get("sealed") or []:
        lines.append("  seal  %-14s shown to %s" % (item["label"], item["scored_by"]))
    if summary.get("shape_limit") is not None:
        lines.append("  shape %d/%d shape round(s)" % (summary.get("shape_rounds", 0), summary["shape_limit"]))
    if summary.get("motion_status") == "not-run":
        lines.append("  move  SKIP motion unverified")
    if summary.get("motion") is not None:
        motion = summary["motion"]
        lines.append("  move  %-4s %s" % (motion["verdict"].upper()[:4], motion["detail"][:90]))
    if summary.get("full") is not None:
        lines.append("  full  %-4s verify_project exit %s  %s" % ("ok" if summary["full"]["ok"] else "FAIL", summary["full"]["returncode"], summary["full"]["tail"][:90]))
    if summary.get("visual") is not None:
        visual = summary["visual"]
        lines.append("  visual %s  %s" % (visual["status"].upper(), visual.get("observation", visual.get("detail", ""))))
        for item in visual["findings"]:
            lines.append("    %s: %s | evidence: %s | repair: %s" % (item["part"], item["defect"], item["evidence"], item["repair"]))
        for item in visual.get("differences") or []:
            lines.append("    differs %s: reference %s | model %s | %s: %s" % (
                item["feature"], item["reference"], item["model"], item["decision"], item["reason"]))
        if visual["status"] == "pending" and summary.get("shape_limit") is not None:
            lines.append("    reviewer inspects %s; record it with --record-review <review.json>" % visual["packet"])
        elif visual["status"] == "pending":
            lines.append("    inspect %s then use --record-visual <feedback.json>" % visual["packet"])
    review = summary.get("review")
    if review is not None:
        lines.append("  review %s by %s: %s" % ("AGREES" if review["agrees"] else "DISAGREES", review["reviewer"], review["reason"][:160]))
        for item in review.get("differences") or []:
            lines.append("    differs %s: reference %s | model %s" % (item["feature"], item["reference"], item["model"]))
        if summary.get("accepted"):
            lines.append("    ACCEPTED at the shape-repair limit (%d shape rounds); reported when the run ends" % summary["accepted"]["shape_rounds"])
    verdict = ("UNVERIFIED" if summary.get("geometry_status") == "unverified" else "PASS") if summary["ok"] else "FAIL"
    if (summary.get("visual") or {}).get("status") == "pending" and summary.get("checks_ok"):
        verdict = "PENDING"
    lines.append("  %s  reports under %s" % (verdict, summary["out"]))
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# running the tools


def run(command, *, cwd, log: Path, timeout=TOOL_TIMEOUT_SECONDS) -> subprocess.CompletedProcess:
    started = time.monotonic()
    name = Path(command[1]).name if len(command) > 1 else ""
    analysis = name in {"check_thickness", "check_overhang", "check_motion", "check_mesh"}
    environment = {**os.environ, "CADGEN_WARM": "0"}
    if analysis:
        budget = float(environment.get("WORKSHOP_GEOMETRY_TIMEOUT", "600"))
        if not 0 < budget <= 86400:
            raise ValueError("WORKSHOP_GEOMETRY_TIMEOUT must be in (0, 86400]")
        deadline = _GEOMETRY_DEADLINES.setdefault(str(cwd), time.monotonic() + budget)
        timeout = min(timeout, max(0, deadline - time.monotonic()))
    with tempfile.TemporaryFile() as failures:
        environment["WORKSHOP_GEOMETRY_FAILURE_FD"] = str(failures.fileno())
        if timeout == 0:
            stdout, stderr, code = "", "geometry time allowance exhausted", 3
        else:
            process = subprocess.Popen(command, cwd=str(cwd), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, start_new_session=True, env=environment, pass_fds=(failures.fileno(),))
            try:
                stdout, stderr = process.communicate(timeout=timeout)
                code = process.returncode
            except (subprocess.TimeoutExpired, KeyboardInterrupt) as interrupted:
                if isinstance(interrupted, KeyboardInterrupt) and analysis:
                    _GEOMETRY_DEADLINES[str(cwd)] = time.monotonic()
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                stdout, stderr = process.communicate(timeout=5)
                code = 3 if analysis else 124
        failures.seek(0)
        if code == 3 and failures.read(1):
            code = 124  # an earlier measured failure remains a failure
    done = subprocess.CompletedProcess(command, code, stdout, stderr)
    log.write_text(
        "$ %s\n(%.1fs, exit %d)\n--- stdout\n%s\n--- stderr\n%s"
        % (" ".join(str(c) for c in command), time.monotonic() - started, done.returncode, done.stdout, done.stderr),
        encoding="utf-8",
    )
    return done


def parse_motion(stdout: str | bytes, returncode: int, stderr: str | bytes = "") -> dict:
    """Read the complete motion result without promoting partial output to PASS."""
    if isinstance(stdout, bytes):
        stdout = stdout.decode("utf-8", errors="replace")
    if isinstance(stderr, bytes):
        stderr = stderr.decode("utf-8", errors="replace")
    result = {
        "verdict": "unverified" if returncode == 3 else "fail" if returncode else "inconclusive",
        "detail": "missing or invalid motion condition evidence",
        "returncode": returncode,
        "conditions": [],
    }
    if returncode:
        result["detail"] = "check_motion exit %d: %s" % (returncode, result["detail"])
        if stderr:
            result["detail"] += "; " + tail(stderr)[:120]
    lines = stdout.splitlines()
    start = next((i for i, line in enumerate(lines) if line.lstrip().startswith(("{", "["))), None)
    if start is None:
        return result
    try:
        # Never fall through to a nested object when the outer document is truncated.
        payload = json.loads("\n".join(lines[start:]))
    except json.JSONDecodeError:
        return result
    if isinstance(payload, dict):
        records = payload.get("results") if "results" in payload else payload.get("conditions")
        if "ok" in payload and not isinstance(payload["ok"], bool):
            return result
    else:
        records = payload
    if not isinstance(records, list) or not records:
        return result
    if any(
        not isinstance(record, dict)
        or not isinstance(record.get("id"), str) or not record["id"].strip()
        or record.get("status") not in ("pass", "fail", "inconclusive")
        or not isinstance(record.get("detail", ""), str)
        for record in records
    ):
        return result
    conditions = [
        {"id": record["id"], "status": record["status"], "detail": record.get("detail", "")}
        for record in records
    ]
    result["conditions"] = conditions
    statuses = [record["status"] for record in conditions]
    verdict = "fail" if "fail" in statuses else ("inconclusive" if "inconclusive" in statuses else "pass")
    if verdict == "pass":
        detail = "%d condition(s): all pass" % len(conditions)
    else:
        first = next(record for record in conditions if record["status"] == verdict)
        detail = "%s=%s: %s" % (first["id"], verdict, " ".join(first["detail"].split()))
    if isinstance(payload, dict) and payload.get("ok") is False and verdict == "pass":
        verdict, detail = "fail", "check_motion reports ok=false despite passing conditions"
    # Exit 1 is check_motion's documented result for failed or inconclusive checks.
    # Other nonzero exits, or exit 1 with all-pass evidence, are process failures.
    if returncode == 3 and "fail" not in statuses:
        verdict, detail = "unverified", "motion analysis cancelled or time allowance exhausted"
    elif returncode and (returncode != 1 or all(status == "pass" for status in statuses)):
        verdict, detail = "fail", "check_motion exit %d; %s" % (returncode, detail)
    result.update(verdict=verdict, detail=detail)
    return result


def resolve_reference(ref: str, project: Path):
    """A reference path as the Manager wrote it: absolute, project-relative,
    cwd-relative, or relative to the run workspace (the directory holding
    WISH.json above the project). The first that exists wins; None if none
    does. Round 27 of the goose run (2026-09-08) wrote a workspace-relative
    path and lost its score for it. A declared ``@AZ,EL[,TOL]`` camera is not
    part of the path."""

    candidate = Path(split_camera(ref)[0])
    if candidate.is_absolute():
        return candidate if candidate.is_file() else None
    roots = [project, Path.cwd()]
    workspace = run_root(project)
    if workspace is not None:
        roots.append(workspace)
    for root in roots:
        path = root / candidate
        if path.is_file():
            return path
    return None


def run_root(project: Path):
    """The run workspace holding WISH.json above the project, or None outside a run."""

    for parent in [project, *project.parents]:
        if (parent / "WISH.json").is_file():
            return parent
    return None


# Kept in step with WISH_REFERENCES_DIRECTORY and _REFERENCE_NAME in
# workshop/wish/contracts.py. This script is materialized into a run as a
# standalone tool and cannot import the host package.
WISH_REFERENCES_DIR = "wish-references"
SEALED_NAME = re.compile(r"^(ref-(?:0[1-9]|[1-9][0-9])-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)\.(?:png|jpg|webp)$")


def contract_reference_labels(wish: dict) -> dict:
    """Sealed file name -> Design Contract label, or ``{}`` outside Contract Mode.

    ADR 0072: in Contract Mode the Make round labels sealed references by the
    contract's ``shows`` field (``"assembly"`` or ``"geometry:<id>"``) instead
    of the sealed file's stem, since that is the vocabulary the contract and
    its review share.
    """

    context = wish.get("context") if isinstance(wish, dict) else None
    contract = context.get("design_contract") if isinstance(context, dict) else None
    if not isinstance(contract, dict):
        return {}
    labels = {}
    for reference in contract.get("references") or ():
        if isinstance(reference, dict) and isinstance(reference.get("file"), str) and isinstance(reference.get("shows"), str):
            labels[reference["file"]] = reference["shows"]
    return labels


def sealed_references(project: Path):
    """The references the Wish sealed, as ``(references, error)``.

    Each reference is ``{"label", "path", "sha256"}``. Outside Contract Mode
    the label is the sealed file's stem, so it names the same image in every
    round; in Contract Mode it is the contract's label for that file (ADR
    0072). Outside a run there is no Wish and no sealed reference. A Wish
    that cannot be read is an error, never an empty list: an empty list is
    how antisol-v01 scored nothing.
    """

    root = run_root(project)
    if root is None:
        return [], None
    try:
        wish = json.loads((root / "WISH.json").read_text(encoding="utf-8"))
        items = wish.get("references") or []
        if not isinstance(items, list):
            raise ValueError("references is not a list")
    except (OSError, ValueError, AttributeError) as exc:
        return [], "WISH.json unreadable: %s" % exc
    contract_labels = contract_reference_labels(wish)
    sealed = []
    for item in items:
        name = item.get("name") if isinstance(item, dict) else None
        digest = item.get("sha256") if isinstance(item, dict) else None
        match = SEALED_NAME.fullmatch(name) if isinstance(name, str) else None
        if match is None or not isinstance(digest, str):
            return [], "WISH.json names an invalid reference: %r" % (name,)
        label = contract_labels.get(name, match.group(1))
        sealed.append({"label": label, "path": root / WISH_REFERENCES_DIR / name, "sha256": digest})
    return sealed, None


def current_passing_component_round(project: Path, role: str, digest: str | None) -> tuple[dict | None, str]:
    """The current, passing isolated round for one Component's evidence, or
    the reason it does not qualify.

    Both the assembly-review prerequisite and sealed-reference coverage need
    the same answer to "does this Component have a current, passing isolated
    round": a readable state and summary, a valid round number, a scope/entry/
    parts that agree with each other, a passing verdict, and an identity that
    has not moved since (``digest`` is the Component's current build identity,
    a B-rep hash whenever the build reported one, else the exported STEP's
    sha256 -- ADR 0073; ``None`` when it did not build this round). A Component
    whose STEP bytes differ from its recorded pass but whose B-rep identity
    still matches qualifies; the exporter's serialization is not the thing
    being checked. Returns ``(summary, "")`` when it qualifies, else
    ``(None, reason)``.
    """

    entry = "part_%s.step.py" % role
    scope = "component:%s" % role
    state_path = project / "measure" / COMPONENT_ROUNDS_DIR / role / STATE_NAME
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "%s has no isolated component round" % entry
    round_value = state.get("round") if isinstance(state, dict) else None
    if type(round_value) is not int or round_value < 1 or state.get("scope") != scope:
        return None, "%s has invalid component state" % entry
    summary_path = state_path.parent / ("r%04d" % round_value) / "summary.json"
    try:
        summary = json.loads(summary_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "%s has no component summary" % entry
    if (
        not isinstance(summary, dict)
        or summary.get("scope") != scope
        or summary.get("entry") != entry
        or summary.get("parts") != [role]
    ):
        return None, "%s has invalid component summary" % entry
    if not summary.get("ok"):
        return None, "%s latest component round did not pass" % entry
    # The recorded B-rep identity, or the STEP bytes the round wrote: a reader
    # without a fresh build (the final verifier on a part `gen` found current)
    # can only hash the file (ADR 0074).
    recorded = ((state.get("parts") or {}).get(role), (state.get("steps") or {}).get(role))
    if digest is None or digest not in recorded:
        return None, "%s changed after its component pass" % entry
    return summary, ""


def component_coverage(project: Path, digests: dict) -> dict[str, dict]:
    """Reference sha256 -> ``{"role", "accepted"}``, for every reference a
    current, passing component round showed its reviewer (ADR 0076).

    ``accepted`` is None when the reviewer agreed, else the component
    acceptance recorded at the shape-repair limit: ``{"reviewer", "reason",
    "shape_rounds"}``. A reference that depicts one Component is shown in
    that Component's round (ADR 0063); this is how the assembly knows not to
    show it again against the whole object. A Component whose identity moved
    since its pass covers nothing, exactly as --require-component-passes
    treats it: both read ``current_passing_component_round``.
    """

    covered = {}
    rounds = project / "measure" / COMPONENT_ROUNDS_DIR
    for state_path in sorted(rounds.glob("*/" + STATE_NAME)) if rounds.is_dir() else ():
        role = state_path.parent.name
        # A Component that does not qualify covers nothing. That is never a
        # silent pass: its sealed image is then missing at assembly.
        summary, reason = current_passing_component_round(project, role, digests.get(role))
        if reason:
            continue
        accepted = summary.get("accepted")
        if accepted is not None:
            accepted = {key: accepted[key] for key in ("reviewer", "reason", "shape_rounds")}
        for _label, ref in summary.get("refs") or []:
            path = resolve_reference(ref, project)
            if path is not None:
                covered.setdefault(file_hash(path), {"role": role, "accepted": accepted})
    return covered


def sealed_file_error(item: dict) -> dict | None:
    """Why one sealed reference cannot be scored, or None when it can."""

    name = item["path"].name
    if not item["path"].is_file():
        return {"label": item["label"], "error": "sealed reference missing: %s" % name}
    if file_hash(item["path"]) != item["sha256"]:
        return {"label": item["label"], "error": "sealed reference %s does not match its sealed hash" % name}
    return None


def with_component_reference(project: Path, role: str, refs: list):
    """A component round's references: the sealed image of this Component's
    Unique Geometry, plus whatever it was explicitly given (ADR 0074).

    Only Contract Mode labels a sealed image ``geometry:<id>``, and a Component
    is built to the geometry whose id is its role. Outside Contract Mode, and
    for a Component no sealed image shows, this returns ``refs`` unchanged:
    ADR 0063's rule of scoring no implicit whole-object image still holds.
    """

    sealed, error = sealed_references(project)
    if error is not None:
        return refs, [], [{"label": "WISH.json", "error": error}]
    label = GEOMETRY_LABEL + role
    mine = [item for item in sealed if item["label"] == label]
    if not mine:
        return refs, [], []
    hashes = {item["sha256"] for item in mine}
    kept, cameras = split_sealed_copies(refs, hashes, project)
    to_score, report, errors = [], [], []
    for item in mine:
        problem = sealed_file_error(item)
        if problem is not None:
            errors.append(problem)
            continue
        to_score.append((label, str(item["path"]) + cameras.get(item["sha256"], "")))
        report.append({"label": label, "scored_by": "component:%s" % role})
    return to_score + kept, report, errors


def split_sealed_copies(refs: list, hashes: set, project: Path) -> tuple[list, dict]:
    """``(kept refs, sealed sha256 -> "@AZ,EL[,TOL]")``.

    A reference that is a copy of a sealed image is not scored twice; the
    sealed image is scored instead, from the camera the copy declared. The
    Wish seals pixels, not where they were taken from, so a declared camera
    is the only way a sealed image reaches verify_project --image-derived.
    """

    kept, cameras = [], {}
    for label, ref in refs:
        path = resolve_reference(ref, project)
        digest = file_hash(path) if path is not None else None
        if digest in hashes:
            camera = split_camera(ref)[1]
            if camera is not None:
                cameras.setdefault(digest, "@" + camera)
            continue
        kept.append((label, ref))
    return kept, cameras


def with_sealed_references(project: Path, refs: list, digests: dict):
    """The assembly round's references: every sealed one not already shown to
    a Component's reviewer, plus the ledger's references the Wish did not seal.

    Returns ``(refs, sealed_report, errors)``. A sealed reference that is
    missing or no longer matches its hash is an error the round fails on,
    never a reference quietly dropped. A ledger entry that is a copy of a
    sealed image is not shown twice.
    """

    sealed, error = sealed_references(project)
    if error is not None:
        return refs, [], [{"label": "WISH.json", "error": error}]
    if not sealed:
        return refs, [], []
    sealed_hashes = {item["sha256"] for item in sealed}
    kept, cameras = split_sealed_copies(refs, sealed_hashes, project)
    covered = component_coverage(project, digests)
    to_show, report, errors = [], [], []
    for item in sealed:
        problem = sealed_file_error(item)
        if problem is not None:
            errors.append(problem)
            continue
        cover = covered.get(item["sha256"])
        if cover is not None:
            report.append({"label": item["label"], "scored_by": "component:%s" % cover["role"]})
            continue
        if item["label"].startswith(GEOMETRY_LABEL):
            # ADR 0074: an image of one Component is never judged against the
            # whole object. Without a current component pass it is missing.
            role = item["label"][len(GEOMETRY_LABEL):]
            errors.append({
                "label": item["label"],
                "error": "no current component round passed its checks and independent review; run "
                         "--component part_%s.step.py" % role,
            })
            report.append({"label": item["label"], "scored_by": "missing"})
            continue
        to_show.append((item["label"], str(item["path"]) + cameras.get(item["sha256"], "")))
        report.append({"label": item["label"], "scored_by": "assembly"})
    return to_show + kept, report, errors


def tail(text: str) -> str:
    return " ".join((text or "").split())[-MAX_TAIL_CHARS:]


def motion_policy():
    return runpy.run_path(str(Path(__file__).resolve().parents[2] / "cad/scripts/motion_policy.py"))


def shape_limit_refusal(state: dict, round_root: Path) -> str | None:
    """Why no further component round may start, or None.

    At the shape-repair limit a round that passed its checks is reviewed, not
    repaired again: the review then passes the component or becomes its
    recorded acceptance, so the run cannot loop on its shape (ADR 0076).
    """

    latest = state.get("round")
    if int(state.get("shape_rounds", 0)) < SHAPE_REPAIR_LIMIT or state.get("checks_ok") is not True:
        return None
    try:
        summary = json.loads((round_root / ("r%04d" % latest) / "summary.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return None
    if isinstance(summary, dict) and summary.get("review") is not None:
        return None
    return ("the component used its %d shape rounds and r%04d passed its checks; have an independent "
            "reviewer judge r%04d and record it with --record-review <review.json>"
            % (SHAPE_REPAIR_LIMIT, latest, latest))


def make_round(args) -> int:
    project = Path(args.project).resolve()
    if not project.is_dir():
        print("make_round: not a directory: %s" % project, file=sys.stderr)
        return 2
    try:
        option = getattr(args, "check_motion", None)
        if args.no_motion:
            if option is True:
                raise ValueError("--no-motion conflicts with --check-motion true")
            option = False
        check_motion = motion_policy()["enabled"](option)
    except (OSError, ValueError) as exc:
        print("make_round: %s" % exc, file=sys.stderr)
        return 2
    if args.record_visual:
        try:
            summary = record_visual(project, args.record_visual, args.full, args.component,
                                    check_motion=check_motion)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
        return 0 if summary["ok"] else 1
    if getattr(args, "record_review", None):
        try:
            summary = record_review(project, args.record_review, args.component)
        except (ValueError, KeyError, OSError, TypeError) as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
        return 0 if summary["ok"] else 1
    if args.full:
        print("make_round: --full requires --record-visual after inspection and independent blind review", file=sys.stderr)
        return 2
    roots = skills_root()
    if roots is None:
        print("make_round: cannot locate the cad and image-to-cad skills", file=sys.stderr)
        return 2
    cad = roots / "cad" / "scripts"
    python = sys.executable
    generators = sorted(project.glob("*.step.py"))
    all_parts = [g for g in generators if g.name.startswith("part_")]
    entries = [g for g in generators if not g.name.startswith("part_")]
    component = None
    if args.component:
        try:
            role, entry = component_role(project, args.component)
        except ValueError as exc:
            print("make_round: %s" % exc, file=sys.stderr)
            return 2
        component = role
        parts = [entry]
    elif args.entry:
        parts = all_parts
        entry = project / args.entry
    elif len(entries) == 1:
        parts = all_parts
        entry = entries[0]
    else:
        print("make_round: expected exactly one entry *.step.py (found %d); pass --entry" % len(entries), file=sys.stderr)
        return 2
    measure = project / "measure"
    measure.mkdir(exist_ok=True)
    try:
        state_path, round_root = state_and_round_root(project, args.component)
    except ValueError as exc:
        print("make_round: %s" % exc, file=sys.stderr)
        return 2
    state_path.parent.mkdir(parents=True, exist_ok=True)
    state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    if component is not None:
        refusal = shape_limit_refusal(state, round_root)
        if refusal is not None:
            print("make_round: %s" % refusal, file=sys.stderr)
            return 2
    round_index = int(state.get("round", 0)) + 1
    out = Path(args.out) if args.out else round_root / ("r%04d" % round_index)
    out.mkdir(parents=True, exist_ok=True)

    # A one-piece project exposes its buildable geometry through the entry.
    if not parts:
        parts = [entry]

    # 1. build every part once. Identity is the B-rep hash `gen --json` reports for
    # the shape it just built from source (ADR 0073); a part built from an
    # imported STEP, or reported by a tool too old to say, falls back to hashing
    # the exported STEP bytes so it still has an identity to compare next round.
    digests: dict[str, str] = {}
    build: dict[str, dict] = {}
    build_failures: dict[str, dict] = {}
    for part in parts:
        role = part.name.removeprefix("part_").removesuffix(".step.py")
        step = part.with_name(part.name[:-len(".py")])
        done = run([python, str(cad / "gen"), str(part), "--write", "--json"], cwd=project, log=out / ("gen-%s.log" % role))
        parsed = parse_build(done.stdout, done.stderr, done.returncode)
        if parsed["verdict"] == "PASS" and not step.is_file():
            parsed = {"verdict": "FAIL", "failures": ["gen reported success but wrote no %s" % step.name]}
        if parsed["verdict"] == "FAIL":
            build_failures[role] = parsed
            continue
        digests[role] = parse_identity(done.stdout) or hashlib.sha256(step.read_bytes()).hexdigest()
    changed = diff_parts(state.get("parts", {}), digests) if not args.all_parts else sorted(digests)
    # The geometry this round scored: the Component's identity, or every
    # part's for the assembly. None when it did not build.
    if component is not None:
        round_identity = digests.get(component)
    else:
        round_identity = None if build_failures else hashlib.sha256(
            json.dumps(digests, sort_keys=True).encode()).hexdigest()

    # Spark can make assembly review contingent on current, passing isolated
    # component evidence. Comparing B-rep identity, not STEP bytes, catches
    # edits in the component file and in any shared helper it imports without
    # refusing a part the exporter merely serialized differently (ADR 0073).
    if args.require_component_passes:
        failures = []
        if not all_parts:
            failures.append("no part_<role>.step.py component sources exist")
        for part in all_parts:
            part_role = part.name[len("part_"):-len(".step.py")]
            _, reason = current_passing_component_round(project, part_role, digests.get(part_role))
            if reason:
                failures.append(reason)
        prerequisite_log = out / "component-prerequisites.log"
        if failures:
            prerequisite_log.write_text("\n".join(failures) + "\n", encoding="utf-8")
            print("make_round: assembled-object review requires current passing component rounds: %s" % "; ".join(failures), file=sys.stderr)
            return 1
        if prerequisite_log.is_file():
            prerequisite_log.unlink()

    # 2. record the build verdict for what moved.
    for role in changed:
        build[role] = {"verdict": "PASS", "failures": []}
    for role, parsed in build_failures.items():
        build[role] = parsed
        if role not in changed:
            changed.append(role)

    # 2b. gate the parts that built, from source. Reuse only a passing pair
    # measured from the same bytes under the same conditions: a failed or
    # legacy entry is re-measured even when its STEP did not change.
    context = print_context(cad, args.nozzle, args.overhang_angle)
    previous_print = state.get("print") or {}
    same_context = context is not None and context == state.get("print_context")
    printing: dict[str, dict] = {}
    for role in sorted(digests):
        prior = previous_print.get(role)
        if (
            not args.all_parts and role not in changed and same_context
            and reusable_print(prior)
        ):
            printing[role] = prior
            continue
        part = next(p for p in parts if p.name.removeprefix("part_").removesuffix(".step.py") == role)
        logs = {}
        gates = {}
        for gate, extra in (
            ("thickness", ["--nozzle", str(args.nozzle)]),
            ("overhang", ["--angle", str(args.overhang_angle)]),
        ):
            log = out / ("%s-%s.log" % (gate, role))
            done = run(
                [python, str(cad / ("check_" + gate)), str(part), *extra,
                 "--report", str(out / ("%s-%s.md" % (gate, role)))],
                cwd=project,
                log=log,
            )
            parsed = (parse_thickness if gate == "thickness" else parse_overhang)(done.stdout)
            if done.returncode == 3:
                parsed["verdict"] = "UNVERIFIED"
                parsed["failures"] = ["geometry analysis cancelled or its time allowance exhausted"]
            elif done.returncode not in (0, 1):
                # 0 pass, 1 measured-and-failed; anything else is the tool
                # failing to measure, which is never a printability verdict.
                parsed["verdict"] = "FAIL"
                parsed["failures"] = (
                    ["check_%s exit %d: %s" % (gate, done.returncode, tail(done.stderr)[:60])]
                    + parsed["failures"]
                )[:4]
            gates[gate] = parsed
            if log.is_file():
                logs[str(log.resolve())] = hashlib.sha256(log.read_bytes()).hexdigest()
        printing[role] = {
            "verdict": "FAIL" if any(g["verdict"] == "FAIL" for g in gates.values()) else "UNVERIFIED" if any(g["verdict"] == "UNVERIFIED" for g in gates.values()) else "PASS",
            "thickness": gates["thickness"],
            "overhang": gates["overhang"],
            "measured_round": round_index,
            "logs": logs,
        }
        if printing[role]["verdict"] == "FAIL" and role not in changed:
            changed.append(role)
    for role in build_failures:
        # A part that did not build has no solid to measure. Say that, rather
        # than reporting an absent gate as a pass.
        printing[role] = {
            "verdict": "FAIL",
            "thickness": {"verdict": "FAIL", "thinnest_mm": None, "failures": ["build failed"]},
            "overhang": {"verdict": "FAIL", "overhang_mm2": None, "failures": ["build failed"]},
            "measured_round": round_index,
            "logs": {},
        }

    # 3. the references this round shows its reader, each composed beside the
    # model at the reference's declared camera. Nothing is scored (ADR 0076).
    refs = parse_refs(args.refs, [] if component is not None else sorted(project.glob("*_spec.md")))
    if component is not None:
        refs, sealed, reference_errors = with_component_reference(project, component, refs)
    else:
        # ADR 0072: the Wish's sealed references are shown whether or not any
        # ledger names them. A component round shows only its own sealed image
        # and what it is explicitly given (ADR 0063, ADR 0074).
        refs, sealed, reference_errors = with_sealed_references(project, refs, digests)
    shown = []
    for label, ref in refs:
        if resolve_reference(ref, project) is None:
            reference_errors.append({"label": label, "error": "reference missing: %s" % ref})
        else:
            shown.append((label, ref))
    refs = shown

    # A shape round changes the geometry of a component whose previous round
    # passed its checks; repairs of build or print failures are not counted.
    shape_rounds = int(state.get("shape_rounds", 0))
    if (
        component is not None and state.get("checks_ok") is True
        and round_identity is not None and round_identity != state.get("identity")
    ):
        shape_rounds += 1

    # 4. motion gate when the project declares a manifest.
    motion = None
    manifest = measure / "motion.json"
    if component is None and manifest.is_file() and check_motion:
        done = run([python, str(cad / "check_motion"), str(project), "--manifest", str(manifest), "--json"], cwd=project, log=out / "motion.log")
        motion = parse_motion(done.stdout, done.returncode, done.stderr)

    # 5. Visual inspection is a separate evidence submission, not a model call.
    visual = prepare_visual(project, entry, out, cad, refs, component)
    full = None

    ok = (
        all(item["verdict"] == "PASS" for item in build.values())
        and all(item["verdict"] in ("PASS", "UNVERIFIED") for item in printing.values())
        and not reference_errors
        and (motion is None or motion["verdict"] in ("pass", "unverified"))
        and (full is None or full["ok"])
    )
    summary = {
        "round": round_index,
        "scope": "component:%s" % component if component is not None else "assembly",
        "project": str(project),
        "entry": entry.name,
        "parts": sorted(set(digests) | set(build_failures)),
        "changed": changed,
        "checked": sorted(build),
        "build": build,
        "print": printing,
        "reused": sorted(role for role in printing if printing[role].get("measured_round") != round_index),
        "nozzle": args.nozzle,
        "overhang_angle": args.overhang_angle,
        "reference_errors": reference_errors,
        "motion": motion,
        "check_motion": check_motion,
        "motion_status": (motion["verdict"] if motion is not None else "not-run"),
        "full": full,
        "checks_ok": ok,
        "visual": visual,
        "refs": refs,
        "sealed": sealed,
        "ok": False,
        "out": str(out),
    }
    if component is not None:
        summary.update(review=None, shape_rounds=shape_rounds, shape_limit=SHAPE_REPAIR_LIMIT)
    if any(item["verdict"] == "UNVERIFIED" for item in printing.values()) or (motion and motion["verdict"] == "unverified"):
        summary["geometry_status"] = "unverified"
        summary["print_ready_claim"] = False
    (out / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    state = {
        "round": round_index,
        "scope": summary["scope"],
        "parts": digests,
        "print": printing,
        "print_context": context,
        "identity": round_identity,
        "steps": {
            role: file_hash(part.with_name(part.name[:-len(".py")]))
            for part in parts
            for role in [part.name.removeprefix("part_").removesuffix(".step.py")]
            if role in digests and part.with_name(part.name[:-len(".py")]).is_file()
        },
        "checks_ok": ok,
        "shape_rounds": shape_rounds,
        "last_out": str(out),
    }
    state_path.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(summary, sort_keys=True) if args.json else render_summary(summary))
    return 1  # pending or failed visual evidence cannot report a complete round


# ---------------------------------------------------------------------------
# self-check: the pure parts, without CAD


def self_check() -> int:
    ok = True

    def check(hit, text):
        nonlocal ok
        print(("ok   " if hit else "FAIL ") + text)
        ok &= hit

    parsed = parse_build(
        '{"ok":false}\n',
        "Traceback (most recent call last):\n  File \"part_frame.step.py\", line 12\nValueError: wall must be positive\n",
        1,
    )
    check(parsed["verdict"] == "FAIL" and parsed["failures"][-1].startswith("ValueError"), "a failing build yields FAIL and the reason")
    check(parse_build('{"ok":true}\n', "", 0) == {"verdict": "PASS", "failures": []}, "a clean build yields PASS")
    check(parse_build("", "", 3)["failures"] == ["gen exit 3"], "a silent non-zero build still names its exit code")
    thin = parse_thickness(
        "part_frame.step.py: 4.20 cm3 solid, grid 0.100 mm\n"
        "  FAIL  wall >= 0.80 mm (+/-0.10)        2.1% of surface below\n"
        "        1. [wall ] 0.42 mm at (1.0, 2.0, 3.0)  12 samples\n"
        "RESULT: WALL BELOW MINIMUM\n"
    )
    check(thin["verdict"] == "FAIL" and thin["thinnest_mm"] == 0.42, "a thin wall yields FAIL and the thinnest region")
    passing = parse_thickness(
        "part_frame.step.py: 4.20 cm3 solid\n"
        "  PASS  wall >= 0.80 mm (+/-0.10)        0.0% of surface below\n"
        "RESULT: printable at this wall\n"
    )
    check(passing["verdict"] == "PASS" and passing["failures"] == [], "a sound wall yields PASS")
    check(parse_thickness("")["verdict"] == "FAIL", "a silent thickness run is never a pass")
    over = parse_overhang(
        "part_frame.step.py: 13.8 cm2 of surface\n"
        "  FAIL  unsupported area                  473.9 mm2\n"
        "        1. [overhang] 473.9 mm2 at (0.0, 0.0, 6.0)  span 20.0 mm\n"
        "RESULT: NEEDS SUPPORT\n"
    )
    check(over["verdict"] == "FAIL" and over["overhang_mm2"] == 473.9, "an unsupported region yields FAIL and its area")
    bridged = parse_overhang(
        "part_frame.step.py: 13.8 cm2 of surface\n"
        "        1. [bridge  ] 192.3 mm2 at (0.0, 0.0, 6.0)  span 9.7 mm\n"
        "RESULT: prints unsupported\n"
    )
    check(
        bridged["verdict"] == "PASS" and bridged["overhang_mm2"] is None,
        "a spannable bridge is not an overhang failure",
    )
    check(parse_overhang("")["verdict"] == "FAIL", "a silent overhang run is never a pass")
    with tempfile.TemporaryDirectory() as tmp:
        log = Path(tmp) / "thickness-frame.log"
        log.write_text("RESULT: printable at this wall\n", encoding="utf-8")
        digest = hashlib.sha256(log.read_bytes()).hexdigest()
        record = {
            "verdict": "PASS", "measured_round": 2,
            "thickness": {"verdict": "PASS", "thinnest_mm": 1.2, "failures": []},
            "overhang": {"verdict": "PASS", "overhang_mm2": None, "failures": []},
            "logs": {str(log): digest},
        }
        check(reusable_print(record), "a passing pair with intact logs is reusable")
        check(not reusable_print({**record, "verdict": "FAIL"}), "a failed record is never reused")
        check(
            not reusable_print({**record, "overhang": {"verdict": "FAIL", "failures": []}}),
            "a pair is only reusable when both gates passed",
        )
        check(not reusable_print({**record, "logs": {}}), "a record without its tool log is not reused")
        log.write_text("tampered\n", encoding="utf-8")
        check(not reusable_print(record), "an edited tool log invalidates the record")
    check(diff_parts({}, {"a": "1", "b": "2"}) == ["a", "b"], "the first round checks every part")
    check(diff_parts({"a": "1", "b": "2"}, {"a": "1", "b": "3", "c": "4"}) == ["b", "c"], "later rounds check only changed or new parts")
    check(parse_refs(["hero=ref/hero.png", "side=/abs/side.png"], []) == [("hero", "ref/hero.png"), ("side", "/abs/side.png")], "--ref pairs parse")
    check(parse_refs(["hero=ref/hero.png@-60,20"], []) == [("hero", "ref/hero.png@-60,20")], "a declared camera stays on the reference, the form verify_project reads")
    check(split_camera("ref/hero.png@-60.5,20,15") == ("ref/hero.png", "-60.5,20,15") and split_camera("ref/hero@2x.png") == ("ref/hero@2x.png", None), "a camera splits off the path; an @ inside a file name is not one")
    for bad in ("hero=ref/hero.png@-60,20,90", "hero=ref/hero.png@0,95", "hero=ref/hero.png@front"):
        try:
            parse_refs([bad], [])
            check(False, "an unusable camera is refused before any render: %s" % bad)
        except ValueError:
            check(True, "an unusable camera is refused before any render: %s" % bad)
    check(reference_view("ref/hero.png@-60,20,15") == ("-60,20", "az-60_el20", "-60,20"), "a reference is compared at its declared camera, without the search tolerance")
    check(reference_view("ref/hero.png")[:2] == ("front", "front"), "a reference without a declared camera is compared from the front")
    with tempfile.TemporaryDirectory() as tmp:
        workspace = Path(tmp); project = workspace / "artifacts" / "make" / "r0001" / "product" / "goose"
        (project / "ref").mkdir(parents=True); (workspace / "WISH.json").write_text("{}", encoding="utf-8")
        (project / "ref" / "hero.jpg").write_bytes(b"x")
        check(resolve_reference("ref/hero.jpg", project) == project / "ref" / "hero.jpg", "a project-relative reference resolves")
        check(resolve_reference("artifacts/make/r0001/product/goose/ref/hero.jpg", project) == project / "ref" / "hero.jpg", "a workspace-relative reference resolves through WISH.json")
        check(resolve_reference("ref/missing.jpg", project) is None, "a missing reference stays missing")
        check(resolve_reference("ref/hero.jpg@-60,20", project) == project / "ref" / "hero.jpg", "a declared camera is not part of the path")
    with tempfile.TemporaryDirectory() as tmp:
        spec = Path(tmp) / "duck_spec.md"
        spec.write_text("# spec\n- `hero=ref/hero.png`\nfront=ref/front.png\nnot a ref line\n", encoding="utf-8")
        refs = parse_refs([], [spec])
        check([r[0] for r in refs] == ["hero", "front"] and refs[0][1].endswith("ref/hero.png"), "the spec ledger supplies references when --ref is absent")
    try:
        parse_refs(["nolabel"], [])
        check(False, "a malformed --ref is refused")
    except ValueError:
        check(True, "a malformed --ref is refused")
    with tempfile.TemporaryDirectory() as tmp:
        spec = Path(tmp) / "toy_spec.md"
        spec.write_text("| Label | Project-local reference | Minimum IoU |\n|---|---|---:|\n| <> | `ref/<file>` | 0.90 |\n| hero | `ref/hero.png` | 0.90 |\n", encoding="utf-8")
        check([r[0] for r in parse_refs([], [spec])] == ["hero"], "the template's Likeness handoff row is a ledger entry; its header and placeholder are not")
        spec.write_text("| Label | Project-local reference | Camera AZ,EL (±TOL) | Minimum IoU | Why |\n|---|---|---|---:|---|\n| <> | `ref/<file>` | <az>,<el> (±30) | 0.90 | <> |\n| hero | `ref/hero.png` | -60,20 (±15) | 0.90 | x |\n| side | `ref/side.png` | 0,0 | 0.90 | x |\n", encoding="utf-8")
        check([(r[0], r[1][len(str(spec.parent)) + 1:]) for r in parse_refs([], [spec])] == [("hero", "ref/hero.png@-60,20,15"), ("side", "ref/side.png@0,0")], "the handoff table's camera column travels with its reference")
    with tempfile.TemporaryDirectory() as tmp:
        run_dir = Path(tmp)
        project = run_dir / "artifacts" / "cad"
        project.mkdir(parents=True)
        check(sealed_references(project) == ([], None), "a project outside any run has no sealed reference")
        (run_dir / "wish-references").mkdir()
        (run_dir / "wish-references" / "ref-01-hero.png").write_bytes(b"hero")
        (run_dir / "wish-references" / "ref-02-side.png").write_bytes(b"side")
        (run_dir / "WISH.json").write_text(json.dumps({"references": [
            {"name": "ref-01-hero.png", "sha256": hashlib.sha256(b"hero").hexdigest()},
            {"name": "ref-02-side.png", "sha256": hashlib.sha256(b"other").hexdigest()},
            {"name": "ref-03-gone.png", "sha256": hashlib.sha256(b"gone").hexdigest()},
        ]}), encoding="utf-8")
        sealed, error = sealed_references(project)
        check(error is None and [s["label"] for s in sealed] == ["ref-01-hero", "ref-02-side", "ref-03-gone"], "a sealed reference is labelled by its file stem")
        (project / "ref").mkdir()
        (project / "ref" / "copy.png").write_bytes(b"hero")
        refs, report, errors = with_sealed_references(project, [("copy", "ref/copy.png")], {})
        check([label for label, _ in refs] == ["ref-01-hero"], "a ledger copy of a sealed image is shown once, under its sealed label")
        check(report == [{"label": "ref-01-hero", "scored_by": "assembly"}], "an uncovered sealed reference is shown to the assembly review")
        check([e["label"] for e in errors] == ["ref-02-side", "ref-03-gone"] and "sealed hash" in errors[0]["error"] and "missing" in errors[1]["error"], "a changed or missing sealed reference is an error, never a silent drop")
        refs, _, _ = with_sealed_references(project, [("copy", "ref/copy.png@-60,20")], {})
        check(refs == [("ref-01-hero", str(run_dir / "wish-references" / "ref-01-hero.png") + "@-60,20")], "a copy of a sealed image lends it the camera it declared")
        (run_dir / "WISH.json").write_text("{not json", encoding="utf-8")
        _, _, errors = with_sealed_references(project, [], {})
        check(len(errors) == 1 and "WISH.json unreadable" in errors[0]["error"], "an unreadable Wish fails the round instead of showing nothing")
    text = render_summary({
        "round": 1, "project": "/p", "parts": ["a"], "changed": ["a"], "checked": ["a"],
        "build": {"a": {"verdict": "PASS", "failures": []}},
        "reference_errors": [{"label": "geometry:body", "error": "no current component round passed its checks and independent review; run --component part_body.step.py"}],
        "sealed": [{"label": "geometry:body", "scored_by": "missing"}],
        "motion": None, "full": None, "ok": False, "out": "/p/measure/rounds/r0001",
    })
    check("seal  geometry:body" in text and "--component part_body.step.py" in text, "a sealed component image missing at assembly points at the component round")
    text = render_summary({
        "round": 6, "scope": "component:body", "project": "/p", "parts": ["body"], "changed": ["body"], "checked": ["body"],
        "build": {"body": {"verdict": "PASS", "failures": []}}, "reference_errors": [], "sealed": [],
        "motion": None, "full": None, "ok": True, "checks_ok": True, "out": "/p/measure/component-rounds/body/r0006",
        "shape_rounds": 5, "shape_limit": 5, "visual": {"status": "reviewed", "findings": [], "detail": "d"},
        "review": {"reviewer": "fresh-reviewer", "agrees": False, "reason": "arms thinner", "round": 6,
                   "differences": [{"feature": "arm", "reference": "thick", "model": "thin"}]},
        "accepted": {"reviewer": "fresh-reviewer", "reason": "arms thinner", "shape_rounds": 5},
    })
    check("shape 5/5" in text and "DISAGREES" in text and "differs arm" in text and "ACCEPTED at the shape-repair limit" in text,
          "a component accepted at the shape-repair limit says so with the reviewer's differences")
    summary = {
        "round": 3, "scope": "assembly", "project": "/p/cad", "parts": ["frame", "knob", "lens"], "changed": ["frame"], "checked": ["frame"],
        "build": {"frame": {"verdict": "PASS", "failures": []}},
        "print": {"frame": {
            "verdict": "FAIL",
            "thickness": {"verdict": "FAIL", "thinnest_mm": 0.42, "failures": ["wall >= 0.80 mm"]},
            "overhang": {"verdict": "PASS", "overhang_mm2": None, "failures": []},
        }},
        "reused": ["knob"],
        "reference_errors": [],
        "motion": {"verdict": "pass", "detail": "47 conditions"}, "full": None, "ok": False, "out": "/p/cad/measure/rounds/r0003",
    }
    text = render_summary(summary)
    check("build PASS frame" in text and "skip 2 unchanged" in text and text.splitlines()[-1].startswith("  FAIL"), "the summary names the changed part and the verdict")
    check("wall  FAIL" in text and "thinnest 0.42 mm" in text, "a failing wall gate reaches the summary with its measurement")
    check("over  PASS" in text, "the overhang gate reports beside the wall gate")
    check("(retained PASS evidence)" in text, "reused gate evidence is named rather than implied")
    check(len(text.splitlines()) <= 10, "the summary stays short")
    print("\nall fixtures pass" if ok else "\nself-check FAILED")
    return 0 if ok else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("project", nargs="?", help="the cad directory holding *.step.py sources")
    parser.add_argument("--entry", help="entry generator name when more than one non-part *.step.py exists")
    parser.add_argument("--component", help="review one isolated part_<role>.step.py using its own round history")
    parser.add_argument("--require-component-passes", action="store_true", help="before assembly review, require current passing isolated rounds for every part")
    parser.add_argument("--ref", dest="refs", action="append", metavar="LABEL=PATH[@AZ,EL[,TOL]]", help="reference view and the camera it was taken from; repeatable; default from the spec ledger. The model is rendered beside it at that camera, else from the front. The Wish's sealed references are always shown at assembly scope; a --ref that copies one lends it its camera")
    parser.add_argument("--nozzle", type=float, default=0.4, help="nozzle diameter for the wall gate (default 0.4 mm)")
    parser.add_argument("--overhang-angle", type=float, default=45.0, help="slope from vertical the printer bridges unsupported (default 45 deg)")
    parser.add_argument("--all-parts", action="store_true", help="report every built part, not only the changed ones")
    parser.add_argument("--check-motion", type=motion_policy()["boolean"], default=None,
                        metavar="true|false", help="enable motion checks (default: false, or frozen Make option)")
    parser.add_argument("--no-motion", action="store_true", help="skip check_motion even when measure/motion.json exists")
    parser.add_argument("--record-visual", help="record native Manager feedback for the last assembly round without rebuilding")
    parser.add_argument("--record-review", metavar="REVIEW.json", help="with --component: record an independent reviewer's judgement of the latest round without rebuilding")
    parser.add_argument("--full", action="store_true", help="with --record-visual: run final verifier after the independent blind review")
    parser.add_argument("--out", help="round directory (default measure/rounds/rNNNN)")
    parser.add_argument("--json", action="store_true", help="print the summary as one JSON line")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)
    if args.self_check:
        return self_check()
    if not args.project:
        parser.error("project is required")
    if args.component and args.require_component_passes:
        parser.error("--component and --require-component-passes are mutually exclusive")
    if args.component and args.entry:
        parser.error("--component and --entry are mutually exclusive")
    if args.component and args.out:
        parser.error("--out is not supported for canonical component round evidence")
    if args.record_review and not args.component:
        parser.error("--record-review requires --component; the assembly is reviewed with --record-visual")
    if args.record_review and (args.record_visual or args.full):
        parser.error("--record-review cannot be combined with --record-visual or --full")
    if args.component and args.record_visual:
        parser.error("a component round is judged by an independent reviewer: use --record-review")
    return make_round(args)


if __name__ == "__main__":
    sys.exit(main())
