#!/usr/bin/env python3
"""Report whether a mesh can become a solid, before anything tries.

A conversion that fails does so for one of a few reasons, and all of them are
visible in the mesh itself. The decisive one is not triangle count: it is
whether the surface closes. Every edge of a closed mesh is shared by exactly
two triangles; an edge with one triangle is a hole, and a mesh with holes sews
into a shell with no inside - it cannot be cut, mounted against, measured for
volume or printed, whatever the file extension says.

It also prints the bounding box, because an STL carries no units. A part that
arrives 25.4 times too small is the most common surprise in this workflow and
the cheapest one to catch here.

    python skills/stl-to-step/scripts/mesh_probe part.stl --summary
    python skills/stl-to-step/scripts/mesh_probe part.stl | jq .

Exit 0 when the file was read, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from meshstep import fixture_stl, mesh_report, read_stl  # noqa: E402


def summarise(report, name):
    size = report["bbox"]["size"]
    out = [f"{name}: {report['triangles']} triangles, {report['nodes']} nodes",
           f"  bbox size:  {size}  (STL carries no units -- check this against the "
           f"part you expect)",
           f"  volume:     {report['volume']}  (mm3 if the file is in mm)",
           f"  area:       {report['area']}"]
    if report["watertight"]:
        out.append("  closed:     yes -- every edge is shared by exactly two triangles")
    else:
        out.append(f"  closed:     NO -- {report['boundaryEdges']} boundary edges, "
                   f"{report['nonManifoldEdges']} non-manifold edges")
        out.append("              a mesh with holes sews into a shell, not a solid. "
                   "Repair it first")
        out.append("              (the 2step backend repairs; the others do not).")
    crossings = report.get("crossingPairs")
    if crossings is None:
        out.append("  crossings:  not measured (numpy unavailable)")
    elif crossings:
        out.append(f"  crossings:  {crossings} triangle pairs pass through each other")
        out.append("              the edge counts cannot see this and every backend "
                   "converts it")
        out.append("              anyway: the solid gets the right volume and fails "
                   "the kernel's")
        out.append("              self-intersection check, which is what booleans and "
                   "validate use.")
    if report["degenerateTriangles"]:
        out.append(f"  degenerate: {report['degenerateTriangles']} zero-area facets, "
                   f"skipped when sewing")
    if report["triangles"] > 200000:
        out.append("  size:       over 200k triangles -- sewing is minutes and the "
                   "result has that many faces.")
        out.append("              Reduce the mesh first (the 2step backend takes "
                   "--reduce).")
    return "\n".join(out)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mesh_probe", description="Report what an STL is, before converting it.")
    parser.add_argument("stl", type=Path, nargs="?", help="STL file, binary or ASCII.")
    parser.add_argument("--digits", type=int, default=4)
    parser.add_argument("--summary", action="store_true",
                        help="Print the readings instead of the full JSON.")
    parser.add_argument("--self-check", action="store_true",
                        help="Run this script's own fixtures; omit the file.")
    args = parser.parse_args(argv)

    if args.self_check:
        return _self_check()
    if not args.stl:
        parser.error("an STL file is required unless --self-check is given")

    report = mesh_report(read_stl(args.stl), args.digits)
    report["source"] = str(args.stl)
    print(summarise(report, args.stl.name) if args.summary
          else json.dumps(report, indent=2))
    return 0


def _self_check():
    import tempfile

    ok = True

    def check(label, condition, detail):
        nonlocal ok
        ok &= bool(condition)
        print(f"{'ok  ' if condition else 'FAIL'} {label}: {detail}")

    with tempfile.TemporaryDirectory() as tmp:
        closed = mesh_report(read_stl(fixture_stl("block_with_bore", tmp)))
        check("a closed mesh reports no boundary edge",
              closed["watertight"] and closed["boundaryEdges"] == 0,
              f"{closed['triangles']} triangles, {closed['boundaryEdges']} boundary edges")

        # Volume straight from the triangles, with no solid in sight: this is
        # the number every conversion is later checked against, so it has to be
        # right before anything else can be.
        check("mesh volume is computed from the triangles alone",
              abs(closed["volume"] - (30 * 20 * 10 - 3.14159265 * 16 * 10)) < 5.0,
              f"{closed['volume']} mm3 against a block of 6000 minus a bore of ~502")

        # The defect no edge count can see. Two closed, manifold boxes that
        # overlap and were never booleaned: nothing here is unshared, nothing
        # is degenerate, and the surfaces still cut through one another.
        crossing = mesh_report(read_stl(fixture_stl("crossing_bodies", tmp)))
        check("crossing surfaces are found in a mesh that is closed and manifold",
              crossing["crossingPairs"] > 0 and crossing["boundaryEdges"] == 0,
              f"{crossing['crossingPairs']} crossing pairs, "
              f"{crossing['boundaryEdges']} boundary edges")

        # And the other half, which is the half that breaks: a flat region is a
        # fan of coplanar triangles that mostly share no vertex, and counting
        # those made a clean block report 1116 crossings. Parallel planes do not
        # cross; neighbours touching along a shared edge do not either.
        check("a clean mesh reports none of them",
              closed["crossingPairs"] == 0,
              f"{closed['crossingPairs']} on a tessellated block with a bore")

        # The second mechanism, which is a different question and the one that
        # decides a sculpted mesh: two triangles in one plane sharing area.
        # Counting only the angled kind found 3 crossings in a body whose exact
        # conversion had 22 self-intersecting solids.
        flat = mesh_report(read_stl(fixture_stl("coplanar_overlap", tmp)))
        check("two triangles overlapping within one plane are found too",
              flat["crossingPairs"] == 1,
              f"{flat['crossingPairs']} between a pair that shares area")

        apart = mesh_report(read_stl(fixture_stl("two_bodies", tmp)))
        check("and two bodies that merely sit near each other report none",
              apart["crossingPairs"] == 0,
              f"{apart['crossingPairs']} between two disjoint boxes")

        holed = mesh_report(read_stl(fixture_stl("open_mesh", tmp)))
        check("a mesh with facets missing is not called closed",
              not holed["watertight"] and holed["boundaryEdges"] > 0,
              f"{holed['boundaryEdges']} boundary edges")

        # And the tell that separates the two cases is not the volume: an open
        # mesh still sums to a plausible number, which is why the edge count
        # decides and the volume does not.
        check("the hole does not show up as an implausible volume",
              abs(holed["volume"] - closed["volume"]) / closed["volume"] < 0.05,
              f"{holed['volume']} against {closed['volume']}")

    print("mesh_probe self-check:", "ok" if ok else "FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
