            "continuous_current_a": 2.0,
            "peak_current_a": 4.0,
        },
        {
            "id": "switch",
            "role": "switch",
            "carried": True,
            "mount_id": "switch_mount",
            "cad": {
                "mode": "assembly",
                "rendered": True,
                "source": "ref/switch.step",
            },
            "evidence": evidence,
