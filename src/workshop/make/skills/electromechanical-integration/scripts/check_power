        },
        {
            "id": "wire_out",
            "role": "wire",
            "carried": True,
            "mount_id": "wire_out_envelope",
            "cad": {
                "mode": "validation_envelope",
                "rendered": False,
                "source": "ref/validation/wire-out-envelope.step",
            },
            "evidence": evidence,
            "continuous_current_a": 3.0,
            "peak_current_a": 6.0,
        },
        {
            "id": "motor",
            "role": "actuator",
            "carried": True,
            "mount_id": "motor_mount",
            "cad": {
                "mode": "assembly",
                "rendered": True,
                "source": "ref/motor.step",
            },
            "evidence": evidence,
            "voltage_v": {"min": 3.0, "max": 6.0},
            "running_current_a": 0.5,
            "stall_current_a": 1.5,
        },
        {
            "id": "wire_return",
            "role": "wire",
            "carried": True,
            "mount_id": "wire_return_envelope",
            "cad": {
                "mode": "validation_envelope",
                "rendered": False,
                "source": "ref/validation/wire-return-envelope.step",
            },
            "evidence": evidence,
            "continuous_current_a": 3.0,
            "peak_current_a": 6.0,
        },
    ]
    manifest = {
        "schema_version": 1,
        "project": "fixture",
        "boundary": "onboard",
        "github_search": [
            {
                "query": "brushed dc toy CAD wiring",
                "url": "https://github.com/example/hardware",
                "license": "MIT",
                "decision": "used",
                "artifacts": ["cad", "bom", "wiring"],
                "relevant_feature": "battery hatch",
                "idea_taken": "serviceable battery tray",
                "compatibility": {
                    "actuator_family": "brushed_dc",
                    "source_voltage_v": [3.0, 4.2],
                },
            }
        ],
        "components": components,
        "paths": [
            {
                "id": "drive",
                "source": "battery",
                "actuator": "motor",
                "sequence": [
                    "battery",
                    "fuse",
                    "switch",
                    "wire_out",
                    "motor",
                    "wire_return",
                    "battery",
                ],
                "required_continuous_current_a": 0.5,
                "required_peak_current_a": 1.5,
                "protection": {"status": "present", "component": "fuse"},
                "control": {"status": "present", "component": "switch"},
                "route": {
                    "modeled": True,
                    "clearance_envelope_mm": 3.0,
                    "strain_relief": True,
                    "service_access": "hatch",
                },
            }
        ],
    }
    return manifest, {
        "battery_mount",
        "fuse_mount",
        "switch_mount",
        "motor_mount",
        "wire_out_envelope",
        "wire_return_envelope",
    }


def _valid_lighting_fixture() -> tuple[
    dict[str, Any], set[str], dict[str, dict[str, Any]]
]:
    manifest, mounts = _valid_fixture()
    manifest["schema_version"] = 3
    compatibility = manifest["github_search"][0]["compatibility"]
    compatibility["load_family"] = "navigation_led"
    del compatibility["actuator_family"]
    manifest["github_search"][0]["query"] = (
        "model aircraft navigation LED CAD BOM wiring"
    )
    manifest["github_search"][0]["revision"] = "0123456789abcdef"
    manifest["component_search"] = [
        {
            "query": "EXAMPLE-LED-RED STEP datasheet",
            "service": "manufacturer",
            "url": "https://manufacturer.example/example-led-red",
            "decision": "used",
            "component_id": "nav_light",
            "part_number": "EXAMPLE-LED-RED",
            "artifacts": ["datasheet", "step"],
            "license_or_terms": "manufacturer CAD download terms",
            "local_file": "ref/example-led-red.step",
            "sha256": "0" * 64,
        },
        {
            "query": "EXAMPLE-SOCKET STEP datasheet",
            "service": "manufacturer",
            "url": "https://manufacturer.example/example-socket",
            "decision": "used",
            "component_id": "nav_light_socket",
            "part_number": "EXAMPLE-SOCKET",
            "artifacts": ["datasheet"],
            "license_or_terms": "manufacturer product-data terms",
        }
    ]
    light = manifest["components"][4]
    light.clear()
    light.update(
        {
            "id": "nav_light",
            "role": "load",
            "load_type": "lighting",
            "carried": True,
            "mount_id": "nav_light_mount",
            "cad": {
                "mode": "assembly",
                "rendered": True,
                "source": "ref/example-led-red.step",
            },
            "evidence": {
                "kind": "manufacturer_datasheet",
                "url": "https://manufacturer.example/example-led-red.pdf",
            },
            "voltage_v": {"min": 3.0, "max": 6.0},
            "continuous_current_a": 0.02,
            "peak_current_a": 0.02,
            "lighting": {
                "function": "port navigation",
                "color": "red",
                "behavior": "steady",
                "installation": {
                    "mode": "removable_socket",
                    "interface_id": "nav_light_twist_lock",
                    "receiver": "nav_light_socket",
                },
            },
        }
    )
    mounts.discard("motor_mount")
    mounts.add("nav_light_mount")
    manifest["components"].append(
        {
            "id": "nav_light_socket",
            "role": "connector",
            "carried": True,
            "mount_id": "nav_light_socket_mount",
            "cad": {
                "mode": "assembly",
                "rendered": True,
                "source": "ref/example-socket.step",
            },
            "evidence": {
                "kind": "manufacturer_datasheet",
                "url": "https://manufacturer.example/example-socket.pdf",
            },
            "voltage_v": {"min": 0.0, "max": 12.0},
            "continuous_current_a": 0.5,
            "peak_current_a": 0.5,
        }
    )
    mounts.add("nav_light_socket_mount")
    path = manifest["paths"][0]
    path["load"] = "nav_light"
    del path["actuator"]
    path["sequence"][4:5] = ["nav_light_socket", "nav_light"]
    path["required_continuous_current_a"] = 0.02
    path["required_peak_current_a"] = 0.02
    manifest["mating_interfaces"] = [
        {
            "id": "nav_light_twist_lock",
            "type": "twist_lock",
            "load_component": "nav_light",
            "receiver_strategy": "purchased_socket",
            "receiver": "nav_light_socket",
            "contact_component": "nav_light_socket",
            "lamp_mpn": "EXAMPLE-LED-RED",
            "receiver_mpn": "EXAMPLE-SOCKET",
            "contact_mpn": "EXAMPLE-SOCKET",
            "evidence": {
                "lamp_source": "https://manufacturer.example/example-led-red.pdf",
                "lamp_revision": "A",
                "receiver_source": "https://manufacturer.example/example-socket.pdf",
                "receiver_revision": "B",
            },
            "geometry": {
                "source_datum": "lamp flange underside to socket mounting face",
                "lug_count": 2,
                "insertion_depth_mm": 6.0,
                "lock_rotation_deg": 30.0,
                "lock_direction": "clockwise",
                "clearance_mm": 0.25,
                "clearance_method": "receiver seat derived with cadfits slip clearance",
                "retention_stop": "socket end stops and lug shoulders",
                "connector_access": "rear contact tabs remain reachable through service hatch",
                "tool_access": "lamp can be gripped and rotated by hand",
            },
            "motion_conditions": {
                "insert": "nav-insert",
                "lock": "nav-lock",
                "retained": "nav-retained",
                "unlock": "nav-unlock",
                "remove": "nav-remove",
            },
            "fit_coupon": {
                "status": "planned",
                "material": "PETG",
                "process": "FDM, 0.4 mm nozzle, 0.2 mm layer",
                "orientation": "socket axis vertical",
                "hardware_sample": "EXAMPLE-LED-RED and EXAMPLE-SOCKET production samples",
                "candidate_clearances_mm": [0.15, 0.25, 0.35],
                "method": "print receiver-seat coupons and dry-fit the exact hardware",
                "result": "pending physical sample",
            },
        }
    ]
    motion_conditions = {
        "nav-insert": {
            "id": "nav-insert",
            "check": "linear_motion_collision",
            "expect": "clear",
            "inputs": {},
        },
        "nav-lock": {
            "id": "nav-lock",
            "check": "rotation_motion_collision",
            "expect": "clear",
            "inputs": {"allow_seated_contact": True},
        },
        "nav-retained": {
            "id": "nav-retained",
            "check": "linear_motion_collision",
            "expect": "blocked",
            "inputs": {"allow_seated_contact": True},
        },
        "nav-unlock": {
            "id": "nav-unlock",
            "check": "rotation_motion_collision",
            "expect": "clear",
            "inputs": {"allow_seated_contact": True},
        },
        "nav-remove": {
            "id": "nav-remove",
            "check": "linear_motion_collision",
            "expect": "clear",
            "inputs": {"allow_seated_contact": True},
        },
    }
    return manifest, mounts, motion_conditions


def self_check() -> None:
    manifest, mounts = _valid_fixture()
    assert validate_manifest(manifest, mounts) == []
    lighting_manifest, lighting_mounts, lighting_motion_conditions = (
        _valid_lighting_fixture()
    )
    assert (
        validate_manifest(
            lighting_manifest,
            lighting_mounts,
            motion_conditions_by_id=lighting_motion_conditions,
        )
        == []
    )
    schema_2_lighting = copy.deepcopy(lighting_manifest)
    schema_2_lighting["schema_version"] = 2
    del schema_2_lighting["mating_interfaces"]
    del schema_2_lighting["components"][4]["lighting"]["installation"]
    assert validate_manifest(schema_2_lighting, lighting_mounts) == []
    cases = []
    bad = copy.deepcopy(manifest)
    bad["components"][4]["voltage_v"]["max"] = 3.7
    cases.append((bad, "outside motor range"))
    bad = copy.deepcopy(manifest)
    bad["components"][2]["peak_current_a"] = 1.0
    cases.append((bad, "switch current"))
    bad = copy.deepcopy(manifest)
    bad["paths"][0]["sequence"][-1] = "switch"
    cases.append((bad, "return path"))
    bad = copy.deepcopy(manifest)
    bad["paths"][0]["sequence"].insert(-1, "battery")
    cases.append((bad, "source repeated inside branch"))
    bad = copy.deepcopy(manifest)
    extra_load = copy.deepcopy(bad["components"][4])
    extra_load["id"] = "second_motor"
    bad["components"].append(extra_load)
    bad["paths"][0]["sequence"].insert(-1, "second_motor")
    cases.append((bad, "two independently rated loads in one branch"))
    bad = copy.deepcopy(manifest)
    bad["github_search"] = []
    cases.append((bad, "GitHub search"))
    bad = copy.deepcopy(manifest)
    bad["paths"][0]["route"]["strain_relief"] = False
    cases.append((bad, "strain relief"))
    bad = copy.deepcopy(manifest)
    bad["boundary"] = "external"
    cases.append((bad, "external boundary without inlet"))
    bad = copy.deepcopy(manifest)
    bad["components"][0]["cad"]["rendered"] = True
    cases.append((bad, "rendered validation envelope"))
    for candidate, name in cases:
        assert validate_manifest(candidate, mounts), (
            f"self-check failed to reject {name}"
        )
    assert validate_manifest(manifest, mounts - {"motor_mount"}), (
        "self-check failed to reject missing mount"
    )
    assert validate_manifest(
        manifest,
        mounts,
        mount_components={"motor_mount": "ref/not-the-motor.step"},
    ), "self-check failed to reject a mount that seats the wrong component STEP"
    bad_lighting = copy.deepcopy(lighting_manifest)
    del bad_lighting["components"][4]["lighting"]["behavior"]
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), (
        "self-check failed to reject incomplete lighting declaration"
    )
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["component_search"] = []
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), (
        "self-check failed to reject missing component search"
    )
    def _lighting_errors(manifest: dict) -> list[str]:
        return validate_manifest(
            manifest,
            lighting_mounts,
            motion_conditions_by_id=lighting_motion_conditions,
        )

    # Both fields carry a component STEP path and both failed the same way, so
    # each branch is locked by its own message rather than by any rejection:
    # a manifest can be invalid for a reason that has nothing to do with ref/.
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["component_search"][0]["local_file"] = "catalog/example-led-red.step"
    assert any("local_file must be under ref/" in error
               for error in _lighting_errors(bad_lighting)), (
        "self-check failed to reject a component STEP parked outside ref/"
    )
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["component_search"][0]["local_file"] = "ref/external/example-led-red.step"
    assert any("local_file must be under ref/" in error
               for error in _lighting_errors(bad_lighting)), (
        "self-check failed to reject a component STEP in design-reference's namespace"
    )
    bad_lighting = copy.deepcopy(lighting_manifest)
    for component in bad_lighting["components"]:
        if isinstance(component.get("cad"), dict):
            component["cad"]["source"] = "catalog/example-led-red.step"
            break
    else:                                       # pragma: no cover - fixture drift
        raise AssertionError("lighting fixture has no component carrying cad")
    assert any("cad.source must be under ref/" in error
               for error in _lighting_errors(bad_lighting)), (
        "self-check failed to reject a seated STEP parked outside ref/"
    )
    bad_lighting = copy.deepcopy(lighting_manifest)
    del bad_lighting["github_search"][0]["revision"]
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), (
        "self-check failed to reject mutable GitHub provenance"
    )
    bad_lighting = copy.deepcopy(lighting_manifest)
    del bad_lighting["mating_interfaces"][0]["receiver_mpn"]
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject a purchased socket without an MPN"
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["mating_interfaces"][0]["lamp_mpn"] = "SIMILAR-LAMP"
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject an MPN absent from component_search"
    bad_lighting = copy.deepcopy(lighting_manifest)
    del bad_lighting["mating_interfaces"][0]["motion_conditions"]["retained"]
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject an incomplete lock motion sequence"
    bad_motion = copy.deepcopy(lighting_motion_conditions)
    bad_motion["nav-retained"]["expect"] = "clear"
    assert validate_manifest(
        lighting_manifest,
        lighting_mounts,
        motion_conditions_by_id=bad_motion,
    ), "self-check failed to reject an unblocked retention check"
    bad_lighting = copy.deepcopy(lighting_manifest)
    coupon = bad_lighting["mating_interfaces"][0]["fit_coupon"]
    coupon["status"] = "passed"
    coupon["selected_clearance_mm"] = 0.45
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject an untested selected clearance"
    bad_lighting = copy.deepcopy(lighting_manifest)
    coupon = bad_lighting["mating_interfaces"][0]["fit_coupon"]
    coupon["status"] = "passed"
    coupon["selected_clearance_mm"] = 0.15
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject a tested clearance not applied to geometry"
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["mating_interfaces"][0]["fit_coupon"]["status"] = "failed"
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to block a failed fit coupon"
    assert validate_manifest(
        lighting_manifest,
        lighting_mounts,
        motion_conditions_by_id={
            condition_id: condition
            for condition_id, condition in lighting_motion_conditions.items()
            if condition_id != "nav-remove"
        },
    ), "self-check failed to reject a missing motion-manifest condition"
    bad_lighting = copy.deepcopy(lighting_manifest)
    bad_lighting["mating_interfaces"] = []
    assert validate_manifest(
        bad_lighting,
        lighting_mounts,
        motion_conditions_by_id=lighting_motion_conditions,
    ), "self-check failed to reject a removable light without an interface"
    assert manifest_notes(lighting_manifest), (
        "self-check failed to surface a planned fit coupon as physically unverified"
    )
    print("check_power self-check: PASS")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project_dir", nargs="?", type=Path)
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--mounts", type=Path)
    parser.add_argument("--json", action="store_true", dest="json_output")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)
    if args.self_check:
        self_check()
        return 0
    if args.project_dir is None:
        parser.error("project_dir is required unless --self-check is used")
    project_dir = args.project_dir.resolve()
    manifest_path = (
        args.manifest or project_dir / "measure" / "power.json"
    ).resolve()
    mounts_path = (
        args.mounts or project_dir / "measure" / "mounts.json"
    ).resolve()
    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors = [f"cannot read power manifest {manifest_path}: {exc}"]
        notes: list[str] = []
    else:
        mount_ids, mount_components, mount_errors = _load_mounts(mounts_path)
        errors = mount_errors + validate_manifest(
            data,
            mount_ids,
            project_dir,
            mount_components=mount_components,
        )
        notes = manifest_notes(data) if not errors else []
    result = {
        "ok": not errors,
        "project": str(project_dir),
        "manifest": str(manifest_path),
        "mounts": str(mounts_path),
        "errors": errors,
        "notes": notes,
    }
    if args.json_output:
        print(json.dumps(result, separators=(",", ":"), sort_keys=True))
    elif errors:
        print(f"check_power: FAIL ({len(errors)} findings)")
        for error in errors:
            print(f"- {error}")
    else:
        print("check_power: PASS")
        print(f"- manifest: {manifest_path}")
        print(f"- mounts: {mounts_path}")
        for note in notes:
            print(f"- NOTE: {note}")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
