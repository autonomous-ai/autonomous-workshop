#!/usr/bin/env python3
"""Rebuild an editable `<name>.step.py` entry from a STEP file, and prove it.

This is not a decompile. A B-rep holds exact surfaces and no history, so what
comes back is a file that *builds the same solid*, not the file that built it:
no parameter names, no relationships between dimensions, no clearances, no
record of which boolean made which face. Use it when there is no generator --
a purchased part to adapt, a STEP a customer sent, a model whose source is
gone -- and not when the generator exists, where the source is better than
anything recovered from its output.

How it rebuilds: a solid whose every wall is parallel to one direction is a
stack of prisms, so cutting it at every plane across that direction and
extruding each cross-section reproduces it exactly rather than approximately.
Where a taper interrupts that, the slab containing it is lofted between its two
ends; a straight taper (a chamfer, a countersink) comes back exact, a curved
one (a fillet) is an approximation and needs --loft-tapers to say so out loud.

Then it runs what it wrote and compares the result against the STEP by
symmetric difference, because a recovery that is not measured is a claim.

    python skills/step-to-source/scripts/step_recover ref/part.step -o part.step.py
    python skills/step-to-source/scripts/step_recover ref/bushing.step --loft-tapers

Exit 0 when the recovery verified within tolerance, 1 when it did not or could
not be attempted, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from steplib import (  # noqa: E402
    RecoveryError, compare, fixture_step, load_entry, read_step, recover,
    render, stamp_roundtrip, verdict,
)


def write_and_prove(step, destination, digits, loft_tapers, tolerance):
    """Emit the entry, run it, and stamp the measured difference into its header.

    The file is written before it is proven, and kept whichever way the proof
    goes: a recovery that missed by 3% is the most useful thing to read when
    working out which slab was wrong.
    """
    source, slabs, report = recover(step, digits, loft_tapers)
    destination.write_text(source, encoding="utf-8")

    try:
        rebuilt = load_entry(destination)
    except Exception as exc:                      # the emitted source is the suspect
        return None, slabs, report, f"{type(exc).__name__}: {exc}"

    measured = compare(read_step(step), rebuilt, digits)
    ok, message = verdict(measured, tolerance)
    stamp = (f"{measured['symmetricDifferencePct']:.6f}% symmetric difference"
             if measured["method"] != "failed" else "not measurable (booleans failed)")
    if not measured["faceKindsMatch"]:
        stamp += ", surface kinds differ"
    destination.write_text(stamp_roundtrip(source, stamp), encoding="utf-8")
    return (measured, ok, message), slabs, report, None


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="step_recover",
        description="Rebuild a build123d entry from a STEP file and verify it.")
    parser.add_argument("step", type=Path, nargs="?", help="STEP/STP file to recover.")
    parser.add_argument("-o", "--out", type=Path,
                        help="Entry to write (default <stem>.step.py here).")
    parser.add_argument("--force", action="store_true", help="Overwrite an existing entry.")
    parser.add_argument("--loft-tapers", action="store_true",
                        help="Loft slabs whose walls curve along the axis (fillets, "
                             "freeform). The result approximates them; the round trip "
                             "reports by how much.")
    parser.add_argument("--tolerance", type=float, default=0.01,
                        help="Symmetric difference in percent allowed (default 0.01).")
    parser.add_argument("--digits", type=int, default=4)
    parser.add_argument("--no-verify", action="store_true",
                        help="Write the entry without running it. The file then says "
                             "its round trip was never measured, and so must you.")
    parser.add_argument("--self-check", action="store_true",
                        help="Run this script's own fixtures; omit the file.")
    args = parser.parse_args(argv)

    if args.self_check:
        return _self_check()
    if not args.step:
        parser.error("a STEP file is required unless --self-check is given")

    destination = args.out or Path(f"{args.step.stem}.step.py")
    if destination.exists() and not args.force:
        print(f"{destination} exists; pass --force to overwrite it", file=sys.stderr)
        return 1

    try:
        if args.no_verify:
            source, slabs, _ = recover(args.step, args.digits, args.loft_tapers)
            destination.write_text(stamp_roundtrip(source, "NOT MEASURED (--no-verify)"),
                                   encoding="utf-8")
            print(f"recovered {destination} ({len(slabs)} slabs, unverified)")
            print("the recovery is unproven: run step_verify before using this entry",
                  file=sys.stderr)
            return 0
        proof, slabs, _, run_error = write_and_prove(
            args.step, destination, args.digits, args.loft_tapers, args.tolerance)
    except RecoveryError as exc:
        print(f"[step_recover] {args.step.name}: {exc}", file=sys.stderr)
        return 1

    if run_error is not None:
        print(f"recovered {destination} ({len(slabs)} slabs, DID NOT RUN)")
        print(f"[step_recover] the emitted entry failed to build: {run_error}",
              file=sys.stderr)
        return 1

    measured, ok, message = proof
    print(f"recovered {destination} ({len(slabs)} slabs)")
    print(render(measured, args.step.name, destination.name))
    print(message, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def _self_check():
    ok = True

    def case(name, loft_tapers, want, tolerance=0.01):
        """want: 'exact', 'within', 'approximate', or 'refused'.

        'within' is 'exact' with the emitter's own rounding allowed: the
        rebuilt solid is the same prisms, but a facet vertex on an irrational
        coordinate comes back at the written number of digits.
        """
        nonlocal ok
        with tempfile.TemporaryDirectory() as tmp:
            step = fixture_step(name, tmp)
            entry = Path(tmp) / f"{name}.step.py"
            try:
                proof, slabs, _, run_error = write_and_prove(
                    step, entry, 4, loft_tapers, tolerance)
            except RecoveryError as exc:
                hit = want == "refused"
                ok &= hit
                print(f"{'ok  ' if hit else 'FAIL'} {name} (loft={int(loft_tapers)}): "
                      f"refused -- {str(exc).splitlines()[0][:64]}")
                return
            if run_error is not None:
                ok = False
                print(f"FAIL {name}: emitted entry did not build -- {run_error}")
                return
            measured = proof[0]
            difference = measured["symmetricDifferencePct"]
            if want == "exact":
                hit = difference == 0.0 and measured["faceKindsMatch"]
            elif want == "within":
                hit = 0.0 <= difference <= tolerance and measured["faceKindsMatch"]
            elif want == "approximate":
                hit = difference > 0.0 and not measured["faceKindsMatch"]
            else:
                hit = False
            ok &= hit
            print(f"{'ok  ' if hit else 'FAIL'} {name} (loft={int(loft_tapers)}): "
                  f"{len(slabs)} slabs, {difference:.6f}% difference, "
                  f"surface kinds {'match' if measured['faceKindsMatch'] else 'differ'}")

    # Planes and cylinders only: every face is reproduced, not approached.
    case("plate", False, "exact")

    # The same part extruded along a direction that is not +Z. The recovery is
    # built on +Z and rotated back, so this fails the moment the pose is lost
    # rather than only when the shape is.
    case("tilted", False, "exact")

    # A boss standing inside a pocket, and a slot whose ends are arcs: the
    # first is what area ranking gets wrong, the second is what a line-only
    # emitter gets wrong.
    case("nested", False, "exact")

    # A ruled taper is straight along the axis, so lofting its slab reproduces
    # it exactly and needs no flag -- outside wall and inside a bore alike.
    case("chamfered", False, "exact")
    case("countersunk", False, "exact")

    # A fillet curves along the axis. Refused unsolicited, and when asked for
    # anyway it comes back as a cone where a torus was: the difference is
    # measured and the surface kinds say what happened.
    case("filleted", False, "refused")
    case("filleted", True, "approximate", tolerance=100.0)

    # No extrusion axis in any orientation: there is no source to write.
    case("sphere", True, "refused")

    # What arrives from skills/stl-to-step. A converted mesh is planes and
    # nothing else, so the question is never "is it faceted" but "is it a stack
    # of prisms". A prismatic mesh recovers exactly; a freeform one is refused
    # at any facet count, and re-authoring (references/re-authoring.md) is its route.
    case("faceted_prism", False, "within")
    case("faceted_dome", True, "refused")

    print("step_recover self-check:", "ok" if ok else "FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
