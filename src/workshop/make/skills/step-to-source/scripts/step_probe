#!/usr/bin/env python3
"""Report what a STEP file proves about its own geometry.

This is the measuring stage, and it guesses nothing. Every number it prints is
read from the kernel's own surface parameters -- plane origins, cylinder axes
and radii, cone half-angles, torus minor radii -- so a bore diameter here is
the bore diameter, to the decimal the file was written with, not a value fitted
to a mesh.

What it will not tell you is how the part was made. A B-rep records surfaces,
not history: nothing in it says a face came from an extrude, that two holes are
a pattern, or that a wall thickness was derived from anything. The readings
below name what each surface *is* (a hole, a chamfer, a fillet radius) because
that much follows from the geometry; the feature tree does not follow from it
and is not reported.

    python skills/step-to-source/scripts/step_probe ref/part.step --summary
    python skills/step-to-source/scripts/step_probe ref/part.step | jq .

Exit 0 when the file was read, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from steplib import analyse, fixture_step, read_step  # noqa: E402


def summarise(report, name):
    out = [f"{name}: {report['faceCount']} faces, {report['solidCount']} solid(s)",
           "  kinds:      " + ", ".join(f"{k}={v}" for k, v in report["faceKinds"].items()),
           f"  analytic:   {report['analyticFraction'] * 100:.1f}%"
           + ("" if report["allAnalytic"] else "  (has freeform faces)"),
           f"  bbox size:  {report['bbox']['size']}",
           f"  volume:     {report['mass']['volume']}"]

    holes = [b for b in report["cylindricalBands"] if b["role"] == "hole"]
    others = [b for b in report["cylindricalBands"] if b["role"] != "hole"]
    out.append(f"  holes:      {len(holes)} through/blind bores, "
               f"{len(others)} other cylindrical walls")
    for bore in holes[:10]:
        out.append(f"                dia {bore['diameter']:.3f} axis {bore['axis']} "
                   f"through {bore['axisPoint']}")
    for band in [b for b in report["cylindricalBands"] if b["role"].startswith("half")][:6]:
        out.append(f"                dia {band['diameter']:.3f} half-cylinder at "
                   f"{band['axisPoint']} (mirror seam)")
    for step in report["steppedBores"]:
        out.append(f"                stepped bore {step['diameters']} at {step['axisPoint']}")
    for arc in report["arcSlots"][:6]:
        out.append(f"  arc slot:   radii {arc['radii']} at {arc['axisPoint']}")
    for chamfer in report["chamfers"][:6]:
        out.append(f"  chamfer:    face {chamfer['faceIndex']}: {chamfer['reading']}")
    radii = report["fillets"]["radiiSeen"]
    out.append(f"  fillets:    {radii if radii else 'none (no torus faces)'}")

    axes = report["extrusionAxes"]
    if not axes:
        out.append("  extrusion:  no direction leaves every face parallel or "
                   "perpendicular to it")
    else:
        for axis in axes:
            if axis["slabDecomposable"]:
                out.append(f"  extrusion:  {axis['direction']}, cross-section constant "
                           f"-- recovers exactly")
            else:
                out.append(f"  extrusion:  {axis['direction']}, but its "
                           f"{'/'.join(axis['blockingSurfaceKinds'])} faces change along "
                           f"it -- those slabs loft")
    return "\n".join(out)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="step_probe",
        description="Dump exact B-rep facts from a STEP file.")
    parser.add_argument("step", type=Path, nargs="?", help="STEP/STP file to measure.")
    parser.add_argument("--digits", type=int, default=4,
                        help="Rounding for reported coordinates (default 4).")
    parser.add_argument("--max-faces", type=int, default=400,
                        help="Cap on individually listed faces (default 400).")
    parser.add_argument("--summary", action="store_true",
                        help="Print the readings instead of the full JSON.")
    parser.add_argument("--self-check", action="store_true",
                        help="Run this script's own fixtures; omit the file.")
    args = parser.parse_args(argv)

    if args.self_check:
        return _self_check()
    if not args.step:
        parser.error("a STEP file is required unless --self-check is given")

    report = analyse(read_step(args.step), args.digits, args.max_faces)
    report["source"] = str(args.step)
    print(summarise(report, args.step.name) if args.summary
          else json.dumps(report, indent=2))
    return 0


def _self_check():
    import tempfile

    ok = True

    def check(label, condition, detail):
        nonlocal ok
        ok &= bool(condition)
        print(f"{'ok  ' if condition else 'FAIL'} {label}: {detail}")

    with tempfile.TemporaryDirectory() as tmp:
        plate = analyse(read_step(fixture_step("plate", tmp)), 4, 0)
        bores = [b for b in plate["cylindricalBands"] if b["role"] == "hole"]
        check("a bore reads its own diameter, not a fitted one",
              len(bores) == 2 and all(abs(b["diameter"] - 5.0) < 1e-9 for b in bores),
              f"{len(bores)} bores, diameters {[b['diameter'] for b in bores]}")
        check("a prismatic part reports a constant cross-section",
              plate["extrusionAxes"] and plate["extrusionAxes"][0]["slabDecomposable"],
              f"{[a['direction'] for a in plate['extrusionAxes']]}")

        chamfered = analyse(read_step(fixture_step("chamfered", tmp)), 4, 0)
        angles = [c["semiAngleDeg"] for c in chamfered["chamfers"]]
        check("a chamfer reports its half-angle",
              len(angles) == 1 and abs(abs(angles[0]) - 45.0) < 1e-6,
              f"half-angles {angles}")
        check("and the axis it shares is not called constant",
              chamfered["extrusionAxes"]
              and not chamfered["extrusionAxes"][0]["slabDecomposable"]
              and chamfered["extrusionAxes"][0]["blockingSurfaceKinds"] == ["cone"],
              f"blockers {chamfered['extrusionAxes'][0]['blockingSurfaceKinds']}")

        filleted = analyse(read_step(fixture_step("filleted", tmp)), 4, 0)
        check("a fillet reports the radius needed to re-apply it",
              filleted["fillets"]["radiiSeen"] == {"2.0": [f["faceIndex"]
                                                           for f in filleted["fillets"]["candidates"]]},
              f"radii {filleted['fillets']['radiiSeen']}")

        # The reason analytic coverage is reported separately from
        # recoverability: a sphere is 100% analytic and cannot be extruded in
        # any orientation. One number is about precision, the other about
        # whether there is source to write at all.
        sphere = analyse(read_step(fixture_step("sphere", tmp)), 4, 0)
        check("fully analytic is not the same as recoverable",
              sphere["allAnalytic"] and not sphere["extrusionAxes"],
              f"analytic {sphere['analyticFraction'] * 100:.0f}%, "
              f"{len(sphere['extrusionAxes'])} extrusion axes")

    print("step_probe self-check:", "ok" if ok else "FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
