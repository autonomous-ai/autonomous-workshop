#!/usr/bin/env python3
"""Delete a project's reference meshes and STEPs, once source no longer needs them.

The route ends with source that builds with no file inputs. The references it
was measured from (supplied or converted `ref/*.step`, `mesh/*.stl`, any
`*.stl` under `ref/`) are then deleted, so nothing downstream can quietly lean
on them. This script is the gate for that deletion. It deletes only when:

1. no project source reads a reference: no `import_step` / `import_stl` of a
   file that is not a purchased part declared in `measure/mounts.json`, and no
   `CARRIES` declaration;
2. `validation.py` exists, reads no reference itself, and exits 0. Its frozen
   literals are the only evidence left once the references are gone;
3. a `<name>_spec.md` exists and passes `check_spec_numbers --strict` (every
   quoted parameter matches `params.py`, and it quotes at least one) and
   `check_spec_format` (tags, no placeholders, a mechanism section when
   driven). The spec is the human record of what the references were;
4. every `<name>.step.py` entry has a `<name>.step` written after the newest
   project source, so the deliverables were written from the source that was
   just checked.

What it deletes: `ref/**/*.step|stp` not declared in `measure/mounts.json`,
`ref/**/*.stl`, `mesh/**/*.stl`. What it keeps: everything else under `ref/`
(photos, manuals, drawings) and every declared purchased part.

    python skills/step-to-source/scripts/release_refs output/thing            # dry run
    python skills/step-to-source/scripts/release_refs output/thing --delete   # checks, then deletes

Exit 0 when releasable (or released), 1 when blocked, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

CAD_SCRIPTS = Path(__file__).resolve().parent.parent.parent / "cad" / "scripts"
SKIP_DIRS = {"__cadgen__", "__pycache__", ".git", "ref", "mesh"}
READS_FILE = re.compile(r"\b(import_step|import_stl|import_brep|Mesher\(\)\.read)\s*\(")
CARRIES = re.compile(r"^\s*CARRIES\s*[:=]", re.MULTILINE)


def _sources(project):
    for path in sorted(project.rglob("*.py")):
        if SKIP_DIRS & set(path.relative_to(project).parts[:-1]):
            continue
        yield path


def _declared_mounts(project):
    manifest = project / "measure" / "mounts.json"
    if not manifest.is_file():
        return set()
    text = manifest.read_text(encoding="utf-8")
    return {Path(m).name for m in re.findall(r'"([^"]+\.(?:step|stp))"', text, re.I)}


def candidates(project):
    mounts = _declared_mounts(project)
    found = []
    for root in (project / "ref", project / "mesh"):
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*")):
            suffix = path.suffix.lower()
            if suffix == ".stl" or (suffix in (".step", ".stp") and path.name not in mounts):
                found.append(path)
    return found, mounts


def check(project, run_validation):
    project = Path(project)
    blockers, notes = [], []
    files, mounts = candidates(project)
    entries = sorted(p for p in _sources(project) if p.name.endswith(".step.py"))
    if not entries:
        blockers.append("no <name>.step.py entries: there is no source to keep")

    for path in _sources(project):
        text = path.read_text(encoding="utf-8", errors="replace")
        rel = path.relative_to(project)
        if CARRIES.search(text):
            blockers.append(f"{rel}: declares CARRIES - a carrier dies with its "
                            f"reference; re-author it")
        for lineno, line in enumerate(text.splitlines(), 1):
            if READS_FILE.search(line) and not any(m in line for m in mounts):
                blockers.append(f"{rel}:{lineno}: reads a file: {line.strip()}")
            elif re.search(r"""["'/](mesh|ref)/[^"']*\.(stl|step|stp)""", line) \
                    and not any(m in line for m in mounts):
                blockers.append(f"{rel}:{lineno}: names a reference: {line.strip()}")

    validation = project / "validation.py"
    if not validation.is_file():
        blockers.append("no validation.py: freeze each part's measured volume, bbox "
                        "and section areas as literals before the references go")
    elif run_validation and not blockers:
        result = subprocess.run([sys.executable, validation.name], cwd=project,
                                capture_output=True, text=True)
        if result.returncode != 0:
            tail = (result.stderr or result.stdout).strip().splitlines()[-3:]
            blockers.append("validation.py failed: " + " | ".join(tail))
        else:
            notes.append("validation.py passed")

    specs = sorted(project.glob("*_spec.md"))
    if not specs:
        blockers.append("no <name>_spec.md: write it from skills/step-to-source/"
                        "templates/source_spec.md before the references go")
    elif run_validation:
        for gate, extra in (("check_spec_numbers", ["--strict"]), ("check_spec_format", [])):
            result = subprocess.run(
                [sys.executable, str(CAD_SCRIPTS / gate), str(project), *extra],
                capture_output=True, text=True)
            if result.returncode != 0:
                lines = [l.strip() for l in result.stdout.splitlines() if l.strip()]
                blockers.append(f"{gate} failed: " + " | ".join(lines[-4:]))
            else:
                notes.append(f"{gate} passed")

    newest = max((p.stat().st_mtime for p in _sources(project)), default=0.0)
    for entry in entries:
        step = entry.with_name(entry.name[:-len(".py")])
        if not step.is_file():
            blockers.append(f"{step.relative_to(project)}: not written - run gen --write")
        elif step.stat().st_mtime < newest:
            blockers.append(f"{step.relative_to(project)}: older than the newest "
                            f"source - run gen --write again")

    return {"project": str(project),
            "delete": [str(p.relative_to(project)) for p in files],
            "keepMounts": sorted(mounts),
            "blocked": blockers, "notes": notes}


def release(report, project):
    project = Path(project)
    for rel in report["delete"]:
        (project / rel).unlink()
    mesh = project / "mesh"
    if mesh.is_dir() and not any(mesh.rglob("*")):
        mesh.rmdir()


def render(report, deleted):
    out = [f"release_refs {report['project']}"]
    verb = "deleted" if deleted else "would delete"
    out += [f"  {verb}: {p}" for p in report["delete"]] or ["  nothing to delete"]
    out += [f"  keep (declared purchased part): {m}" for m in report["keepMounts"]]
    out += [f"  {n}" for n in report["notes"]]
    if report["blocked"]:
        out.append("blocked - the source still needs its references:")
        out += [f"  - {b}" for b in report["blocked"]]
    return "\n".join(out)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="release_refs",
        description="Delete reference meshes/STEPs once source no longer needs them.")
    parser.add_argument("project", type=Path, nargs="?")
    parser.add_argument("--delete", action="store_true",
                        help="Run validation.py, then delete if nothing blocks.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)
    if args.self_check:
        return _self_check()
    if not args.project or not args.project.is_dir():
        parser.error("give the project directory")
    report = check(args.project, run_validation=args.delete)
    deleted = args.delete and not report["blocked"]
    if deleted:
        release(report, args.project)
    print(json.dumps(report, indent=2) if args.json else render(report, deleted))
    return 1 if report["blocked"] else 0


def _self_check():
    import os  # noqa: PLC0415
    import tempfile  # noqa: PLC0415
    import time  # noqa: PLC0415

    results = []

    def ok(label, condition, detail=""):
        results.append(condition)
        print(f"{'ok  ' if condition else 'FAIL'} {label}{': ' + detail if detail else ''}")

    good_spec = ("# Spec - demo box\n\n## 3. Parts\n\n"
                 "| wall | `WALL` | 2.0 mm | `[observed]` |\n")

    def project(tmp, name, entry_body, validation="print('ok')\n", mounts=None,
                spec=good_spec):
        root = Path(tmp) / name
        (root / "ref" / "photos").mkdir(parents=True)
        (root / "mesh").mkdir()
        (root / "ref" / "part.step").write_text("x")
        (root / "ref" / "photos" / "01.jpg").write_text("x")
        (root / "mesh" / "part.stl").write_text("x")
        (root / "part_a.step.py").write_text(entry_body)
        (root / "params.py").write_text("WALL = 2.0\n")
        if spec is not None:
            (root / "demo_spec.md").write_text(spec)
        if validation is not None:
            (root / "validation.py").write_text(validation)
        if mounts:
            (root / "measure").mkdir()
            (root / "ref" / mounts).write_text("x")
            (root / "measure" / "mounts.json").write_text(
                json.dumps({"mounts": [{"step": f"ref/{mounts}"}]}))
        later = time.time() + 5
        (root / "part_a.step").write_text("x")
        os.utime(root / "part_a.step", (later, later))
        return root

    authored = "from build123d import Box\n\ndef gen_step():\n    return Box(1, 1, 1)\n"
    carrier = ('from build123d import import_step\nCARRIES = "ref/part.step"\n\n'
               'def gen_step():\n    return import_step("ref/part.step")\n')
    with tempfile.TemporaryDirectory() as tmp:
        good = project(tmp, "good", authored)
        report = check(good, run_validation=True)
        ok("authored source with passing validation is releasable",
           not report["blocked"], str(report["blocked"]))
        ok("it deletes the converted STEP and the mesh",
           set(report["delete"]) == {"ref/part.step", "mesh/part.stl"}, str(report["delete"]))
        release(report, good)
        ok("photos under ref/ stay", (good / "ref" / "photos" / "01.jpg").is_file())
        ok("an emptied mesh/ is removed", not (good / "mesh").exists())

        carried = project(tmp, "carried", carrier)
        report = check(carried, run_validation=True)
        ok("a carrier entry blocks the release",
           any("CARRIES" in b for b in report["blocked"])
           and any("reads a file" in b for b in report["blocked"]), str(report["blocked"]))

        novalid = project(tmp, "novalid", authored, validation=None)
        ok("no validation.py blocks the release",
           any("validation.py" in b for b in check(novalid, True)["blocked"]))

        failing = project(tmp, "failing", authored, validation="raise SystemExit(1)\n")
        ok("a failing validation.py blocks the release",
           any("failed" in b for b in check(failing, True)["blocked"]))

        nospec = project(tmp, "nospec", authored, spec=None)
        ok("no spec blocks the release",
           any("_spec.md" in b for b in check(nospec, True)["blocked"]))

        wrong = project(tmp, "wrong", authored,
                        spec=good_spec.replace("2.0 mm", "3.0 mm"))
        ok("a spec quoting a stale parameter blocks the release",
           any("check_spec_numbers" in b for b in check(wrong, True)["blocked"]))

        untagged = project(tmp, "untagged", authored,
                           spec=good_spec + "\nThe lid is 40 mm wide.\n")
        ok("a spec with an untagged dimension blocks the release",
           any("check_spec_format" in b for b in check(untagged, True)["blocked"]))

        stale = project(tmp, "stale", authored)
        past = time.time() - 100
        os.utime(stale / "part_a.step", (past, past))
        ok("a STEP older than its source blocks the release",
           any("older" in b for b in check(stale, False)["blocked"]))

        mounted = project(tmp, "mounted", authored + '\nMOTOR = import_step("ref/motor.step")\n',
                          mounts="motor.step")
        report = check(mounted, run_validation=True)
        ok("a declared purchased part may be imported and is kept",
           not report["blocked"] and "ref/motor.step" not in report["delete"],
           str(report["blocked"] or report["delete"]))

    good_all = all(results)
    print(f"release_refs self-check: {'ok' if good_all else 'FAILED'}")
    return 0 if good_all else 1


if __name__ == "__main__":
    raise SystemExit(main())
