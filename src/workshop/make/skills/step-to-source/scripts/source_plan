#!/usr/bin/env python3
"""Plan the route from STEP references to source that needs no references.

The input is STEP only: a supplied STEP with no generator, or one that
`$stl-to-step` converted from a mesh. Both take the same route from here:

    1. build source      recover each solid, or re-author it from measurements
    2. release refs      once the source passes its frozen checks and its spec
                         is written, delete the references (release_refs)
    3. assemble          place the parts from source, never from references

This reads the references, applies one stated rule per decision, and prints the
commands plus the assumptions to declare. It writes nothing.

    python skills/step-to-source/scripts/source_plan output/thing/ref/*.step --project output/thing

Decisions it makes from the files:

- per solid, the exit: `recover` (a stack of prisms), `recover_refit` (refused
  sharp only because of fillets), or `re-author` (anything step_recover
  refuses). The recovery is run in memory rather than predicted.
- per file with several solids: keep the bodies separate and build each one.
- across files, whether the set is already assembled, recentred on the origin,
  or laid out on print plates.

Exit 0 when a plan came out, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

# Surfaces an extrusion rebuilds exactly: a plane is a slab wall and a cone is
# straight along its generatrices, so a chamfer or a countersink lofts ruled
# and costs nothing. A torus does not, and a sphere or a bspline leaves no axis
# to extrude along at all.
EXACT_BLOCKERS = {"cone"}
APPROXIMATE_BLOCKERS = {"torus"}


# --------------------------------------------------------------------------
# One rule per decision
# --------------------------------------------------------------------------

def decide_exit(step_report, path=None):
    """recover, recover_refit or re-author - decided by the solid.

    With the shape in hand this is not a prediction: the decomposition is
    attempted in memory and the answer is whatever it did. Surface kinds are
    not sufficient - an M8 hex nut has an axis whose only tapers are cones,
    which reads as recoverable, and it is refused anyway on a slab whose
    cross-section changes topology. The surface tiers below are the fallback
    for a report with no shape beside it, stamped `assumed` for that reason.
    """
    solids = step_report["solidCount"]
    if solids > 1:
        return {"exit": "several_bodies", "confidence": "measured",
                "why": f"{solids} solids: the body count, the repeats and the "
                       f"placements are the structure the file kept. Keep the "
                       f"bodies separate and build each one; an assembly may "
                       f"place them one by one"}
    if path is not None:
        return _attempt_recovery(path, step_report)
    axes = step_report["extrusionAxes"]
    if any(a["slabDecomposable"] for a in axes):
        return {"exit": "recover", "confidence": "assumed",
                "why": "one solid with a direction that leaves the "
                       "cross-section constant: it rebuilds as a stack of "
                       "prisms"}
    for axis in axes:
        if set(axis["blockingSurfaceKinds"]) <= EXACT_BLOCKERS:
            return {"exit": "recover", "confidence": "assumed",
                    "why": f"one solid with an axis at {axis['direction']} "
                           f"whose only tapers are cones, which loft ruled "
                           f"and exactly"}
    for axis in axes:
        if set(axis["blockingSurfaceKinds"]) <= EXACT_BLOCKERS | APPROXIMATE_BLOCKERS:
            return {"exit": "recover_refit", "confidence": "assumed",
                    "why": f"one solid with an axis at {axis['direction']} "
                           f"blocked by torus faces: recover the sharp body, "
                           f"then re-apply fillet() with the probed radius"}
    return {"exit": "re-author", "confidence": "assumed",
            "why": "one solid with no direction that leaves every face "
                   "parallel, perpendicular or ruled along it; step_recover "
                   "will refuse it, so it is measured and authored"}


def _attempt_recovery(path, step_report):
    """Run the recovery rather than predicting it. It returns text, not files."""
    from steplib import RecoveryError, recover  # noqa: PLC0415

    try:
        _, slabs, _ = recover(path)
    except RecoveryError as error:
        refusal = str(error).replace("\n", " ")
    else:
        return {"exit": "recover", "confidence": "measured",
                "why": f"recovered here into {len(slabs)} slabs, so the exit is "
                       f"a checked fact rather than a reading of its surface "
                       f"kinds"}
    if "torus" in step_report["faceKinds"]:
        try:
            _, slabs, _ = recover(path, loft_tapers=True)
        except RecoveryError:
            slabs = None
        if slabs:
            return {"exit": "recover_refit", "confidence": "measured",
                    "why": f"refused sharp, and decomposes into {len(slabs)} "
                           f"slabs only once its torus faces loft. Recover it "
                           f"that way to measure, then re-apply fillet() with "
                           f"the radius step_probe read"}
    return {"exit": "re-author", "confidence": "measured",
            "why": f"step_recover refuses it: {refusal.rstrip('.')}. Refused does not mean "
                   f"hard - measure it and author it"}


def decide_pose(steps):
    """Say whether separate files carry their assembled pose, or lost it.

    A file stores absolute coordinates, so parts exported from one assembly
    against a common origin arrive already placed and parts each recentred on
    their own origin arrive stacked on one another. The bounding boxes are the
    only evidence of which. Overlap in plan decides nothing: a pin inside a
    frame's box is nested in the assembly too.
    """
    if len(steps) < 2:
        return None
    boxes = [(e["path"].name, e["report"]["bbox"]) for e in steps]
    at_origin = [n for n, b in boxes if all(abs(v) <= _slack(b) for v in b["min"])]
    centred = [n for n, b in boxes if _centred(b)]
    for names, how in ((at_origin, "have their bounding box at the origin"),
                       (centred, "are centred on the origin")):
        if len(names) >= 2:
            return {"pose": "recentred", "confidence": "measured",
                    "why": f"{len(names)} files {how} ({', '.join(names)}); "
                           f"the assembly relationship is not in the files",
                    "consequence": "place every part from datums in source "
                                   "(assembling.md); derive mates with cadfits"}
    floors = [b["min"][2] for _, b in boxes]
    if max(floors) - min(floors) <= 0.5:
        return {"pose": "print_plates", "confidence": "assumed",
                "why": "each file sits at its own offset and every one stands "
                       "on the same floor: a print-plate layout looks exactly "
                       "like this, and its offsets are packing, not a pose",
                "consequence": "take the pose from the designer's photos or "
                               "manual and place parts from datums "
                               "(assembling.md). If the parts were in fact "
                               "exported assembled, one interference check "
                               "shows parts touching"}
    return {"pose": "assembled", "confidence": "measured",
            "why": "each file sits at its own offset, at different heights: a "
                   "common-origin assembly export",
            "consequence": "the placement in the files is the pose; record "
                           "each part's offset as a named placement before "
                           "the references are released"}


def _slack(box):
    return max(0.5, 0.005 * max(box["size"] or [1.0]))


def _centred(box):
    return all(abs(lo + hi) / 2.0 <= _slack(box)
               for lo, hi in zip(box["min"], box["max"]))


# --------------------------------------------------------------------------
# The plan
# --------------------------------------------------------------------------

def plan(paths, project, max_faces=400):
    from steplib import analyse, read_step  # noqa: PLC0415

    project = Path(project)
    steps, refused = [], []
    for path in paths:
        if path.suffix.lower() in (".step", ".stp"):
            steps.append({"path": path,
                          "report": analyse(read_step(path), max_faces=max_faces)})
        else:
            refused.append(path)
    report = {"project": str(project), "refused": [str(p) for p in refused],
              "steps": [], "commands": [], "assumptions": []}

    for entry in steps:
        path, stem = entry["path"], entry["path"].stem
        exit_ = decide_exit(entry["report"], path)
        report["steps"].append({"file": str(path),
                                "solids": entry["report"]["solidCount"],
                                "faces": entry["report"]["faceCount"],
                                "bboxSize": entry["report"]["bbox"]["size"],
                                "exit": exit_})
        probe = f"python skills/step-to-source/scripts/step_probe {path} --summary"
        if exit_["exit"] in ("recover", "recover_refit"):
            report["commands"] += [
                probe,
                f"python skills/step-to-source/scripts/step_recover {path} "
                f"-o {project}/part_{stem}.step.py",
                f"python skills/step-to-source/scripts/step_verify {path} "
                f"{project}/part_{stem}.step.py",
                f"name the dimensions of part_{stem} into params.py and re-verify "
                f"(references/what-survives.md)"]
            if exit_["exit"] == "recover_refit":
                report["commands"].append(
                    f"re-apply fillet() in part_{stem} with the probed radii, "
                    f"then step_verify to zero")
        elif exit_["exit"] == "several_bodies":
            report["commands"] += [
                probe,
                f"python skills/step-to-source/scripts/carrier_project {path} "
                f"--name {stem} --dry-run    # lists the body groups; writes nothing",
                f"re-author parts/{stem}.py returning each body as its own "
                f"labelled solid, in its original position "
                f"(references/re-authoring.md)"]
            report["assumptions"].append(
                f"{path.name}: {entry['report']['solidCount']} bodies kept "
                f"separate in source, because an assembly may place them one "
                f"by one")
        else:
            report["commands"] += [
                probe,
                f"re-author parts/{stem}.py from measurements "
                f"(references/re-authoring.md)"]
        if exit_["exit"] != "recover":
            report["assumptions"].append(
                f"{path.name}: {exit_['exit']} -- {exit_['why']}")

    pose = decide_pose(steps)
    if pose:
        report["pose"] = pose
        report["assumptions"].append(
            f"placement: {pose['pose']} [{pose['confidence']}] -- {pose['why']}")

    report["commands"] += [
        f"freeze each part's measured volume, bbox and section areas into "
        f"{project}/validation.py as literals, and run it",
        f"CADGEN_WARM=1 python skills/cad/scripts/gen {project}/*.step.py --write",
        f"write {project}/{project.name}_spec.md from "
        f"skills/step-to-source/templates/source_spec.md (BOM, parameters, datums, "
        f"pose, verification)",
        f"python skills/step-to-source/scripts/release_refs {project}    "
        f"# dry run: says whether the references can go",
        f"python skills/step-to-source/scripts/release_refs {project} --delete",
    ]
    if pose:
        report["commands"].append(
            f"assemble from parts/ in {project}/assemblies/ "
            f"(references/assembling.md): audit, interfere, check_motion")
    return report


def render(report):
    out = [f"source plan -> {report['project']}"]
    for path in report["refused"]:
        out.append(f"  refused: {path} -- STEP only; convert an STL with "
                   f"$stl-to-step first")
    for row in report["steps"]:
        out.append(f"\n{Path(row['file']).name}: {row['solids']} solid(s), "
                   f"{row['faces']} faces, bbox {row['bboxSize']}")
        out.append(f"  exit: {row['exit']['exit']} [{row['exit']['confidence']}] "
                   f"-- {row['exit']['why']}")
    if report.get("pose"):
        pose = report["pose"]
        out.append(f"\nplacement: {pose['pose']} [{pose['confidence']}]")
        out.append(f"  {pose['why']}")
        out.append(f"  -> {pose['consequence']}")
    if report["commands"]:
        out.append("\nrun, in order:")
        out += [f"  {c}" for c in report["commands"]]
    if report["assumptions"]:
        out.append("\ndeclare these in the handover (they are decisions, not questions):")
        out += [f"  - {a}" for a in report["assumptions"]]
    return "\n".join(out)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="source_plan",
        description="Plan STEP references -> source -> released references -> assembly.")
    parser.add_argument("inputs", type=Path, nargs="*", help="STEP or STP files.")
    parser.add_argument("--project", type=Path, help="Project directory.")
    parser.add_argument("--max-faces", type=int, default=400,
                        help="Face budget for the STEP analysis (default 400).")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-check", action="store_true",
                        help="Run the built-in fixtures and exit.")
    args = parser.parse_args(argv)
    if args.self_check:
        return _self_check()
    if not args.inputs or not args.project:
        parser.error("give at least one STEP file and --project")
    missing = [p for p in args.inputs if not p.exists()]
    if missing:
        parser.error(f"no such file: {missing[0]}")
    report = plan(args.inputs, args.project, max_faces=args.max_faces)
    print(json.dumps(report, indent=2) if args.json else render(report))
    return 0


# --------------------------------------------------------------------------
# Self-check
# --------------------------------------------------------------------------

def _self_check():
    import tempfile  # noqa: PLC0415

    from steplib import analyse, fixture_step, read_step  # noqa: PLC0415

    results = []

    def check(label, condition, detail):
        results.append(condition)
        print(f"{'ok  ' if condition else 'FAIL'} {label}: {detail}")

    def as_steps(names_boxes):
        return [{"path": Path(f"{n}.step"),
                 "report": {"bbox": {"min": lo, "max": hi,
                                     "size": [b - a for a, b in zip(lo, hi)]}}}
                for n, lo, hi in names_boxes]

    plate = decide_pose(as_steps([("a", [0, 0, 0], [10, 10, 10]),
                                  ("b", [20, 0, 0], [30, 10, 10])]))
    check("a set all on one floor is flagged as print plates",
          plate["pose"] == "print_plates" and plate["confidence"] == "assumed",
          plate["why"])
    nested = decide_pose(as_steps([("frame", [23.6, 45.4, 0], [190.3, 215.4, 5.7]),
                                   ("pin", [162.5, 142.0, 0], [184.5, 150.0, 2.5])]))
    check("overlap in plan is not read as recentred", nested["pose"] != "recentred",
          nested["why"])
    stacked = decide_pose(as_steps([("base", [0, 0, 0], [40, 40, 10]),
                                    ("lid", [2, 2, 10], [38, 38, 14])]))
    check("parts at different heights are an assembly",
          stacked["pose"] == "assembled", stacked["why"])
    recentred = decide_pose(as_steps([("a", [0, 0, 0], [10, 10, 10]),
                                      ("b", [0, 0, 0], [6, 6, 6])]))
    check("boxes at the origin are recentred", recentred["pose"] == "recentred",
          recentred["why"])
    centred = decide_pose(as_steps([("a", [-5, -5, -5], [5, 5, 5]),
                                    ("b", [-3, -3, -3], [3, 3, 3])]))
    check("boxes centred on the origin are recentred", centred["pose"] == "recentred",
          centred["why"])
    check("one file carries no relationship",
          decide_pose(as_steps([("a", [0, 0, 0], [1, 1, 1])])) is None, "none")

    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)

        def exit_for(name):
            path = fixture_step(name, tmp)
            return decide_exit(analyse(read_step(path)), path)

        prism = exit_for("faceted_prism")
        check("a prismatic solid recovers", prism["exit"] == "recover", prism["why"])
        dome = exit_for("faceted_dome")
        check("a freeform solid is re-authored, not carried",
              dome["exit"] == "re-author", dome["why"])
        chamfered = exit_for("chamfered")
        check("a chamfer still recovers", chamfered["exit"] == "recover",
              chamfered["why"])
        filleted = exit_for("filleted")
        check("a fillet recovers sharp and is re-applied",
              filleted["exit"] == "recover_refit", filleted["why"])
        sphere = exit_for("sphere")
        check("a sphere is re-authored", sphere["exit"] == "re-author", sphere["why"])

        full = plan([fixture_step("faceted_prism", tmp)], tmp / "proj")
        check("every plan ends by releasing the references",
              any("release_refs" in c and "--delete" in c for c in full["commands"]),
              "source that still needs its references is not finished")

    predicted = decide_exit({"solidCount": 1, "faceKinds": {"cone": 2},
                             "extrusionAxes": [{"direction": [0, 0, 1],
                                                "slabDecomposable": False,
                                                "blockingSurfaceKinds": ["cone"]}]})
    check("a prediction with no shape is stamped assumed",
          predicted["confidence"] == "assumed", predicted["why"])
    many = decide_exit({"solidCount": 4, "extrusionAxes": []})
    check("several bodies stay separate", many["exit"] == "several_bodies", many["why"])

    ok = all(results)
    print(f"source_plan self-check: {'ok' if ok else 'FAILED'}")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
