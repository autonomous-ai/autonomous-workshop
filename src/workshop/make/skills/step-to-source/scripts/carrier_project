#!/usr/bin/env python3
"""Split a carried reference into one entry per measured body group.

The carrier entry in references/carrying.md is one file that imports the whole converted
STEP and returns it. On a reference that holds one body that is the right
answer. On one that holds many it throws away the only structure a conversion
*does* preserve: how many bodies there are, which of them are copies of each
other, and where each one sits. The snake this was written for carried 100
solids -- 98 chain links in five repeated size groups, one main body, and one
degenerate sliver -- behind a single `import_step()` and an assert on the
count. Nothing in it could be addressed, moved, replaced or deleted.

So this writes the same geometry as a project: a library holding the measured
groups, one `part_<role>.step.py` per group, and the combined entry. Each body
is then editable in the only sense a conversion allows -- it can be selected,
placed, removed, or swapped for authored geometry one group at a time, while
the rest stays carried and keeps passing its gates.

What it does not do is make a dimension editable. Every face here is still a
facet of the supplied mesh; no radius survived the STL and none comes back.
The groups are measured, not designed: `volume` and `faces` are what the
solids have, not what anyone chose. Renaming a group to what the thing
actually is, and replacing groups with real parametric parts, is the work this
scaffold exists to make possible one piece at a time.

    python skills/step-to-source/scripts/carrier_project ref/snake.step \\
        -o output/snake --name snake

Exit 0 when the project was written, 1 when the reference does not need one,
2 on bad usage.
"""

from __future__ import annotations

import argparse
import json
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
# STEP reading and solid exploration are shared with the mesh converter.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "stl-to-step" / "scripts"))

from meshstep import explore, read_step  # noqa: E402

from OCP.BRepBndLib import BRepBndLib  # noqa: E402
from OCP.BRepGProp import BRepGProp  # noqa: E402
from OCP.Bnd import Bnd_Box  # noqa: E402
from OCP.GProp import GProp_GProps  # noqa: E402
from OCP.TopAbs import TopAbs_FACE, TopAbs_SOLID  # noqa: E402
from OCP.TopoDS import TopoDS  # noqa: E402

# A body this small is not a part of anything. The snake carried one at
# 9.26e-09 mm3, which `validate` still had to check and every gate still had to
# carry. It is reported and left out of the built groups rather than silently
# dropped: the reference is not edited here.
DEGENERATE_MM3 = 1e-6


def measure(step_path):
    """Volume, face count and box of every solid, in the reference's own order.

    Order matters more than it looks: the groups are recorded as indices into
    this list, so the entries this writes are only correct while the reference
    reads back the same way. That is why each group also records what its
    members measured, and the library re-checks that at build time.
    """
    shape = read_step(step_path)
    rows = []
    for index, raw in enumerate(explore(shape, TopAbs_SOLID)):
        solid = TopoDS.Solid_s(raw)
        props = GProp_GProps()
        BRepGProp.VolumeProperties_s(solid, props)
        box = Bnd_Box()
        BRepBndLib.Add_s(solid, box, True)
        xm, ym, zm, xx, yx, zx = box.Get()
        centre = props.CentreOfMass()
        rows.append({
            "index": index,
            "volume": round(props.Mass(), 4),
            "faces": sum(1 for _ in explore(solid, TopAbs_FACE)),
            "size": [round(xx - xm, 3), round(yx - ym, 3), round(zx - zm, 3)],
            "centre": [round(centre.X(), 3), round(centre.Y(), 3), round(centre.Z(), 3)],
        })
    return rows


def group(rows, volume_tolerance=1.0, face_tolerance=0.02):
    """Cluster the solids into groups of bodies that measure the same.

    Volume and face count, not the bounding box. A repeated body laid along a
    curve arrives rotated, so its box is a different triple every time -- on
    the snake the same 2591 mm3 link measured 37.9x24.9x13.7 and 19.1x41.1x13.8
    -- while volume and face count are the same number whichever way it is
    turned. Two bodies that share both are copies of one another for every
    purpose this scaffold has.
    """
    live = sorted((r for r in rows if r["volume"] > DEGENERATE_MM3),
                  key=lambda r: -r["volume"])
    groups = []
    for row in live:
        for found in groups:
            volume_gap = abs(row["volume"] - found["volume"]) / max(found["volume"], 1e-9)
            face_gap = abs(row["faces"] - found["faces"]) / max(found["faces"], 1)
            if volume_gap * 100 <= volume_tolerance and face_gap <= face_tolerance:
                found["members"].append(row)
                break
        else:
            groups.append({"volume": row["volume"], "faces": row["faces"],
                           "members": [row]})
    for found in groups:
        volumes = [m["volume"] for m in found["members"]]
        found["volume"] = round(sum(volumes) / len(volumes), 4)
        found["volumeSpan"] = [min(volumes), max(volumes)]
        found["faces"] = max(m["faces"] for m in found["members"])
        found["indices"] = sorted(m["index"] for m in found["members"])
    return groups


def name_groups(groups):
    """Roles that say what was measured and nothing more.

    A group of one body is `body_n`; a repeated one is `links_n`, numbered by
    descending volume. These are deliberately not guesses at what the thing is
    -- the scaffold has no way to know, and a wrong name in a filename outlives
    every comment. Rename them once you do know; that is an ordinary edit.
    """
    solo = links = 0
    for found in groups:
        if len(found["members"]) == 1:
            solo += 1
            found["role"] = f"body_{solo}"
        else:
            links += 1
            found["role"] = f"links_{links}"
    return groups


LIB = '''"""{name} - the measured structure of the solids carried from {reference}.

Written by $step-to-source's `carrier_project` from the converted reference; not
parametric source. Every face is a facet of the supplied mesh, so nothing here
is a design intent: `volume` and `faces` are what each body measured, not what
anyone chose, and no radius survived the STL to be named.

What it does give is a handle on each body. A group can be placed, removed, or
replaced by an authored part without touching the rest, which is the only kind
of editing a converted mesh allows.

Groups are addressed by their index in the reference's own solid order, so the
reference must read back the way it did when this was written. `solids_for`
re-checks that rather than trusting it: a reference that has been re-converted,
re-exported or replaced fails here instead of silently building other bodies.
"""

from pathlib import Path

from build123d import Compound, import_step

REFERENCE = "{reference}"
REFERENCE_PATH = Path(__file__).resolve().parent / "{reference}"

# Solids in the reference, including the degenerate ones excluded below.
TOTAL_SOLIDS = {total}

# Bodies too small to be part of anything, left out of every group. They stay
# in the reference: this scaffold measures that file, it does not edit it.
DEGENERATE = {degenerate}

# role -> measured group. `indices` are positions in the reference's solid
# order; `volume` and `faces` are what those bodies measured and what
# `solids_for` holds them to.
GROUPS = {groups}

_CACHE = {{}}


def load_reference():
    """The converted STEP, read once per process."""
    if "shape" not in _CACHE:
        shape = import_step(str(REFERENCE_PATH))
        solids = shape.solids()
        if len(solids) != TOTAL_SOLIDS:
            raise ValueError(
                f"{{REFERENCE}} holds {{len(solids)}} solids, not the {{TOTAL_SOLIDS}} "
                f"this project was written against. Re-run carrier_project "
                f"against the current reference rather than editing the indices."
            )
        _CACHE["shape"] = solids
    return _CACHE["shape"]


def solids_for(role, tolerance_pct=2.0):
    """The bodies of one group, as a labelled compound.

    The volume check is what makes an index safe to hand out. Solid order comes
    from the STEP file, and nothing in the format promises it is stable across
    a re-export, so an index alone would be a silent wrong answer after the
    reference changed. A volume that has moved more than the tolerance means
    these are no longer the bodies that were measured.
    """
    if role not in GROUPS:
        raise KeyError(f"no group {{role!r}}; this project has {{sorted(GROUPS)}}")
    group = GROUPS[role]
    solids = load_reference()
    picked = []
    for index in group["indices"]:
        solid = solids[index]
        measured = solid.volume
        expected = group["volume"]
        if abs(measured - expected) / max(expected, 1e-9) * 100 > tolerance_pct:
            raise ValueError(
                f"solid {{index}} measures {{measured:.4f}} mm3 where group "
                f"{{role!r}} was written against {{expected:.4f}} mm3. The "
                f"reference is not the one this project was split from."
            )
        solid.label = f"{{role}}_{{index}}"
        picked.append(solid)
    return Compound(children=picked, label=role)


{builders}

# role -> the function that builds it. Both the part entries and the combined
# entry go through this, so authoring a role changes every view of it at once.
BUILDERS = {{
{builder_map}
}}


def build(role):
    """The geometry of one role, carried or authored."""
    return BUILDERS[role]()


def all_roles():
    """Every role, built in the order the groups were measured."""
    return [build(role) for role in BUILDERS]
'''

BUILDER = '''

def build_{role}():
    """{count} carried body/bodies at {volume} mm3.

    **This function is the seam.** To author this part for real, replace
    the line below with build123d geometry and delete {role!r} from GROUPS;
    the part entry and the combined entry both come through here, so
    nothing else has to change and no count has to be kept in step.
    """
    return solids_for("{role}")
'''


PART = '''"""{name} {role} - {count} carried body/bodies, {volume} mm3 each.

One measured group of the solids in {reference}. Not parametric source: these
faces are facets of the supplied mesh. This entry exists so the group can be
built, gated, placed and eventually replaced on its own.

To author this group for real, edit `build_{role}` in {libname}.py -- not this
file. A `.step.py` cannot be imported, so the library is where both this entry
and the combined one read the geometry from, and replacing it there is what
makes the change show up in both.
"""

from {libname} import build_{role}

PRINTABLE = False
CARRIES = "{reference}"
ROLE = "{role}"


def gen_step():
    return build_{role}()
'''

COMBINED = '''"""{name} - every carried body, placed as it sits in {reference}.

The combined entry of a split carrier project: it returns the groups, not the
reference, so what is reviewed here is what the part entries build. A group
replaced by authored geometry shows up in this file with no edit to it.

Not parametric source. See {libname} for what was measured and what that does
and does not mean.
"""

from build123d import Compound

from {libname} import BUILDERS, all_roles

PRINTABLE = False
CARRIES = "{reference}"

# What the reference held when this was split, for the record. It is
# deliberately not asserted: a role replaced by authored geometry is free to
# hold a different number of bodies, and a count kept in step by hand would
# fail the first time the project did what it exists to allow.
CARRIED_BODIES = {carried}


def gen_step():
    roles = all_roles()
    assert len(roles) == len(BUILDERS), (
        f"{{len(roles)}} roles built, expected {{len(BUILDERS)}}"
    )
    empty = [name for name, part in zip(BUILDERS, roles) if not part.solids()]
    assert not empty, f"these roles built no solid: {{empty}}"
    shape = Compound(children=roles)
    shape.label = "{name}"
    return shape
'''


def write_project(step_path, out_dir, name, reference_rel, dry_run=False,
                  volume_tolerance=1.0, face_tolerance=0.02):
    rows = measure(step_path)
    if len(rows) < 2:
        raise SystemExit(
            f"{step_path} holds {len(rows)} solid; a single-body reference wants the "
            f"plain carrier entry in $step-to-source's references/carrying.md, not a split project.")
    degenerate = [r["index"] for r in rows if r["volume"] <= DEGENERATE_MM3]
    groups = name_groups(group(rows, volume_tolerance, face_tolerance))
    carried = sum(len(g["members"]) for g in groups)

    lib_name = f"{name}_lib"
    payload = {
        g["role"]: {
            "indices": g["indices"],
            "volume": g["volume"],
            "faces": g["faces"],
            "count": len(g["members"]),
            "volumeSpan": g["volumeSpan"],
            "sizeFirst": g["members"][0]["size"],
        } for g in groups
    }
    files = {
        f"{lib_name}.py": LIB.format(
            name=name, reference=reference_rel, total=len(rows),
            degenerate=json.dumps(degenerate),
            groups=json.dumps(payload, indent=4),
            builders="\n".join(
                BUILDER.format(role=g["role"], count=len(g["members"]),
                               volume=g["volume"]) for g in groups),
            builder_map="\n".join(
                f'    "{g["role"]}": build_{g["role"]},' for g in groups)),
        f"{name}.step.py": COMBINED.format(
            name=name, reference=reference_rel, libname=lib_name, carried=carried),
    }
    for found in groups:
        files[f"part_{found['role']}.step.py"] = PART.format(
            name=name, role=found["role"], count=len(found["members"]),
            volume=found["volume"], reference=reference_rel, libname=lib_name)

    if not dry_run:
        out_dir.mkdir(parents=True, exist_ok=True)
        for filename, text in files.items():
            (out_dir / filename).write_text(text)
    return rows, groups, degenerate, files


def render(rows, groups, degenerate, files):
    lines = [f"{len(rows)} solids -> {len(groups)} measured group(s), "
             f"{len(files)} file(s)"]
    for found in groups:
        span = found["volumeSpan"]
        spread = (span[1] - span[0]) / max(span[0], 1e-9) * 100
        lines.append(f"  part_{found['role']:<9} {len(found['members']):>4} body(s)  "
                     f"{found['volume']:>12.2f} mm3  {found['faces']:>6} faces  "
                     f"spread {spread:.2f}%")
    if degenerate:
        lines.append(f"  excluded            {len(degenerate)} degenerate solid(s) "
                     f"at indices {degenerate}, below {DEGENERATE_MM3} mm3 -- they "
                     f"stay in the reference and no group builds them")
    lines.append("Roles are measured, not identified. Rename them to what the bodies "
                 "are, then replace one at a time with authored parts.")
    return "\n".join(lines)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="carrier_project",
        description="Split a carried multi-body reference into one entry per group.")
    parser.add_argument("step", type=Path, nargs="?",
                        help="The converted STEP under the project's ref/.")
    parser.add_argument("-o", "--out", type=Path,
                        help="Project directory to write into (default: the "
                             "parent of the reference's ref/ directory).")
    parser.add_argument("--name", help="Project name (default: the STEP's stem).")
    parser.add_argument("--volume-tolerance", type=float, default=1.0,
                        help="Percent two bodies' volumes may differ by and still "
                             "be called copies (default 1.0).")
    parser.add_argument("--face-tolerance", type=float, default=0.02,
                        help="Fraction two bodies' face counts may differ by and "
                             "still be called copies (default 0.02). Raise it to "
                             "merge groups that differ only in tessellation; "
                             "splitting bodies that are not copies is the safer "
                             "error, so the default splits.")
    parser.add_argument("--dry-run", action="store_true",
                        help="Measure and report the split; write nothing.")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)

    if args.self_check:
        return _self_check()
    if args.step is None:
        parser.error("a STEP file is required unless --self-check is given")

    step_path = args.step
    if not step_path.exists():
        raise SystemExit(f"no such STEP: {step_path}")
    name = args.name or step_path.stem
    out_dir = args.out or (step_path.parent.parent if step_path.parent.name == "ref"
                           else step_path.parent)
    try:
        reference_rel = step_path.resolve().relative_to(out_dir.resolve()).as_posix()
    except ValueError:
        raise SystemExit(
            f"{step_path} is not inside {out_dir}; a carried reference lives under "
            f"the project's own ref/ so the entries can name it relatively.")

    rows, groups, degenerate, files = write_project(
        step_path, out_dir, name, reference_rel, dry_run=args.dry_run,
        volume_tolerance=args.volume_tolerance,
        face_tolerance=args.face_tolerance)
    print(render(rows, groups, degenerate, files))
    if args.dry_run:
        print("--dry-run: nothing written")
    else:
        print(f"wrote {len(files)} file(s) into {out_dir}")
        print("next: delete the project's __cadgen__/ , then "
              "check_layout and gen --write every entry")
    return 0


def _self_check():
    from meshstep import fixture_stl
    from meshstep import convert, options

    ok = True

    def case(label, condition, detail):
        nonlocal ok
        ok &= bool(condition)
        print(f"{'ok  ' if condition else 'FAIL'} {label}: {detail}")

    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        project = tmp / "proj"
        (project / "ref").mkdir(parents=True)

        # Two boxes of different sizes plus two that match each other: a
        # reference with a repeated group is the case the split exists for.
        two = convert(fixture_stl("two_bodies", tmp), project / "ref" / "two.step",
                      options(), order=("sew",))
        case("a multi-body reference converts for the split to read",
             two["backend"] is not None and two["report"]["solids"] == 2,
             f"{(two['report'] or {}).get('solids')} solid(s)")

        rows, groups, degenerate, files = write_project(
            project / "ref" / "two.step", project, "two", "ref/two.step")
        case("two differently sized bodies are two groups, not one",
             len(groups) == 2, f"{len(groups)} group(s)")
        case("and each group gets a part entry beside the combined one",
             (project / "two.step.py").exists() and (project / "two_lib.py").exists()
             and sum(1 for p in project.glob("part_*.step.py")) == 2,
             sorted(p.name for p in project.glob("*.py")))

        # The guard that makes an index safe to hand out.
        sys.path.insert(0, str(project))
        import importlib
        lib = importlib.import_module("two_lib")
        built = lib.solids_for("body_1")
        case("a group builds the bodies it measured",
             len(built.solids()) == 1, f"{len(built.solids())} solid(s)")
        lib.GROUPS["body_1"]["volume"] = 1.0
        try:
            lib.solids_for("body_1")
            caught = False
        except ValueError as exc:
            caught = "not the one this project was split from" in str(exc)
        case("and a reference that no longer measures the same is refused",
             caught, "volume guard fired" if caught else "no guard")
        sys.path.remove(str(project))
        del sys.modules["two_lib"]

        single = convert(fixture_stl("block_with_bore", tmp),
                         project / "ref" / "one.step", options(), order=("sew",))
        case("a single-body reference converts", single["backend"] is not None,
             f"{(single['report'] or {}).get('solids')} solid(s)")
        try:
            write_project(project / "ref" / "one.step", project, "one", "ref/one.step")
            refused = False
        except SystemExit as exc:
            refused = "single-body reference" in str(exc)
        case("but is sent back to the plain carrier entry, not split",
             refused, "refused" if refused else "wrote a project for one body")

    print(f"carrier_project self-check: {'ok' if ok else 'FAILED'}")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
