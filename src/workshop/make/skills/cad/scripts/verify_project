#!/usr/bin/env python3
"""Run a CAD project through a sequential quick or final workflow.

The runner removes orchestration overhead, not validation.  It batches explicit
generation targets, runs inspect JSONL in one process, and keeps every geometry
consumer sequential so the single-request warm daemon never becomes a hidden
queue.

    python "$CAD_SKILL_ROOT/scripts/verify_project" <project-dir> --quick
    python "$CAD_SKILL_ROOT/scripts/verify_project" <project-dir> --fresh --exports
    python "$CAD_SKILL_ROOT/scripts/verify_project" <project-dir> --dry-run

Final mode (the default) runs layout, design-reference provenance, multi-target
generation with STEP writes, print fit, local audits, bought-part mounts,
powered-system integration and motion when declared (or required by a
documented assembly procedure), then refs + validate for every entry and assembly
interference.  --exports additionally writes the assembly GLB and one STL per
declared printable entry from the fresh STEP files, then checks each mesh and
its printable wall thickness.

Image-derived mode adds the gates geometry-only CAD cannot answer: spec/source
reconciliation, landmark coverage, orthogonal and reference-pose renders,
source-vs-STEP drift, and silhouette likeness.  It deliberately requires local
measure/check_spec.py and measure/check_landmarks.py audits because those claims
are project-specific and cannot be inferred generically, and a measure/mounts.json
whenever the project carries a component STEP under ref/ -- a fetched part with no
matching declared mount is a seat no gate has ever measured. This mount preflight
applies to every final workflow, not only image-derived work.

Conditional gates that do not run are still written to the report as `skipped`
rows.  A gate missing from the record is indistinguishable from one that passed.
Image-derived final verification requires an explicit power classification:
pass `--powered` for any functional electrical load, which requires
`measure/power.json`, or `--unpowered` when there is none.
"""

from __future__ import annotations

import argparse
import ast
from datetime import datetime, timezone
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path
from typing import Sequence


SCRIPTS_DIR = Path(__file__).resolve().parent
IMAGE_SCRIPTS_DIR = SCRIPTS_DIR.parents[1] / "image-to-cad" / "scripts"
POWER_SCRIPTS_DIR = (
    SCRIPTS_DIR.parents[1] / "electromechanical-integration" / "scripts"
)
ENTRY_SUFFIX = ".step.py"
PART_PREFIX = "part_"
DEFAULT_PREVIEW_TOLERANCE = 0.1
# Keep these in step with check_likeness.DEFAULT_MIN and STALL_STREAK. Final
# acceptance never lowers the numeric floor: it preserves the raw failure and
# records the user's decision separately.
LIKENESS_FLOOR = 0.90
LIKENESS_STALL_STREAK = 3
DEFAULT_BED = (220.0, 220.0, 220.0)
BED_DECLARATION = re.compile(
    r"--bed\s+(\d+(?:\.\d+)?)\s*[x\u00d7]\s*(\d+(?:\.\d+)?)\s*[x\u00d7]\s*(\d+(?:\.\d+)?)"
)
SAFE_LABEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
ASSEMBLY_HEADING = re.compile(r"^#{1,6}\s+.*\bassembly\b", re.IGNORECASE)
ASSEMBLY_ORDER = re.compile(r"\bassembly\s+(?:order|procedure|steps?|sequence)\b", re.IGNORECASE)
MATING_ACTION = re.compile(
    r"\b(?:insert|install|seat|fit|press|slide|slot|screw|bolt|snap|thread|"
    r"attach|fasten|lock|bond|glue|feed|mate)\w*\b",
    re.IGNORECASE,
)
SIGNATURE_REVIEW_KIND = "autonomous-workshop.signature-experience-review"
SIGNATURE_REVIEW_RELATIVE = Path("snap/SIGNATURE-REVIEW.json")
SIGNATURE_REVIEW_FIELDS = {
    "schema_version",
    "kind",
    "iso_sha256",
    "signature_sha256",
    "reviewer",
    "blind_held_read",
    "blind_subjects_read",
    "blind_action_read",
    "blind_relationship_read",
    "wish_revealed_after_blind_read",
    "held_object_unmistakable",
    "subjects_match_wish",
    "action_matches_wish",
    "relationship_matches_wish",
    "signature_experience_unmistakable",
    "finished_product_desirable",
    "review_rounds",
    "largest_risk",
    "resolution",
}
SHA256_TEXT = re.compile(r"^[0-9a-f]{64}$")


def _path_arg(path: Path, cwd: Path) -> str:
    resolved = path.resolve()
    try:
        return resolved.relative_to(cwd).as_posix()
    except ValueError:
        return str(resolved)


def _resolve_inside_project(raw: str | None, project: Path, cwd: Path) -> Path | None:
    if raw is None:
        return None
    candidate = Path(raw)
    if not candidate.is_absolute():
        from_cwd = (cwd / candidate).resolve()
        candidate = from_cwd if from_cwd.exists() else (project / candidate).resolve()
    else:
        candidate = candidate.resolve()
    try:
        candidate.relative_to(project)
    except ValueError as exc:
        raise ValueError(f"path must stay inside {project}: {candidate}") from exc
    return candidate


def _required_signature_review(project: Path) -> str:
    """Bind the expensive final workflow to an already completed blind review."""

    review_path = project / SIGNATURE_REVIEW_RELATIVE
    try:
        identity = review_path.lstat()
        if review_path.is_symlink() or not stat.S_ISREG(identity.st_mode):
            raise ValueError("signature review must be one bounded regular file")
        if identity.st_size > 64 * 1024:
            raise ValueError("signature review must be one bounded regular file")
        content = review_path.read_bytes()
    except OSError as exc:
        raise ValueError(
            "final verification requires snap/SIGNATURE-REVIEW.json before the "
            "integrated CAD gate"
        ) from exc
    if len(content) != identity.st_size:
        raise ValueError("signature review must be one bounded regular file")
    try:
        review = json.loads(content.decode("utf-8"))
    except (UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise ValueError("signature review must be valid JSON") from exc
    canonical = json.dumps(
        review,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")
    if content != canonical or not isinstance(review, dict):
        raise ValueError("signature review must use canonical JSON encoding")
    if set(review) != SIGNATURE_REVIEW_FIELDS:
        raise ValueError("signature review fields do not match schema 3")
    if review.get("schema_version") != 3 or review.get("kind") != SIGNATURE_REVIEW_KIND:
        raise ValueError("signature review identity is invalid")
    for key in (
        "reviewer",
        "blind_held_read",
        "blind_subjects_read",
        "blind_action_read",
        "blind_relationship_read",
        "largest_risk",
        "resolution",
    ):
        value = review.get(key)
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"signature review {key} must be non-empty text")
    for key in (
        "wish_revealed_after_blind_read",
        "held_object_unmistakable",
        "subjects_match_wish",
        "action_matches_wish",
        "relationship_matches_wish",
        "signature_experience_unmistakable",
        "finished_product_desirable",
    ):
        if review.get(key) is not True:
            raise ValueError(f"signature review must affirm {key}")
    if type(review.get("review_rounds")) is not int or review.get(
        "review_rounds"
    ) not in (1, 2):
        raise ValueError("signature review must record one or two review rounds")
    for filename, field in (("iso.png", "iso_sha256"), ("signature.png", "signature_sha256")):
        expected = review.get(field)
        if not isinstance(expected, str) or not SHA256_TEXT.fullmatch(expected):
            raise ValueError(f"signature review {field} is invalid")
        image_path = review_path.parent / filename
        try:
            image_identity = image_path.lstat()
            if image_path.is_symlink() or not stat.S_ISREG(image_identity.st_mode):
                raise ValueError(
                    f"signature review snap/{filename} must be a regular file"
                )
            image_bytes = image_path.read_bytes()
        except OSError as exc:
            raise ValueError(f"signature review requires snap/{filename}") from exc
        if len(image_bytes) != image_identity.st_size:
            raise ValueError(f"signature review snap/{filename} must be a regular file")
        if hashlib.sha256(image_bytes).hexdigest() != expected:
            raise ValueError(f"signature review is stale for snap/{filename}")
    return hashlib.sha256(content).hexdigest()


def _discover_entries(project: Path, assembly_arg: str | None, cwd: Path) -> tuple[Path, list[Path]]:
    entries = sorted(project.glob(f"*{ENTRY_SUFFIX}"))
    part_entries = [path for path in entries if path.name.startswith(PART_PREFIX)]
    if assembly_arg:
        assembly = _resolve_inside_project(assembly_arg, project, cwd)
        if assembly is None or not assembly.is_file():
            raise ValueError(f"assembly entry does not exist: {assembly_arg}")
    else:
        assemblies = [path for path in entries if not path.name.startswith(PART_PREFIX)]
        if len(assemblies) != 1:
            names = ", ".join(path.name for path in assemblies) or "none"
            raise ValueError(
                f"expected one combined entry in {project}, found {len(assemblies)} ({names}); "
                "pass --assembly explicitly"
            )
        assembly = assemblies[0]
    if assembly.suffix != ".py" or not assembly.name.endswith(ENTRY_SUFFIX):
        raise ValueError(f"assembly must be a *{ENTRY_SUFFIX} entry: {assembly}")
    return assembly, part_entries


def _declared_printable(entry: Path) -> bool | None:
    """Read ``PRINTABLE = bool`` statically so selection never builds geometry."""
    tree = ast.parse(entry.read_text(encoding="utf-8"), filename=str(entry))
    for node in tree.body:
        value = None
        if isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "PRINTABLE"
            for target in node.targets
        ):
            value = node.value
        elif (
            isinstance(node, ast.AnnAssign)
            and isinstance(node.target, ast.Name)
            and node.target.id == "PRINTABLE"
        ):
            value = node.value
        if value is not None:
            if isinstance(value, ast.Constant) and isinstance(value.value, bool):
                return value.value
            raise ValueError(f"{entry}: PRINTABLE must be the literal True or False")
    return None


def _printable_entries(assembly: Path, parts: list[Path]) -> list[Path]:
    """Select actual print targets while preserving legacy project defaults.

    Legacy ``part_*`` entries are printable.  A Tier 1 combined entry is also
    printable.  In a split project the combined entry is view-only unless it
    explicitly declares ``PRINTABLE = True``; logical review parts opt out with
    ``PRINTABLE = False``.
    """
    selected = [part for part in parts if _declared_printable(part) is not False]
    assembly_flag = _declared_printable(assembly)
    if assembly_flag is True or (not parts and assembly_flag is not False):
        selected.insert(0, assembly)
    return selected


def _parse_bed(raw: str) -> tuple[float, float, float]:
    parts = [item.strip() for item in re.split(r"[x×]", raw.lower())]
    if len(parts) != 3:
        raise argparse.ArgumentTypeError("bed must be WxDxH, for example 220x220x220")
    try:
        values = tuple(float(item) for item in parts)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("bed dimensions must be numbers") from exc
    if any(value <= 0 for value in values):
        raise argparse.ArgumentTypeError("bed dimensions must be positive")
    return values  # type: ignore[return-value]


def _parse_likeness_ref(raw: str) -> tuple[str, str]:
    if "=" not in raw:
        raise argparse.ArgumentTypeError(
            "likeness reference must be LABEL=PATH, for example hero=ref/hero.png"
        )
    label, path = raw.split("=", 1)
    label = label.strip()
    path = path.strip()
    if not SAFE_LABEL.fullmatch(label):
        raise argparse.ArgumentTypeError(
            "likeness label must start with a letter or digit and contain only "
            "letters, digits, dot, underscore, or hyphen"
        )
    if not path:
        raise argparse.ArgumentTypeError("likeness reference path is empty")
    return label, path


def _documented_assembly_claims(project: Path) -> list[str]:
    """Assembly-path claims that make a missing motion manifest observable.

    Part count alone is too broad: a print plate or independent variants can
    have many printable entries and no assembly. Prose is the stronger signal.
    Inspect only the project's README/spec, and require both an assembly scope
    and a mating action so ordinary mentions of an assembly do not trigger it.
    """
    claims: list[str] = []
    for path in (project / "README.md", *sorted(project.glob("*_spec.md"))):
        if not path.is_file():
            continue
        in_assembly_section = False
        for line_number, line in enumerate(
            path.read_text(encoding="utf-8", errors="replace").splitlines(), 1
        ):
            if line.startswith("#"):
                in_assembly_section = bool(ASSEMBLY_HEADING.match(line))
            scoped = in_assembly_section or bool(ASSEMBLY_ORDER.search(line))
            if scoped and MATING_ACTION.search(line):
                claims.append(f"{path.name}:{line_number}: {line.strip()}")
    return claims


def _read_likeness_history(project: Path) -> list[dict]:
    """Read the append-only likeness rows with the gate's tolerant semantics."""
    path = project / "measure" / "likeness-history.jsonl"
    if not path.is_file():
        return []
    rows = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def _history_reference_matches(
    row: dict,
    reference: Path,
    *,
    project: Path,
    cwd: Path,
) -> bool:
    """Match the producer's canonical identity, then legacy path spellings."""
    resolved = row.get("reference_resolved")
    if isinstance(resolved, str) and resolved:
        try:
            return Path(resolved).resolve() == reference.resolve()
        except OSError:
            return False
    raw = row.get("reference")
    if raw is None:  # rows written before references were stored: label-only compatibility
        return True
    if not isinstance(raw, str) or not raw:
        return False
    path = Path(raw)
    candidates = [path.resolve()] if path.is_absolute() else [
        (cwd / path).resolve(),
        (project / path).resolve(),
    ]
    return reference.resolve() in candidates


def _likeness_rows_for(
    history: list[dict],
    label: str,
    reference: Path,
    *,
    project: Path,
    cwd: Path,
) -> list[dict]:
    return [
        row for row in history
        if row.get("label") == label
        and _history_reference_matches(
            row, reference, project=project, cwd=cwd
        )
    ]


def _mismatch_acceptance_labels(
    project: Path,
    cwd: Path,
    likeness_refs: list[tuple[str, Path]],
) -> tuple[set[str], list[str]]:
    """Views whose latest failing loop has reached the stopping condition."""
    history = _read_likeness_history(project)
    eligible: set[str] = set()
    blockers: list[str] = []
    for label, reference in likeness_refs:
        rows = _likeness_rows_for(
            history, label, reference, project=project, cwd=cwd
        )
        if not rows:
            blockers.append(f"{label}: no scored history for this reference")
            continue
        latest = rows[-1]
        if latest.get("ok") is True:
            continue
        streak = latest.get("stall_streak")
        if not isinstance(streak, int):
            blockers.append(
                f"{label}: rerun check_likeness to record the stalled-out state"
            )
            continue
        if streak < LIKENESS_STALL_STREAK:
            blockers.append(
                f"{label}: {streak}/{LIKENESS_STALL_STREAK} consecutive "
                "stalled/regressing rounds"
            )
            continue
        eligible.add(label)
    return eligible, blockers


def _accepted_likeness_summary(
    project: Path,
    cwd: Path,
    likeness_refs: list[tuple[str, Path]],
    eligible_labels: set[str],
    prior_row_counts: dict[str, int],
) -> tuple[str | None, list[str]]:
    """Look up the fresh gate decision; do not reproduce its pass/fail rules."""
    history = _read_likeness_history(project)
    accepted: list[str] = []
    blockers: list[str] = []
    for label, reference in likeness_refs:
        rows = _likeness_rows_for(
            history, label, reference, project=project, cwd=cwd
        )
        if len(rows) <= prior_row_counts.get(label, 0):
            blockers.append(f"{label}: final likeness run wrote no history row")
            continue
        row = rows[-1]
        if row.get("ok") is True:
            continue
        failed_because = row.get("failed_because")
        if failed_because != "floor":
            blockers.append(
                f"{label}: final likeness failure is {failed_because or 'unclassified'}, "
                "not an accepted floor mismatch"
            )
            continue
        if label not in eligible_labels:
            blockers.append(f"{label}: this view was not stalled out before final")
            continue
        if row.get("trend") == "improving":
            blockers.append(
                f"{label}: likeness moved again in the final run; run another round "
                "before deciding whether to accept it"
            )
            continue
        streak = row.get("stall_streak")
        if not isinstance(streak, int) or streak < LIKENESS_STALL_STREAK:
            blockers.append(f"{label}: final likeness row is no longer stalled out")
            continue
        iou = row.get("iou")
        if not isinstance(iou, (int, float)):
            blockers.append(f"{label}: final likeness row has no numeric score")
            continue
        accepted.append(f"{label}={float(iou):.3f}<{LIKENESS_FLOOR:.2f}")
    return (", ".join(accepted) if accepted else None), blockers


def _component_steps(project: Path) -> tuple[list[Path], list[Path]]:
    """Component STEP files, split into canonical and misplaced paths.

    Generated STEP artifacts have a sibling ``.step.py`` entry and are not
    components. Every remaining STEP is bought/foreign geometry and must live
    under ``ref/`` so the final mount preflight cannot be bypassed by putting
    the supplier file in a sibling ``catalog/`` directory and checking a
    hand-authored envelope.
    """
    reference_dir = project / "ref"
    canonical: list[Path] = []
    misplaced: list[Path] = []
    for path in sorted(project.rglob("*")):
        if not path.is_file() or path.suffix.lower() not in {".step", ".stp"}:
            continue
        if "__cadgen__" in path.relative_to(project).parts:
            continue
        # ``part_body.step`` -> ``part_body.step.py``. A sibling source marks
        # a generated deliverable, not a fetched component.
        if Path(str(path) + ".py").is_file():
            continue
        if reference_dir in path.parents:
            canonical.append(path)
        else:
            misplaced.append(path)
    return canonical, misplaced


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _declared_mount_steps(project: Path, manifest: Path) -> dict[Path, list[str | None]]:
    """Return component STEP paths and checksums named by ``mounts.json``."""
    try:
        data = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"cannot read {manifest}: {error}") from error
    mounts = data.get("mounts") if isinstance(data, dict) else None
    if not isinstance(mounts, list) or not mounts:
        raise ValueError(f"{manifest} must contain a non-empty mounts list")
    declared: dict[Path, list[str | None]] = {}
    mount_ids: set[str] = set()
    for index, mount in enumerate(mounts):
        if not isinstance(mount, dict):
            raise ValueError(f"{manifest}: mounts[{index}] must be an object")
        mount_id = mount.get("id")
        if not isinstance(mount_id, str) or not mount_id.strip():
            raise ValueError(f"{manifest}: mounts[{index}].id is required")
        if mount_id in mount_ids:
            raise ValueError(f"{manifest}: duplicate mount id {mount_id!r}")
        mount_ids.add(mount_id)
        raw = mount.get("component")
        if not isinstance(raw, str) or not raw.strip():
            continue  # check_mount will report the exact malformed declaration
        candidate = (project / raw).resolve()
        try:
            candidate.relative_to(project)
        except ValueError:
            continue  # check_mount owns the project-local-path diagnostic
        checksum = mount.get("sha256")
        declared.setdefault(candidate, []).append(
            checksum if isinstance(checksum, str) else None
        )
    return declared


def _power_manifest_notes(path: Path) -> list[str]:
    """Surface valid-but-unresolved physical-fit claims in the final report."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    notes = []
    interfaces = data.get("mating_interfaces", []) if isinstance(data, dict) else []
    if not isinstance(interfaces, list):
        return notes
    for interface in interfaces:
        if not isinstance(interface, dict):
            continue
        coupon = interface.get("fit_coupon")
        if isinstance(coupon, dict) and coupon.get("status") == "planned":
            notes.append(
                f"mating interface {interface.get('id', '?')}: fit coupon is planned; "
                "physical fit remains unverified"
            )
    return notes


def _declared_bed(project: Path) -> tuple[float, float, float] | None:
    for path in (project / "README.md", *sorted(project.glob("*_spec.md"))):
        if not path.is_file():
            continue
        match = BED_DECLARATION.search(path.read_text(encoding="utf-8", errors="replace"))
        if match:
            return tuple(  # type: ignore[return-value]
                float(match.group(index)) for index in range(1, 4)
            )
    return None


def _command_label(args: Sequence[str]) -> str:
    if len(args) > 1 and Path(args[0]).name.startswith("python"):
        return Path(args[1]).name
    return Path(args[0]).name


class Runner:
    def __init__(self, *, cwd: Path, dry_run: bool, verbose: bool) -> None:
        self.cwd = cwd
        self.dry_run = dry_run
        self.verbose = verbose
        self.records: list[dict[str, object]] = []

    def command(
        self,
        argv: Sequence[str | Path],
        *,
        warm: bool = False,
        env_extra: dict[str, str] | None = None,
    ) -> int:
        args = [str(item) for item in argv]
        print(f"[verify_project] {shlex.join(args)}", flush=True)
        if self.dry_run:
            self.records.append({"command": shlex.join(args), "status": "planned", "seconds": 0.0})
            return 0
        env = dict(os.environ)
        if warm:
            env["CADGEN_WARM"] = "1"
        if env_extra:
            env.update(env_extra)
        started = time.perf_counter()
        return_code = subprocess.run(args, cwd=self.cwd, env=env, check=False).returncode
        elapsed = time.perf_counter() - started
        self.records.append(
            {"command": shlex.join(args), "status": f"rc={return_code}", "seconds": elapsed}
        )
        print(
            f"[verify_project] {_command_label(args)}: rc={return_code} "
            f"in {elapsed:.2f}s",
            flush=True,
        )
        return return_code

    def skipped(self, label: str, reason: str) -> None:
        """Record a gate that did not run.

        A gate that is absent from the report is indistinguishable from a gate
        that passed.  Every conditional check writes a row either way.
        """
        print(f"[verify_project] skip {label}: {reason}", flush=True)
        self.records.append(
            {"command": f"{label}  # NOT RUN: {reason}", "status": "skipped", "seconds": 0.0}
        )

    def note(self, label: str, detail: str) -> None:
        """Persist a non-failing limitation that changes the handoff claim."""
        print(f"[verify_project] note {label}: {detail}", flush=True)
        self.records.append(
            {"command": f"{label}  # NOTE: {detail}", "status": "note", "seconds": 0.0}
        )

    def inspect_batch(self, requests: list[dict[str, object]]) -> int:
        argv = [sys.executable, str(SCRIPTS_DIR / "inspect"), "batch"]
        print(f"[verify_project] {shlex.join(argv)}  # {len(requests)} JSONL request(s)", flush=True)
        if self.dry_run:
            for request in requests:
                print(json.dumps(request, separators=(",", ":")))
            self.records.append(
                {"command": f"{shlex.join(argv)} ({len(requests)} JSONL requests)",
                 "status": "planned", "seconds": 0.0}
            )
            return 0
        payload = "".join(json.dumps(request, separators=(",", ":")) + "\n" for request in requests)
        env = dict(os.environ)
        # Batch owns stdin and is itself the long-lived inspect process.  Do not
        # ask the no-stdin daemon protocol to carry it.
        env.pop("CADGEN_WARM", None)
        started = time.perf_counter()
        completed = subprocess.run(
            argv,
            cwd=self.cwd,
            env=env,
            input=payload,
            text=True,
            capture_output=True,
            check=False,
        )
        if completed.stderr:
            print(completed.stderr, file=sys.stderr, end="")
        failed = completed.returncode != 0
        response_count = 0
        for line in completed.stdout.splitlines():
            if not line.strip():
                continue
            response_count += 1
            try:
                response = json.loads(line)
            except ValueError:
                print(line)
                failed = True
                continue
            response_ok = isinstance(response, dict) and bool(response.get("ok"))
            if self.verbose or not response_ok:
                print(line)
            else:
                print(f"[verify_project] inspect {response.get('id', response_count)}: ok")
            if not response_ok:
                failed = True
        if response_count != len(requests):
            print(
                f"verify_project: inspect batch returned {response_count} response(s), "
                f"expected {len(requests)}",
                file=sys.stderr,
            )
            failed = True
        elapsed = time.perf_counter() - started
        self.records.append(
            {"command": f"{shlex.join(argv)} ({len(requests)} JSONL requests)",
             "status": f"rc={1 if failed else 0}", "seconds": elapsed}
        )
        print(
            f"[verify_project] inspect batch: rc={1 if failed else 0} "
            f"in {elapsed:.2f}s",
            flush=True,
        )
        return 1 if failed else 0


def _step_for_entry(entry: Path) -> Path:
    return entry.with_suffix("")


def _stl_for_entry(entry: Path) -> Path:
    return _step_for_entry(entry).with_suffix(".stl")


def _run_or_stop(runner: Runner, argv: Sequence[str | Path], **kwargs) -> bool:
    return runner.command(argv, **kwargs) == 0


def _audit_env(project: Path) -> dict[str, str]:
    current_pythonpath = os.environ.get("PYTHONPATH", "")
    value = str(project)
    if current_pythonpath:
        value += os.pathsep + current_pythonpath
    return {"PYTHONPATH": value}


def _write_report(
    path: Path,
    runner: Runner,
    *,
    mode: str,
    result: int,
    elapsed: float,
    bed: tuple[float, float, float],
    preserve_existing: bool = False,
) -> None:
    previous = None
    if preserve_existing and path.is_file():
        previous = path.read_text(encoding="utf-8")
    accepted_failures = sum(
        1 for record in runner.records if record.get("status") == "accepted-fail"
    )
    result_text = "PASS" if result == 0 else "FAIL"
    if result == 0 and accepted_failures:
        noun = "gate" if accepted_failures == 1 else "gates"
        result_text += f" ({accepted_failures} accepted failing {noun})"
    lines = [
        "# Verification pipeline record",
        "",
        f"- Recorded: {datetime.now(timezone.utc).isoformat(timespec='seconds')}",
        f"- Mode: `{mode}`",
        f"- Result: **{result_text}** (exit {result})",
        f"- Elapsed: {elapsed:.2f} s",
        f"- Bed: {bed[0]:g} x {bed[1]:g} x {bed[2]:g} mm",
        "",
        "| # | command | result | seconds |",
        "|---:|---|---:|---:|",
    ]
    for index, record in enumerate(runner.records, 1):
        command = str(record["command"]).replace("|", "\\|")
        lines.append(
            f"| {index} | `{command}` | {record['status']} | "
            f"{float(record['seconds']):.2f} |"
        )
    lines.append("")
    if previous:
        lines.extend([
            "---",
            "",
            "## Previous pipeline record (preserved)",
            "",
            previous.rstrip(),
            "",
        ])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines), encoding="utf-8")


def _quick(
    runner: Runner,
    assembly: Path,
    *,
    preview_tolerance: float,
) -> int:
    assembly_arg = _path_arg(assembly, runner.cwd)
    if not _run_or_stop(
        runner,
        [
            sys.executable,
            SCRIPTS_DIR / "gen",
            assembly_arg,
            "--mesh-tolerance",
            str(preview_tolerance),
            "--json",
        ],
        warm=True,
    ):
        return 1
    return 0


def _final(
    runner: Runner,
    project: Path,
    assembly: Path,
    parts: list[Path],
    printables: list[Path],
    *,
    motion_manifest: Path | None,
    exports: bool,
    strict_fit: bool,
    strict_mount: bool,
    bed: tuple[float, float, float],
    nozzle: float,
    skip_thickness: bool,
    image_derived: bool,
    likeness_refs: list[tuple[str, Path]],
    likeness_min: float,
    likeness_accept_mismatch: str | None,
    likeness_mismatch_labels: set[str],
    likeness_accept_regression: str | None,
    search_fov: str,
) -> int:
    entries = [assembly, *parts]
    entry_args = [_path_arg(path, runner.cwd) for path in entries]

    if not _run_or_stop(
        runner,
        [sys.executable, SCRIPTS_DIR / "gen", *entry_args, "--write", "--json"],
        warm=True,
    ):
        return 1

    if printables:
        fit_args: list[str | Path] = [
            sys.executable,
            SCRIPTS_DIR / "check_fit",
            _path_arg(project, runner.cwd),
            "--bed",
            str(bed[0]),
            str(bed[1]),
        ]
        for printable in printables:
            fit_args.extend(["--entry", _path_arg(printable, runner.cwd)])
        if strict_fit:
            fit_args.append("--strict")
        if not _run_or_stop(runner, fit_args):
            return 1
    else:
        runner.skipped(
            "check_fit",
            "no printable entry is declared; geometry-only final workflow",
        )

    for audit_name in ("check_fit.py", "check_spec.py", "check_landmarks.py"):
        local_audit = project / "measure" / audit_name
        if local_audit.is_file():
            if not _run_or_stop(
                runner,
                [sys.executable, _path_arg(local_audit, runner.cwd)],
                env_extra=_audit_env(project),
            ):
                return 1

    mount_manifest = project / "measure" / "mounts.json"
    if mount_manifest.is_file():
        mount_args: list[str | Path] = [
            sys.executable,
            SCRIPTS_DIR / "check_mount",
            _path_arg(project, runner.cwd),
        ]
        if strict_mount:
            mount_args.append("--strict")
        if not _run_or_stop(
            runner,
            mount_args,
        ):
            return 1
    else:
        runner.skipped(
            "check_mount",
            f"no {mount_manifest.relative_to(project)}; no bought part is declared seated",
        )

    power_manifest = project / "measure" / "power.json"
    if power_manifest.is_file():
        power_gate = POWER_SCRIPTS_DIR / "check_power"
        if not power_gate.is_file():
            print(
                f"verify_project: powered-system gate not found: {power_gate}",
                file=sys.stderr,
            )
            return 2
        if not _run_or_stop(
            runner,
            [
                sys.executable,
                power_gate,
                _path_arg(project, runner.cwd),
                "--manifest",
                _path_arg(power_manifest, runner.cwd),
            ],
        ):
            return 1
        for note in _power_manifest_notes(power_manifest):
            runner.note("check_power", note)
    else:
        runner.skipped(
            "check_power",
            "no measure/power.json; no functional powered system is declared",
        )

    if motion_manifest is not None:
        if not motion_manifest.is_file():
            print(f"verify_project: motion manifest not found: {motion_manifest}", file=sys.stderr)
            return 2
        if not _run_or_stop(
            runner,
            [
                sys.executable,
                SCRIPTS_DIR / "check_motion",
                _path_arg(project, runner.cwd),
                "--manifest",
                _path_arg(motion_manifest, runner.cwd),
            ],
        ):
            return 1
    else:
        runner.skipped(
            "check_motion",
            "no documented mating/assembly action and no moving joint is declared",
        )

    if image_derived:
        snap_dir = project / "snap"
        render_args: list[str | Path] = [
            sys.executable,
            IMAGE_SCRIPTS_DIR / "render_views.py",
            _path_arg(assembly, runner.cwd),
            "--view", "front",
            "--view", "right",
            "--view", "top",
            "--view", "iso",
        ]
        for label, reference in likeness_refs:
            render_args.extend(
                ["--match", _path_arg(reference, runner.cwd), "--label", f"match-{label}"]
            )
        render_args.extend(
            [
                "--search-fov", search_fov,
                # check_likeness is the acceptance gate below.  Zero here lets
                # the renderer finish writing every view even when likeness is
                # poor; a non-zero exit still catches source-vs-STEP drift.
                "--min", "0",
                "--compare-step",
                "--json",
                "-o", _path_arg(snap_dir, runner.cwd),
            ]
        )
        if not _run_or_stop(runner, render_args):
            return 1

        likeness_args: list[str | Path] = [
            sys.executable,
            IMAGE_SCRIPTS_DIR / "check_likeness.py",
        ]
        for label, reference in likeness_refs:
            likeness_args.extend(
                [
                    "--pair", _path_arg(snap_dir / f"match-{label}.png", runner.cwd),
                    _path_arg(reference, runner.cwd),
                    "--label", label,
                ]
            )
        likeness_args.extend(
            [
                "--min", str(likeness_min),
                "--report", _path_arg(project / "measure" / "likeness.md", runner.cwd),
            ]
        )
        if likeness_accept_regression:
            likeness_args.extend(["--accept-regression", likeness_accept_regression])
        history_before = _read_likeness_history(project)
        prior_row_counts = {
            label: len(_likeness_rows_for(
                history_before, label, reference, project=project, cwd=runner.cwd
            ))
            for label, reference in likeness_refs
        }
        likeness_rc = runner.command(likeness_args)
        if likeness_rc != 0:
            accepted = None
            acceptance_blockers: list[str] = []
            if likeness_rc == 1 and likeness_accept_mismatch:
                accepted, acceptance_blockers = _accepted_likeness_summary(
                    project,
                    runner.cwd,
                    likeness_refs,
                    likeness_mismatch_labels,
                    prior_row_counts,
                )
            if accepted is None or acceptance_blockers:
                for blocker in acceptance_blockers:
                    print(f"verify_project: {blocker}", file=sys.stderr)
                return 1
            # Keep the child gate's raw non-zero result observable while
            # recording that this specific failure no longer blocks delivery.
            runner.records[-1]["status"] = "accepted-fail"
            runner.note(
                "check_likeness acceptance",
                f"raw floor failure accepted by user: {accepted}; "
                f"reason: {likeness_accept_mismatch}",
            )
        elif likeness_accept_mismatch:
            print(
                "verify_project: warning: --likeness-accept-mismatch was not needed; "
                "the fresh likeness gate passed, so no acceptance decision was recorded",
                file=sys.stderr,
            )

    requests: list[dict[str, object]] = []
    for index, entry in enumerate(entry_args):
        label = "assembly" if index == 0 else Path(entry).name.removesuffix(ENTRY_SUFFIX)
        requests.extend(
            [
                {
                    "id": f"refs:{label}",
                    "argv": ["refs", entry, "--facts", "--planes", "--positioning"],
                },
                {"id": f"validate:{label}", "argv": ["validate", entry]},
            ]
        )
    requests.append(
        {
            "id": "interfere:assembly",
            "argv": ["interfere", entry_args[0]],
        }
    )
    if runner.inspect_batch(requests) != 0:
        return 1

    if exports:
        assembly_step = _step_for_entry(assembly)
        if not _run_or_stop(
            runner,
            [sys.executable, SCRIPTS_DIR / "export", _path_arg(assembly_step, runner.cwd), "--glb", "--json"],
            warm=True,
        ):
            return 1
        for printable in printables:
            part_step = _step_for_entry(printable)
            if not _run_or_stop(
                runner,
                [sys.executable, SCRIPTS_DIR / "export", _path_arg(part_step, runner.cwd), "--stl", "--json"],
                warm=True,
            ):
                return 1
            if not _run_or_stop(
                runner,
                [
                    sys.executable,
                    SCRIPTS_DIR / "check_mesh",
                    _path_arg(_stl_for_entry(printable), runner.cwd),
                    "--bed",
                    f"{bed[0]:g}x{bed[1]:g}x{bed[2]:g}",
                ],
            ):
                return 1
            if not skip_thickness:
                role = printable.name.removesuffix(ENTRY_SUFFIX)
                if role.startswith(PART_PREFIX):
                    role = role.removeprefix(PART_PREFIX)
                if not _run_or_stop(
                    runner,
                    [
                        sys.executable,
                        SCRIPTS_DIR / "check_thickness",
                        _path_arg(_stl_for_entry(printable), runner.cwd),
                        "--nozzle", str(nozzle),
                        "--report",
                        _path_arg(project / "measure" / f"thickness-{role}.md", runner.cwd),
                    ],
                ):
                    return 1

    return 0


# --------------------------------------------------------------------------
# self-check
# --------------------------------------------------------------------------
#
# Everything this runner refuses, it refuses in argument and manifest
# validation -- before a single solid is built.  That makes those refusals the
# cheapest thing in the toolchain to break and the hardest to notice: a gate
# that quietly stops being required still prints a clean run.  The fixtures
# below build a paper project in a temporary directory and assert that each
# refusal still fires, and that it fires for the stated reason.  No geometry,
# no daemon, no kernel import.
#
# Every fixture asserts the REASON as well as the exit status.  A refusal that
# still happens for a different reason is how one of these stops testing what
# its name says while continuing to pass.


def _sc_project(root: Path, extra: dict[str, str] | None = None) -> Path:
    """A project directory made only of the files a refusal reads."""
    project = root / "proj"
    if project.exists():
        shutil.rmtree(project)
    (project / "measure").mkdir(parents=True)
    (project / "ref").mkdir()
    (project / "widget.step.py").write_text(
        "PRINTABLE = True\n\n\ndef gen_step():\n    return None\n", encoding="utf-8")
    (project / "widget_spec.md").write_text("# spec\n", encoding="utf-8")
    (project / "measure" / "check_spec.py").write_text("raise SystemExit(0)\n", encoding="utf-8")
    (project / "measure" / "check_landmarks.py").write_text("raise SystemExit(0)\n", encoding="utf-8")
    (project / "ref" / "hero.png").write_bytes(b"\x89PNG\r\n\x1a\n")
    (project / "snap").mkdir()
    iso = b"fixture iso"
    signature = b"fixture signature"
    (project / "snap" / "iso.png").write_bytes(iso)
    (project / "snap" / "signature.png").write_bytes(signature)
    review = {
        "schema_version": 3,
        "kind": SIGNATURE_REVIEW_KIND,
        "iso_sha256": hashlib.sha256(iso).hexdigest(),
        "signature_sha256": hashlib.sha256(signature).hexdigest(),
        "reviewer": "fixture-critic",
        "blind_held_read": "A fixture product.",
        "blind_subjects_read": "A fixture and its exact parts.",
        "blind_action_read": "The fixture changes state.",
        "blind_relationship_read": "The parts align into the promised state.",
        "wish_revealed_after_blind_read": True,
        "held_object_unmistakable": True,
        "subjects_match_wish": True,
        "action_matches_wish": True,
        "relationship_matches_wish": True,
        "signature_experience_unmistakable": True,
        "finished_product_desirable": True,
        "review_rounds": 1,
        "largest_risk": "Fixture risk.",
        "resolution": "Fixture resolution.",
    }
    (project / SIGNATURE_REVIEW_RELATIVE).write_text(
        json.dumps(review, sort_keys=True, separators=(",", ":")),
        encoding="utf-8",
    )
    for rel, body in (extra or {}).items():
        target = project / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(body, encoding="utf-8")
    return project


def _sc_refuses(argv: list[str]) -> tuple[bool, str]:
    """Run main() and report whether it refused, with the reason it printed.

    A refusal must come from validation, so this also fails a run that merely
    exits non-zero after starting the pipeline -- that is a broken fixture, not
    a working guard.
    """
    import contextlib
    import io

    err, out = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(out):
            code = main(argv)
    except SystemExit as exc:
        code = exc.code
    lines = [line for line in err.getvalue().strip().splitlines() if line]
    started = "check_layout" in out.getvalue()
    return (code not in (0, None) and not started), (lines[-1] if lines else "")


def self_check() -> int:
    ok = True

    def fixture(claim: str, argv: list[str], reason: str) -> None:
        nonlocal ok
        refused, why = _sc_refuses(argv)
        hit = refused and reason in why
        print(f"{'ok  ' if hit else 'FAIL'} {claim}")
        if not hit:
            print(f"       wanted a refusal naming {reason!r}, got: {why or '(ran)'}")
        ok &= hit

    import tempfile

    origin = Path.cwd()
    with tempfile.TemporaryDirectory() as td:
        root = Path(td).resolve()
        os.chdir(root)
        try:
            img = ["proj", "--exports", "--image-derived",
                   "--likeness-ref", "hero=ref/hero.png"]

            _sc_project(root)
            fixture("image-derived final refuses an unclassified power state",
                    img, "power classification")

            _sc_project(root)
            fixture("--powered without measure/power.json is refused, not skipped",
                    img + ["--powered"], "power.json")

            _sc_project(root, {"measure/power.json": '{"schemaVersion": 3}'})
            fixture("--unpowered cannot talk past an existing power.json",
                    img + ["--unpowered"], "contradicts")

            # a fetched component with no mount row is a seat nothing measured
            _sc_project(root, {"ref/servo.step": "ISO-10303-21;\nEND-ISO-10303-21;\n"})
            fixture("a component STEP under ref/ with no mount declaration blocks final",
                    img + ["--unpowered"], "mounts.json")

            _sc_project(root, {"catalog/servo.step": "ISO-10303-21;\nEND-ISO-10303-21;\n"})
            fixture("a component STEP outside ref/ cannot bypass the mount preflight",
                    img + ["--unpowered"], "Move a component source under ref/")

            _sc_project(root)
            fixture("the final likeness floor cannot be lowered",
                    img + ["--unpowered", "--likeness-min", "0.5"], "fixed")

            _sc_project(root)
            fixture("an accepted mismatch cannot lower the fixed final floor",
                    img + ["--unpowered", "--likeness-min", "0.5",
                           "--likeness-accept-mismatch", "single oblique view"],
                    "fixed")

            _sc_project(root)
            fixture("a mismatch acceptance without image-derived mode is refused",
                    ["proj", "--exports", "--likeness-accept-mismatch", "fixture"],
                    "requires --image-derived")

            _sc_project(root)
            fixture("a user mismatch acceptance cannot skip the stalled-out condition",
                    img + ["--unpowered", "--likeness-accept-mismatch", "fixture"],
                    "stalled out")

            project = _sc_project(root)
            reference = project / "ref" / "hero.png"
            history_path = project / "measure" / "likeness-history.jsonl"
            conflicting_identity = {
                "reference": str(reference),
                "reference_resolved": str(project / "ref" / "different.png"),
            }
            hit = not _history_reference_matches(
                conflicting_identity, reference, project=project, cwd=root
            )
            print(f"{'ok  ' if hit else 'FAIL'} a canonical reference mismatch "
                  "cannot fall through to a matching legacy spelling")
            ok &= hit

            stalled_rows = [
                {"run": 1, "label": "hero", "reference": str(reference),
                 "iou": 0.75, "trend": "first", "ok": False,
                 "failed_because": "floor", "stall_streak": 0},
                {"run": 2, "label": "hero", "reference": str(reference),
                 "iou": 0.75, "trend": "stalled", "ok": False,
                 "failed_because": "floor", "stall_streak": 1},
                {"run": 3, "label": "hero", "reference": str(reference),
                 "iou": 0.74, "trend": "regressing", "ok": False,
                 "failed_because": "regression", "stall_streak": 2},
                {"run": 4, "label": "hero", "reference": str(reference),
                 "iou": 0.74, "trend": "stalled", "ok": False,
                 "failed_because": "floor", "stall_streak": 3},
            ]
            for row in stalled_rows:
                # The raw spelling came from another working directory and is
                # ambiguous here; the producer-recorded identity is authoritative.
                row["reference"] = "ref/from-another-cwd.png"
                row["reference_resolved"] = str(reference)
            history_path.write_text(
                "".join(json.dumps(row) + "\n" for row in stalled_rows),
                encoding="utf-8",
            )
            eligible, blockers = _mismatch_acceptance_labels(
                project, root, [("hero", reference)]
            )
            hit = eligible == {"hero"} and not blockers
            print(f"{'ok  ' if hit else 'FAIL'} canonical reference identity keeps "
                  "three cross-CWD non-improving rounds eligible")
            ok &= hit

            summary, blockers = _accepted_likeness_summary(
                project, root, [("hero", reference)], eligible, {"hero": 4}
            )
            hit = summary is None and any("no history row" in blocker
                                          for blocker in blockers)
            print(f"{'ok  ' if hit else 'FAIL'} a child failure cannot reuse the "
                  "last row when no fresh history was written")
            ok &= hit

            summary, blockers = _accepted_likeness_summary(
                project, root, [("hero", reference)], eligible, {"hero": 3}
            )
            hit = summary == "hero=0.740<0.90" and not blockers
            print(f"{'ok  ' if hit else 'FAIL'} accepted-fail keeps the raw score "
                  f"visible  - {summary}")
            ok &= hit

            stalled_rows[-1]["trend"] = "improving"
            stalled_rows[-1]["stall_streak"] = 0
            history_path.write_text(
                "".join(json.dumps(row) + "\n" for row in stalled_rows),
                encoding="utf-8",
            )
            summary, blockers = _accepted_likeness_summary(
                project, root, [("hero", reference)], eligible, {"hero": 3}
            )
            hit = summary is None and any("moved again" in blocker
                                          for blocker in blockers)
            print(f"{'ok  ' if hit else 'FAIL'} a fresh improving row cancels a "
                  "previously unlocked acceptance")
            ok &= hit

            eligible, blockers = _mismatch_acceptance_labels(
                project, root, [("hero", reference)]
            )
            hit = not eligible and any("0/3" in blocker for blocker in blockers)
            print(f"{'ok  ' if hit else 'FAIL'} an improving round resets the "
                  "acceptance streak")
            ok &= hit

            stalled_rows[-1].update({
                "trend": "stalled", "stall_streak": 3,
                "failed_because": "regression", "ok": False,
            })
            history_path.write_text(
                "".join(json.dumps(row) + "\n" for row in stalled_rows),
                encoding="utf-8",
            )
            eligible, blockers = _mismatch_acceptance_labels(
                project, root, [("hero", reference)]
            )
            summary, final_blockers = _accepted_likeness_summary(
                project, root, [("hero", reference)], eligible, {"hero": 3}
            )
            hit = (eligible == {"hero"} and not blockers and summary is None
                   and any("regression" in blocker for blocker in final_blockers))
            print(f"{'ok  ' if hit else 'FAIL'} an unaccepted regression remains "
                  "blocked after the loop stalls")
            ok &= hit

            stalled_rows[-1].update({
                "iou": 0.95, "trend": "improving", "stall_streak": 0,
                "failed_because": None, "ok": True,
            })
            history_path.write_text(
                "".join(json.dumps(row) + "\n" for row in stalled_rows),
                encoding="utf-8",
            )
            eligible, blockers = _mismatch_acceptance_labels(
                project, root, [("hero", reference)]
            )
            hit = not eligible and not blockers
            print(f"{'ok  ' if hit else 'FAIL'} an already passing history lets the "
                  "fresh gate prove the acceptance flag unnecessary")
            ok &= hit

            report_runner = Runner(cwd=root, dry_run=False, verbose=False)
            report_runner.records.append(
                {"command": "check_likeness", "status": "accepted-fail", "seconds": 0.1}
            )
            report_path = root / "accepted-report.md"
            _write_report(
                report_path, report_runner, mode="final", result=0, elapsed=0.1,
                bed=DEFAULT_BED,
            )
            headline = report_path.read_text(encoding="utf-8")
            hit = "Result: **PASS (1 accepted failing gate)**" in headline
            print(f"{'ok  ' if hit else 'FAIL'} report headline exposes an accepted "
                  "failing gate")
            ok &= hit

            # the two audits are required precisely because no generic gate can
            # state a project's own claim
            project = _sc_project(root)
            (project / "measure" / "check_landmarks.py").unlink()
            fixture("a missing landmark audit is a refusal, not a skipped row",
                    img + ["--unpowered"], "check_landmarks.py")

            _sc_project(root)
            fixture("a likeness reference without --image-derived is refused",
                    ["proj", "--exports", "--likeness-ref", "hero=ref/hero.png"],
                    "--likeness-ref requires --image-derived")

            _sc_project(root)
            fixture("a regression waiver without --image-derived is refused",
                    ["proj", "--exports", "--likeness-accept-regression", "fixture"],
                    "requires --image-derived")

            _sc_project(root)
            fixture("image-derived cannot skip the thickness gate",
                    img + ["--unpowered", "--skip-thickness"], "thickness")

            # the two --bed forms are not interchangeable, and the error has to
            # say so rather than silently taking the first number
            got = _parse_bed("256x256x256")
            hit = got == (256.0, 256.0, 256.0)
            print(f"{'ok  ' if hit else 'FAIL'} --bed parses the WxDxH form  - {got}")
            ok &= hit
            try:
                _parse_bed("220 220")
                hit = False
            except Exception:
                hit = True
            print(f"{'ok  ' if hit else 'FAIL'} and rejects check_fit's two-number form")
            ok &= hit

            # PRINTABLE is what separates a review entry from a print target
            project = _sc_project(root)
            (project / "part_body.step.py").write_text(
                "def gen_step():\n    return None\n", encoding="utf-8")
            (project / "part_view.step.py").write_text(
                "PRINTABLE = False\n\n\ndef gen_step():\n    return None\n",
                encoding="utf-8")
            assembly, parts = _discover_entries(project, None, root)
            names = sorted(path.name for path in _printable_entries(assembly, parts))
            hit = names == ["part_body.step.py", "widget.step.py"]
            print(f"{'ok  ' if hit else 'FAIL'} PRINTABLE = False keeps a review "
                  f"entry out of the print targets  - {names}")
            ok &= hit

            project = _sc_project(root, {
                "README.md": "# Widget\n\n## Assembly\n\n1. Insert the lid into the body.\n",
                "part_lid.step.py": "def gen_step():\n    return None\n",
            })
            fixture("a documented assembly path cannot become a skipped motion gate",
                    img + ["--unpowered"], "no motion manifest exists")

            project = _sc_project(root)
            _sc_refuses(img)
            report = project / "measure" / "verification-pipeline.md"
            report_text = report.read_text(encoding="utf-8") if report.is_file() else ""
            hit = "| `preflight  # ERROR:" in report_text and "| refused |" in report_text
            print(f"{'ok  ' if hit else 'FAIL'} a final preflight refusal is recorded")
            ok &= hit

            project = _sc_project(root)
            report = project / "measure" / "verification-pipeline.md"
            previous = "DELIVERED RUN EVIDENCE\n"
            report.write_text(previous, encoding="utf-8")
            _sc_refuses(img)
            report_text = report.read_text(encoding="utf-8")
            hit = "| refused |" in report_text and previous.strip() in report_text
            print(f"{'ok  ' if hit else 'FAIL'} a preflight refusal preserves the prior record")
            ok &= hit

            project = _sc_project(root)
            report = project / "measure" / "verification-pipeline.md"
            report.write_text(previous, encoding="utf-8")
            _sc_refuses(["proj", "--nozzle", "0"])
            hit = report.read_text(encoding="utf-8") == previous
            print(f"{'ok  ' if hit else 'FAIL'} an argument typo cannot rewrite project evidence")
            ok &= hit

            project = _sc_project(root)
            _sc_refuses(img + ["--report", "../outside.md"])
            hit = not (project / "measure" / "verification-pipeline.md").exists()
            print(f"{'ok  ' if hit else 'FAIL'} an invalid --report path is not redirected")
            ok &= hit

            project = _sc_project(root)
            measure = project / "measure"
            measure.chmod(0o500)
            try:
                refused, why = _sc_refuses(img)
            finally:
                measure.chmod(0o700)
            hit = refused and "power classification" in why
            print(f"{'ok  ' if hit else 'FAIL'} report write failure cannot hide the refusal")
            ok &= hit
        finally:
            os.chdir(origin)

    print("\nall fixtures pass" if ok else "\nself-check FAILED")
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("project", help="project directory containing *.step.py entries")
    parser.add_argument("--assembly", help="combined entry; inferred when exactly one non-part entry exists")
    parser.add_argument("--quick", action="store_true", help="combined-entry preview generation only")
    parser.add_argument("--fresh", action="store_true", help="delete only this project's __cadgen__ cache before running")
    parser.add_argument("--exports", action="store_true", help="final mode: write assembly GLB and printable-entry STLs, then check each mesh and wall thickness")
    parser.add_argument("--strict-fit", action="store_true", help="final mode: promote check_fit advisory notes to failures")
    parser.add_argument("--strict-mount", action="store_true", help="final mode: promote check_mount advisory notes to failures")
    parser.add_argument("--powered", action="store_true", help="final mode: require measure/power.json and run the powered-system gate")
    parser.add_argument("--unpowered", action="store_true", help="image-derived final: explicitly declare that the product has no functional electrical load")
    parser.add_argument("--motion-manifest", help="motion JSON; defaults to measure/motion.json when present")
    parser.add_argument("--bed", type=_parse_bed, help="printer bed WxDxH (default: project declaration, then 220x220x220)")
    parser.add_argument("--preview-tolerance", type=float, default=DEFAULT_PREVIEW_TOLERANCE, help="quick-mode render mesh tolerance (default: 0.1)")
    parser.add_argument("--nozzle", type=float, default=0.4, help="nozzle diameter for exported-part thickness gates (default: 0.4 mm)")
    parser.add_argument("--skip-thickness", action="store_true", help="export/check meshes without the print-thickness gate; output cannot be called print-ready")
    parser.add_argument("--image-derived", action="store_true", help="require spec/landmark audits and run render, STEP-drift, and likeness gates")
    parser.add_argument(
        "--likeness-ref",
        action="append",
        type=_parse_likeness_ref,
        default=[],
        metavar="LABEL=PATH",
        help="reference image inside the project; repeat for every usable viewpoint",
    )
    parser.add_argument("--likeness-min", type=float, default=0.90, help="minimum IoU for every likeness pair; final delivery cannot set it below 0.90")
    parser.add_argument("--likeness-accept-mismatch", metavar="REASON", help="accept a raw sub-0.90 likeness failure after the same view/reference has stalled out; preserves the failing score and records the user reason")
    parser.add_argument("--likeness-accept-regression", metavar="REASON", help="record why a final score below the best prior run is accepted; passed through to check_likeness")
    parser.add_argument("--search-fov", default="0,25,40", help="comma-separated FOVs for reference-pose search (default: 0,25,40)")
    parser.add_argument("--report", help="final pipeline record path inside project (default: measure/verification-pipeline.md)")
    parser.add_argument("--no-report", action="store_true", help="do not persist the final pipeline record")
    parser.add_argument("--dry-run", action="store_true", help="print the sequential plan without changing files")
    parser.add_argument("--verbose", action="store_true", help="print complete successful inspect JSON responses")
    parser.add_argument("--self-check", action="store_true", help="run the built-in validation fixtures and exit")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    if "--self-check" in (list(argv) if argv is not None else sys.argv[1:]):
        return self_check()
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    cwd = Path.cwd().resolve()
    project = (cwd / args.project).resolve() if not Path(args.project).is_absolute() else Path(args.project).resolve()
    if not project.is_dir():
        parser.error(f"project is not a directory: {project}")
    try:
        project.relative_to(cwd)
    except ValueError:
        parser.error(f"project must be inside the command cwd: {project}")

    def refuse(message: str) -> None:
        """Reject a resolved project's preflight and leave an auditable row.

        Argument parsing can fail before a project is known, but once a valid
        project is in hand a final run must not disappear from its pipeline
        record merely because it was cheap enough to fail before geometry.
        """
        if not args.quick and not args.no_report and not args.dry_run:
            final_report = project / "measure" / "verification-pipeline.md"
            report_is_valid = True
            if args.report:
                try:
                    requested = _resolve_inside_project(args.report, project, cwd)
                except ValueError:
                    requested = None
                    report_is_valid = False
                if requested is not None:
                    final_report = requested
            if report_is_valid:
                runner = Runner(cwd=cwd, dry_run=False, verbose=bool(args.verbose))
                runner.records.append({
                    "command": f"preflight  # ERROR: {message}",
                    "status": "refused",
                    "seconds": 0.0,
                })
                mode = "image-derived final" if args.image_derived else "final"
                try:
                    _write_report(
                        final_report,
                        runner,
                        mode=mode,
                        result=2,
                        elapsed=0.0,
                        bed=args.bed or DEFAULT_BED,
                        preserve_existing=True,
                    )
                except OSError as exc:
                    print(
                        f"verify_project: warning: could not write preflight report "
                        f"{final_report}: {exc}",
                        file=sys.stderr,
                    )
                else:
                    print(f"[verify_project] wrote preflight failure {final_report}", flush=True)
        parser.error(message)

    if args.preview_tolerance <= 0:
        parser.error("--preview-tolerance must be positive")
    if args.nozzle <= 0:
        parser.error("--nozzle must be positive")
    if not 0 <= args.likeness_min <= 1:
        parser.error("--likeness-min must be between 0 and 1")
    if args.likeness_accept_mismatch is not None:
        args.likeness_accept_mismatch = args.likeness_accept_mismatch.strip()
        if not args.likeness_accept_mismatch:
            parser.error("--likeness-accept-mismatch requires a non-empty user reason")
    if args.likeness_min < LIKENESS_FLOOR:
        parser.error(
            f"--likeness-min {args.likeness_min:.2f} is below the {LIKENESS_FLOOR:.2f} "
            "fixed delivery floor. A final --likeness-accept-mismatch decision may "
            "accept a stalled failing result, but it never lowers this floor"
        )
    if args.quick and args.exports:
        parser.error("--exports is a final-mode option and cannot be combined with --quick")
    if args.quick and args.strict_fit:
        parser.error("--strict-fit is a final-mode option and cannot be combined with --quick")
    if args.quick and (args.image_derived or args.likeness_ref):
        parser.error("image-derived gates are final-mode options and cannot be combined with --quick")
    if args.quick and (args.strict_mount or args.skip_thickness):
        parser.error("--strict-mount/--skip-thickness are final-mode options and cannot be combined with --quick")
    if args.quick and args.powered:
        parser.error("--powered is a final-mode option and cannot be combined with --quick")
    if args.quick and args.unpowered:
        parser.error("--unpowered is a final-mode option and cannot be combined with --quick")
    if args.powered and args.unpowered:
        parser.error("--powered and --unpowered are mutually exclusive")
    if args.unpowered and not args.image_derived:
        parser.error("--unpowered is only needed with --image-derived")
    if args.likeness_ref and not args.image_derived:
        parser.error("--likeness-ref requires --image-derived")
    if args.likeness_accept_mismatch and not args.image_derived:
        parser.error("--likeness-accept-mismatch requires --image-derived")
    if args.likeness_accept_regression and not args.image_derived:
        parser.error("--likeness-accept-regression requires --image-derived")
    if args.image_derived and not args.exports:
        parser.error("--image-derived is a completion gate and requires --exports")
    if args.image_derived and args.skip_thickness:
        parser.error("--image-derived cannot skip the required thickness gate")
    if args.skip_thickness and not args.exports:
        parser.error("--skip-thickness only applies with --exports")
    if args.report and args.no_report:
        parser.error("--report and --no-report are mutually exclusive")
    signature_review_sha256 = None
    if not args.quick and not args.dry_run:
        try:
            signature_review_sha256 = _required_signature_review(project)
        except ValueError as exc:
            refuse(str(exc))
    try:
        assembly, parts = _discover_entries(project, args.assembly, cwd)
        printables = _printable_entries(assembly, parts)
        explicit_motion = _resolve_inside_project(args.motion_manifest, project, cwd)
        report_path = _resolve_inside_project(args.report, project, cwd)
        likeness_refs = [
            (label, _resolve_inside_project(raw_path, project, cwd))
            for label, raw_path in args.likeness_ref
        ]
    except (OSError, SyntaxError, ValueError) as exc:
        refuse(str(exc))

    labels = [label for label, _reference in likeness_refs]
    if len(labels) != len(set(labels)):
        refuse("--likeness-ref labels must be unique within one final run")

    if args.exports and not printables:
        refuse(
            "--exports requires at least one printable entry. Legacy part_* entries "
            "are printable; logical entries set PRINTABLE = False and a combined "
            "one-piece print target sets PRINTABLE = True"
        )

    motion_manifest = explicit_motion
    if motion_manifest is None and (project / "measure" / "motion.json").is_file():
        motion_manifest = project / "measure" / "motion.json"
    assembly_claims = _documented_assembly_claims(project) if not args.quick else []
    if motion_manifest is None and assembly_claims:
        refuse(
            "README/spec documents an assembly action but no motion manifest exists: "
            f"{assembly_claims[0]} Add measure/motion.json with the insertion/retention "
            "or assembly_sequence conditions; absence cannot turn a documented path into "
            "a skipped gate"
        )
    if args.powered and not (project / "measure" / "power.json").is_file():
        refuse(
            "--powered requires measure/power.json; run "
            "$electromechanical-integration before final verification"
        )
    if args.unpowered and (project / "measure" / "power.json").is_file():
        refuse(
            "--unpowered contradicts the existing measure/power.json; use --powered or "
            "remove a stale manifest"
        )

    if not args.quick:
        component_steps, misplaced_steps = _component_steps(project)
        if misplaced_steps:
            listed = ", ".join(
                str(path.relative_to(project)) for path in misplaced_steps[:4]
            )
            if len(misplaced_steps) > 4:
                listed += f", +{len(misplaced_steps) - 4} more"
            refuse(
                "resolve bought/foreign or stale STEP files before final verification: "
                f"{listed}. Move a component source under ref/, or delete a stale exported "
                "copy; only generated STEP artifacts with sibling .step.py entries belong "
                "elsewhere. Every component under ref/ must be checksum-pinned and declared "
                "in measure/mounts.json"
            )
        mount_manifest = project / "measure" / "mounts.json"
        if component_steps and not mount_manifest.is_file():
            listed = ", ".join(str(path.relative_to(project)) for path in component_steps[:4])
            if len(component_steps) > 4:
                listed += f", +{len(component_steps) - 4} more"
            refuse(
                f"final verification requires measure/mounts.json: the project carries "
                f"{len(component_steps)} component STEP(s) ({listed}) and no mount is "
                "declared, so no gate has seen them. Declare each seated component, "
                "or move an unseated STEP out of ref/ -- see references/bought-parts.md"
            )
        if component_steps:
            try:
                declared_steps = _declared_mount_steps(project, mount_manifest)
            except ValueError as error:
                refuse(str(error))
            undeclared = [path for path in component_steps if path.resolve() not in declared_steps]
            if undeclared:
                listed = ", ".join(str(path.relative_to(project)) for path in undeclared[:4])
                if len(undeclared) > 4:
                    listed += f", +{len(undeclared) - 4} more"
                refuse(
                    "measure/mounts.json does not declare every component STEP under ref/: "
                    f"{listed}. A downloaded part with no mount row is not checked"
                )
            checksum_failures = []
            for path in component_steps:
                actual = _sha256_file(path)
                declared_hashes = declared_steps[path.resolve()]
                if any(
                    checksum is None or checksum.lower() != actual
                    for checksum in declared_hashes
                ):
                    checksum_failures.append(path)
            if checksum_failures:
                listed = ", ".join(
                    str(path.relative_to(project)) for path in checksum_failures[:4]
                )
                if len(checksum_failures) > 4:
                    listed += f", +{len(checksum_failures) - 4} more"
                refuse(
                    "every component STEP mount row needs its current sha256; missing or "
                    f"mismatched checksum for: {listed}"
                )

    resolved_likeness_refs: list[tuple[str, Path]] = []
    for label, reference in likeness_refs:
        if reference is None or not reference.is_file():
            refuse(f"likeness reference not found: {label}={reference}")
        resolved_likeness_refs.append((label, reference))

    likeness_mismatch_labels: set[str] = set()
    if args.image_derived:
        if not (args.powered or args.unpowered):
            refuse(
                "--image-derived requires an explicit power classification: pass "
                "--powered for any functional electrical load, otherwise --unpowered"
            )
        specs = sorted(project.glob("*_spec.md"))
        if len(specs) != 1:
            refuse(
                f"--image-derived requires exactly one *_spec.md in the project; found {len(specs)}"
            )
        if not resolved_likeness_refs:
            refuse("--image-derived requires at least one --likeness-ref LABEL=PATH")
        for audit_name in ("check_spec.py", "check_landmarks.py"):
            audit = project / "measure" / audit_name
            if not audit.is_file():
                refuse(
                    f"--image-derived requires {audit.relative_to(project)}; "
                    "the project-specific claim cannot be checked generically"
                )
        for tool in ("render_views.py", "check_likeness.py"):
            if not (IMAGE_SCRIPTS_DIR / tool).is_file():
                refuse(f"image-derived tool not found: {IMAGE_SCRIPTS_DIR / tool}")
        if args.likeness_accept_mismatch:
            likeness_mismatch_labels, blockers = _mismatch_acceptance_labels(
                project, cwd, resolved_likeness_refs
            )
            if blockers:
                refuse(
                    "--likeness-accept-mismatch requires every currently failing "
                    "view/reference to be stalled out first: " + "; ".join(blockers)
                )
    bed = args.bed or _declared_bed(project) or DEFAULT_BED
    runner = Runner(cwd=cwd, dry_run=bool(args.dry_run), verbose=bool(args.verbose))
    if signature_review_sha256 is not None:
        runner.note(
            "signature review",
            f"schema=3 sha256={signature_review_sha256}",
        )
    workflow_started = time.perf_counter()
    result = runner.command([sys.executable, SCRIPTS_DIR / "check_layout", _path_arg(project, cwd)])

    cache = project / "__cadgen__"
    if result == 0 and args.fresh and cache.exists():
        print(f"[verify_project] delete cache {cache}", flush=True)
        if args.dry_run:
            runner.records.append(
                {"command": f"delete cache {cache}", "status": "planned", "seconds": 0.0}
            )
        else:
            cache_started = time.perf_counter()
            shutil.rmtree(cache)
            runner.records.append(
                {
                    "command": f"delete cache {cache}",
                    "status": "rc=0",
                    "seconds": time.perf_counter() - cache_started,
                }
            )

    if result != 0:
        mode = "quick" if args.quick else ("image-derived final" if args.image_derived else "final")
    elif args.quick:
        result = _quick(
            runner,
            assembly,
            preview_tolerance=float(args.preview_tolerance),
        )
        mode = "quick"
    else:
        result = _final(
            runner,
            project,
            assembly,
            parts,
            printables,
            motion_manifest=motion_manifest,
            exports=bool(args.exports),
            strict_fit=bool(args.strict_fit),
            strict_mount=bool(args.strict_mount),
            bed=bed,
            nozzle=float(args.nozzle),
            skip_thickness=bool(args.skip_thickness),
            image_derived=bool(args.image_derived),
            likeness_refs=resolved_likeness_refs,
            likeness_min=float(args.likeness_min),
            likeness_accept_mismatch=args.likeness_accept_mismatch,
            likeness_mismatch_labels=likeness_mismatch_labels,
            likeness_accept_regression=args.likeness_accept_regression,
            search_fov=str(args.search_fov),
        )
        mode = "image-derived final" if args.image_derived else "final"
    elapsed = time.perf_counter() - workflow_started
    if not args.quick and not args.no_report and not args.dry_run:
        final_report = report_path or (project / "measure" / "verification-pipeline.md")
        _write_report(final_report, runner, mode=mode, result=result, elapsed=elapsed, bed=bed)
        print(f"[verify_project] wrote report {final_report}", flush=True)
    print(
        f"[verify_project] {mode} workflow: rc={result} "
        f"in {elapsed:.2f}s",
        flush=True,
    )
    return result


if __name__ == "__main__":
    raise SystemExit(main())
