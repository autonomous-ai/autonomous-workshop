#!/usr/bin/env python3
"""Write browser-free shaded PNGs for visual CAD review.

Silhouette renders are the right instrument for likeness IoU and the wrong one
for reviewing an exposed mechanism: a larger base can hide every interior part
while the silhouette still looks complete. This renderer keeps occurrence
colours and applies deterministic flat lighting in software, so a review can
see overlapping parts, openings, recesses, and relative visual mass without a
GL context or an available CAD Viewer.

It is evidence for appearance only. Dimensions, validity, interference,
motion, fit, mesh quality, and thickness remain owned by their normal gates.
"""

from __future__ import annotations

import argparse
import contextlib
import functools
import hashlib
import importlib.util
import io
import math
import os
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image


ENTRY_SUFFIX = ".step.py"
GEN_FUNC = "gen_" + "step"
DEFAULT_SIZE = 900
DEFAULT_TOLERANCE = 0.08
DEFAULT_PAD = 0.07
BACKGROUND = (237, 240, 244)
TESSELLATION_CACHE_NAMESPACE = "tessellation-v1"
NAMED_VIEWS = {
    "front": (-90.0, 0.0),
    "back": (90.0, 0.0),
    "right": (0.0, 0.0),
    "left": (180.0, 0.0),
    "top": (-90.0, 90.0),
    "bottom": (-90.0, -90.0),
    "iso": (-45.0, 35.264),
    "rear_iso": (135.0, 30.0),
}
FALLBACK_COLOURS = (
    (52, 63, 75),
    (231, 168, 62),
    (74, 168, 162),
    (197, 88, 92),
    (115, 102, 189),
    (129, 149, 75),
)


def _runtime_paths() -> None:
    scripts = Path(__file__).resolve().parent
    for path in (scripts, scripts / "packages", scripts / "packages" / "cadgen" / "src"):
        text = str(path)
        if path.is_dir() and text not in sys.path:
            sys.path.insert(0, text)


def _resolve_source(source: Path) -> Path:
    if not source.is_dir():
        return source
    entries = [
        path
        for path in sorted(source.glob("*" + ENTRY_SUFFIX))
        if not path.name.startswith("part_")
    ]
    if not entries:
        entries = sorted(source.glob("*" + ENTRY_SUFFIX))
    if not entries:
        raise ValueError(f"{source} holds no {ENTRY_SUFFIX} entry")
    return entries[0]


def _load_entry(path: Path):
    module_name = f"_review_{path.name.replace('.', '_')}"
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    project = str(path.parent)
    if project not in sys.path:
        sys.path.insert(0, project)
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop(module_name, None)
        raise
    return module


def build_shape(source: Path):
    source = _resolve_source(source)
    if source.name.endswith(ENTRY_SUFFIX):
        with contextlib.redirect_stdout(io.StringIO()):
            module = _load_entry(source)
            builder = getattr(module, GEN_FUNC, None)
            if builder is None:
                raise AttributeError(f"{source.name} defines no {GEN_FUNC}()")
            shape = builder()
        if shape is None:
            raise ValueError(f"{source.name} {GEN_FUNC}() returned None")
        return source, shape
    if source.suffix.lower() in {".step", ".stp"}:
        from build123d import import_step

        return source, import_step(str(source))
    raise ValueError(f"{source} is neither a {ENTRY_SUFFIX} entry nor STEP")


def _linear_to_srgb(value: float) -> int:
    value = min(1.0, max(0.0, value))
    encoded = 12.92 * value if value <= 0.0031308 else 1.055 * value ** (1 / 2.4) - 0.055
    return round(encoded * 255)


def _shape_colour(shape, index: int) -> tuple[int, int, int]:
    colour = getattr(shape, "color", None)
    if colour is None:
        return FALLBACK_COLOURS[index % len(FALLBACK_COLOURS)]
    channels = tuple(colour)
    if len(channels) < 3:
        return FALLBACK_COLOURS[index % len(FALLBACK_COLOURS)]
    return tuple(_linear_to_srgb(float(value)) for value in channels[:3])


def _leaves(shape, parent_location=None, inherited_colour=None):
    """Yield placed leaves without changing the source assembly hierarchy.

    A group's tessellation merges its children and loses their materials.
    Children retain local placements, so descend with the accumulated parent
    transform rather than tessellating unplaced leaves directly.
    """
    colour = getattr(shape, "color", None)
    if colour is None:
        colour = inherited_colour
    children = list(getattr(shape, "children", ()) or ())
    if children:
        location = shape.location
        if parent_location is not None:
            location = parent_location * location
        for child in children:
            yield from _leaves(child, location, colour)
    else:
        placed = shape if parent_location is None else shape.moved(parent_location)
        if getattr(placed, "color", None) is None and colour is not None:
            placed.color = colour
        yield placed


@functools.lru_cache(maxsize=1)
def _self_source_identity() -> str:
    """This file's own bytes, since it lives outside the cadgen package that
    `tool_identity()` hashes but still governs how a triangle is produced."""
    return hashlib.sha256(Path(__file__).read_bytes()).hexdigest()


def _tessellation_cache(entry: Path | None):
    """A content-bound cache for occurrence tessellation, or None to skip it.

    Mirrors ADR 0068's inspection cache (`cadgen.inspection_runtime`): a miss
    is silent, corruption is a miss, and `WORKSHOP_GEOMETRY_CACHE=0` (already
    set for host sealing re-derivation) disables reads and writes. Only the
    directory it writes under differs, so `_directory` is overridden to walk
    `self.root`'s own components rather than the inspection cache's fixed
    `("__cadgen__", "inspection-v2")` pair.
    """
    if entry is None:
        return None
    _runtime_paths()
    from cadgen.inspection_runtime import Measurements

    class _OccurrenceTessellationCache(Measurements):
        @contextlib.contextmanager
        def _directory(self):
            project = self.root.parent.parent
            if project.absolute() != project.resolve():
                raise OSError("cache project path contains a symlink")
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
            fd = os.open(project, flags)
            try:
                for name in self.root.relative_to(project).parts:
                    try:
                        os.mkdir(name, mode=0o700, dir_fd=fd)
                    except FileExistsError:
                        pass
                    child = os.open(name, flags, dir_fd=fd)
                    os.close(fd)
                    fd = child
                yield fd
            finally:
                os.close(fd)

    cache = _OccurrenceTessellationCache(entry)
    cache.root = entry.parent / "__cadgen__" / TESSELLATION_CACHE_NAMESPACE
    return cache


def _tessellate_leaf(child, tolerance: float, angular: float | None, cache):
    def compute():
        vertices, triangles = (
            child.tessellate(tolerance)
            if angular is None
            else child.tessellate(tolerance, angular)
        )
        points = np.asarray([[p.X, p.Y, p.Z] for p in vertices], dtype=float)
        faces = np.asarray(triangles, dtype=np.int64)
        return points, faces

    if cache is None:
        return compute()

    from cadgen.inspection_runtime import shape_identity

    def inputs():
        # The placed leaf's own B-rep, never STEP bytes: a warm multi-target
        # `gen` does not reproduce single-target STEP bytes, which would miss
        # when it should hit. Placement is part of the key, not normalised
        # away, since two occurrences of one part at different positions are
        # different evidence until a test proves otherwise.
        return [shape_identity(child.wrapped), tolerance, angular, _self_source_identity()]

    def operation():
        points, faces = compute()
        return {"points": points.tolist(), "faces": faces.tolist()}

    value = cache.run("tessellate", "occurrence", inputs, operation, failed=lambda _v: False)
    return np.asarray(value["points"], dtype=float), np.asarray(value["faces"], dtype=np.int64)


def tessellate_occurrences(shape, tolerance: float, angular: float | None = None, *, cache_entry: Path | None = None):
    """Tessellate each placed leaf, optionally naming the angular deflection.

    build123d defaults the angular half of the deflection to 0.1 rad, about
    sixty-three steps around a full circle, which a reader sees as facet rings
    across a curved cap however fine the millimetre tolerance is. Callers that
    render curved organic form pass `angular` instead of copying this routine.

    `cache_entry` names the project entry whose directory holds a persistent,
    content-keyed tessellation cache; omit it to tessellate every call fresh.
    """
    cache = _tessellation_cache(cache_entry)
    occurrences = []
    for index, child in enumerate(_leaves(shape)):
        points, faces = _tessellate_leaf(child, tolerance, angular, cache)
        if len(points) and len(faces):
            occurrences.append((points, faces, _shape_colour(child, index)))
    if not occurrences:
        raise ValueError("tessellation produced no triangles")
    return occurrences


def camera_basis(azimuth: float, elevation: float):
    az = math.radians(azimuth)
    el = math.radians(elevation)
    toward_viewer = np.array(
        [math.cos(el) * math.cos(az), math.cos(el) * math.sin(az), math.sin(el)]
    )
    right = np.cross(np.array([0.0, 0.0, 1.0]), toward_viewer)
    length = float(np.linalg.norm(right))
    right = (
        np.array([-math.sin(az), math.cos(az), 0.0])
        if length < 1e-9
        else right / length
    )
    up = np.cross(toward_viewer, right)
    return toward_viewer, right, up


def _shade(colour, normal, light, toward_viewer):
    normal_length = float(np.linalg.norm(normal))
    if normal_length < 1e-12:
        brightness = 0.55
    else:
        normal = normal / normal_length
        diffuse = max(0.0, float(np.dot(normal, light)))
        rim = max(0.0, float(np.dot(normal, toward_viewer)))
        brightness = min(1.18, 0.34 + 0.66 * diffuse + 0.12 * rim)
    return tuple(min(255, max(0, round(channel * brightness))) for channel in colour)


def shade_faces(colour, normals, light, toward_viewer):
    """Flat-shade every face at once, with the arithmetic `_shade` uses.

    Written elementwise rather than as matrix products so a face keeps the
    identical float brightness it would be given one at a time.
    """
    lengths = np.sqrt(normals[:, 0] ** 2 + normals[:, 1] ** 2 + normals[:, 2] ** 2)
    degenerate = lengths < 1e-12
    unit = normals / np.where(degenerate, 1.0, lengths)[:, None]
    diffuse = np.maximum(
        0.0, unit[:, 0] * light[0] + unit[:, 1] * light[1] + unit[:, 2] * light[2]
    )
    rim = np.maximum(
        0.0,
        unit[:, 0] * toward_viewer[0]
        + unit[:, 1] * toward_viewer[1]
        + unit[:, 2] * toward_viewer[2],
    )
    brightness = np.where(
        degenerate, 0.55, np.minimum(1.18, 0.34 + 0.66 * diffuse + 0.12 * rim)
    )
    values = np.rint(np.asarray(colour, dtype=float)[None, :] * brightness[:, None])
    return np.clip(values, 0, 255).astype(np.uint8)


# Pixels one batch may cover. Each cell costs a few float64 temporaries, so
# this bounds the rasteriser's peak memory; it does not affect its output.
BATCH_CELLS = 2_000_000
def _box_classes(size: int):
    """Powers of two up to the frame, the boxes a batch is padded out to.

    Padding a bounding box up to one of these makes a batch a single
    rectangular array, and wastes at most three quarters of its cells.
    """
    classes = [1]
    while classes[-1] < size:
        classes.append(classes[-1] * 2)
    return np.asarray(classes, dtype=np.int64)


def _raster_batch(faces, xs, ys, zs, denominator, left, rightmost, top, bottom,
                  box_width, box_rows, fills, pixels_flat, depths_flat, size):
    """Composite one batch of identically boxed faces into the depth buffer."""
    cells = box_rows * box_width
    column = left[:, None, None] + np.arange(box_width, dtype=np.int64)[None, None, :]
    row = top[:, None, None] + np.arange(box_rows, dtype=np.int64)[None, :, None]
    x = column + 0.5
    y = row + 0.5
    x2 = xs[:, 2][:, None, None]
    y2 = ys[:, 2][:, None, None]
    share = denominator[:, None, None]
    # Pixel-centre barycentric coordinates, as in the face-at-a-time pass.
    w0 = ((ys[:, 1] - ys[:, 2])[:, None, None] * (x - x2)
          + (xs[:, 2] - xs[:, 1])[:, None, None] * (y - y2)) / share
    w1 = ((ys[:, 2] - ys[:, 0])[:, None, None] * (x - x2)
          + (xs[:, 0] - xs[:, 2])[:, None, None] * (y - y2)) / share
    w2 = 1.0 - w0 - w1
    inside = (w0 >= -1e-9) & (w1 >= -1e-9) & (w2 >= -1e-9)
    inside &= (column <= rightmost[:, None, None]) & (row <= bottom[:, None, None])
    cell = np.flatnonzero(inside.ravel())
    if not len(cell):
        return
    depth = (w0 * zs[:, 0][:, None, None] + w1 * zs[:, 1][:, None, None]
             + w2 * zs[:, 2][:, None, None])

    local = cell // cells
    offset = cell - local * cells
    target = ((top[local] + offset // box_width) * size
              + left[local] + offset % box_width)
    candidate = depth.ravel()[cell]

    # The depth test has hysteresis: a surface must beat the one already held
    # by a clear margin, so which of two near-coincident faces is kept depends
    # on the order they are drawn in. Taking the maximum would decide it by
    # floating-point noise instead. Sort each pixel's candidates into draw
    # order and apply them one layer at a time -- a layer holds at most one
    # candidate per pixel, so a layer's scatter is exactly what drawing those
    # faces one after another would write.
    ordered = np.lexsort((faces[local], target))
    target, candidate, local = target[ordered], candidate[ordered], local[ordered]
    opening = np.flatnonzero(np.append(True, target[1:] != target[:-1]))
    depth_complexity = np.diff(np.append(opening, len(target)))
    layer = np.arange(len(target)) - np.repeat(opening, depth_complexity)
    for index in range(int(depth_complexity.max())):
        held = layer == index
        pixel, depth_at, face_at = target[held], candidate[held], local[held]
        visible = depth_at > depths_flat[pixel] + 1e-9
        pixel, depth_at, face_at = pixel[visible], depth_at[visible], face_at[visible]
        depths_flat[pixel] = depth_at
        pixels_flat[pixel] = fills[face_at]


def render(occurrences, azimuth: float, elevation: float, size: int, pad: float, *, framing=None):
    toward_viewer, right, up = camera_basis(azimuth, elevation)
    light = np.array([0.35, -0.45, 0.82], dtype=float)
    light /= np.linalg.norm(light)
    all_points = (np.concatenate([points for points, _faces, _colour in occurrences])
                  if framing is None else np.asarray(framing, dtype=float))
    if all_points.ndim != 2 or all_points.shape[1] != 3 or not len(all_points) or not np.isfinite(all_points).all():
        raise ValueError("framing must contain finite 3D points")
    sx = all_points @ right
    sy = all_points @ up
    width = float(sx.max() - sx.min())
    height = float(sy.max() - sy.min())
    span = max(width, height)
    if span <= 0:
        raise ValueError("projection is degenerate")
    scale = (1.0 - 2.0 * pad) * size / span
    x_offset = (size - width * scale) / 2.0 - float(sx.min()) * scale
    y_offset = (size - height * scale) / 2.0 + float(sy.max()) * scale

    # Mean triangle depth cannot resolve crossing or partially occluded faces.
    # Keep the nearest surface separately at each pixel of this orthographic view.
    pixels = np.empty((size, size, 3), dtype=np.uint8)
    pixels[:] = BACKGROUND
    depths = np.full((size, size), -np.inf)
    pixels_flat = pixels.reshape(-1, 3)
    depths_flat = depths.reshape(-1)
    classes = _box_classes(size)
    # A whole-set review frame carries over a million triangles, most of them
    # smaller than one pixel, so every per-face quantity here is a single array
    # call and faces are rasterised in batches rather than one at a time.
    for points, faces, colour in occurrences:
        points = np.asarray(points, dtype=float)
        faces = np.asarray(faces, dtype=np.int64)
        if not len(faces):
            continue
        px = points @ right * scale + x_offset
        py = y_offset - points @ up * scale
        depth = points @ toward_viewer
        corners = points[faces]
        normals = np.cross(corners[:, 1] - corners[:, 0], corners[:, 2] - corners[:, 0])
        fills = shade_faces(colour, normals, light, toward_viewer)

        xs, ys, zs = px[faces], py[faces], depth[faces]
        denominator = ((ys[:, 1] - ys[:, 2]) * (xs[:, 0] - xs[:, 2])
                       + (xs[:, 2] - xs[:, 1]) * (ys[:, 0] - ys[:, 2]))
        with np.errstate(invalid="ignore"):
            left = np.maximum(0.0, np.floor(xs.min(axis=1))).astype(np.int64)
            rightmost = np.minimum(size - 1.0, np.ceil(xs.max(axis=1))).astype(np.int64)
            top = np.maximum(0.0, np.floor(ys.min(axis=1))).astype(np.int64)
            bottom = np.minimum(size - 1.0, np.ceil(ys.max(axis=1))).astype(np.int64)
            drawable = np.flatnonzero(
                (np.abs(denominator) >= 1e-12) & (rightmost >= left) & (bottom >= top)
            )
        if not len(drawable):
            continue

        box_width = classes[np.searchsorted(classes, rightmost[drawable] - left[drawable] + 1)]
        box_height = classes[np.searchsorted(classes, bottom[drawable] - top[drawable] + 1)]
        shapes = np.unique(np.stack([box_width, box_height], axis=1), axis=0)
        # Draw the box classes in the order their first face appears, so that
        # coincident faces resolve as they would in a single ordered pass.
        groups = [drawable[(box_width == shape[0]) & (box_height == shape[1])] for shape in shapes]
        for shape, group in sorted(zip(shapes, groups), key=lambda pair: pair[1][0]):
            width_class, height_class = int(shape[0]), int(shape[1])
            step = max(1, BATCH_CELLS // (width_class * height_class))
            for start in range(0, len(group), step):
                batch = group[start:start + step]
                # One face whose own box is over the budget is drawn in row
                # bands, as the face-at-a-time pass did. A band splits no
                # batch that holds more than one face, so no pixel ever sees
                # its candidates out of draw order.
                band = (max(1, BATCH_CELLS // width_class)
                        if len(batch) == 1 else height_class)
                for first in range(0, height_class, band):
                    rows = min(band, height_class - first)
                    _raster_batch(batch, xs[batch], ys[batch], zs[batch], denominator[batch],
                                  left[batch], rightmost[batch], top[batch] + first, bottom[batch],
                                  width_class, rows, fills[batch],
                                  pixels_flat, depths_flat, size)
    return Image.fromarray(pixels)


def parse_view(text: str):
    if text in NAMED_VIEWS:
        return text, *NAMED_VIEWS[text]
    fields = text.split(",")
    if len(fields) != 2:
        raise argparse.ArgumentTypeError(f"view must be a name or AZ,EL, not {text!r}")
    azimuth, elevation = (float(field) for field in fields)
    return f"az{azimuth:g}_el{elevation:g}", azimuth, elevation


def self_check() -> int:
    from build123d import Box, Cylinder, Pos

    shape = Box(20, 14, 6) + Pos(4, 0, 3) * Cylinder(3, 12)
    occurrences = tessellate_occurrences(shape, 0.1)
    image = render(occurrences, -45.0, 35.264, 320, DEFAULT_PAD)
    pixels = np.asarray(image)
    colour_count = len(np.unique(pixels.reshape(-1, 3), axis=0))
    foreground = int(np.any(pixels != np.asarray(BACKGROUND), axis=2).sum())
    if foreground < 2000 or colour_count < 8:
        print(
            f"render_review self-check failed: foreground={foreground} colours={colour_count}",
            file=sys.stderr,
        )
        return 1
    with tempfile.TemporaryDirectory(prefix="render-review-") as tmp:
        path = Path(tmp) / "fixture.png"
        image.save(path)
        if path.stat().st_size <= 1000:
            print("render_review self-check failed: PNG is unexpectedly small", file=sys.stderr)
            return 1
    print(f"render_review self-check: ok foreground={foreground} colours={colour_count}")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", nargs="?", type=Path)
    parser.add_argument("--view", action="append", default=[])
    parser.add_argument("-o", "--out", type=Path)
    parser.add_argument("--size", type=int, default=DEFAULT_SIZE)
    parser.add_argument("--tolerance", type=float, default=DEFAULT_TOLERANCE)
    parser.add_argument(
        "--angular-tolerance",
        type=float,
        default=None,
        help="angular deflection in radians; build123d's 0.1 facets curved caps visibly",
    )
    parser.add_argument("--pad", type=float, default=DEFAULT_PAD)
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args(argv)
    if args.self_check:
        return self_check()
    if args.source is None:
        parser.error("source is required unless --self-check is used")
    if args.size < 128:
        parser.error("--size must be at least 128")
    if not 0.0 <= args.pad < 0.4:
        parser.error("--pad must be in [0, 0.4)")
    if args.angular_tolerance is not None and not 0.0 < args.angular_tolerance <= 1.0:
        parser.error("--angular-tolerance must be in (0, 1] radians")

    source, shape = build_shape(args.source)
    occurrences = tessellate_occurrences(shape, args.tolerance, args.angular_tolerance, cache_entry=source)
    views = [parse_view(value) for value in (args.view or ["iso"])]
    out = args.out or source.parent / "snap" / "review"
    out.mkdir(parents=True, exist_ok=True)
    for label, azimuth, elevation in views:
        path = out / f"{label}.png"
        render(occurrences, azimuth, elevation, args.size, args.pad).save(path)
        print(path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
