#!/usr/bin/env python3
"""Bought-part seating gate: does the built model actually hold the component?

`check_fit` reads the source and asks whether a part can be printed.
`check_mesh` reads the artifact. `check_motion` asks whether parts can be
brought together. None of them has ever seen the servo.

That gap is the expensive one, because a bought part's dimensions live in a
datasheet rather than in the repository: a bracket whose pocket is 2 mm too
shallow is a soundcompound solid, clash-free in assembly pose, watertight when
exported, and useless. Every gate in the toolchain passes it.

This one places the component's own STEP into the assembly at a declared pose
and measures what the model leaves it. Five checks:

    component-source    the STEP exists and lives inside the project
    component-checksum  it is the file the manifest was written against
    seat-clash          the model does not occupy the component's volume
    seat-clearance      what it does leave is at least the declared gap
    bolt-access         a screw can reach each hole of the component's own
                        mounting pattern from at least one side

reporting the last of those as `no-bolt-pattern` -- a note, not a failure --
when the component has no mounting holes to find. A strapped, glued or
captive-screwed component owes this gate nothing, and says so with
`"bolts": false`.

It is not circular with `cadmount`. The seat may have been derived, typed by
hand, or cut by a boolean three features later that ate half of it; this gate
reads the solids the generator actually produced and the vendor's STEP, and
recomputes none of the recipe.

    scripts/check_mount <project-dir>                       # measure/mounts.json
    scripts/check_mount <project-dir> --manifest <file>
    scripts/check_mount <project-dir> --manifest - --json
    scripts/check_mount <project-dir> --list-parts

Exit 0 when every mount conforms, 1 on any failure, 2 on bad usage.
See references/bought-parts.md for the manifest schema.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import importlib.util
import io
import json
import sys
from pathlib import Path

SCRIPTS_DIR = Path(__file__).resolve().parent
PACKAGES_DIR = SCRIPTS_DIR / "packages"
CADPY_SRC_DIR = PACKAGES_DIR / "cadgen" / "src"
for _runtime_path in (SCRIPTS_DIR, PACKAGES_DIR, CADPY_SRC_DIR):
    _text = str(_runtime_path)
    if _runtime_path.is_dir() and _text not in sys.path:
        sys.path.insert(0, _text)

import cadfits          # noqa: E402 - after the sys.path setup above
import cadmount         # noqa: E402

ENTRY_SUFFIX = ".step.py"
PART_PREFIX = "part_"
GEN_FUNC = "gen_" + "step"

DEFAULT_MANIFEST = Path("measure") / "mounts.json"

# Contact is not collision, as everywhere else in this toolchain.
CLASH_TOL_MM3 = 1e-3

# The gap a hand-assembled bought part wants at minimum. `snug` rather than
# `slip`: a seat tighter than this needs force against a component that does
# not compress, and the failure is a cracked bracket at the printer, not here.
DEFAULT_MIN_CLEARANCE = cadfits.FIT_TABLE["snug"]

# A clearance far past any fit class is a component rattling in its pocket. It
# is reported, never failed: a deliberately loose cradle for a foam-mounted
# motor is a design, not a defect.
LOOSE_CLEARANCE = 1.0

ADVISORY_RULES = {"component-checksum", "no-bolt-pattern", "seat-clearance-loose"}


class ManifestError(Exception):
    """The manifest asks for something this gate cannot answer."""


# --- loading the assembly -------------------------------------------------

def find_assembly_entry(project: Path, declared: str | None) -> Path:
    if declared:
        path = project / declared
        if not path.is_file():
            raise ManifestError(f"assembly entry {declared} not found in {project}")
        return path
    candidates = [
        path for path in sorted(project.glob("*" + ENTRY_SUFFIX))
        if not path.name.startswith(PART_PREFIX)
    ]
    if not candidates:
        raise ManifestError(f"no combined <name>{ENTRY_SUFFIX} in {project}")
    if len(candidates) > 1:
        names = ", ".join(path.name for path in candidates)
        raise ManifestError(f'{project} has several assembly entries ({names}); set "assembly"')
    return candidates[0]


def build_assembly(entry: Path):
    """Import one entry generator with its project directory on sys.path."""
    project = str(entry.parent)
    inserted = project not in sys.path
    if inserted:
        sys.path.insert(0, project)
    module_name = f"_checkmount_{entry.name.replace('.', '_')}"
    try:
        spec = importlib.util.spec_from_file_location(module_name, entry)
        if spec is None or spec.loader is None:
            raise ManifestError(f"cannot load {entry}")
        module = importlib.util.module_from_spec(spec)
        sys.modules[module_name] = module
        sink = io.StringIO()
        with contextlib.redirect_stdout(sink):
            spec.loader.exec_module(module)
            builder = getattr(module, GEN_FUNC, None)
            if builder is None:
                raise ManifestError(f"{entry.name} defines no {GEN_FUNC}()")
            shape = builder()
    finally:
        if inserted:
            with contextlib.suppress(ValueError):
                sys.path.remove(project)
    if shape is None:
        raise ManifestError(f"{entry.name} {GEN_FUNC}() returned None")
    return shape


def index_parts(shape) -> dict[str, object]:
    """Map every labelled leaf to its shape, in assembly pose."""
    found: dict[str, list[object]] = {}

    def walk(node, trail: list[str]) -> None:
        label = getattr(node, "label", "") or ""
        path = trail + ([label] if label else [])
        if label and trail:
            found.setdefault(label, []).append(node)
            found.setdefault(".".join(path), []).append(node)
        for child in list(getattr(node, "children", []) or []):
            walk(child, path)

    walk(shape, [])
    parts = {name: shapes[0] for name, shapes in found.items() if len(shapes) == 1}
    parts["__ambiguous__"] = sorted(name for name, shapes in found.items() if len(shapes) > 1)
    return parts


def obstacle_solids(shape, parts: dict, names) -> list:
    """The solids the component is measured against, in assembly pose.

    Solids rather than the compound: a Compound's own volume is 0 when the
    geometry hangs off its children, and every measurement below is a boolean
    that wants real bodies.
    """
    if names is None:
        return list(shape.solids())
    if isinstance(names, str):
        names = [names]
    if not isinstance(names, list) or not names:
        raise ManifestError('"parts" must name at least one labelled part')
    ambiguous = parts.get("__ambiguous__", [])
    solids = []
    for name in names:
        if name in ambiguous:
            raise ManifestError(f'part "{name}" is ambiguous; use its dotted path')
        if name not in parts:
            known = ", ".join(sorted(k for k in parts if k != "__ambiguous__")) or "none"
            raise ManifestError(f'no part labelled "{name}" in the assembly (have: {known})')
        solids.extend(parts[name].solids())
    return solids


# --- geometry -------------------------------------------------------------

def boxes_apart(a, b, margin: float = 0.0) -> bool:
    box_a, box_b = a.bounding_box(), b.bounding_box()
    return (
        box_a.min.X > box_b.max.X + margin or box_a.max.X < box_b.min.X - margin
        or box_a.min.Y > box_b.max.Y + margin or box_a.max.Y < box_b.min.Y - margin
        or box_a.min.Z > box_b.max.Z + margin or box_a.max.Z < box_b.min.Z - margin
    )


def clash_volume(component, obstacles: list) -> float:
    """Exact intersection volume against every obstacle, bbox-prefiltered."""
    total = 0.0
    for obstacle in obstacles:
        if boxes_apart(component, obstacle):
            continue
        with contextlib.suppress(Exception):
            meeting = component & obstacle
            if meeting is not None:
                total += float(sum(solid.volume for solid in meeting.solids()))
    return total


def nearest_gap(component, obstacles: list, reach: float) -> float | None:
    """Smallest distance to any obstacle within `reach`, or None if unmeasurable.

    Deliberately not `offset(component, +gap)` and a clash test: growing an
    imported solid is the failure `references/bought-parts.md` documents, and a
    grown component that quietly lost its output shaft would report a clearance
    the shaft does not have.
    """
    best = None
    for obstacle in obstacles:
        if boxes_apart(component, obstacle, margin=reach):
            continue
        try:
            gap = float(component.distance_to(obstacle))
        except Exception:                              # noqa: BLE001
            continue
        best = gap if best is None else min(best, gap)
    return best


def placement(spec, field: str):
    """A pose from the manifest: [x,y,z], or {position, rotation}."""
    from build123d import Location

    if spec is None:
        return Location()
    if isinstance(spec, (list, tuple)):
        return Location(vector3(spec, field))
    if not isinstance(spec, dict):
        raise ManifestError(f"{field} must be [x, y, z] or an object with position/rotation")
    position = vector3(spec.get("position", [0, 0, 0]), f"{field}.position")
    rotation = vector3(spec.get("rotation", [0, 0, 0]), f"{field}.rotation")
    return Location(position, rotation)


def vector3(value, field: str):
    if not isinstance(value, (list, tuple)) or len(value) != 3:
        raise ManifestError(f"{field} must be [x, y, z]")
    try:
        return tuple(float(component) for component in value)
    except (TypeError, ValueError) as error:
        raise ManifestError(f"{field} must be numeric: {error}") from error


def bolt_access(component, holes: list, obstacles: list, span_hint: float) -> list[dict]:
    """Can a clearance screw reach each hole from either side, or is it walled in?

    Tried both ways along the hole axis and passed if **either** is clear: a
    screw only ever needs one open side, and demanding both would fail every
    bracket with a back wall. A hole with no model material along it at all is
    clear by the same rule, which is correct -- a strapped or glued component
    owes this gate nothing.
    """
    from build123d import Cylinder, Location, Plane

    results = []
    for index, hole in enumerate(holes):
        bore = cadfits.slot_for(hole["diameter"], "free")
        axis = hole["along"]
        blocked = {}
        for sign in (1, -1):
            direction = axis * sign
            start = hole["centre"] + direction * (hole["span"] / 2)
            plane = Plane(origin=tuple(start + direction * (span_hint / 2)),
                          z_dir=tuple(direction))
            shaft = plane.location * Cylinder(radius=bore / 2, height=span_hint)
            blocked[sign] = clash_volume(shaft, obstacles)
        clear = min(blocked.values())
        results.append({
            "hole": index,
            "diameter": hole["diameter"],
            "clear": clear <= CLASH_TOL_MM3,
            "obstructed_mm3": round(clear, 4),
        })
    return results


# --- one mount ------------------------------------------------------------

def run_mount(spec: dict, project: Path, shape, parts: dict,
              index: int, measured: dict) -> list[dict]:
    """Every finding for one declared mount. An empty list is a clean mount.

    `measured` is filled with what was actually read off the solids, so a clean
    run still reports numbers: an "ok" with no clearance in it cannot be pasted
    into a verification record as evidence of anything.
    """
    name = str(spec.get("id") or f"mount[{index}]")
    measured["mount"] = name
    findings: list[dict] = []

    def note(rule: str, detail: str) -> None:
        findings.append({"mount": name, "rule": rule, "detail": detail,
                         "advisory": rule in ADVISORY_RULES})

    declared = spec.get("component")
    if not declared:
        note("component-source", 'no "component" STEP declared')
        return findings
    source = (project / declared).resolve()
    if not source.is_file():
        note("component-source", f"no component STEP at {declared}")
        return findings
    try:
        source.relative_to(project)
    except ValueError:
        note("component-source",
             f"{declared} resolves outside the project. Copy the STEP into "
             "<project-dir>/ref/ -- a seat derived from a file elsewhere cannot "
             "be re-verified once that location is cleaned out")
        return findings

    wanted = spec.get("sha256")
    if wanted:
        got = hashlib.sha256(source.read_bytes()).hexdigest()
        if got != wanted:
            note("component-checksum",
                 f"{declared} is sha256 {got[:12]}..., manifest says {str(wanted)[:12]}... "
                 "-- the vendor model changed under the seat derived from it")
    else:
        note("component-checksum",
             f'no "sha256" for {declared}; the catalog file can change under the seat')

    try:
        component = cadmount.load(source)
    except (ValueError, FileNotFoundError) as error:
        note("component-source", str(error))
        return findings

    try:
        pose = placement(spec.get("at"), f"{name}.at")
        obstacles = obstacle_solids(shape, parts, spec.get("parts"))
    except ManifestError as error:
        note("component-source", str(error))
        return findings
    if not obstacles:
        note("seat-clash", "the assembly built no solid to measure against")
        return findings

    placed = pose * component
    measured["component"] = declared
    clash = clash_volume(placed, obstacles)
    measured["clash_mm3"] = round(clash, 4)
    if clash > CLASH_TOL_MM3:
        note("seat-clash",
             f"the model occupies {clash:.3f} mm3 of the component's own volume "
             f"({100 * clash / placed.volume:.1f}% of it) -- the seat is too small, "
             "in the wrong place, or was cut away by a later feature")
        return findings                                # clearance is meaningless now

    floor = spec.get("min_clearance", DEFAULT_MIN_CLEARANCE)
    try:
        floor = float(floor)
    except (TypeError, ValueError):
        note("seat-clearance", f'"min_clearance" must be a number, got {floor!r}')
        return findings
    gap = nearest_gap(placed, obstacles, reach=max(LOOSE_CLEARANCE, floor) * 4)
    measured["clearance_mm"] = None if gap is None else round(gap, 4)
    measured["min_clearance_mm"] = floor
    if gap is None:
        note("seat-clearance",
             "nothing in the model comes within measuring distance of the component; "
             "check the pose -- a seat that holds nothing reads as clearance")
    elif gap < floor:
        note("seat-clearance",
             f"only {gap:.3f} mm of clearance, below the {floor:.3f} mm minimum. "
             "A bought part does not compress")
    elif gap > LOOSE_CLEARANCE:
        note("seat-clearance-loose",
             f"{gap:.3f} mm of clearance; the component is not located by this seat")

    if spec.get("bolts") is False:
        return findings
    axis = spec.get("bolt_axis")
    # Asked of the *placed* component, so the holes come back in assembly
    # coordinates and no pattern has to be transformed into them.
    try:
        holes = cadmount.bolt_pattern(placed, vector3(axis, f"{name}.bolt_axis")
                                      if axis else None)
    except Exception as error:                         # noqa: BLE001
        note("bolt-access", f"reading the component's bores raised "
                            f"{type(error).__name__}: {error}")
        return findings
    if not holes:
        note("no-bolt-pattern",
             "no mounting hole pattern found in the component; if it is screwed "
             'down, set "bolt_axis", and if it is not, set "bolts": false')
        return findings
    measured["holes"] = len(holes)

    box = shape.bounding_box()
    reach = max(box.size.X, box.size.Y, box.size.Z) + 20.0
    for result in bolt_access(placed, holes, obstacles, reach):
        if not result["clear"]:
            note("bolt-access",
                 f"hole {result['hole']} (Ø{result['diameter']:.2f}) is walled in from "
                 f"both sides -- {result['obstructed_mm3']:.1f} mm3 of model material "
                 "in the way of its clearance screw on the more open side")
    return findings


def load_manifest(source: str) -> dict:
    text = sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")
    try:
        manifest = json.loads(text)
    except json.JSONDecodeError as error:
        raise ManifestError(f"manifest is not valid JSON: {error}") from error
    if not isinstance(manifest, dict):
        raise ManifestError("manifest must be a JSON object")
    return manifest


def mount_specs(manifest: dict) -> list[dict]:
    """Validate mount identity before paying to build the CAD assembly."""
    mounts = manifest.get("mounts", [])
    if not isinstance(mounts, list) or not mounts:
        raise ManifestError("manifest declares no mounts")
    seen: set[str] = set()
    for index, item in enumerate(mounts):
        if not isinstance(item, dict):
            raise ManifestError(f"mounts[{index}] must be an object")
        mount_id = item.get("id")
        if not isinstance(mount_id, str) or not mount_id.strip():
            raise ManifestError(f"mounts[{index}].id is required")
        if mount_id in seen:
            raise ManifestError(f"duplicate mount id {mount_id!r}")
        seen.add(mount_id)
    return mounts


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("project", help="project directory holding the assembly entry")
    parser.add_argument("--manifest",
                        help=f"mount manifest JSON, or - for stdin. Default: {DEFAULT_MANIFEST}")
    parser.add_argument("--list-parts", action="store_true",
                        help="print the labelled parts and exit")
    parser.add_argument("--strict", action="store_true",
                        help="fail on advisories as well")
    parser.add_argument("--json", action="store_true", help="emit results as JSON")
    args = parser.parse_args()

    project = Path(args.project).resolve()
    if not project.is_dir():
        print(f"check_mount: {project} is not a directory", file=sys.stderr)
        return 2

    source = args.manifest
    if source is None:
        default = project / DEFAULT_MANIFEST
        if not default.is_file():
            print(f"check_mount: no {DEFAULT_MANIFEST} in {project}; pass --manifest. "
                  "A project that seats a bought part owes one -- see "
                  "references/bought-parts.md", file=sys.stderr)
            return 2
        source = str(default)

    try:
        manifest = load_manifest(source)
        mounts = [] if args.list_parts else mount_specs(manifest)
        entry = find_assembly_entry(project, manifest.get("assembly"))
        shape = build_assembly(entry)
        parts = index_parts(shape)
    except ManifestError as error:
        print(f"check_mount: {error}", file=sys.stderr)
        return 2
    except Exception as error:                         # noqa: BLE001 - the build failed
        print(f"check_mount: building the assembly raised "
              f"{type(error).__name__}: {error}", file=sys.stderr)
        return 2

    if args.list_parts:
        for name in sorted(name for name in parts if name != "__ambiguous__"):
            print(name)
        for name in parts["__ambiguous__"]:
            print(f"{name}  (ambiguous - use its dotted path)")
        return 0

    findings: list[dict] = []
    measurements: list[dict] = []
    for index, spec in enumerate(mounts):
        measured: dict = {}
        findings.extend(run_mount(spec, project, shape, parts, index, measured))
        measurements.append(measured)

    failures = [f for f in findings if not f["advisory"] or args.strict]
    advisories = [f for f in findings if f["advisory"] and not args.strict]

    if args.json:
        print(json.dumps({
            "ok": not failures,
            "project": str(project),
            "assembly": entry.name,
            "mounts": len(mounts),
            "measurements": measurements,
            "findings": findings,
        }, indent=2))
        return 1 if failures else 0

    print(f"{entry.name}: {len(mounts)} mount(s)\n")
    for measured in measurements:
        if "clash_mm3" not in measured:
            continue
        gap, floor = measured.get("clearance_mm"), measured.get("min_clearance_mm")
        reading = ("not measured -- the component clashes"
                   if "clearance_mm" not in measured else
                   "unmeasurable" if gap is None else
                   f"{gap:.3f} mm (min {floor:.2f})")
        print(f"  {measured.get('mount', '?')}: clash {measured['clash_mm3']:.3f} mm3, "
              f"clearance {reading}, {measured.get('holes', 0)} mount hole(s)")
    if measurements:
        print()
    for finding in findings:
        badge = "note" if finding["advisory"] and not args.strict else "FAIL"
        print(f"  {badge} {finding['mount']} [{finding['rule']}]")
        print(f"       {finding['detail']}")
    if not findings:
        print("  ok   every declared mount seats its component")

    if failures:
        print(f"\ncheck_mount: {len(failures)} finding(s) in {len(mounts)} mount(s)",
              file=sys.stderr)
        return 1
    if advisories:
        print(f"\ncheck_mount: ok - {len(mounts)} mount(s) seat their component "
              f"({len(advisories)} note(s); --strict promotes them)")
        return 0
    print(f"\ncheck_mount: ok - {len(mounts)} mount(s) seat their component")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
