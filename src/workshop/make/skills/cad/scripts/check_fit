#!/usr/bin/env python3
"""Print-datum, bed-footprint and body-count gate for printable part entries.

`validate`, `interfere` and `snapshot` all pass a model that cannot be printed:
they say the solid is sound and that nothing clashes in assembly pose, not that
each part sits on the bed. This gate answers the part of the printable/connector
question that needs no project knowledge:

    print-datum       every selected printable entry returns min(Z) == 0
    bed-footprint     its footprint fits the stated bed, in either yaw
    empty-part        it has positive volume
    build-error       the entry generator runs at all

and reports two things that need a human to read the project before they mean
anything, so they are notes rather than failures unless --strict is given:

    multi-body-part       the entry returns several disconnected bodies, which
                          is a defect only if the README calls it one piece
    no-project-fit-audit  2+ printable parts with no local fit/print audit

Every selected printable entry is built here, so this is the only check that
compares the *source* against the print claim. It deliberately does not redo interference:
`scripts/inspect interfere` already answers that with exact B-rep booleans.

Three of the six mandated items still need project knowledge and cannot be
checked generically -- that one mating pair derives from one base dimension
with clearance applied once, that every connector is named in the spec/README,
and that the assembly order is physically possible. When a project has 2+ part
entries and no local audit, that gap is reported as `no-project-fit-audit`.

    scripts/check_fit                       # scan the worktree
    scripts/check_fit <project-dir>
    scripts/check_fit <project-dir> --entry <project-dir>/<name>.step.py
    scripts/check_fit --bed 256 256
    scripts/check_fit --json

Exit 0 when every printable part conforms, 1 when any fails, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import ast
import contextlib
import importlib.util
import io
import json
import re
import sys
from pathlib import Path

SCRIPTS_DIR = Path(__file__).resolve().parent
PACKAGES_DIR = SCRIPTS_DIR / "packages"
CADPY_SRC_DIR = PACKAGES_DIR / "cadgen" / "src"
for _runtime_path in (SCRIPTS_DIR, PACKAGES_DIR, CADPY_SRC_DIR):
    _text = str(_runtime_path)
    if _runtime_path.is_dir() and _text not in sys.path:
        sys.path.insert(0, _text)

ENTRY_SUFFIX = ".step.py"
PART_PREFIX = "part_"

DEFAULT_BED = (220.0, 220.0)
Z_TOL = 0.01
BED_TOL = 0.01
TOUCH_TOL = 1e-6

ADVISORY_RULES = {"multi-body-part", "no-project-fit-audit"}

IGNORED_DIR_NAMES = {
    "__cadgen__",
    "__pycache__",
    ".cache",
    ".git",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    "measure",
    "node_modules",
    "ref",
    "skills",
    "snaps",
}

# Built at runtime for the same reason as check_layout's marker: cadgen's
# discovery scan treats any worktree file carrying these bytes as a generator
# candidate, and would log a spurious "invalid CAD source" on every gen run.
GEN_FUNC = "gen_" + "step"


def declared_printable(path: Path) -> bool | None:
    """Read an optional module-level ``PRINTABLE = bool`` without importing CAD."""
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    for node in tree.body:
        value = None
        if isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "PRINTABLE"
            for target in node.targets
        ):
            value = node.value
        elif (
            isinstance(node, ast.AnnAssign)
            and isinstance(node.target, ast.Name)
            and node.target.id == "PRINTABLE"
        ):
            value = node.value
        if value is not None:
            if isinstance(value, ast.Constant) and isinstance(value.value, bool):
                return value.value
            raise ValueError(f"{path}: PRINTABLE must be the literal True or False")
    return None


def iter_printable_entries(root: Path):
    """Yield actual print targets, grouped by their project directory."""
    entries_by_dir: dict[Path, list[Path]] = {}
    for path in sorted(root.rglob("*" + ENTRY_SUFFIX)):
        rel_parts = path.relative_to(root).parts[:-1]
        if any(part in IGNORED_DIR_NAMES for part in rel_parts):
            continue
        if GEN_FUNC not in path.read_text(encoding="utf-8", errors="replace"):
            continue
        entries_by_dir.setdefault(path.parent, []).append(path)

    by_dir: dict[Path, list[Path]] = {}
    for project, entries in entries_by_dir.items():
        parts = [path for path in entries if path.name.startswith(PART_PREFIX)]
        assemblies = [path for path in entries if not path.name.startswith(PART_PREFIX)]
        selected = [path for path in parts if declared_printable(path) is not False]
        if parts:
            selected.extend(
                path for path in assemblies if declared_printable(path) is True
            )
        elif len(assemblies) == 1 and declared_printable(assemblies[0]) is not False:
            selected.append(assemblies[0])
        if selected:
            by_dir[project] = sorted(selected)
    return by_dir


def explicit_entries(root: Path, raw_entries: list[str]) -> dict[Path, list[Path]]:
    """Resolve explicitly selected printable entries beneath ``root``."""
    by_dir: dict[Path, list[Path]] = {}
    cwd = Path.cwd().resolve()
    for raw in raw_entries:
        candidate = Path(raw)
        if not candidate.is_absolute():
            from_cwd = (cwd / candidate).resolve()
            candidate = from_cwd if from_cwd.is_file() else (root / candidate).resolve()
        else:
            candidate = candidate.resolve()
        try:
            candidate.relative_to(root)
        except ValueError as error:
            raise ValueError(f"entry must stay inside {root}: {candidate}") from error
        if not candidate.is_file() or not candidate.name.endswith(ENTRY_SUFFIX):
            raise ValueError(f"not a *{ENTRY_SUFFIX} entry: {candidate}")
        if GEN_FUNC not in candidate.read_text(encoding="utf-8", errors="replace"):
            raise ValueError(f"{candidate} defines no {GEN_FUNC}()")
        if declared_printable(candidate) is False:
            raise ValueError(f"{candidate} declares PRINTABLE = False")
        by_dir.setdefault(candidate.parent, []).append(candidate)
    return by_dir


def load_entry(path: Path, namespace: str):
    """Import one entry generator with its project directory on sys.path."""
    module_name = f"_checkfit_{namespace}_{path.name.replace('.', '_')}"
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop(module_name, None)
        raise
    return module


def purge_project_modules(project: Path) -> None:
    """Drop every module imported from this project so the next one is clean."""
    project_text = str(project)
    for name, module in list(sys.modules.items()):
        origin = getattr(module, "__file__", None)
        if origin and str(Path(origin).resolve()).startswith(project_text):
            sys.modules.pop(name, None)


def body_count(solids) -> int:
    """Disconnected bodies, via bounding-box adjacency over the part's solids.

    A part may be modelled as many touching solids, so `len(shape.solids())` is
    not a body count. Union-find over overlapping
    bounding boxes is: two solids that share material must have overlapping
    boxes. It is deliberately conservative in the safe direction. Boxes that
    overlap without the solids touching merge anyway, so this under-reports
    rather than raising false alarms on a correctly-built part.
    """
    boxes = [solid.bounding_box() for solid in solids]
    parent = list(range(len(boxes)))

    def find(index: int) -> int:
        while parent[index] != index:
            parent[index] = parent[parent[index]]
            index = parent[index]
        return index

    def overlap(a, b) -> bool:
        return (
            a.min.X <= b.max.X + TOUCH_TOL and a.max.X >= b.min.X - TOUCH_TOL
            and a.min.Y <= b.max.Y + TOUCH_TOL and a.max.Y >= b.min.Y - TOUCH_TOL
            and a.min.Z <= b.max.Z + TOUCH_TOL and a.max.Z >= b.min.Z - TOUCH_TOL
        )

    for i in range(len(boxes)):
        for j in range(i + 1, len(boxes)):
            if not overlap(boxes[i], boxes[j]):
                continue
            root_i, root_j = find(i), find(j)
            if root_i != root_j:
                parent[root_i] = root_j
    return len({find(i) for i in range(len(boxes))})


def fits_bed(size_x: float, size_y: float, bed: tuple[float, float]) -> bool:
    """A part may be yawed 90 deg on the plate, so compare sorted extents."""
    part = sorted((size_x, size_y))
    plate = sorted(bed)
    return part[0] <= plate[0] + BED_TOL and part[1] <= plate[1] + BED_TOL


def measure_entry(path: Path, namespace: str) -> dict:
    """Build one part entry and return its print-orientation measurements."""
    sink = io.StringIO()
    with contextlib.redirect_stdout(sink):
        module = load_entry(path, namespace)
        builder = getattr(module, GEN_FUNC, None)
        if builder is None:
            raise AttributeError(f"{path.name} defines no {GEN_FUNC}()")
        shape = builder()
    if shape is None:
        raise ValueError(f"{path.name} {GEN_FUNC}() returned None")
    box = shape.bounding_box()
    solids = shape.solids()
    # Compound.volume is 0 when the geometry hangs off children rather than
    # being wrapped directly, which is what AssemblyHelper.compound() returns.
    return {
        "minZ": box.min.Z,
        "sizeX": box.size.X,
        "sizeY": box.size.Y,
        "sizeZ": box.size.Z,
        "volume": float(sum(solid.volume for solid in solids)),
        "solids": len(solids),
        "bodies": body_count(solids),
    }


BED_DECLARATION = re.compile(r"--bed\s+(\d+(?:\.\d+)?)\s*[x\u00d7]\s*(\d+(?:\.\d+)?)")


def declared_bed(project: Path) -> tuple[float, float] | None:
    """The bed a project states for itself, read from its own docs.

    Honouring the project's documented `check_mesh --bed ...` declaration keeps
    one bed size serving both the mesh check and this one, instead of this gate
    inventing a second, quieter answer.
    """
    for name in ("README.md", *sorted(q.name for q in project.glob("*_spec.md"))):
        doc = project / name
        if not doc.is_file():
            continue
        match = BED_DECLARATION.search(doc.read_text(encoding="utf-8", errors="replace"))
        if match:
            return float(match.group(1)), float(match.group(2))
    return None


def has_local_audit(project: Path) -> bool:
    """A project may carry its own audit, or document an equivalent command."""
    if (project / "measure" / "check_fit.py").is_file():
        return True
    readme = project / "README.md"
    if readme.is_file():
        text = readme.read_text(encoding="utf-8", errors="replace").lower()
        if "check_fit" in text or "fit/print audit" in text:
            return True
    return False


def check_project(project: Path, root: Path, paths: list[Path],
                  bed: tuple[float, float]) -> tuple[list[dict], list[dict]]:
    findings: list[dict] = []
    rows: list[dict] = []
    namespace = project.name.replace("-", "_").replace(".", "_")
    stated = declared_bed(project)
    if stated is not None:
        bed = stated

    project_text = str(project)
    inserted = project_text not in sys.path
    if inserted:
        sys.path.insert(0, project_text)
    try:
        for path in paths:
            rel = str(path.relative_to(root))
            try:
                measured = measure_entry(path, namespace)
            except BaseException as error:  # a generator may raise anything
                findings.append({
                    "path": rel,
                    "rule": "build-error",
                    "detail": f"{type(error).__name__}: {error}",
                })
                rows.append({"path": rel, "error": str(error)})
                continue

            rows.append({"path": rel, "bed": list(bed), **measured})

            if measured["volume"] <= 0:
                findings.append({
                    "path": rel,
                    "rule": "empty-part",
                    "detail": f"volume {measured['volume']:.3f} mm3 is not positive",
                })
            if abs(measured["minZ"]) > Z_TOL:
                findings.append({
                    "path": rel,
                    "rule": "print-datum",
                    "detail": (
                        f"min(Z) is {measured['minZ']:.3f}, expected 0 - the part is "
                        "still in assembly coordinates, not on the bed"
                    ),
                })
            if not fits_bed(measured["sizeX"], measured["sizeY"], bed):
                findings.append({
                    "path": rel,
                    "rule": "bed-footprint",
                    "detail": (
                        f"footprint {measured['sizeX']:.1f} x {measured['sizeY']:.1f} "
                        f"exceeds the {bed[0]:.0f} x {bed[1]:.0f} bed in either yaw"
                        + ("" if stated is None else " declared by the project")
                    ),
                })
            if measured["bodies"] > 1:
                findings.append({
                    "path": rel,
                    "rule": "multi-body-part",
                    "detail": (
                        f"{measured['bodies']} disconnected bodies from "
                        f"{measured['solids']} solids - confirm the README calls this "
                        "a print plate and not one printed piece"
                    ),
                })
    finally:
        if inserted:
            with contextlib.suppress(ValueError):
                sys.path.remove(project_text)
        purge_project_modules(project)

    if len(paths) >= 2 and not has_local_audit(project):
        findings.append({
            "path": str(project.relative_to(root)) if project != root else project.name,
            "rule": "no-project-fit-audit",
            "detail": (
                f"{len(paths)} printable parts, but no measure/check_fit.py and no "
                "README-documented equivalent; the base-dimension, connector-naming "
                "and assembly-order items cannot be checked generically"
            ),
        })
    return findings, rows


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("root", nargs="?", default=".", help="directory to scan (default: cwd)")
    parser.add_argument(
        "--entry",
        action="append",
        default=[],
        help=(
            "explicit printable *.step.py entry beneath root; repeat as needed. "
            "Use this for a Tier 1 or combined one-piece print target"
        ),
    )
    parser.add_argument("--bed", nargs=2, type=float, metavar=("X", "Y"),
                        default=list(DEFAULT_BED), help="bed size in mm (default: 220 220)")
    parser.add_argument("--strict", action="store_true",
                        help="fail on the advisory notes too")
    parser.add_argument("--json", action="store_true", help="emit findings as JSON")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    if not root.is_dir():
        print(f"check_fit: {root} is not a directory", file=sys.stderr)
        return 2
    bed = (args.bed[0], args.bed[1])

    try:
        by_dir = explicit_entries(root, args.entry) if args.entry else iter_printable_entries(root)
    except (OSError, SyntaxError, ValueError) as error:
        print(f"check_fit: {error}", file=sys.stderr)
        return 2
    raised: list[dict] = []
    measurements: list[dict] = []
    for project, paths in sorted(by_dir.items()):
        project_findings, rows = check_project(project, root, paths, bed)
        raised.extend(project_findings)
        measurements.extend(rows)

    if args.strict:
        findings, notes = raised, []
    else:
        findings = [f for f in raised if f["rule"] not in ADVISORY_RULES]
        notes = [f for f in raised if f["rule"] in ADVISORY_RULES]

    if args.json:
        print(json.dumps({
            "ok": not findings,
            "root": str(root),
            "bed": list(bed),
            "parts": measurements,
            "findings": findings,
            "notes": notes,
        }, indent=2))
        return 1 if findings else 0

    if not by_dir:
        print("check_fit: no printable entries found")
        return 0

    failed = {f["path"] for f in findings}
    flagged = {f["path"] for f in notes}
    print(f"{'printable part':<52} {'min Z':>8} {'footprint mm':>18} "
          f"{'height':>7} {'bodies':>7} {'volume mm3':>12}")
    for row in measurements:
        if "error" in row:
            print(f"{row['path']:<52}   BUILD ERROR")
            continue
        if row["path"] in failed:
            mark = "  FAIL"
        elif row["path"] in flagged:
            mark = "  note"
        else:
            mark = ""
        print(
            f"{row['path']:<52} {row['minZ']:8.3f} "
            f"{row['sizeX']:8.1f} x{row['sizeY']:7.1f} {row['sizeZ']:7.1f} "
            f"{row['bodies']:7d} {row['volume']:12.1f}{mark}"
        )

    if notes:
        print(f"\n{len(notes)} note(s) - not failures, but a human has to confirm them:")
        for note in notes:
            print(f"  {note['path']}\n    [{note['rule']}] {note['detail']}")

    if not findings:
        used = sorted({(row["bed"][0], row["bed"][1]) for row in measurements if "bed" in row})
        plates = ", ".join(f"{x:.0f} x {y:.0f}" for x, y in used) or "no bed"
        print(f"\ncheck_fit: ok - {len(measurements)} printable part(s) "
              f"on the bed, within {plates}")
        return 0
    print(f"\ncheck_fit: {len(findings)} fit/print violation(s)\n", file=sys.stderr)
    for finding in findings:
        print(f"  {finding['path']}\n    [{finding['rule']}] {finding['detail']}\n", file=sys.stderr)
    print("See the cad skill's SKILL.md, \"Do not declare a part printable\".", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
