#!/usr/bin/env python3
"""Motion-path and assembly-order gate for a source-built assembly.

`validate` says the solid is sound. `interfere` says nothing overlaps in the
assembled pose. Neither says the parts can be *brought* to that pose; a rigid
feature can still be impossible to insert into a closed slot.

This runs a declared motion manifest against the assembly, sampling the path and
testing each step with B-rep Boolean operations. Five checks:

    linear_motion_collision     slide/insert/withdraw along a vector
    rotation_motion_collision   hinge/fold/latch about an axis
    coupled_motion_collision    several parts moving together, on a pose table
    clear_path_proxy            a pin, tool or finger of radius r reaches
    assembly_sequence           an ordered list of the above, in order

The first two move ONE part against static obstacles, which is the wrong shape
of question for a machine: a gear pair, a cam and its follower, a Geneva drive
and a linkage all move at once, and holding the follower still turns the
mechanism's whole working motion into a collision. `coupled_motion_collision`
takes a pose per mover per sample -- the project's own kinematics, tabulated --
and asks whether the declared samples clear each other. Marking a mover
`"driven": true` additionally requires input-connected sampled contact
evidence: every edge has both a frozen-target collision and a nominal contact
witness. Static obstacles cannot supply drive edges. This is a necessary
geometric condition; it does not establish sustained contact, the prescribed
kinematic relationship, force transmission, or physical operation.

A condition says which answer it wants. `"expect": "clear"` (the default) is a
motion that must be possible; `"expect": "blocked"` is a capture -- a dovetail
that has to retain its tenon, a pin that must not back out. Without that second
form the gate can only ask whether parts come apart, never whether they stay
together, and a connector modelled as a plain boss in a plain pocket reads as a
clean pass.

At each sampled pose, measure the material intersection and check it against
the union volume within a band that scales with the operand volumes; when the
union disagrees or is unavailable, both differences must confirm the
intersection, or every formulation must at least agree on the threshold
verdict. Unavailable or inconsistent measurements are inconclusive. These operations use
the same CAD kernel; agreement is a consistency check.

A manifest may also declare a retention graph. This closes the loophole where
one moving part appears retained only because its nominal retainer was frozen
as an obstacle even though that retainer can itself fall or slide away.

    scripts/check_motion <project-dir> --manifest measure/motion.json
    scripts/check_motion <project-dir> --manifest -        # from stdin
    scripts/check_motion <project-dir> --manifest m.json --json

Exit 0 when every condition passes, 1 on any failure, 2 on bad usage.
See references/motion-manifests.md for the schema.
"""

from __future__ import annotations

import argparse
import contextlib
import importlib.util
import io
import json
import math
import sys
from contextlib import contextmanager
from contextvars import ContextVar
from pathlib import Path

SCRIPTS_DIR = Path(__file__).resolve().parent
PACKAGES_DIR = SCRIPTS_DIR / "packages"
CADPY_SRC_DIR = PACKAGES_DIR / "cadgen" / "src"
for _runtime_path in (SCRIPTS_DIR, PACKAGES_DIR, CADPY_SRC_DIR):
    _text = str(_runtime_path)
    if _runtime_path.is_dir() and _text not in sys.path:
        sys.path.insert(0, _text)

ENTRY_SUFFIX = ".step.py"
PART_PREFIX = "part_"
GEN_FUNC = "gen_" + "step"

DEFAULT_STEPS = 12
DEFAULT_OVERLAP_TOL = 1e-3  # mm3; contact is not collision
# Agreement between Common and A + B - Fuse, independent of a manifest's threshold.
# The kernel integrates volume to a relative precision, not to an absolute cubic
# micrometre. Replaying twelve accepted products showed the union-inferred
# intersection drifting by up to 3.4e-6 of the operand volumes in seated-contact
# poses of curved parts while the direct intersection and both differences
# agreed, so the band scales with the operands. A missing or wrong intersection
# differs by whole cubic millimetres and stays far outside it.
VOLUME_CONSISTENCY_MM3 = 1e-6
VOLUME_CONSISTENCY_RELATIVE = 1e-5
# Numerical contact tolerance, not a manifest-selectable operating clearance.
CONTACT_DISTANCE_MM = 1e-6


def consistency_tolerance(*volumes: float) -> float:
    """Absolute agreement band for measurements over these operand volumes."""
    return max(VOLUME_CONSISTENCY_MM3, VOLUME_CONSISTENCY_RELATIVE * math.fsum(volumes))


class ManifestError(Exception):
    """The manifest asks for something this gate cannot answer."""


# --- loading the assembly -------------------------------------------------

def find_assembly_entry(project: Path, declared: str | None) -> Path:
    if declared:
        path = project / declared
        if not path.is_file():
            raise ManifestError(f"assembly entry {declared} not found in {project}")
        return path
    candidates = [
        path for path in sorted(project.glob("*" + ENTRY_SUFFIX))
        if not path.name.startswith(PART_PREFIX)
    ]
    if not candidates:
        raise ManifestError(f"no combined <name>{ENTRY_SUFFIX} in {project}")
    if len(candidates) > 1:
        names = ", ".join(path.name for path in candidates)
        raise ManifestError(f'{project} has several assembly entries ({names}); set "assembly"')
    return candidates[0]


def build_assembly(entry: Path):
    """Import one entry generator with its project directory on sys.path."""
    project = str(entry.parent)
    inserted = project not in sys.path
    if inserted:
        sys.path.insert(0, project)
    module_name = f"_checkmotion_{entry.name.replace('.', '_')}"
    try:
        spec = importlib.util.spec_from_file_location(module_name, entry)
        if spec is None or spec.loader is None:
            raise ManifestError(f"cannot load {entry}")
        module = importlib.util.module_from_spec(spec)
        sys.modules[module_name] = module
        sink = io.StringIO()
        with contextlib.redirect_stdout(sink):
            spec.loader.exec_module(module)
            builder = getattr(module, GEN_FUNC, None)
            if builder is None:
                raise ManifestError(f"{entry.name} defines no {GEN_FUNC}()")
            shape = builder()
    finally:
        if inserted:
            with contextlib.suppress(ValueError):
                sys.path.remove(project)
    if shape is None:
        raise ManifestError(f"{entry.name} {GEN_FUNC}() returned None")
    return shape


def index_parts(shape) -> dict[str, object]:
    """Index placed nodes and leaves using their exact assembly ancestry.

    The private leaf/key metadata lets motion presentation reuse the same
    placed occurrences and resolve a moving group without moving a leaf twice.
    """
    from build123d import Location

    found: dict[str, list[tuple[tuple[int, ...], object]]] = {}
    leaves = []

    def walk(node, trail, parent_pose, key=(), inherited_colour=None):
        label = getattr(node, "label", "") or ""
        path = trail + ([label] if label else [])
        pose = parent_pose * node.location
        placed = node.located(pose)
        colour = getattr(node, "color", None)
        if colour is None:
            colour = inherited_colour
        if label and key:
            for alias in dict.fromkeys((label, ".".join(path))):
                found.setdefault(alias, []).append((key, placed))
        children = list(getattr(node, "children", []) or [])
        if not children:
            leaves.append((key, placed, colour))
        for index, child in enumerate(children):
            walk(child, path, pose, (*key, index), colour)

    walk(shape, [], Location())
    parts = {name: nodes[0][1] for name, nodes in found.items() if len(nodes) == 1}
    parts["__node_keys__"] = {name: nodes[0][0] for name, nodes in found.items() if len(nodes) == 1}
    parts["__leaf_nodes__"] = leaves
    parts["__ambiguous__"] = sorted(name for name, nodes in found.items() if len(nodes) > 1)
    parts["__toplevel__"] = [label for label in
                             (getattr(child, "label", "") for child in
                              list(getattr(shape, "children", []) or []))
                             if label]
    return parts


# --- geometry -------------------------------------------------------------


_MAX_VALIDITY_CACHE_ENTRIES = 256


class ValidityCache:
    """Scope to an immutable assembly measurement with non-destructive Booleans.

    Cache complete non-compound topology, including its orientation. A positive
    unit-scale placement may change while internal validity is invariant. Other
    transforms keep their placement in the key. Hash matches require IsEqual.
    OCCT compound validity recurses into children and adds no compound check.
    """
    def __init__(self):
        self.buckets = {}
        self.hits = 0
        self.checks = 0
        self.entries = 0
        self.clears = 0

    def is_valid(self, wrapped):
        from build123d import Compound
        from OCP.TopAbs import TopAbs_COMPOUND
        from OCP.TopLoc import TopLoc_Location
        from OCP.TopoDS import TopoDS_Iterator

        if wrapped.IsNull():
            return False
        if wrapped.ShapeType() == TopAbs_COMPOUND:
            children = TopoDS_Iterator(wrapped)
            while children.More():
                if not self.is_valid(children.Value()):
                    return False
                children.Next()
            return True
        transform = wrapped.Location().Transformation()
        canonical = wrapped
        if transform.ScaleFactor() == 1.0 and not transform.IsNegative():
            canonical = wrapped.Located(TopLoc_Location())
        bucket = self.buckets.setdefault(hash(canonical), [])
        for previous, valid in bucket:
            if previous.IsEqual(canonical):
                self.hits += 1
                return valid
        # Validate the complete topology on a miss. Reuse is limited to
        # immutable geometry within this measurement scope.
        valid = Compound(wrapped).is_valid
        self.checks += 1
        if self.entries >= _MAX_VALIDITY_CACHE_ENTRIES:
            # Retaining every transient Boolean result would make memory grow
            # with the pose count. Eviction only causes fresh validation.
            self.buckets.clear()
            self.entries = 0
            self.clears += 1
            bucket = self.buckets.setdefault(hash(canonical), [])
        bucket.append((canonical, valid))
        self.entries += 1
        return valid


_VALIDATION = ContextVar('motion_validation', default=None)
# The collision threshold of the condition being measured, so a pose whose
# Boolean volumes disagree can still be judged when every formulation gives the
# same threshold verdict. Absent outside a condition.
_DECISION = ContextVar('motion_decision_threshold', default=None)


@contextmanager
def decision_scope(threshold):
    token = _DECISION.set(float(threshold))
    try:
        yield
    finally:
        _DECISION.reset(token)



@contextmanager
def validation_scope():
    """Share bounded validity work inside one immutable outer condition."""
    existing = _VALIDATION.get()
    if existing is not None:
        yield existing
        return
    cache = ValidityCache()
    token = _VALIDATION.set(cache)
    try:
        yield cache
    finally:
        _VALIDATION.reset(token)


def _is_valid(shape):
    cache = _VALIDATION.get()
    return shape.is_valid if cache is None else cache.is_valid(shape.wrapped)


def solid_volume(shape, *, require_solid=False):
    """Require finite nonnegative volumes; valid empty Boolean results have zero."""
    solids = list(shape.solids())
    if require_solid and not solids:
        raise ValueError('motion operand contains no solid')
    values = [float(s.volume) for s in solids]
    if any(not math.isfinite(v) or v < 0 for v in values):
        raise ValueError('motion geometry has nonfinite or negative volume')
    result = math.fsum(values)
    if not math.isfinite(result) or (require_solid and result <= 0):
        raise ValueError('motion geometry has no finite positive volume')
    return result


def _boolean_shape(kind, arguments, tool_shapes):
    """Run one non-destructive operation and reject unusable geometry."""
    from build123d import Compound
    from OCP.TopTools import TopTools_ListOfShape

    operation = kind()
    operation.SetNonDestructive(True)
    args, tools = TopTools_ListOfShape(), TopTools_ListOfShape()
    for shape in arguments:
        args.Append(shape.wrapped)
    for shape in tool_shapes:
        tools.Append(shape.wrapped)
    operation.SetArguments(args)
    operation.SetTools(tools)
    operation.Build()
    if not operation.IsDone():
        raise ValueError('motion Boolean operation did not complete')
    wrapped = operation.Shape()
    if wrapped.IsNull():
        raise ValueError('motion Boolean operation returned null geometry')
    shape = Compound(wrapped)
    if not _is_valid(shape):
        raise ValueError('motion Boolean operation returned invalid geometry')
    return shape


def _material(shape):
    """Fuse placed solids so overlapping children count as material once."""
    from OCP.BRepAlgoAPI import BRepAlgoAPI_Fuse

    solids = list(shape.solids())
    if not solids:
        raise ValueError('motion operand contains no solid')
    values = [solid_volume(s, require_solid=True) for s in solids]
    if len(solids) == 1:
        return solids[0], values[0]
    try:
        normalized = _boolean_shape(BRepAlgoAPI_Fuse, solids[:1], solids[1:])
        measured = solid_volume(normalized, require_solid=True)
        tolerance = consistency_tolerance(*values)
        if (measured < max(values) - tolerance or
                measured > math.fsum(values) + tolerance):
            raise ValueError('motion group union has inconsistent volume')
    except ValueError as error:
        label = getattr(shape, 'label', '') or '<unnamed>'
        raise ValueError(
            f'normalizing group {label!r} ({len(solids)} solids): {error}'
        ) from error
    return normalized, measured


def overlap_volume(a, b):
    """Measure intersection only when both Boolean measurements are consistent."""
    from OCP.BRepAlgoAPI import BRepAlgoAPI_Common, BRepAlgoAPI_Cut, BRepAlgoAPI_Fuse

    # Resolve actual placed solids for both plain and assembly compounds.
    a, va = _material(a)
    b, vb = _material(b)
    ba, bb = a.bounding_box(), b.bounding_box()
    if (ba.min.X > bb.max.X or ba.max.X < bb.min.X or
            ba.min.Y > bb.max.Y or ba.max.Y < bb.min.Y or
            ba.min.Z > bb.max.Z or ba.max.Z < bb.min.Z):
        return 0.0
    a_solids, b_solids = list(a.solids()), list(b.solids())
    common = solid_volume(_boolean_shape(BRepAlgoAPI_Common, a_solids, b_solids))
    tolerance = consistency_tolerance(va, vb)
    if common > min(va, vb) + tolerance:
        raise ValueError('motion Boolean measurements are inconsistent: '
                         f'common={common:.9g} exceeds an operand volume mm3')
    def arbitrate(reason: str, union_estimate: float | None) -> float:
        # The union of touching or interpenetrating solids can fail, come back
        # invalid, or lose material along coincident faces where the
        # intersection succeeded. Both differences must then confirm the
        # intersection; failing that, every available formulation must still
        # give the same verdict against the condition's collision threshold.
        # Interpenetrating thin shells on accepted products measured 13 mm3 by
        # intersection, 12-21 mm3 by the differences and 50-78 mm3 by union:
        # unusable as volumes, unanimous as a blocked pose.
        residue_a = solid_volume(_boolean_shape(BRepAlgoAPI_Cut, a_solids, b_solids))
        residue_b = solid_volume(_boolean_shape(BRepAlgoAPI_Cut, b_solids, a_solids))
        estimates = [va - residue_a, vb - residue_b]
        if all(abs(common - estimate) <= tolerance for estimate in estimates):
            return common
        threshold = _DECISION.get()
        judged = estimates + ([union_estimate] if union_estimate is not None else [])
        if threshold is not None and all((estimate > threshold) == (common > threshold)
                                         for estimate in judged):
            return common
        raise ValueError('motion Boolean measurements are inconsistent: '
                         f'common={common:.9g}, operand-minus-difference='
                         f'{estimates[0]:.9g}/{estimates[1]:.9g} mm3 ({reason})')

    try:
        union = solid_volume(_boolean_shape(BRepAlgoAPI_Fuse, a_solids, b_solids))
    except ValueError as union_error:
        return arbitrate(f'union unavailable: {union_error}', None)
    inferred = math.fsum([va, vb, -union])
    if union < max(va, vb) - tolerance or abs(common - inferred) > tolerance:
        return arbitrate(f'operands-minus-union={inferred:.9g} mm3 disagrees', inferred)
    return common


def boxes_apart(a, b) -> bool:
    box_a, box_b = a.bounding_box(), b.bounding_box()
    return (
        box_a.min.X > box_b.max.X or box_a.max.X < box_b.min.X
        or box_a.min.Y > box_b.max.Y or box_a.max.Y < box_b.min.Y
        or box_a.min.Z > box_b.max.Z or box_a.max.Z < box_b.min.Z
    )


def vector3(value, field: str):
    if not isinstance(value, (list, tuple)) or len(value) != 3:
        raise ManifestError(f"{field} must be [x, y, z]")
    try:
        return tuple(float(component) for component in value)
    except (TypeError, ValueError) as error:
        raise ManifestError(f"{field} must be numeric: {error}") from error


def part_names(parts: dict) -> list[str]:
    """The labelled parts, without the dunder bookkeeping keys."""
    return [name for name in parts if not name.startswith("__")]


def resolve_parts(names, parts: dict, field: str) -> list[tuple[str, object]]:
    if isinstance(names, str):
        names = [names]
    if not isinstance(names, list) or not names:
        raise ManifestError(f"{field} must name at least one part")
    ambiguous = parts.get("__ambiguous__", [])
    resolved = []
    for name in names:
        if name in ambiguous:
            options = [key for key in part_names(parts) if key.endswith("." + name)]
            raise ManifestError(
                f'{field} "{name}" is ambiguous - several parts carry that label; '
                f'use a dotted path such as {options[0] if options else "<parent>." + name}'
            )
        if name not in parts or name.startswith("__"):
            near = [key for key in sorted(part_names(parts))
                    if name.lower() in key.lower()][:6]
            hint = f"did you mean: {', '.join(near)}" if near else "run --list-parts"
            raise ManifestError(f'{field} "{name}" is not a labelled part; {hint}')
        resolved.append((name, parts[name]))
    return resolved


def sweep(moving, obstacles, place, steps: int, tol: float, allow_seated: bool) -> dict:
    """Move `moving` through `steps` samples, reporting the first collision.

    `allow_seated` skips step 0. An installed insert legitimately touches what
    it is installed in, so testing the seated pose measures the design intent,
    not the path -- that is what `interfere` is for.
    """
    first = 1 if allow_seated else 0
    for step in range(first, steps + 1):
        moved = place(moving, step / steps)
        for name, obstacle in obstacles:
            volume = overlap_volume(moved, obstacle)
            if volume > tol:
                return {
                    "clear": False,
                    "step": step,
                    "steps": steps,
                    "obstacle": name,
                    "overlapMm3": round(volume, 6),
                }
    return {"clear": True, "steps": steps, "skippedSeatedStep": allow_seated}


# --- the checks -----------------------------------------------------------

def check_linear(inputs: dict, thresholds: dict, parts: dict) -> dict:
    from build123d import Vector

    moving_name = inputs.get("moving_part")
    if not moving_name:
        raise ManifestError("linear_motion_collision requires moving_part")
    moving = resolve_parts(moving_name, parts, "moving_part")[0][1]
    obstacles = resolve_parts(inputs.get("obstacle_parts"), parts, "obstacle_parts")
    translation = Vector(*vector3(inputs.get("translation"), "translation"))
    steps = int(inputs.get("steps", DEFAULT_STEPS))
    if steps < 1:
        raise ManifestError("steps must be >= 1")
    tol = float(thresholds.get("maxOverlapMm3", DEFAULT_OVERLAP_TOL))

    def place(shape, fraction: float):
        return shape.translate(translation * fraction)

    result = sweep(moving, obstacles, place, steps, tol,
                   bool(inputs.get("allow_seated_contact", False)))
    result["translation"] = list(vector3(inputs.get("translation"), "translation"))
    result["stepMm"] = round(translation.length / steps, 4)
    return result


def check_rotation(inputs: dict, thresholds: dict, parts: dict) -> dict:
    from build123d import Axis, Vector

    moving_name = inputs.get("moving_part")
    if not moving_name:
        raise ManifestError("rotation_motion_collision requires moving_part")
    moving = resolve_parts(moving_name, parts, "moving_part")[0][1]
    obstacles = resolve_parts(inputs.get("obstacle_parts"), parts, "obstacle_parts")
    point = vector3(inputs.get("axis_point"), "axis_point")
    direction = vector3(inputs.get("axis_direction"), "axis_direction")
    if not any(direction):
        raise ManifestError("axis_direction must not be the zero vector")
    axis = Axis(Vector(*point), Vector(*direction))
    start = float(inputs.get("start_deg", 0.0))
    end = float(inputs.get("end_deg", 0.0))
    steps = int(inputs.get("steps", DEFAULT_STEPS))
    if steps < 1:
        raise ManifestError("steps must be >= 1")
    tol = float(thresholds.get("maxOverlapMm3", DEFAULT_OVERLAP_TOL))

    def place(shape, fraction: float):
        return shape.rotate(axis, start + (end - start) * fraction)

    result = sweep(moving, obstacles, place, steps, tol,
                   bool(inputs.get("allow_seated_contact", False)))
    result["arcDeg"] = [start, end]
    reach = _reach(moving, point, direction)
    sampled = [start + (end - start) * i / steps for i in range(steps + 1)]
    result["stepMm"] = round(_step_mm(reach, sampled, [(0.0, 0.0, 0.0)] * (steps + 1)), 4)
    if not result["clear"]:
        result["angleDeg"] = round(start + (end - start) * result["step"] / steps, 4)
    return result


def check_clear_path(inputs: dict, thresholds: dict, parts: dict) -> dict:
    from build123d import Plane, Solid, Vector

    start = Vector(*vector3(inputs.get("start"), "start"))
    end = Vector(*vector3(inputs.get("end"), "end"))
    radius = float(inputs.get("radius", 0.0))
    if radius <= 0:
        raise ManifestError("clear_path_proxy requires a positive radius")
    direction = end - start
    if direction.length == 0:
        raise ManifestError("clear_path_proxy start and end must differ")
    obstacles = resolve_parts(inputs.get("obstacle_parts"), parts, "obstacle_parts")
    tol = float(thresholds.get("maxOverlapMm3", DEFAULT_OVERLAP_TOL))

    probe = Solid.make_cylinder(radius, direction.length, Plane(origin=start, z_dir=direction))
    blocked = []
    for name, obstacle in obstacles:
        volume = overlap_volume(probe, obstacle)
        if volume > tol:
            blocked.append({"obstacle": name, "overlapMm3": round(volume, 6)})
    return {
        "clear": not blocked,
        "radius": radius,
        "length": round(direction.length, 4),
        "blockedBy": blocked,
    }



def _reach(shape, axis_point, axis_direction) -> float:
    """Furthest any point of the shape sits from a rotation axis."""
    import math as _math

    box = shape.bounding_box()
    px, py, pz = axis_point
    dx, dy, dz = axis_direction
    length = _math.sqrt(dx * dx + dy * dy + dz * dz) or 1.0
    dx, dy, dz = dx / length, dy / length, dz / length
    worst = 0.0
    for x in (box.min.X, box.max.X):
        for y in (box.min.Y, box.max.Y):
            for z in (box.min.Z, box.max.Z):
                rx, ry, rz = x - px, y - py, z - pz
                along = rx * dx + ry * dy + rz * dz
                ox, oy, oz = rx - along * dx, ry - along * dy, rz - along * dz
                worst = max(worst, _math.sqrt(ox * ox + oy * oy + oz * oz))
    return worst


def _step_mm(reach: float, angles, offsets) -> float:
    """Furthest a point of a part travels between consecutive samples.

    A sweep is blind to anything smaller than its own step: sample a gear mesh
    every third of a tooth and a tooth passing clean through another reads as a
    clear path. This is what makes that visible -- and, with
    `thresholds.maxStepMm`, what makes it a check rather than a footnote.
    """
    import math as _math

    worst = 0.0
    count = max(len(angles), len(offsets))
    for index in range(1, count):
        turn = abs(angles[index] - angles[index - 1]) if index < len(angles) else 0.0
        swing = 2.0 * reach * _math.sin(_math.radians(turn) / 2.0) if turn else 0.0
        slide = 0.0
        if index < len(offsets):
            a, b = offsets[index - 1], offsets[index]
            slide = _math.sqrt(sum((b[k] - a[k]) ** 2 for k in range(3)))
        worst = max(worst, swing + slide)
    return worst


def _pose_table(spec: dict, steps: int, field: str):
    """Absolute poses for one mover, sample by sample.

    Explicit tables come from the project's own kinematics -- the same solution
    that placed the geometry -- so the gate never re-derives a mechanism it
    cannot know. A start/end pair is the linear shorthand for the cases where
    the motion really is uniform.
    """
    from build123d import Axis, Vector

    rotate = spec.get("rotation")
    translate = spec.get("translation")
    if not rotate and not translate:
        raise ManifestError(f"{field} needs a rotation, a translation, or both")

    axis = None
    point = direction = None
    angles = [0.0] * (steps + 1)
    if rotate:
        point = vector3(rotate.get("axis_point"), f"{field}.rotation.axis_point")
        direction = vector3(rotate.get("axis_direction"), f"{field}.rotation.axis_direction")
        if not any(direction):
            raise ManifestError(f"{field}.rotation.axis_direction must not be the zero vector")
        axis = Axis(Vector(*point), Vector(*direction))
        listed = rotate.get("angles_deg")
        if listed is not None:
            if not isinstance(listed, list) or len(listed) != steps + 1:
                raise ManifestError(
                    f"{field}.rotation.angles_deg must hold steps+1 = {steps + 1} values, "
                    f"got {len(listed) if isinstance(listed, list) else type(listed).__name__}")
            angles = [float(value) for value in listed]
        else:
            start = float(rotate.get("start_deg", 0.0))
            end = float(rotate.get("end_deg", 0.0))
            angles = [start + (end - start) * i / steps for i in range(steps + 1)]

    offsets = [(0.0, 0.0, 0.0)] * (steps + 1)
    if translate:
        listed = translate.get("offsets_mm")
        if listed is not None:
            if not isinstance(listed, list) or len(listed) != steps + 1:
                raise ManifestError(
                    f"{field}.translation.offsets_mm must hold steps+1 = {steps + 1} values")
            offsets = [vector3(value, f"{field}.translation.offsets_mm") for value in listed]
        else:
            vector = vector3(translate.get("vector"), f"{field}.translation.vector")
            start = float(translate.get("start", 0.0))
            end = float(translate.get("end", 1.0))
            offsets = [
                tuple(component * (start + (end - start) * i / steps) for component in vector)
                for i in range(steps + 1)
            ]

    def place(shape, index: int):
        moved = shape
        if axis is not None and angles[index]:
            moved = moved.rotate(axis, angles[index])
        offset = offsets[index]
        if any(offset):
            moved = moved.translate(Vector(*offset))
        return moved

    place.angles = angles
    place.offsets = offsets
    place.axis_point = point if rotate else (0.0, 0.0, 0.0)
    place.axis_direction = direction if rotate else (0.0, 0.0, 1.0)
    return place


def _box_gap(first, second) -> float:
    """Euclidean gap between two bounding boxes; zero when they meet."""
    gaps = (max(0.0, first.min.X - second.max.X, second.min.X - first.max.X),
            max(0.0, first.min.Y - second.max.Y, second.min.Y - first.max.Y),
            max(0.0, first.min.Z - second.max.Z, second.min.Z - first.max.Z))
    return math.sqrt(sum(g * g for g in gaps))


# Bounding boxes come without the shape tolerance; keep candidate faces that
# are within this extra margin so a genuine contact is never filtered away.
NEAR_FACE_MARGIN_MM = 1e-3


def _extrema(a, b) -> float:
    from OCP.BRepExtrema import BRepExtrema_DistShapeShape
    # OCCT's shape-taking constructor performs the query immediately.
    # Calling Perform again repeats the same expensive distance search.
    measurement = BRepExtrema_DistShapeShape(a.wrapped, b.wrapped)
    if not measurement.IsDone() or measurement.NbSolution() < 1:
        raise ManifestError("drive contact distance did not complete")
    distance = float(measurement.Value())
    if not math.isfinite(distance) or distance < 0:
        raise ManifestError("drive contact distance is not finite and nonnegative")
    return distance


def surface_distance(a, b, within: float | None = None):
    """Finite minimum distance between the actual placed solid materials.

    With `within`, the answer is exact whenever it is at most `within`, and
    otherwise only certifies that the distance exceeds `within`: faces whose
    bounding boxes lie farther than that from the other part cannot realize a
    closer point, so the expensive extrema query runs on the near faces only.
    A whole-part query on an accepted product cost 0.22 s per sample, over a
    thousand samples for pairs that never touch.
    """
    from build123d import Compound
    a, _ = _material(a)
    b, _ = _material(b)
    if not _is_valid(a) or not _is_valid(b):
        raise ManifestError("drive contact distance has invalid geometry")
    if within is None:
        return _extrema(a, b)
    if not math.isfinite(within) or within < 0:
        raise ManifestError("drive contact tolerance is not finite and nonnegative")
    reach = within + NEAR_FACE_MARGIN_MM
    box_a, box_b = a.bounding_box(), b.bounding_box()
    bound = _box_gap(box_a, box_b)
    if bound > reach:
        return bound
    near_a = [face for face in a.faces() if _box_gap(face.bounding_box(), box_b) <= reach]
    near_b = [face for face in b.faces() if _box_gap(face.bounding_box(), box_a) <= reach]
    if not near_a or not near_b:
        return reach
    return _extrema(Compound(near_a), Compound(near_b))


def sampled_drive_evidence(placed, steps, overlap_tol, allow_seated):
    """Necessary sampled contact evidence, not a transmission/dynamics proof.

    A candidate parent must touch the target's frozen pose, and the same pair
    must have contact in at least one nominal operating pose. Every target
    must be reachable from an independently declared input along such edges.
    Static obstacles never become drive edges.
    """
    roots = [name for name, _shape, _place, driven in placed if not driven]
    targets = [entry for entry in placed if entry[3]]
    first_step = 1 if allow_seated else 0
    nominal = {}
    edges = []
    # Every placement is a deep copy of the part; the same mover at the same
    # sample is needed by several pairs, so place each once.
    placements = {}

    def posed(name, shape, place, step):
        key = (name, step)
        if key not in placements:
            placements[key] = place(shape, step)
        return placements[key]

    for target, target_shape, target_place, _ in targets:
        frozen = posed(target, target_shape, target_place, 0)
        for parent, parent_shape, parent_place, _ in placed:
            if parent == target:
                continue
            frozen_hit = None
            for step in range(first_step, steps + 1):
                volume = overlap_volume(posed(parent, parent_shape, parent_place, step), frozen)
                if volume > overlap_tol:
                    frozen_hit = {"step": step, "overlapMm3": volume}
                    break
            if frozen_hit is None:
                continue
            pair = tuple(sorted((parent, target)))
            if pair not in nominal:
                nominal[pair] = None
                for step in range(first_step, steps + 1):
                    distance = float(surface_distance(
                        posed(parent, parent_shape, parent_place, step),
                        posed(target, target_shape, target_place, step),
                        within=CONTACT_DISTANCE_MM))
                    # Keep validation at the decision boundary, before using
                    # a distance measurement as contact evidence.
                    if not math.isfinite(distance) or distance < 0:
                        raise ManifestError("drive contact distance is not finite and nonnegative")
                    if distance <= CONTACT_DISTANCE_MM:
                        nominal[pair] = {"step": step, "distanceMm": distance}
                        break
            if nominal[pair] is not None:
                edges.append({"from": parent, "to": target,
                              "frozenWitness": frozen_hit,
                              "nominalWitness": nominal[pair]})
    reached = set(roots)
    while True:
        extra = {edge["to"] for edge in edges if edge["from"] in reached} - reached
        if not extra:
            break
        reached.update(extra)
    return {"scope": "necessary sampled contact evidence; no force, sustained-contact or physical proof",
            "inputParts": roots, "edges": edges,
            "unreachedDrivenParts": [name for name, *_ in targets if name not in reached]}


def check_coupled(inputs: dict, thresholds: dict, parts: dict) -> dict:
    """Several parts driven through one cycle together, pose table by pose table."""
    movers = inputs.get("movers")
    if not isinstance(movers, list) or not movers:
        raise ManifestError("coupled_motion_collision requires a movers list")
    steps = int(inputs.get("steps", DEFAULT_STEPS))
    if steps < 1:
        raise ManifestError("steps must be >= 1")
    tol = float(thresholds.get("maxOverlapMm3", DEFAULT_OVERLAP_TOL))
    allow_seated = bool(inputs.get("allow_seated_contact", False))

    placed = []
    selected_names = set()
    selected_nodes = []
    node_keys = parts.get("__node_keys__", {})
    for index, spec in enumerate(movers):
        if not isinstance(spec, dict):
            raise ManifestError(f"movers[{index}] must be an object")
        name = spec.get("part")
        if not name or not isinstance(name, str):
            raise ManifestError(f"movers[{index}] requires a part name")
        if name in selected_names:
            raise ManifestError(
                f"movers repeat {name}; name each assembly occurrence only once")
        shape = resolve_parts(name, parts, f"movers[{index}].part")[0][1]
        key = node_keys.get(name)
        if key is not None:
            # Aliases share one node key; a group also owns its descendant
            # leaves. Both cases would otherwise move one occurrence twice.
            for prior_name, prior_key in selected_nodes:
                if key[:len(prior_key)] == prior_key or prior_key[:len(key)] == key:
                    raise ManifestError(
                        f"movers {prior_name} and {name} select overlapping assembly "
                        "occurrences; name each occurrence only once")
            selected_nodes.append((name, key))
        selected_names.add(name)
        placed.append((name, shape, _pose_table(spec, steps, f"movers[{index}]"),
                       bool(spec.get("driven", False))))
    if len(placed) < 2 and any(driven for *_, driven in placed):
        raise ManifestError('"driven" needs something to be driven by: name at least two movers')

    obstacles = []
    if "obstacle_parts" not in inputs:
        # Every other check names its obstacles. This one does not have to, and
        # the part it silently leaves out is the frame -- the one thing a
        # mechanism is guaranteed to move against. Absence is unexamined; an
        # explicit empty list is a decision, and passes.
        mover_names = {name for name, *_ in placed}
        unswept = [name for name in parts.get("__toplevel__", [])
                   if name not in mover_names
                   and not any(mover == name or mover.startswith(name + ".")
                               for mover in mover_names)]
        if unswept:
            raise ManifestError(
                "coupled_motion_collision left "
                + ", ".join(sorted(unswept))
                + " out of the sweep entirely: they are neither movers nor "
                  "obstacles, so this cycle was never tested against them. "
                  'Name them in obstacle_parts, or write "obstacle_parts": [] '
                  "to say on the record that the cycle does not touch them."
            )
    elif inputs.get("obstacle_parts"):
        obstacles = resolve_parts(inputs["obstacle_parts"], parts, "obstacle_parts")

    def sweep_cycle():
        """First collision in the declared nominal poses, or None."""
        for step in range(1 if allow_seated else 0, steps + 1):
            posed = [
                (name, place(shape, step))
                for name, shape, place, driven in placed
            ]
            for first in range(len(posed)):
                for second in range(first + 1, len(posed)):
                    volume = overlap_volume(posed[first][1], posed[second][1])
                    if volume > tol:
                        return {"step": step, "steps": steps,
                                "between": [posed[first][0], posed[second][0]],
                                "overlapMm3": round(volume, 6)}
                for obstacle_name, obstacle in obstacles:
                    volume = overlap_volume(posed[first][1], obstacle)
                    if volume > tol:
                        return {"step": step, "steps": steps,
                                "between": [posed[first][0], obstacle_name],
                                "overlapMm3": round(volume, 6)}
        return None

    step_mm = 0.0
    for name, shape, place, _driven in placed:
        reach = _reach(shape, place.axis_point, place.axis_direction)
        step_mm = max(step_mm, _step_mm(reach, place.angles, place.offsets))

    hit = sweep_cycle()
    result = {
        "clear": hit is None,
        "steps": steps,
        "stepMm": round(step_mm, 4),
        "movers": [name for name, *_ in placed],
        "skippedSeatedStep": allow_seated,
    }
    if hit is not None:
        result.update(step=hit["step"], obstacle=" x ".join(hit["between"]),
                      overlapMm3=hit["overlapMm3"])

    driven_names = [name for name, _, _, driven in placed if driven]
    if driven_names:
        evidence = sampled_drive_evidence(placed, steps, tol, allow_seated)
        missing = evidence["unreachedDrivenParts"]
        result["drivenParts"] = driven_names
        result["driveEvidence"] = evidence
        result["driveContactEvidencePassed"] = not missing
        if missing:
            # Keep the sampled collision answer truthful. The independent
            # evidence flag still makes run_condition fail closed.
            result["driveEvidenceDetail"] = (
                "No input-connected nominal contact evidence for " + ", ".join(missing)
                + ("; no independent input was declared" if not evidence["inputParts"] else "")
                + ". A frozen-pose collision alone does not establish transmission.")
        else:
            result["driveEvidenceDetail"] = (
                "Every declared driven part has input-connected sampled contact evidence; "
                "this is necessary evidence, not a dynamics or physical transmission proof.")
    return result


CHECKS = {
    "linear_motion_collision": check_linear,
    "rotation_motion_collision": check_rotation,
    "coupled_motion_collision": check_coupled,
    "clear_path_proxy": check_clear_path,
}


def run_condition(condition: dict, parts: dict, index: int) -> dict:
    # One condition samples an immutable assembly with non-destructive Boolean
    # operations. Nested assembly-sequence conditions share this cache; it is
    # discarded when the outer condition returns or raises.
    threshold = (condition.get("thresholds") or {}).get("maxOverlapMm3", DEFAULT_OVERLAP_TOL)
    with validation_scope(), decision_scope(threshold):
        return _run_condition(condition, parts, index)


def _run_condition(condition: dict, parts: dict, index: int) -> dict:
    name = condition.get("check")
    ident = condition.get("id", f"condition_{index}")
    record = {
        "id": ident,
        "check": name,
        "description": condition.get("description", ""),
    }
    inputs = condition.get("inputs", {}) or {}
    thresholds = condition.get("thresholds", {}) or {}

    if name == "assembly_sequence":
        steps = inputs.get("steps")
        if not isinstance(steps, list) or not steps:
            record.update(status="inconclusive",
                          detail="assembly_sequence requires a non-empty steps list")
            return record
        results = []
        for position, step in enumerate(steps):
            if not isinstance(step, dict):
                record.update(status="inconclusive",
                              detail=f"assembly_sequence step {position} must be an object")
                return record
            step.setdefault("id", f"{ident}.{position}")
            results.append(run_condition(step, parts, position))
        record["stepResults"] = results
        failed = [r["id"] for r in results if r["status"] == "fail"]
        unclear = [r["id"] for r in results if r["status"] == "inconclusive"]
        if failed:
            record.update(status="fail",
                          detail=f"order breaks at {failed[0]} ({len(failed)} failing step(s))")
        elif unclear:
            record.update(status="inconclusive", detail=f"inconclusive at {', '.join(unclear)}")
        else:
            record.update(status="pass", detail=f"{len(results)} steps in order, all clear")
        return record

    handler = CHECKS.get(name)
    if handler is None:
        known = ", ".join(sorted([*CHECKS, "assembly_sequence"]))
        record.update(status="inconclusive", detail=f"unknown check {name!r}; known: {known}")
        return record

    try:
        outcome = handler(inputs, thresholds, parts)
    except ManifestError as error:
        record.update(status="inconclusive", detail=str(error))
        return record
    except Exception as error:  # a boolean can fail on degenerate input
        record.update(status="inconclusive", detail=f"{type(error).__name__}: {error}")
        return record

    record.update(outcome)
    limit = thresholds.get("maxStepMm")
    if limit is not None and outcome.get("stepMm", 0.0) > float(limit):
        record.update(
            status="inconclusive",
            detail=(f"sampled every {outcome['stepMm']:.3f} mm, coarser than the "
                    f"{float(limit):.3f} mm this condition declares it has to see: a sweep "
                    "is blind to anything smaller than its own step. Raise steps."))
        return record
    expect = condition.get("expect", "clear")
    if expect not in ("clear", "blocked"):
        record.update(status="inconclusive", detail=f'expect must be "clear" or "blocked"')
        return record
    record["expect"] = expect

    clear = bool(outcome.get("clear"))
    if outcome.get("drivenParts") and not outcome.get("driveContactEvidencePassed"):
        # Missing required contact evidence cannot be converted into a
        # successful blocked/retention condition by changing expect.
        record["expect"] = condition.get("expect", "clear")
        record["status"] = "fail"
        record["detail"] = outcome["driveEvidenceDetail"]
        return record
    if clear:
        moved = (f"clear across {outcome['steps']} samples" if outcome.get("movers")
                 else f"clear across {outcome['steps']} steps" if "steps" in outcome
                 else "path is clear")
        if outcome.get("stepMm"):
            moved += f" (step {outcome['stepMm']:.3f} mm)"
        if outcome.get("driveEvidenceDetail"):
            moved = f"{moved}; {outcome['driveEvidenceDetail']}"
    elif "step" in outcome:
        moved = (f"blocked by {outcome['obstacle']} at step "
                 f"{outcome['step']}/{outcome['steps']} ({outcome['overlapMm3']} mm3)")
    elif outcome.get("movers"):
        moved = f"clear across {outcome['steps']} samples"
    else:
        names = ", ".join(entry["obstacle"] for entry in outcome.get("blockedBy", []))
        moved = f"blocked by {names}"

    if clear == (expect == "clear"):
        record["status"] = "pass"
        record["detail"] = moved if expect == "clear" else f"{moved} - retained, as expected"
    else:
        record["status"] = "fail"
        record["detail"] = (
            moved if expect == "clear"
            else f"{moved} - expected this to be blocked, but the part is free to leave"
        )
    return record


def _self_check() -> int:
    """Fixtures whose answers are known, for the coupled check.

    Contact controls close their initial gap before following. Missing
    nominal/input-path evidence, collisions and malformed/coarse paths
    must not produce a successful contact-evidence condition.
    """
    from build123d import Box, Pos

    def block(label, x):
        solid = Pos(x, 0, 0) * Box(10, 10, 10)
        solid.label = label
        return solid

    parts = {"drive": block("drive", 0.0), "output": block("output", 20.0),
             "__ambiguous__": [], "__toplevel__": ["drive", "output"]}

    def coupled(ident, drive_to, output_offsets, driven=True, steps=10, extra=None):
        movers = [
            {"part": "drive", "translation": {"vector": [drive_to, 0, 0]}},
            {"part": "output", "driven": driven,
             "translation": {"offsets_mm": output_offsets}},
        ]
        inputs = {"steps": steps, "movers": movers}
        if extra:
            inputs.update(extra)
        return run_condition(
            {"id": ident, "check": "coupled_motion_collision", "expect": "clear",
             "inputs": inputs}, parts, 0)

    still = [[0.0, 0.0, 0.0]] * 11
    ok = True

    # 1. The drive never reaches the output. Every sample is clear, and that is
    #    the failure: this is a gap being measured, not a mechanism.
    got = coupled("gap", 5.0, still)
    hit = got["status"] == "fail" and "No input-connected" in got["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a clear sweep with nothing driven fails: {got['detail']}")

    # Retain the former positive fixture as a negative regression. Both boxes
    # move by the same offset and remain 10 mm apart for the entire stroke.
    parallel = [[15.0 * i / 10.0, 0.0, 0.0] for i in range(11)]
    got = coupled("constant-gap", 15.0, parallel)
    hit = (got["status"] == "fail" and got["clear"]
           and got.get("driveContactEvidencePassed") is False)
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a constant-gap output fails: {got['detail']}")

    # 2. The input closes the initial gap before the output starts moving.
    #    Their surfaces then remain tangent; this tests geometric contact only.
    following = [[max(0.0, 15.0 * i / 10.0 - 10.0), 0.0, 0.0] for i in range(11)]
    got = coupled("driven", 15.0, following)
    hit = got["status"] == "pass" and got.get("driveContactEvidencePassed") is True
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a following output has sampled contact evidence: {got['detail']}")

    # 3. An output that lags is run into: the pair binds and the cycle fails.
    #    The blocks start 10 mm apart, so the drive has to close more than that
    #    on the output for this to be a bind rather than a near miss.
    lagging = [[15.0 * i / 10.0, 0.0, 0.0] for i in range(11)]
    got = coupled("bind", 30.0, lagging)
    hit = got["status"] == "fail" and "blocked" in got["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a lagging output is caught as a bind: {got['detail']}")

    # 4. Two driven parts, only one of them reachable. A single "something
    #    collided" would pass this; the per-part rule is what fails it.
    parts["far"] = block("far", 60.0)
    two = run_condition({
        "id": "one-of-two", "check": "coupled_motion_collision", "expect": "clear",
        "inputs": {"steps": 10, "movers": [
            {"part": "drive", "translation": {"vector": [15.0, 0, 0]}},
            {"part": "output", "driven": True,
             "translation": {"offsets_mm": [[max(0.0, 15.0 * i / 10.0 - 10.0), 0.0, 0.0] for i in range(11)]}},
            {"part": "far", "driven": True,
             "translation": {"offsets_mm": [[0.0, 0.0, 0.0]] * 11}},
        ]}}, parts, 0)
    hit = two["status"] == "fail" and "far" in two["detail"] and two["driveEvidence"]["unreachedDrivenParts"] == ["far"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} one driven part out of two is not enough: {two['detail']}")
    del parts["far"]

    # 5. Without `driven`, case 1 is just a clear path -- the flag is what asks
    #    the second question, and the file must not answer it uninvited.
    got = coupled("no-claim", 5.0, still, driven=False)
    hit = got["status"] == "pass" and "driveContactEvidencePassed" not in got
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} without driven, the same sweep is only a clear path")

    # 6. A sweep is blind to anything smaller than its own step, so a condition
    #    may declare the size it has to see. Too coarse is a check that did not
    #    run -- not a clear path.
    coarse = run_condition({
        "id": "coarse", "check": "coupled_motion_collision", "expect": "clear",
        "inputs": {"steps": 2, "movers": [
            {"part": "drive", "translation": {"vector": [15.0, 0, 0]}},
            {"part": "output", "driven": True,
             "translation": {"offsets_mm": [[max(0.0, 15.0 * i / 2.0 - 10.0), 0.0, 0.0] for i in range(3)]}},
        ]},
        "thresholds": {"maxStepMm": 1.0}}, parts, 0)
    hit = coarse["status"] == "inconclusive" and "coarser than" in coarse["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} too coarse a step is inconclusive: {coarse['detail'][:88]}")

    fine = run_condition({
        "id": "fine", "check": "coupled_motion_collision", "expect": "clear",
        "inputs": {"steps": 30, "movers": [
            {"part": "drive", "translation": {"vector": [15.0, 0, 0]}},
            {"part": "output", "driven": True,
             "translation": {"offsets_mm": [[max(0.0, 15.0 * i / 30.0 - 10.0), 0.0, 0.0] for i in range(31)]}},
        ]},
        "thresholds": {"maxStepMm": 1.0}}, parts, 0)
    hit = fine["status"] == "pass" and fine["stepMm"] <= 1.0
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} the same motion sampled finely passes, and says so: "
          f"step {fine.get('stepMm')} mm")

    # 7. A table that is not steps+1 long is a broken check, not a clear one.
    got = coupled("short-table", 5.0, still[:4])
    hit = got["status"] == "inconclusive" and "steps+1" in got["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a short pose table is inconclusive: {got['detail']}")


    # 9. A frame the cycle never sweeps against. The movers clear each other
    #    perfectly, so the condition passes on its own terms while the one part
    #    the mechanism actually runs into was never in the test.
    parts["frame"] = block("frame", 10.0)
    parts["__toplevel__"] = ["drive", "output", "frame"]
    got = coupled("silent-frame", 20.0, [[max(0.0, i * 2.0 - 10.0), 0.0, 0.0] for i in range(11)])
    hit = got["status"] == "inconclusive" and "frame" in got["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a part left out of the sweep is inconclusive: "
          f"{got['detail'][:96]}")

    # 10. ... and saying so explicitly is a decision the manifest may record.
    got = coupled("declared-empty", 20.0, [[max(0.0, i * 2.0 - 10.0), 0.0, 0.0] for i in range(11)],
                  extra={"obstacle_parts": []})
    hit = got["status"] == "pass"
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} an explicit empty obstacle list is accepted: "
          f"{got['status']}")

    # 11. Naming it is the other way through, and it catches the collision.
    got = coupled("named-frame", 20.0, [[max(0.0, i * 2.0 - 10.0), 0.0, 0.0] for i in range(11)],
                  extra={"obstacle_parts": ["frame"]})
    hit = got["status"] == "fail" and "frame" in got["detail"]
    ok &= hit
    print(f"{'ok  ' if hit else 'FAIL'} a named frame is swept: {got['detail'][:96]}")
    del parts["frame"]
    parts["__toplevel__"] = ["drive", "output"]

    print("check_motion coupled-motion fixtures:", "ok" if ok else "FAILED")
    return 0 if ok else 1


def load_manifest(source: str) -> dict:
    text = sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")
    try:
        manifest = json.loads(text)
    except json.JSONDecodeError as error:
        raise ManifestError(f"manifest is not valid JSON: {error}") from error
    if not isinstance(manifest, dict):
        raise ManifestError("manifest must be a JSON object")
    return manifest


# --- retention dependency audit -----------------------------------------

def flatten_conditions(conditions: list[dict]) -> list[dict]:
    """Return top-level and assembly-sequence conditions in one list."""
    flat = []
    for condition in conditions:
        if not isinstance(condition, dict):
            continue
        flat.append(condition)
        if condition.get("check") == "assembly_sequence":
            steps = (condition.get("inputs", {}) or {}).get("steps", [])
            if isinstance(steps, list):
                flat.extend(flatten_conditions(steps))
    return flat


def flatten_results(results: list[dict]) -> list[dict]:
    """Return top-level and assembly-sequence results in one list."""
    flat = []
    for result in results:
        flat.append(result)
        nested = result.get("stepResults", [])
        if isinstance(nested, list):
            flat.extend(flatten_results(nested))
    return flat


def retention_member_evidence(condition: dict, parts: dict, supports: list[str]) -> dict:
    """Repeat the declared escape sweep for each connected material member.

    A blocked group only proves that at least one member met an obstacle. Use
    the same path, thresholds and sampling for each normalized solid, against
    the supports whose dependencies the retention graph actually closes.
    This is sampled directional evidence, not a joint or dynamics simulation.
    """
    part = condition["inputs"]["moving_part"]
    record = {"part": part, "condition": condition["id"], "members": []}
    if condition.get("check") not in (
        "linear_motion_collision", "rotation_motion_collision"
    ):
        record.update(status="inconclusive", detail="retention requires a linear or rotation escape sweep")
        return record
    try:
        with validation_scope():
            shape = resolve_parts(part, parts, "retention.part")[0][1]
            material, _ = _material(shape)
            if not _is_valid(material):
                raise ValueError("retention operand contains invalid material")
            solids = list(material.solids())
            record["solidCount"] = len(solids)
            replay = {**condition, "inputs": {
                **condition["inputs"], "obstacle_parts": list(supports),
            }}
            for index, solid in enumerate(solids):
                bounds = solid.bounding_box()
                measured = run_condition(replay, {**parts, part: solid}, index)
                record["members"].append({
                    "memberIndex": index,
                    "volumeMm3": float(solid.volume),
                    "boundsMm": [list(bounds.min), list(bounds.max)],
                    **measured,
                })
    except Exception as error:
        record.update(status="inconclusive", detail=f"{type(error).__name__}: {error}")
        return record
    failed = [row for row in record["members"] if row["status"] == "fail"]
    unclear = [row for row in record["members"] if row["status"] == "inconclusive"]
    if failed or unclear:
        record.update(
            status="fail" if failed else "inconclusive",
            detail="; ".join(f'member {row["memberIndex"]}: {row["detail"]}'
                             for row in [*failed, *unclear]),
        )
    else:
        record.update(status="pass", detail=f"{len(solids)} material member(s) blocked by declared supports")
    return record


def check_retention_closure(manifest: dict, parts: dict, results: list[dict]) -> dict | None:
    """Prove that each declared retainer reaches an explicitly fixed root.

    Collision sweeps hold obstacle parts stationary. That is legitimate only
    when a retention claim also explains why every removable obstacle in its
    load path stays put. The manifest's retention graph supplies that missing
    dependency information. Verify the graph and independently sweep each
    connected material member against the declared supports.
    """
    declaration = manifest.get("retention")
    if declaration is None:
        return None

    record = {
        "id": "retention-closure",
        "check": "retention_closure",
        "description": "Every removable retainer reaches an explicitly fixed assembly root.",
    }
    errors = []
    if not isinstance(declaration, dict):
        record.update(status="fail", detail="retention must be an object")
        return record

    fixed_parts = declaration.get("fixed_parts", [])
    proofs = declaration.get("proofs", [])
    if not isinstance(fixed_parts, list) or not fixed_parts:
        errors.append("retention.fixed_parts must name at least one fixed assembly root")
        fixed_parts = []
    if not isinstance(proofs, list) or not proofs:
        errors.append("retention.proofs must contain at least one proof")
        proofs = []

    fixed = set()
    for name in fixed_parts:
        if not isinstance(name, str):
            errors.append("every retention.fixed_parts entry must be a part name")
            continue
        try:
            resolve_parts(name, parts, "retention.fixed_parts")
            fixed.add(name)
        except ManifestError as error:
            errors.append(str(error))

    condition_rows = flatten_conditions(manifest.get("conditions", []))
    conditions = {}
    for condition in condition_rows:
        ident = condition.get("id")
        if not isinstance(ident, str) or not ident:
            continue
        if ident in conditions:
            errors.append(f'retention proof condition id "{ident}" is duplicated')
        conditions[ident] = condition
    result_by_id = {
        result.get("id"): result for result in flatten_results(results)
        if isinstance(result.get("id"), str)
    }

    proof_by_part = {}
    supports_by_part = {}
    for index, proof in enumerate(proofs):
        field = f"retention.proofs[{index}]"
        if not isinstance(proof, dict):
            errors.append(f"{field} must be an object")
            continue
        part = proof.get("part")
        condition_id = proof.get("condition")
        if not isinstance(part, str) or not part:
            errors.append(f"{field}.part must name a part")
            continue
        if part in proof_by_part:
            errors.append(f'{field}.part "{part}" has more than one retention proof')
            continue
        try:
            resolve_parts(part, parts, f"{field}.part")
        except ManifestError as error:
            errors.append(str(error))
            continue
        condition = conditions.get(condition_id)
        if condition is None:
            errors.append(f'{field}.condition "{condition_id}" does not name a condition')
            continue
        inputs = condition.get("inputs", {}) or {}
        if condition.get("expect", "clear") != "blocked":
            errors.append(f'{field}.condition "{condition_id}" must expect blocked')
        if inputs.get("moving_part") != part:
            errors.append(
                f'{field}.condition "{condition_id}" moves {inputs.get("moving_part")!r}, '
                f'not "{part}"'
            )
        result = result_by_id.get(condition_id)
        if result is None or result.get("status") != "pass":
            errors.append(f'{field}.condition "{condition_id}" did not pass')

        obstacles = inputs.get("obstacle_parts", [])
        if isinstance(obstacles, str):
            obstacles = [obstacles]
        if not isinstance(obstacles, list) or not obstacles:
            errors.append(f'{field}.condition "{condition_id}" has no obstacle_parts')
            obstacles = []
        supports = proof.get("supports", obstacles)
        if isinstance(supports, str):
            supports = [supports]
        if not isinstance(supports, list) or not supports:
            errors.append(f"{field}.supports must name at least one load-bearing obstacle")
            supports = []
        for support in supports:
            if not isinstance(support, str):
                errors.append(f"every {field}.supports entry must be a part name")
                continue
            if support not in obstacles:
                errors.append(
                    f'{field}.supports "{support}" is not an obstacle in "{condition_id}"'
                )
                continue
            try:
                resolve_parts(support, parts, f"{field}.supports")
            except ManifestError as error:
                errors.append(str(error))
        proof_by_part[part] = condition_id
        supports_by_part[part] = supports

    visited = set()

    def reaches_fixed(part: str, trail: list[str]) -> None:
        if part in fixed or part in visited:
            return
        if part in trail:
            cycle = " -> ".join([*trail, part])
            errors.append(f"retention dependency cycle: {cycle}")
            return
        if part not in proof_by_part:
            parent = trail[-1] if trail else "retained part"
            errors.append(
                f'"{parent}" relies on removable obstacle "{part}", but "{part}" '
                "has no retention proof and is not a fixed part"
            )
            return
        for support in supports_by_part.get(part, []):
            reaches_fixed(support, [*trail, part])
        visited.add(part)

    for part in proof_by_part:
        reaches_fixed(part, [])

    if errors:
        record.update(status="fail", detail="; ".join(dict.fromkeys(errors)))
        return record

    evidence = [retention_member_evidence(conditions[ident], parts, supports_by_part[part])
                for part, ident in proof_by_part.items()]
    record["memberEvidence"] = evidence
    failed = [row for row in evidence if row["status"] == "fail"]
    unclear = [row for row in evidence if row["status"] == "inconclusive"]
    if failed or unclear:
        record.update(
            status="fail" if failed else "inconclusive",
            detail="; ".join(f'{row["part"]}: {row["detail"]}' for row in [*failed, *unclear]),
        )
    else:
        record.update(
            status="pass",
            detail=(f"{len(proof_by_part)} retention proof(s) close at "
                    f"{len(fixed)} fixed root(s); every material member has a blocked escape sweep"),
        )
    return record


def run_self_check() -> int:
    """Regression for the frozen-but-unretained obstacle failure mode."""
    from build123d import Box

    heights = {"shaft": 0, "gate": 4, "key": 8, "frame": 12}
    parts = {name: Box(2, 2, 2).translate((0, 0, z)) for name, z in heights.items()}

    def blocked(ident: str, moving: str, obstacles: list[str]) -> dict:
        return {
            "id": ident,
            "check": "linear_motion_collision",
            "expect": "blocked",
            "inputs": {"moving_part": moving, "obstacle_parts": obstacles,
                       "translation": [0, 0, heights[obstacles[0]] - heights[moving]],
                       "steps": 4},
        }

    conditions = [
        blocked("shaft-held", "shaft", ["gate"]),
        blocked("gate-held", "gate", ["key"]),
        blocked("key-seated", "key", ["frame"]),
    ]
    results = [run_condition(row, parts, i) for i, row in enumerate(conditions)]

    broken = {
        "conditions": conditions,
        "retention": {
            "fixed_parts": ["frame"],
            "proofs": [{"part": "shaft", "condition": "shaft-held"}],
        },
    }
    broken_result = check_retention_closure(broken, parts, results)
    assert broken_result and broken_result["status"] == "fail"
    assert 'obstacle "gate"' in broken_result["detail"]

    closed = {
        "conditions": conditions,
        "retention": {
            "fixed_parts": ["frame"],
            "proofs": [
                {"part": "shaft", "condition": "shaft-held"},
                {"part": "gate", "condition": "gate-held"},
                {"part": "key", "condition": "key-seated"},
            ],
        },
    }
    closed_result = check_retention_closure(closed, parts, results)
    assert closed_result and closed_result["status"] == "pass"

    cyclic = {
        "conditions": [
            blocked("shaft-held", "shaft", ["gate"]),
            blocked("gate-held", "gate", ["shaft"]),
        ],
        "retention": {
            "fixed_parts": ["frame"],
            "proofs": [
                {"part": "shaft", "condition": "shaft-held"},
                {"part": "gate", "condition": "gate-held"},
            ],
        },
    }
    cyclic_results = [run_condition(row, parts, i) for i, row in enumerate(cyclic["conditions"])]
    cyclic_result = check_retention_closure(cyclic, parts, cyclic_results)
    assert cyclic_result and cyclic_result["status"] == "fail"
    assert "dependency cycle" in cyclic_result["detail"]

    print("check_motion retention fixtures: ok")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("project", nargs="?", help="project directory holding the assembly entry")
    parser.add_argument("--manifest", help="motion manifest JSON, or - for stdin")
    parser.add_argument("--list-parts", action="store_true",
                        help="print the labelled parts and exit")
    parser.add_argument("--allow-inconclusive", action="store_true",
                        help="do not fail on conditions that could not run")
    parser.add_argument("--json", action="store_true", help="emit results as JSON")
    parser.add_argument("--self-check", action="store_true",
                        help="run the coupled-motion and retention fixtures, and exit")
    args = parser.parse_args()

    if args.self_check:
        # Both suites, always: a fixture set that stops running does not fail,
        # it just stops appearing.
        coupled = _self_check()
        retention = run_self_check()
        return coupled or retention
    if not args.project or not args.manifest:
        parser.error("project and --manifest are required unless --self-check is used")

    project = Path(args.project).resolve()
    if not project.is_dir():
        print(f"check_motion: {project} is not a directory", file=sys.stderr)
        return 2

    try:
        manifest = load_manifest(args.manifest)
        entry = find_assembly_entry(project, manifest.get("assembly"))
        parts = index_parts(build_assembly(entry))
    except ManifestError as error:
        print(f"check_motion: {error}", file=sys.stderr)
        return 2

    if args.list_parts:
        for name in sorted(part_names(parts)):
            print(f"{name}  (ambiguous)" if name in parts["__ambiguous__"] else name)
        for name in parts["__ambiguous__"]:
            print(f"{name}  (ambiguous - use its dotted path)")
        return 0

    conditions = manifest.get("conditions", [])
    if not isinstance(conditions, list) or not conditions:
        print("check_motion: manifest has no conditions", file=sys.stderr)
        return 2

    results = [run_condition(condition, parts, index)
               for index, condition in enumerate(conditions)]
    retention_result = check_retention_closure(manifest, parts, results)
    if retention_result is not None:
        results.append(retention_result)
    failed = [r for r in results if r["status"] == "fail"]
    unclear = [r for r in results if r["status"] == "inconclusive"]

    if args.json:
        print(json.dumps({
            "ok": not failed and (args.allow_inconclusive or not unclear),
            "project": str(project),
            "assembly": entry.name,
            "results": results,
        }, indent=2))
        return 0 if not failed and (args.allow_inconclusive or not unclear) else 1

    labelled = len(part_names(parts))
    print(f"{entry.name}: {labelled} labelled parts, {len(results)} condition(s)\n")
    for result in results:
        badge = {"pass": "ok  ", "fail": "FAIL", "inconclusive": "??  "}[result["status"]]
        print(f"  {badge} {result['id']} [{result['check']}] {result['detail']}")
        if result.get("description"):
            print(f"         {result['description']}")
        for step in result.get("stepResults", []):
            inner = {"pass": "ok  ", "fail": "FAIL", "inconclusive": "??  "}[step["status"]]
            print(f"         {inner} {step['id']} {step['detail']}")

    if failed:
        print(f"\ncheck_motion: {len(failed)} condition(s) failed", file=sys.stderr)
        return 1
    if unclear:
        # An inconclusive condition is a manifest that did not run, not a path
        # that was found clear. Exiting 0 on it is the quiet pass this gate
        # exists to remove. --allow-inconclusive is for the genuinely
        # unmeasurable, and says so out loud either way.
        print(f"\ncheck_motion: {len(unclear)} condition(s) never ran "
              f"({len(results) - len(unclear)} clear)",
              file=sys.stderr if not args.allow_inconclusive else sys.stdout)
        return 0 if args.allow_inconclusive else 1
    print(f"\ncheck_motion: ok - {len(results)} condition(s) clear")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
