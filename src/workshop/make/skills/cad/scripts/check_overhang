#!/usr/bin/env python3
"""Unsupported down-facing surface, measured off the exported STL.

Every other gate in this toolchain is blind to the build direction.
`check_fit` puts the part on the bed, `check_mesh` says the shell is closed,
`check_thickness` says the walls can be extruded -- and a part whose every
feature hangs in mid-air passes all three, because none of them knows which way
is up.

This one asks the question a slicer asks: which faces point downward more
steeply than the printer can hold, and is there anything under them.

    steep       down-facing area whose slope from vertical is under --angle
    bridge      a steep region short enough to span, with material on both
                sides in the preceding layer -- a hole's ceiling, a slot roof
    overhang    a steep region that is neither: it FAILS, because the slicer
                either droops it or asks for support material

The distinction is the whole point. A round horizontal bore has a ceiling and
is perfectly printable up to a span the nozzle can bridge; a shelf of the same
area, anchored on one side only, is not. Area alone cannot tell them apart, so
this reports the span and what is beside each region as well.

    python "$CAD_SKILL_ROOT/scripts/check_overhang" part.stl --angle 45
    python "$CAD_SKILL_ROOT/scripts/check_overhang" part.stl --report measure/overhang.md

Exit 0 when nothing needs support, 1 when something does, 2 on bad usage.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent))

from meshlib import WELD_TOL, load_stl, summarize, voxel_pitch, voxelize, weld  # noqa: E402
from mesh_support import support_at_layer  # noqa: E402

MAX_SAMPLES = 300_000
REPORT_REGIONS = 8
# A region smaller than this is a chamfer runout or a tessellation artefact,
# not a feature anybody supports.
MIN_REGION_AREA = 1.0  # mm2


def down_facing(verts, faces, limit_deg):
    """Triangles whose normal points down more steeply than the limit.

    The slope is measured from vertical, the way a slicer states it: a flat
    ceiling is 0 deg and a 45 deg roof is 45 deg. `limit_deg` is the shallowest
    slope the printer is expected to hold unaided.
    """
    tri = verts[faces]
    normals = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
    lengths = np.linalg.norm(normals, axis=1)
    live = lengths > 0
    unit = np.zeros_like(normals)
    unit[live] = normals[live] / lengths[live, None]
    area = lengths / 2.0
    slope = np.degrees(np.arccos(np.clip(-unit[:, 2], -1.0, 1.0)))
    return slope < limit_deg, slope, area


def sample_faces(verts, faces, keep, area, pitch, cap=MAX_SAMPLES, *, return_faces=False):
    """Equal-area subtriangle centroids, symmetric in the triangle's corners.

    A face owns its sample set. Record order and cyclic starting corners do
    not change sample locations; each point represents the same area fraction.
    The cap is soft: as before, retain at least one sample per selected face.
    """
    selected = np.flatnonzero(keep & (area > 0))
    if not len(selected):
        result = (np.empty((0, 3)), np.empty(0))
        return (*result, np.empty(0, dtype=int)) if return_faces else result
    divisions = np.maximum(1, np.ceil(np.sqrt(area[selected] / (pitch * pitch))).astype(int))
    total = (divisions * divisions).sum()
    if total > cap:
        divisions = np.maximum(1, np.floor(divisions * np.sqrt(cap / total)).astype(int))
    grids, all_points, all_weights, all_faces = {}, [], [], []
    for face, n in zip(selected, divisions):
        if n not in grids:
            bary = []
            for i in range(n):
                for j in range(n - i):
                    bary.append(((i + 1/3) / n, (j + 1/3) / n))
                    if i + j < n - 1:
                        bary.append(((i + 2/3) / n, (j + 2/3) / n))
            grids[n] = np.asarray(bary)
        uv = grids[n]
        a, b, c = verts[faces[face]]
        all_points.append(a + uv[:, :1] * (b - a) + uv[:, 1:] * (c - a))
        all_weights.append(np.full(len(uv), area[face] / len(uv)))
        all_faces.append(np.full(len(uv), face, dtype=int))
    result = (np.concatenate(all_points), np.concatenate(all_weights))
    return (*result, np.concatenate(all_faces)) if return_faces else result


def on_the_bed(points, bed_z, layer):
    """Faces resting on the build plate. The plate is their support."""
    return points[:, 2] <= bed_z + max(layer, 1e-6)


def gap_below(inside, origin, pitch, points, limit):
    """Distance from each sample straight down to the next material, or to the bed."""
    shape = np.array(inside.shape)
    gaps = np.full(len(points), np.inf)
    steps = int(limit / pitch) + 2
    cell = np.floor((points - origin) / pitch).astype(int)
    live = np.arange(len(points))
    depth = np.zeros(len(points))
    for step in range(1, steps):
        if live.size == 0:
            break
        probe = cell[live].copy()
        probe[:, 2] -= step
        below_bed = probe[:, 2] < 0
        gaps[live[below_bed]] = step * pitch
        keep = ~below_bed
        live, probe = live[keep], probe[keep]
        if live.size == 0:
            break
        within = np.all((probe >= 0) & (probe < shape), axis=1)
        hit = np.zeros(len(live), dtype=bool)
        w = np.flatnonzero(within)
        if w.size:
            p = probe[w]
            hit[w] = inside[p[:, 0], p[:, 1], p[:, 2]]
        gaps[live[hit]] = step * pitch
        live = live[~hit]
        depth[live] = step * pitch
    gaps[np.isinf(gaps)] = limit
    return gaps


def surface_labels(faces, steep, area):
    """Connected down-facing surfaces, using actual shared triangle edges."""
    selected = np.flatnonzero(steep & (area > 0))
    parent = np.arange(len(faces))
    def find(n):
        while parent[n] != n:
            parent[n] = parent[parent[n]]
            n = parent[n]
        return n
    edges = {}
    for face in selected:
        for x, y in zip(faces[face], np.roll(faces[face], -1)):
            key = tuple(sorted((int(x), int(y))))
            if key in edges:
                a, c = find(face), find(edges[key])
                parent[max(a, c)] = min(a, c)
            else:
                edges[key] = face
    return np.array([find(f) for f in range(len(faces))])


def surface_regions(points, weights, gaps, labels, spans=None):
    """Keep one geometric surface together when sparse samples have gaps."""
    regions = []
    for surface in np.unique(labels):
        mask = labels == surface
        p = points[mask]
        extent = p[:, :2].max(axis=0) - p[:, :2].min(axis=0)
        regions.append({'samples': int(mask.sum()), 'area': float(weights[mask].sum()),
                        'span': float(spans[mask].max()) if spans is not None else float(extent.min()),
                        'extent': tuple(float(v) for v in extent),
                        'at': tuple(float(v) for v in p.mean(axis=0)),
                        'gap': float(gaps[mask].max()), 'z': float(p[:, 2].mean())})
    return regions


def bridge_support(verts, faces, points, below, reach):
    """Query real material on both sides, including the nearest-support ray."""
    near, bridged, spans, _ = support_at_layer(verts, faces, points, below, 0., reach, WELD_TOL)
    return near | bridged, spans


def canonical_triangles(tris):
    """Keep winding, with stable vertex and triangle order before welding.

    Stable order makes reports reproducible and stabilizes the representative
    chosen when nearby exported vertices share a welding-grid cell.
    """
    tris = np.asarray(tris, dtype=float).reshape(-1, 3, 3)
    if not len(tris):
        return tris.copy()
    start = np.lexsort((tris[:, :, 2], tris[:, :, 1], tris[:, :, 0]), axis=1)[:, 0]
    corners = (np.arange(3)[None, :] + start[:, None]) % 3
    canonical = np.take_along_axis(tris, corners[:, :, None], axis=1)
    flat = canonical.reshape(len(canonical), 9)
    order = np.lexsort(tuple(flat[:, i] for i in range(8, -1, -1)))
    return canonical[order]


def measure_regions(verts, faces, pitch, layer, angle, bridge):
    """Check every non-bed down-facing sample against the preceding layer.

    Voxels describe the vertical air gap in reports. Eligibility, lateral
    support and grouping use mesh geometry so a coarse grid cannot hide a ledge.
    """
    steep, _, area = down_facing(verts, faces, angle)
    points, weights, face_ids = sample_faces(verts, faces, steep, area, pitch, return_faces=True)
    if not len(points):
        return []
    labels = surface_labels(faces, steep, area)[face_ids]
    loose = ~on_the_bed(points, float(verts[:, 2].min()), layer)
    points, weights, labels = points[loose], weights[loose], labels[loose]
    allowance = layer / np.tan(np.deg2rad(angle))
    near, supported, spans, _ = support_at_layer(
        verts, faces, points, layer, allowance, bridge, WELD_TOL)
    points, weights, labels = points[~near], weights[~near], labels[~near]
    supported, spans = supported[~near], spans[~near]
    if not len(points):
        return []
    inside, origin = voxelize(verts, faces, pitch)
    gaps = gap_below(inside, origin, pitch, points, max(bridge, 20.))
    regions = []
    for mask, kind in ((supported, "bridge"), (~supported, "overhang")):
        for region in surface_regions(points[mask], weights[mask], gaps[mask], labels[mask],
                                      spans=spans[mask] if kind == "bridge" else None):
            region["kind"] = "trace" if region["area"] < MIN_REGION_AREA else kind
            regions.append(region)
    regions.sort(key=lambda region: -region["area"])
    return regions


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("stl", nargs="?", help="omit with --self-check")
    ap.add_argument("--angle", type=float, default=45.0,
                    help="deg from vertical; below this a down-face needs help (default 45)")
    ap.add_argument("--bridge", type=float, default=12.0,
                    help="mm; the longest span the printer is expected to bridge")
    ap.add_argument("--layer", type=float, default=0.2, help="mm; layer height")
    ap.add_argument("--voxel", type=float, default=None, help="mm; grid pitch")
    ap.add_argument("--report", help="write a markdown record to this path")
    ap.add_argument("--self-check", action="store_true",
                    help="measure shapes whose answers are known, and stop")
    args = ap.parse_args()

    if args.self_check:
        return _self_check()
    if not args.stl:
        ap.error("an STL is required unless --self-check is given")

    verts, faces = weld(canonical_triangles(load_stl(args.stl)))
    state = summarize(verts, faces)
    if state["boundary"]:
        sys.exit(f"{args.stl}: {state['boundary']} open edges -- which way is inside is "
                 "undefined on an open surface. Run check_mesh, then repair_mesh.")

    pitch = voxel_pitch(verts, args.voxel or max(args.layer * 2, 0.4))
    steep, _, area = down_facing(verts, faces, args.angle)
    total_area = float(area.sum())
    steep_area = float(area[steep].sum())

    regions = measure_regions(verts, faces, pitch, args.layer, args.angle, args.bridge)
    unsupported_samples = sum(region["samples"] for region in regions)

    needs_support = [r for r in regions if r["kind"] == "overhang"]
    bridges = [r for r in regions if r["kind"] == "bridge"]
    traces = [r for r in regions if r["kind"] == "trace"]

    head = (f"{args.stl}: {total_area / 100:.1f} cm2 of surface, grid {pitch:.3f} mm, "
            f"{unsupported_samples} unsupported samples over {len(regions)} region(s)")
    print(head)
    checks = [
        ("FAIL" if needs_support else "PASS",
         f"no face under {args.angle:.0f} deg needs support",
         f"{100 * steep_area / total_area:.1f}% of the surface faces down that steeply; "
         f"{len(needs_support)} region(s) need support, {len(bridges)} bridge, "
         f"{len(traces)} below {MIN_REGION_AREA:.0f} mm2"
         + (f"; worst {needs_support[0]['area']:.1f} mm2 spanning "
            f"{needs_support[0]['span']:.1f} mm" if needs_support else "")),
        ("PASS", f"bridges within {args.bridge:.0f} mm",
         f"{len(bridges)} region(s), longest span "
         f"{max((r['span'] for r in bridges), default=0.0):.1f} mm"),
    ]
    failed = False
    for status, name, detail in checks:
        print(f"  {status}  {name:38s} {detail}")
        failed |= status == "FAIL"
    shown = regions[:REPORT_REGIONS]
    if shown:
        print("        every unsupported region, largest first:")
        for i, r in enumerate(shown, 1):
            print(f"        {i}. [{r['kind']:8s}] {r['area']:7.1f} mm2 at "
                  f"({r['at'][0]:.1f}, {r['at'][1]:.1f}, {r['at'][2]:.1f})  "
                  f"span {r['span']:5.1f} mm of {r['extent'][0]:.0f}x{r['extent'][1]:.0f}, "
                  f"{r['gap']:.1f} mm of air below")
        if len(regions) > len(shown):
            print(f"        ... and {len(regions) - len(shown)} smaller region(s)")
    print("RESULT:", "NEEDS SUPPORT" if failed else "prints unsupported")

    if args.report:
        out = Path(args.report)
        out.parent.mkdir(parents=True, exist_ok=True)
        rows = "\n".join(f"| {n} | {s} | {d} |" for s, n, d in checks)
        region_rows = "" if not shown else (
            "\n\n## Unsupported regions, largest first\n\n"
            "A `bridge` is a steep region short enough to span with material on both sides of "
            "it -- a bore ceiling or a slot roof. An `overhang` has neither, and needs support "
            "or a design change.\n\n"
            "| # | kind | area mm2 | at | span mm | air below mm |\n|---|---|---|---|---|---|\n"
            + "\n".join(
                f"| {i} | {r['kind']} | {r['area']:.1f} | "
                f"({r['at'][0]:.1f}, {r['at'][1]:.1f}, {r['at'][2]:.1f}) | "
                f"{r['span']:.1f} | {r['gap']:.1f} |" for i, r in enumerate(shown, 1)))
        out.write_text(
            f"# Overhang and support\n\n`{' '.join(sys.argv[1:])}`\n\n{head}\n\n"
            f"| check | status | detail |\n|---|---|---|\n{rows}\n{region_rows}\n\n"
            "Measured on the exported STL, in the pose it is printed in. The fix belongs in\n"
            "the generator: reorient the part, replace a round horizontal bore with a\n"
            "teardrop, or add a 45 deg buttress under the feature.\n",
            encoding="utf-8")
        print(f"  wrote {out}")
    return 1 if failed else 0


def _box(x0, y0, z0, x1, y1, z1):
    q = [
        [(x0,y0,z1),(x1,y0,z1),(x1,y1,z1)], [(x0,y0,z1),(x1,y1,z1),(x0,y1,z1)],
        [(x0,y0,z0),(x1,y1,z0),(x1,y0,z0)], [(x0,y0,z0),(x0,y1,z0),(x1,y1,z0)],
        [(x0,y0,z0),(x1,y0,z0),(x1,y0,z1)], [(x0,y0,z0),(x1,y0,z1),(x0,y0,z1)],
        [(x0,y1,z0),(x0,y1,z1),(x1,y1,z1)], [(x0,y1,z0),(x1,y1,z1),(x1,y1,z0)],
        [(x0,y0,z0),(x0,y0,z1),(x0,y1,z1)], [(x0,y0,z0),(x0,y1,z1),(x0,y1,z0)],
        [(x1,y0,z0),(x1,y1,z0),(x1,y1,z1)], [(x1,y0,z0),(x1,y1,z1),(x1,y0,z1)],
    ]
    return [[list(v) for v in t] for t in q]


def _measure(tris, angle=45.0, bridge=12.0, layer=0.2, voxel=0.4):
    verts, faces = weld(canonical_triangles(tris))
    pitch = voxel_pitch(verts, voxel)
    return measure_regions(verts, faces, pitch, layer, angle, bridge)


def _self_check() -> int:
    ok = True

    def fixture(label, regions, want_kind, want_area=None):
        nonlocal ok
        kinds = [r["kind"] for r in regions if r["kind"] != "trace"]
        hit = (kinds[:1] == [want_kind]) if want_kind else (kinds == [])
        if hit and want_area is not None:
            hit = abs(regions[0]["area"] - want_area) / want_area < 0.35
        ok &= hit
        detail = ", ".join(f"{r['kind']} {r['area']:.1f} mm2 span {r['span']:.1f}"
                           for r in regions[:3]) or "nothing unsupported"
        print(f"{'ok  ' if hit else 'FAIL'} {label}: {detail}")

    # A plain block has no down-facing surface but its own footprint, which sits
    # on the bed. Nothing to support.
    fixture("a block on the bed needs no support", _measure(_box(0, 0, 0, 20, 20, 10)), None)

    # A shelf: a slab held up at one end only. Its underside is a ceiling with
    # material on ONE side, which is exactly what support material is for.
    shelf = _box(0, 0, 0, 6, 20, 20) + _box(6, 0, 14, 30, 20, 20)
    fixture("a cantilevered shelf needs support", _measure(shelf), "overhang", 24 * 20)

    # The same span, bridged: hold the far end up too and the slicer can reach
    # across. Same area, same slope, and now printable.
    bridge = (_box(0, 0, 0, 6, 20, 20) + _box(6, 0, 14, 16, 20, 20)
              + _box(16, 0, 0, 22, 20, 20))
    fixture("the same roof, anchored both ends, bridges", _measure(bridge), "bridge")

    # And a span too long to bridge fails even though it is anchored twice.
    long_span = (_box(0, 0, 0, 6, 20, 20) + _box(6, 0, 14, 46, 20, 20)
                 + _box(46, 0, 0, 52, 20, 20))
    fixture("too long a span still needs support", _measure(long_span, bridge=12.0), "overhang")

    cap = _box(-2, -2, 0, 2, 2, 10) + _box(-5, -5, 10, 5, 5, 12)
    fixture("a flat cap around one stem is a cantilever", _measure(cap), "overhang")

    print("check_overhang self-check:", "ok" if ok else "FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
