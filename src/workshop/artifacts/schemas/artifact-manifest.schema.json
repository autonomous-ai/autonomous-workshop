{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/artifact-manifest-v1.json",
  "title": "Content-addressed inventor artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_sha256",
    "entries",
    "total_bytes",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "executable"],
        "properties": {
          "path": {
            "allOf": [
              {"$ref": "#/$defs/safePath"},
              {"not": {"const": "_inventor-artifact.json"}}
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99614720
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "executable": {"type": "boolean"}
        }
      }
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "created_at": {
      "oneOf": [
        {"const": "content-addressed"},
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?![.]$)(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[/]$).+$"
    }
  }
}
