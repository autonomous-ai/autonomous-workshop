{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/receipt-v1.json",
  "title": "Workshop external receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_sha256",
    "artifact_sha256",
    "adapter",
    "status",
    "observed_at",
    "reference",
    "details"
  ],
  "properties": {
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 4096},
    "status": {"type": "string", "minLength": 1, "maxLength": 4096},
    "observed_at": {
      "type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"
    },
    "reference": {"type": "string", "minLength": 1, "maxLength": 4096},
    "details": {"type": "object"},
    "design_id": {"type": ["string", "null"], "minLength": 1},
    "slug": {"type": ["string", "null"], "minLength": 1},
    "owner_id": {"type": ["string", "null"], "minLength": 1},
    "root_id": {"type": ["string", "null"], "minLength": 1},
    "current_history_id": {"type": ["string", "null"], "minLength": 1},
    "published_history_id": {"type": ["string", "null"], "minLength": 1},
    "listing_active": {"type": ["boolean", "null"]},
    "listing_price_cents": {
      "type": ["integer", "null"],
      "minimum": 100,
      "maximum": 1000000
    },
    "listing_currency": {"type": ["string", "null"], "minLength": 1},
    "listing_sku": {"type": ["string", "null"], "minLength": 1},
    "project_url": {
      "type": ["string", "null"],
      "pattern": "^https://[^/?#@\\u0000-\\u001f\\u007f]+(?:/[^?#\\u0000-\\u001f\\u007f]*)?$"
    }
  }
}
