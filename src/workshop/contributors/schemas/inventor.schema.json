{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/v6.json",
  "title": "Autonomous Workshop inventor persona manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "capabilities",
    "source"
  ],
  "oneOf": [
    {
      "properties": {"schema_version": {"const": 1}},
      "required": [
        "name", "niche", "summary", "autonomy", "entrypoint", "core_features"
      ],
      "not": {
        "anyOf": [
          {"required": ["workshop_features"]},
          {"required": ["foundation_features"]},
          {"required": ["checks"]}
        ]
      }
    },
    {
      "properties": {"schema_version": {"const": 2}},
      "required": [
        "name", "niche", "summary", "autonomy", "entrypoint",
        "foundation_features", "checks"
      ],
      "not": {
        "anyOf": [
          {"required": ["core_features"]},
          {"required": ["workshop_features"]}
        ]
      }
    },
    {
      "properties": {
        "schema_version": {"const": 3},
        "workshop_features": {
          "items": {
            "enum": [
              "clockwork.state",
              "clockwork.workflow",
              "doors.delivery",
              "doors.shop",
              "inspect.evidence",
              "make.skills.cad",
              "make.skills.product-to-cad",
              "make.skills.step-parts",
              "make.workbench",
              "pack.content-addressed",
              "send.outbox",
              "taste.content-addressed"
            ]
          }
        }
      },
      "required": [
        "name", "niche", "summary", "autonomy", "entrypoint",
        "workshop_features", "checks"
      ],
      "not": {
        "anyOf": [
          {"required": ["core_features"]},
          {"required": ["foundation_features"]}
        ]
      }
    },
    {
      "properties": {"schema_version": {"const": 4}},
      "required": ["name", "niche", "summary", "autonomy", "entrypoint", "checks"],
      "not": {
        "anyOf": [
          {"required": ["core_features"]},
          {"required": ["foundation_features"]},
          {"required": ["workshop_features"]}
        ]
      }
    },
    {
      "properties": {"schema_version": {"const": 5}},
      "required": ["entrypoint", "checks"],
      "not": {
        "anyOf": [
          {"required": ["name"]},
          {"required": ["niche"]},
          {"required": ["summary"]},
          {"required": ["autonomy"]},
          {"required": ["core_features"]},
          {"required": ["foundation_features"]},
          {"required": ["workshop_features"]}
        ]
      }
    },
    {
      "properties": {
        "schema_version": {"const": 6},
        "capabilities": {
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "classics-made-yours",
              "invented-games",
              "moving-machines",
              "holdable-science",
              "little-worlds"
            ]
          }
        }
      },
      "not": {
        "anyOf": [
          {"required": ["name"]},
          {"required": ["niche"]},
          {"required": ["summary"]},
          {"required": ["autonomy"]},
          {"required": ["entrypoint"]},
          {"required": ["checks"]},
          {"required": ["core_features"]},
          {"required": ["foundation_features"]},
          {"required": ["workshop_features"]}
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4, 5, 6]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "name": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "niche": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "summary": {
      "type": "string", "minLength": 1, "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "autonomy": {
      "enum": ["autonomous", "human-checkpointed", "reference"]
    },
    "status": {
      "enum": ["active", "experimental", "blocked", "reference", "archived"]
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "core_features": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "foundation_features": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "workshop_features": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1, "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "string", "minLength": 1, "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["local", "upstream-snapshot"]},
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\u0000-\\u001f\\u007f]+/[^?#\\u0000-\\u001f\\u007f]+$"
        },
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "imported_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "oneOf": [
        {
          "properties": {"kind": {"const": "local"}},
          "required": ["kind"],
          "maxProperties": 1
        },
        {
          "properties": {"kind": {"const": "upstream-snapshot"}},
          "required": ["kind", "url", "commit", "imported_at"]
        }
      ]
    }
  }
}
