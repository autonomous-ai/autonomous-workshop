{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/v8.json",
  "title": "Autonomous Workshop Inventor bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "source",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": 8},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "status": {
      "enum": ["active", "experimental", "blocked", "reference", "archived"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["local", "upstream-snapshot"]},
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\u0000-\\u001f\\u007f]+/[^?#\\u0000-\\u001f\\u007f]+$"
        },
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "imported_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "oneOf": [
        {
          "properties": {"kind": {"const": "local"}},
          "required": ["kind"],
          "maxProperties": 1
        },
        {
          "properties": {"kind": {"const": "upstream-snapshot"}},
          "required": ["kind", "url", "commit", "imported_at"]
        }
      ]
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "-inventor$"}
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "path", "artifact_sha256"],
        "properties": {
          "kind": {"const": "codex-skill"},
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          },
          "path": {
            "type": "string",
            "pattern": "^skills/[a-z0-9][a-z0-9-]{1,62}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
