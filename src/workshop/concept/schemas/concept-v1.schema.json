{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous.ai/schemas/inventor/concept-v1.json",
  "title": "Sealed native Concept contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "round",
    "wish_sha256",
    "assignment_sha256",
    "taste_sha256",
    "blueprint_sha256",
    "invented_sha256",
    "concept_root",
    "concept_manifest",
    "brief_path",
    "brief",
    "brief_sha256",
    "research_path",
    "research",
    "research_sha256",
    "drawing_instructions_path",
    "drawing_instructions",
    "drawing_instructions_sha256",
    "descriptor_path",
    "descriptor",
    "descriptor_sha256",
    "derived_wish_path",
    "derived_wish",
    "derived_wish_sha256_field",
    "concept_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "autonomous-workshop.concept"},
    "round": {"type": "integer", "minimum": 1, "maximum": 100},
    "wish_sha256": {"$ref": "#/$defs/sha256"},
    "assignment_sha256": {"$ref": "#/$defs/sha256"},
    "taste_sha256": {"$ref": "#/$defs/sha256"},
    "blueprint_sha256": {"$ref": "#/$defs/sha256"},
    "invented_sha256": {"$ref": "#/$defs/sha256"},
    "concept_root": {"type": "string", "minLength": 1},
    "concept_manifest": {"type": "object"},
    "brief_path": {"type": "string", "minLength": 1},
    "brief": {"type": "object"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "research_path": {"type": "string", "minLength": 1},
    "research": {"type": "object"},
    "research_sha256": {"$ref": "#/$defs/sha256"},
    "drawing_instructions_path": {"type": "string", "minLength": 1},
    "drawing_instructions": {"type": "object"},
    "drawing_instructions_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_path": {"type": "string", "minLength": 1},
    "descriptor": {"type": "object"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "derived_wish_path": {"type": "string", "minLength": 1},
    "derived_wish": {"type": "object"},
    "derived_wish_sha256_field": {"$ref": "#/$defs/sha256"},
    "concept_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
