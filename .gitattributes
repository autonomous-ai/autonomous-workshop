# These imported snapshots are byte-locked to their upstream commits. Preserve
# their source/CAD whitespace verbatim and exempt it from repository diff checks.
inventors/text2cad/** -whitespace
inventors/text2game/** -whitespace
inventors/vibe-ideas/** -whitespace

# STEP is exporter-owned CAD text. Preserve the exact generated bytes that the
# artifact manifests seal instead of applying source-code whitespace rules.
*.step -whitespace
