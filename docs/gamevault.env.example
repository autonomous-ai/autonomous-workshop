# Design-vault API credentials for the Workshop host.
#
# Copy to $WORKSHOP_HOME/credentials/gamevault.env (mode 0600, directory 0700)
# or export both names in the host environment. Ask the vault operator for the
# real origin and token. Without them the host runs vault-bypassed; see
# docs/DESIGN_VAULT.md.
WORKSHOP_GAMEVAULT_URL=https://gamevault.example.test:8090
WORKSHOP_GAMEVAULT_TOKEN=replace-with-the-vault-bearer-token
