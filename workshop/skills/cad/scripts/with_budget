#!/usr/bin/env python3
"""Wall-clock budget for a whole pipeline run, enforced across separate commands.

CLAUDE.md requires a full run -- spec, gen, validate, the gates, snapshots --
to finish in under 30 minutes. Nothing in the toolchain enforced that, and the
four timeouts that do exist all bound something else:

    gen/artifact --lock-timeout   how long to WAIT for a peer's build lock
    snapshot job timeoutSeconds   one render (default 300 s), not the job
    CADGEN_DAEMON_TIMEOUT         one RPC to the warm daemon
    CADGEN_DAEMON_IDLE_TIMEOUT    when an idle daemon exits (default 10 min)
    step-parts --timeout          one HTTP fetch

So a step that wedges -- a snapshot browser that never loads, a boolean that
does not converge, a `check_fit` run bare over the whole worktree -- runs until
someone notices. This does not, and `timeout(1)` is not installed on macOS.

The budget is a TOTAL, so it cannot live inside one command: it is kept in a
ledger file that every step of the run reads and appends to.

    scripts/with_budget --start                    # open a run (default 30m)
    scripts/with_budget -- <cmd> [args...]         # run one step against it
    scripts/with_budget --step 5m -- <cmd> ...     # ...and cap the step too
    scripts/with_budget --report                   # elapsed / remaining
    scripts/with_budget --start --total 45m        # a different total

The cap on any step is `min(--step, remaining)`, so the last step of a run gets
whatever is left rather than its nominal slice. When nothing is left, a step is
refused before it starts instead of being killed halfway through.

Two clocks are recorded and they answer different questions:

    wall        since --start, which is what the 30 minutes means to a human
    commands    summed time inside the children, which is what tuning can move

`--measure wall` (the default) enforces the first, so an agent's own thinking
time between steps counts against the run -- that is deliberate, it is time the
user waits. `--measure commands` enforces the second, for an unattended batch
where only compute matters. Both are always reported.

A killed child is killed as a process group (`start_new_session=True`), because
`gen` under `CADGEN_WARM=1` runs work in a daemon child and SIGTERM to the
launcher alone leaves it running. SIGTERM first, then SIGKILL after `--grace`.

Killing a build is safe for the lock -- `coordination/lock.py` is a kernel-owned
flock released when the process dies -- but NOT for the package cache: every
artifact writer renames atomically, so `__cadgen__/` is left holding a mix of
new and old files that are each individually complete. That is exactly the
staleness CLAUDE.md's "Delete `__cadgen__/` after editing a `*_lib.py`" section
describes, and every deterministic check will agree with it. So a killed build
prints the `rm -rf` it needs.

The ledger is one per git worktree (`CADGEN_BUDGET_LEDGER` overrides it), so two
agent sessions in sibling worktrees each get their own. Two runs in the SAME
worktree share it and will both misreport -- give one of them its own path.

The wrapper's own status line goes to stderr, always, including under --json,
so the child's stdout stays clean for `| jq`. `--report` is the one mode that
prints to stdout, because then there is no child.

Exit codes follow timeout(1): 124 when the step was killed or the budget was
already spent, 127 when the command does not exist, 2 on bad usage, otherwise
the child's own code.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_TOTAL_SECONDS = 30 * 60
DEFAULT_GRACE_SECONDS = 5.0
LEDGER_NAME = ".cadgen-budget.json"

DURATION_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*([smh]?)\s*$", re.IGNORECASE)
UNIT_SECONDS = {"": 1.0, "s": 1.0, "m": 60.0, "h": 3600.0}


def parse_duration(text: str) -> float:
    """Accept `1800`, `90s`, `30m`, `1h` -- seconds when no unit is given."""
    match = DURATION_RE.match(text)
    if not match:
        raise argparse.ArgumentTypeError(
            f"not a duration: {text!r} (use 90s, 30m, 1h, or plain seconds)"
        )
    value = float(match.group(1)) * UNIT_SECONDS[match.group(2).lower()]
    if value <= 0:
        raise argparse.ArgumentTypeError("duration must be positive")
    return value


def human(seconds: float) -> str:
    seconds = max(0.0, float(seconds))
    if seconds < 60:
        return f"{seconds:.1f}s"
    minutes, rest = divmod(int(round(seconds)), 60)
    if minutes < 60:
        return f"{minutes}m{rest:02d}s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h{minutes:02d}m"


def worktree_root() -> Path:
    """The git worktree, so every step of a run finds the same ledger."""
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return Path.cwd()
    return Path(out.stdout.strip() or ".").resolve()


def ledger_path() -> Path:
    override = os.environ.get("CADGEN_BUDGET_LEDGER", "").strip()
    if override:
        return Path(override).expanduser().resolve()
    return worktree_root() / LEDGER_NAME


def read_ledger(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) and "startedAt" in data else None


def write_ledger(path: Path, ledger: dict) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(ledger, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def new_ledger(total: float, measure: str, label: str | None) -> dict:
    return {
        "startedAt": time.time(),
        "totalSeconds": total,
        "measure": measure,
        "label": label,
        "steps": [],
    }


def clocks(ledger: dict) -> tuple[float, float]:
    wall = max(0.0, time.time() - float(ledger["startedAt"]))
    commands = sum(float(step.get("seconds", 0.0)) for step in ledger["steps"])
    return wall, commands


def spent(ledger: dict) -> float:
    wall, commands = clocks(ledger)
    return commands if ledger.get("measure") == "commands" else wall


def remaining(ledger: dict) -> float:
    return float(ledger["totalSeconds"]) - spent(ledger)


def status_line(ledger: dict) -> str:
    wall, commands = clocks(ledger)
    left = remaining(ledger)
    verb = "left" if left >= 0 else "OVER"
    return (
        f"{human(wall)} wall / {human(commands)} in commands "
        f"of {human(ledger['totalSeconds'])} - {human(abs(left))} {verb}"
    )


def cache_hint(argv: list[str]) -> str | None:
    """After a kill, name the package cache that may now hold a mixed build."""
    for arg in argv:
        if not arg.endswith(".step.py"):
            continue
        project = Path(arg).resolve().parent
        if (project / "__cadgen__").is_dir():
            return str(project / "__cadgen__")
    return None


def run_step(args: argparse.Namespace, ledger: dict, path: Path) -> int:
    left = remaining(ledger)
    if left <= 0:
        over = -left
        print(
            f"with_budget: budget spent - {status_line(ledger)}\n"
            f"  the run is {human(over)} past its {human(ledger['totalSeconds'])} "
            f"total; nothing was started.\n"
            f"  open a new run with: {sys.argv[0]} --start",
            file=sys.stderr,
        )
        return 124

    cap = min(left, args.step) if args.step else left
    started = time.time()
    try:
        child = subprocess.Popen(args.command, start_new_session=True)
    except FileNotFoundError:
        print(f"with_budget: command not found: {args.command[0]}", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"with_budget: cannot run {args.command[0]}: {exc}", file=sys.stderr)
        return 127

    killed = False
    try:
        code = child.wait(timeout=cap)
    except subprocess.TimeoutExpired:
        killed = True
        _terminate_group(child, args.grace)
        code = 124
    except KeyboardInterrupt:
        _terminate_group(child, args.grace)
        code = 130

    elapsed = time.time() - started
    outcome = "timeout" if killed else ("ok" if code == 0 else "error")
    ledger["steps"].append({
        "argv": list(args.command),
        "seconds": round(elapsed, 3),
        "cap": round(cap, 3),
        "exit": code,
        "outcome": outcome,
    })
    write_ledger(path, ledger)

    name = display(args.command)
    if killed:
        print(
            f"with_budget: KILLED {name} at {human(elapsed)} "
            f"(cap {human(cap)}) | {status_line(ledger)}",
            file=sys.stderr,
        )
        stale = cache_hint(args.command)
        if stale:
            print(
                f"  a killed build leaves {stale} holding a mix of new and old "
                f"files.\n  rm -rf {stale}   before trusting the next gen.",
                file=sys.stderr,
            )
    else:
        print(
            f"with_budget: {outcome} {name} in {human(elapsed)} "
            f"| {status_line(ledger)}",
            file=sys.stderr,
        )

    if args.json:
        print(json.dumps({
            "ok": code == 0,
            "outcome": outcome,
            "seconds": round(elapsed, 3),
            "cap": round(cap, 3),
            "exit": code,
            "budget": budget_report(ledger, path),
        }, indent=2), file=sys.stderr)
    return code


def display(argv: list[str], width: int = 72) -> str:
    """One readable line for a status message: absolute paths become basenames.

    A ten-part `gen` invocation is ten absolute paths, and printing it whole
    buries the number the line exists to report.
    """
    parts = [Path(arg).name if "/" in arg and len(arg) > 24 else arg for arg in argv]
    text = " ".join(parts)
    return text if len(text) <= width else text[: width - 3] + "..."


def _terminate_group(child: subprocess.Popen, grace: float) -> None:
    """SIGTERM the group, then SIGKILL it -- the warm daemon ignores the launcher."""
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 5.0)):
        try:
            os.killpg(os.getpgid(child.pid), sig)
        except (ProcessLookupError, PermissionError, OSError):
            return
        try:
            child.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def budget_report(ledger: dict, path: Path) -> dict:
    wall, commands = clocks(ledger)
    return {
        "ledger": str(path),
        "label": ledger.get("label"),
        "measure": ledger.get("measure", "wall"),
        "totalSeconds": ledger["totalSeconds"],
        "wallSeconds": round(wall, 3),
        "commandSeconds": round(commands, 3),
        "remainingSeconds": round(remaining(ledger), 3),
        "withinBudget": remaining(ledger) >= 0,
        "steps": ledger["steps"],
    }


def report(ledger: dict, path: Path, as_json: bool) -> int:
    if as_json:
        print(json.dumps(budget_report(ledger, path), indent=2))
        return 0 if remaining(ledger) >= 0 else 1
    label = ledger.get("label")
    print(f"run: {label}" if label else f"ledger: {path}")
    print(f"budget: {human(ledger['totalSeconds'])} total, "
          f"enforced on {ledger.get('measure', 'wall')} clock")
    if ledger["steps"]:
        print(f"\n{'step':<62} {'seconds':>9} {'outcome':>9}")
        for step in ledger["steps"]:
            print(f"{display(step['argv'], 62):<62} "
                  f"{step['seconds']:9.1f} {step['outcome']:>9}")
    print(f"\n{status_line(ledger)}")
    return 0 if remaining(ledger) >= 0 else 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="with_budget",
        description="Enforce one wall-clock budget across every command of a run.",
        epilog="See CLAUDE.md, \"A full run has 30 minutes\".",
    )
    parser.add_argument("--start", action="store_true",
                        help="open a new run, discarding any ledger in place")
    parser.add_argument("--report", action="store_true",
                        help="print the run's elapsed and remaining time")
    parser.add_argument("--total", type=parse_duration, default=None,
                        metavar="DURATION",
                        help=f"total for the run (default {human(DEFAULT_TOTAL_SECONDS)})")
    parser.add_argument("--step", type=parse_duration, default=None,
                        metavar="DURATION",
                        help="also cap this one step; the effective cap is min(step, remaining)")
    parser.add_argument("--measure", choices=("wall", "commands"), default=None,
                        help="which clock the total is enforced on (default wall)")
    parser.add_argument("--grace", type=float, default=DEFAULT_GRACE_SECONDS,
                        metavar="SECONDS",
                        help=f"SIGTERM-to-SIGKILL gap (default {DEFAULT_GRACE_SECONDS:g})")
    parser.add_argument("--label", default=None,
                        help="name this run, for --report")
    parser.add_argument("--json", action="store_true",
                        help="machine-readable summary (to stderr when a command ran)")
    parser.add_argument("command", nargs=argparse.REMAINDER,
                        help="-- followed by the command to run")
    args = parser.parse_args(argv)

    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    args.command = command

    path = ledger_path()
    ledger = read_ledger(path)

    if args.start:
        ledger = new_ledger(
            args.total or DEFAULT_TOTAL_SECONDS,
            args.measure or "wall",
            args.label,
        )
        write_ledger(path, ledger)
        print(f"with_budget: run open - {human(ledger['totalSeconds'])} total "
              f"on the {ledger['measure']} clock ({path})", file=sys.stderr)
        if not args.command:
            return 0

    if args.report:
        if ledger is None:
            print(f"with_budget: no run open ({path})", file=sys.stderr)
            return 2
        return report(ledger, path, args.json)

    if not args.command:
        parser.error("nothing to run: pass -- <command>, or --start / --report")

    if ledger is None:
        ledger = new_ledger(
            args.total or DEFAULT_TOTAL_SECONDS,
            args.measure or "wall",
            args.label,
        )
        print(f"with_budget: no run open; started one - "
              f"{human(ledger['totalSeconds'])} total ({path})", file=sys.stderr)
    else:
        if args.total is not None and args.total != ledger["totalSeconds"]:
            ledger["totalSeconds"] = args.total
        if args.measure is not None:
            ledger["measure"] = args.measure
    write_ledger(path, ledger)

    return run_step(args, ledger, path)


if __name__ == "__main__":
    raise SystemExit(main())
