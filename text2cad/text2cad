def lessons_block() -> str:
    lessons = HERE / "lessons.md"
    if not lessons.is_file():
        return ""
    return ("\n\nLESSONS from previous failed runs — these are HARD RULES, "
            "violating them is how past runs failed:\n" + lessons.read_text(encoding="utf-8"))


