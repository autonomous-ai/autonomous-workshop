def repair_prompt(slug: str, out_dir: Path, fails: list) -> str:
    gate_cmd = f"{VENV_PY} {GATE_PY} {out_dir}"
    return f"""{HEADLESS_WARNING}

You are a REPAIR session of a text-to-CAD pipeline, in `{out_dir}`. Previous
sessions left this part FAILING its printability gate: {fails}.{lessons_block()}
{"""
LOOK AT `reference/concept.png` BEFORE FIXING — it is the design the human
approved and what the fidelity lens scores against, so a fidelity fail is a
question about that image, not about prose. Take silhouette, part count and
feature presence from it; take every number from brief.md; never let it argue
you past the printability non-negotiables.
""" if (out_dir / "reference" / "concept.png").is_file() else ""}

0. Read `panel_history.json` (every prior panel verdict, oldest -> newest) and
   the current `review_*.md` files FIRST. Treat prior verdicts as a REGRESSION
   SUITE: past repair rounds oscillated — each fixed its named fail while
   quietly re-breaking a feature an earlier round had already accepted. A fix
   that re-breaks a previously-PASSed lens or re-opens an old finding is worse
   than no fix. If `arbitration.md` exists, read it too: it may prove some
   review claims measurably FALSE (a prior arbitration did) and may name the
   exact fix technique for the real ones — do not spend turns "fixing" a
   refuted claim; verify each claimed defect against the geometry before
   changing code.
1. Read `gate.json`, `params.py`, `main.py`, `{HERE}/blocks/BLOCKS.md` (prefer
   swapping broken hand-built geometry for a verified golden block), and
   `{CADCODE}/SKILL.md` (the sections on booleans/validation). Diagnose the
   ROOT CAUSE in the code —
   e.g. multiple bodies usually means unioned pieces only touch tangentially
   or don't overlap; make every piece OVERLAP its neighbor by >= 1mm and fuse
   with a single union chain into ONE solid.
2. Fix the code. Do NOT redesign the product; change geometry construction only.
3. Re-export with the cad tool (`{CAD_CMD}`), re-run the gate (`{gate_cmd}`),
   and iterate SYNCHRONOUSLY until the gate prints GATE PASS.
4. Append ONE short durable lesson to `{HERE}/lessons.md` (create if missing):
   a rule that would have PREVENTED this failure class in a future build,
   written as an imperative, and it MUST carry the origin tag the file's
   header defines, or it is useless to the humans reading it later:
   `- [cause · phase · {slug} <today> · cost <what it burned> · OPEN] Always ...`
   Pick `cause` from the header's vocabulary (kernel, printability, brief,
   assembly, fidelity, discipline, harness, tooling, discover) — that word is
   what makes a recurring failure countable, so choose where the failure
   really CAME FROM, not where it was noticed.

Reply with ONE line: `REPAIRED` or `STUCK <reason>`. IMPORTANT: if your
diagnosis is that the failure traces to `brief.md` itself demanding something
impossible (numbers that cannot coexist geometrically, physically, or with
each other), do NOT fake a workaround — reply `STUCK spec-conflict: <the
impossibility in one sentence>` so the pipeline goes straight to arbitration
instead of burning more repair rounds."""


def arbitration_prompt(slug: str, out_dir: Path, fails: list) -> str:
    return f"""{HEADLESS_WARNING}

You are the ARBITRATION phase of a text-to-CAD pipeline, in `{out_dir}`.
The repair budget is exhausted and the part still fails: {fails}.
Your job: decide whether what remains is a genuine SPEC CONFLICT — brief.md
demanding things that are mutually impossible (geometrically, physically, or
against its own other numbers) — as opposed to a build defect or reviewer
noise. Repair sessions may have left their diagnosis in `params.py` comments
and their replies; weigh those.

1. Read `brief.md`, `gate.json`, `params.py`, `main.py`, every
   `review_*.md`, and the renders in `{slug}_review/`.
2. WRITE EARLY: the moment you have decided, write `arbitration.md` — its
   FIRST line must be EXACTLY `Verdict: PROPOSE <one-sentence summary>` or
   `Verdict: NO-CONFLICT <reason>` — then the conflict in one paragraph, the
   changed numbers as a short before → after list, and what the change trades
   away. The pipeline falls back to that first line if this session dies
   before replying; a session that ends without `arbitration.md` is lost.
3. If the remaining fails are NOT a spec conflict (fixable defect, or the
   lens verdict looks wrong), write no other file and reply
   `NO-CONFLICT <reason>`.
4. If they ARE a spec conflict: write `brief_proposed.md` — the FULL amended
   brief, changing the MINIMUM set of numbers that resolves the conflict,
   with an `## Amendments` section at the end stating each change and why.
   NEVER relax safety-critical requirements (viewing safety, min walls,
   watertightness) and NEVER exceed the user's stated envelope. Do NOT touch
   `brief.md` itself — the human applies the proposal.

Reply with ONE line: `PROPOSE <one-sentence summary>` or `NO-CONFLICT <reason>`."""


TIER_BUDGET = {"broken": 2, "functional": 3, "cosmetic": 2}


def fail_tier(fails: list) -> str:
    """Circuit-style severity tiers: worst tier present decides the repair budget."""
    fl = " ".join(map(str, fails or []))
    if any(k in fl for k in ("not_watertight", "bodies=", "no_stl", "lint:")):
        return "broken"
    if any(k in fl for k in ("print_time=", "slice_failed", "overhang=", "lens:printability", "lens:fidelity", "lens:likeness")):
        return "functional"
    return "cosmetic"


STUCK_EVIDENCE = re.compile(
    r"\b0 legal\b|\bno legal\b|\bunresolved conflict|\bfor arbitration\b|"
    r"\bno \(?\w+, ?\w+\)? pairs\b|\bgeometrically impossible\b|\bover-?constrained\b",
    re.I)


def is_stuck(last_line: str, verdict: str) -> bool:
    """Has this repair told us it cannot finish — in any words?

    The test used to be `last_line.startswith("STUCK")` and nothing else. On
    2026-08-17 repair2 swept ~21,000 candidates, proved the brief had ZERO legal
    (pivot_y, blade_r) pairs, and ended with "params.py now carries both
    unresolved conflicts for arbitration: C1 and C2". The pipeline did not hear
    it, spent repair3 (~50 min, $12.94) on the proven-impossible constraint, and
    repair3 was itself cut off before it could say anything at all.

    An agent that writes "0 legal pairs" has answered the question. Listen for
    the evidence, not only for the magic word — and read the whole verdict,
    because a truncated phase never reaches its final line.
    """
    if last_line.startswith("STUCK"):
        return True
    return bool(STUCK_EVIDENCE.search(verdict or ""))


def run_arbitration(slug: str, out_dir: Path, fails: list, tier: str,
                    spent_n: int, run_log: dict) -> None:
    """Run the arbitration phase; falls back to arbitration.md's first
    `Verdict:` line (mtime-guarded, like lens_verdict) when stdout is empty —
    the phase can die at max_turns with its verdict only on disk."""
    arb_file = out_dir / "arbitration.md"
    arb_mtime = arb_file.stat().st_mtime if arb_file.is_file() else None
    arb = run_phase("arbitration", arbitration_prompt(slug, out_dir, fails),
                    out_dir, ARB_TURNS, run_log, timeout_s=3600)
    last = (arb or "").strip().splitlines()[-1] if (arb or "").strip() else ""
    if not last.startswith(("PROPOSE", "NO-CONFLICT")) and arb_file.is_file() \
            and (arb_mtime is None or arb_file.stat().st_mtime > arb_mtime):
        first = arb_file.read_text(encoding="utf-8").strip().splitlines()[0]
        if first.lower().startswith("verdict:"):
            last = first.partition(":")[2].strip()
    if last.startswith("PROPOSE") and (out_dir / "brief_proposed.md").is_file():
        msg = (f"ARBITRATION: {slug} — spec conflict after {spent_n} repairs: "
               f"{last[len('PROPOSE'):].strip()}\n"
               f"details: {out_dir}/arbitration.md\n"
               f"GO:  ./text2cad {slug} --amend\n"
               f"NO:  rm {out_dir}/brief_proposed.md")
        run_log.pop("escalated", None)
        run_log["arbitrated"] = {"tier": tier, "fails": fails, "proposal": last}
    else:
        msg = (f"ESCALATE: {slug} — {tier} tier budget exhausted "
               f"({spent_n} repairs), still failing: {fails}")
        run_log.pop("arbitrated", None)
        run_log["escalated"] = {"tier": tier, "fails": fails}
    print(msg)
    telegram_send_text(msg)


