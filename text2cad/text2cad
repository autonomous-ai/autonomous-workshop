    cap without producing new geometry, so the anchor and the render were the
    same bytes. The lens answered honestly — "reference/concept.png is
    byte-identical to the current render, so there is no independent approved
    concept image to judge likeness against" — and scored it 0/10 because the
    verdict format has no way to say "unanswerable". The milestone gate read
    that 0 as "silhouette unsalvageable" and killed a $29.49 run that had never
    been judged at all: no build2, no gate, no panel.

    An unanswerable question is not a failing answer. Check before asking.
    """
    ref = out_dir / "reference" / "concept.png"
    if not ref.is_file():
        ref = out_dir / "concept.png"
    if not ref.is_file():
        return False
    cur = out_dir / f"{out_dir.name}_review" / "_assembled.png"
    if not cur.is_file():
        return True  # nothing rendered yet, so nothing to collide with
    return ref.read_bytes() != cur.read_bytes()


def run_build(slug: str, out_dir: Path, run_log: dict) -> None:
    """BUILD with a mid-point likeness milestone.

    The 08-14 run (arc-coil-blaster-prop) spent its whole budget on detail and
    only learned at the END-of-cycle panel that the grip, guard and stock were
    off-concept — 17 hours and the repair budget gone before the first likeness
    verdict. So: half the budget, then a cheap likeness lens on the current
    geometry, then the second half with that verdict injected — silhouette
    failures now cost half a build, not a whole cycle."""
    if not has_concept_ref(out_dir):
        run_phase("build", build_prompt(slug, out_dir), out_dir, BUILD_TURNS,
                  run_log, timeout_s=10800)
        return
    r1 = run_phase("build", build_prompt(slug, out_dir), out_dir, BUILD_TURNS // 2,
                   run_log, timeout_s=5400)
    done = (r1 or "").strip().splitlines()[-1].startswith("DONE") if (r1 or "").strip() else False
    if list(out_dir.glob("*.stl")):
        render_fresh(slug, out_dir)
        f = out_dir / "review_likeness.md"
        mtime = f.stat().st_mtime if f.is_file() else None
        r = run_phase("build-likeness-check", lens_prompt(slug, out_dir, "likeness"),
                      out_dir, LENS_TURNS_LIKENESS, run_log, timeout_s=2400)
        verdict = lens_verdict(out_dir, "likeness", r, mtime)
        if verdict == "FAIL no output":
            # "no output" is an agent CRASH, not a content verdict (lessons.md,
            # three recurrences) — retry once, like the panel already does.
            r = run_phase("build-likeness-check-retry",
                          lens_prompt(slug, out_dir, "likeness"),
                          out_dir, LENS_TURNS_LIKENESS, run_log, timeout_s=2400)
            verdict = lens_verdict(out_dir, "likeness", r, mtime)
        run_log["build_milestone"] = verdict
        print(f"[build-milestone] likeness: {verdict}", flush=True)
        # 2026-08-15: a hopeless silhouette is not repairable in half a budget —
        # shadow-moire scored 2/10 at milestone, then burned $8 build2 + panel
        # anyway. Below the threshold, kill the whole run now.
        m_score = re.search(r"FAIL\s+(\d+(?:\.\d+)?)\s*/\s*10", verdict)
        abort_below = float(os.environ.get("MILESTONE_ABORT_BELOW", "4"))
        # Only a JUDGED silhouette may kill the run. When the anchor and the
        # render are the same bytes the lens cannot answer, and its 0/10 means
        # "unanswerable", not "hopeless" — aborting on it throws away a whole
        # cycle over a pipeline defect. Carry on to build2 instead: producing
        # new geometry is exactly what makes the question answerable again.
        judged = concept_ref_independent(out_dir)
        if not judged:
            run_log["build_milestone"] = (
                "SKIP likeness unjudgeable — the anchor is byte-identical to the "
                "render (no independent concept); continuing to build2")
            print(f"[build-milestone] {run_log['build_milestone']}", flush=True)
        if judged and m_score and float(m_score.group(1)) < abort_below:
            run_log["build_aborted"] = (
                f"milestone likeness {m_score.group(1)}/10 < {abort_below:g} — "
                "silhouette unsalvageable, build2/gate/panel skipped to save budget")
            print(f"[build-milestone] ABORT RUN: {run_log['build_aborted']}", flush=True)
            return
        if verdict.startswith("PASS") and done:
            return  # silhouette approved and the build already declared DONE
        if verdict.startswith("PASS"):
            note = ("\n\nMILESTONE — a likeness lens PASSED the current silhouette "
                    f"({verdict}). Do NOT regress it: finish detail, per-part "
                    "exports, part_colors.json and fit_checks.py.")
        elif not judged:
            # Same category as a crashed lens: INCONCLUSIVE. Handing build2 the
            # 0/10 text would order it to fix a silhouette nobody ever judged.
            note = ("\n\nMILESTONE — the likeness check could not be answered: "
                    "the anchor image is byte-identical to the current render, "
                    "so there was nothing independent to compare against. Treat "
                    "the silhouette as UNVERIFIED — keep matching the approved "
                    "renders in reference/ and finish the build.")
        elif verdict == "FAIL no output":
            # Crashed twice: the milestone is INCONCLUSIVE. Never inject the
            # stale findings file — 2026-08-16 a crashed lens fell through to
            # this branch and build2 was handed the PREVIOUS run's 2/10
            # findings, with orders to destroy an already-DONE correct model.
            if done:
                print("[build-milestone] lens crashed twice and the build is "
                      "DONE — skipping build2", flush=True)
                return
            note = ("\n\nMILESTONE — the likeness lens crashed twice, so there "
                    "is no silhouette verdict this round. Keep matching the "
                    "approved renders in reference/ and finish the build: "
                    "detail, per-part exports, part_colors.json, fit_checks.py.")
        else:
            # Only trust findings the lens ACTUALLY wrote this round — a stale
            # review_likeness.md describes a previous geometry.
            fresh = f.is_file() and (mtime is None or f.stat().st_mtime > mtime)
            findings = f.read_text(encoding="utf-8") if fresh else verdict
            note = ("\n\nMILESTONE LIKENESS CHECK FAILED at half budget — fix the "
                    "silhouette findings below BEFORE any detail or gate work; a "
                    "finished part with the wrong shape fails the run:\n" + findings)
    else:
        note = ("\n\nMILESTONE — half the build budget is spent and NO assembled "
                "STL exists yet. Export the assembled silhouette FIRST (rough is "
                "fine), render it, compare against the concept, then continue.")
    run_phase("build2", build_prompt(slug, out_dir) + note, out_dir,
              BUILD_TURNS // 2, run_log, timeout_s=5400)


def run_gate(out_dir: Path, no_slice: bool) -> dict:
    gate = subprocess.run([str(VENV_PY), str(GATE_PY), str(out_dir)]
                          + (["--no-slice"] if no_slice else []),
                          capture_output=True, text=True)
    print(gate.stdout.strip())
    return json.loads((out_dir / "gate.json").read_text(encoding="utf-8"))


def main() -> int:
    ap = argparse.ArgumentParser(description="text prompt -> printable .step/.stl")
    ap.add_argument("prompt", nargs="?", default="",
                    help='prompt, or slug of existing out/<slug> with --repair/--go/--reject')
    ap.add_argument("--slug", help="output folder name (default: from prompt)")
    ap.add_argument("--no-slice", action="store_true", help="mesh-only gate")
    ap.add_argument("--repair", action="store_true",
                    help="skip brief/build/review; gate + repair-loop an existing out/<slug>")
    ap.add_argument("--amend", action="store_true",
                    help="apply out/<slug>/brief_proposed.md from arbitration, then re-review")
    ap.add_argument("--arbitrate", action="store_true",
                    help="re-run only the arbitration phase on an escalated out/<slug>")
    ap.add_argument("--review", action="store_true",
                    help="skip brief/build; review + gate + repair-loop an existing out/<slug>")
    ap.add_argument("--max-repairs", type=int, default=3)
    ap.add_argument("--discover", action="store_true",
                    help="trend scan -> 3 scored candidates -> pick 1 -> brief -> draft renders -> STOP for human")
    ap.add_argument("--auto", action="store_true",
                    help="with --discover: do not stop at the proposal — continue straight into build (full-auto)")
    ap.add_argument("--go", action="store_true",
                    help="human approved the proposal: full build from existing brief + draft")
    ap.add_argument("--reject", metavar="REASON",
                    help="human rejected the proposal: record lesson for future discovery")
    args = ap.parse_args()

    load_env()

    if args.amend:
        args.review = True

    if args.reject:
        slug = args.slug or args.prompt
        f = HERE / "discover_lessons.md"
        header = "" if f.is_file() else "# discover lessons (human GO/REJECT feedback)\n\n"
        with f.open("a", encoding="utf-8") as fh:
            fh.write(f"{header}- REJECTED '{slug}': {args.reject}\n")
        print(f"lesson recorded. re-run --discover for a new proposal.")
        return 0

    if args.discover:
        trend_dir = Path(os.environ.get("TREND_DIR", str(Path.home() / "brain" / "raw")))
        source = os.environ.get("TREND_SOURCE", "files" if trend_dir.is_dir() else "mcp")
        trends = [] if source == "mcp" else \
            sorted(trend_dir.glob("*-x-scrape.md"))[-1:] + \
            sorted(trend_dir.glob("*-hn-morning.md"))[-1:]
        if source != "mcp" and not trends:
            print(f"no trend files in {trend_dir} — falling back to second-brain MCP")
        tmp = HERE / "out" / "_discover"
        tmp.mkdir(parents=True, exist_ok=True)
        run_log = {"mode": "discover", "trends": [str(t) for t in trends] or ["second-brain-mcp"]}
        print(f"== text2cad discover: trends={[t.name for t in trends] or 'second-brain MCP'}, "
              f"{len(PROPOSE_LANES)} proposers -> {N_JUDGES} judges")
        text = run_discover_panel(tmp, trends, run_log)
        m = re.search(r"^WINNER:\s*([a-z0-9-]+)", text, re.M)
        p = re.search(r"^PROMPT:\s*(.+)$", text, re.M)
        if not m:
            print("ABORT: no WINNER line in discover.md"); return 1
        slug = m.group(1)[:40]
        out_dir = HERE / "out" / slug
        out_dir.mkdir(parents=True, exist_ok=True)
        (out_dir / "discover.md").write_text(text, encoding="utf-8")
        telegram_send_text(discover_preview(text))
        concept_target(out_dir)
        panel_dir = out_dir / "panel"
        panel_dir.mkdir(exist_ok=True)
        for rec in sorted(tmp.glob("cand_*.md")) + sorted(tmp.glob("judge_*.md")):
            (panel_dir / rec.name).write_bytes(rec.read_bytes())
        run_log["slug"] = slug
        product_prompt = p.group(1).strip() if p else slug.replace("-", " ")
        run_log["prompt"] = product_prompt
        # Which trend item bought this product. one-way-newsreel could only be
        # traced back to its HN story by hand, weeks later, by matching phrasing
        # in a candidate file — the run itself recorded nothing but the string
        # "second-brain-mcp". Without this the pipeline cannot answer whether its
        # reads of the market were any good.
        seed = re.search(r"^Seed:\s*(.+)$", text, re.M)
        run_log["seed"] = seed.group(1).strip() if seed else "NOT CITED"

        run_phase("brief", brief_prompt(product_prompt, out_dir), out_dir, BRIEF_TURNS, run_log, timeout_s=1800)
        if not (out_dir / "brief.md").is_file():
            print("ABORT: brief.md was not produced"); return 1
        run_phase("draft", draft_prompt(slug, out_dir), out_dir, DRAFT_TURNS, run_log, timeout_s=3600)
        rd = out_dir / f"{slug}_review"
        if not (rd / "_assembled.png").is_file():
            # 2026-08-15: two drafts in a row hit the turn cap with zero
            # exports and the proposal went out render-less. One corrective
            # retry, alert either way so a silent draft death is visible.
            telegram_send_text(f"{slug}: draft died with no renders — one retry "
                               "with export-first note")
            run_phase("draft2", draft_prompt(slug, out_dir) +
                      f"\n\nRETRY — the previous draft session hit its turn limit "
                      f"with NO export on disk. Do not repeat that: produce "
                      f"`{slug}.stl` and `_assembled.png` at placeholder quality "
                      f"within your first 10 turns, then refine only with what "
                      f"remains.", out_dir, DRAFT_TURNS, run_log, timeout_s=3600)
            if not (rd / "_assembled.png").is_file():
                telegram_send_text(f"text2cad {slug}: draft failed TWICE — "
                                   f"proposal goes out without renders; check {out_dir}")
        for src, dst in ((rd / "_assembled.png", "hero.png"), (rd / "_qa.png", "parts.png")):
            if src.is_file():
                (out_dir / dst).write_bytes(src.read_bytes())
        ref = out_dir / "reference"
        ref.mkdir(exist_ok=True)
        for png in rd.glob("*.png"):
            (ref / png.name).write_bytes(png.read_bytes())
        concept = out_dir / "concept.png"
        if concept.is_file():  # the approved look, judged alongside the renders
            (ref / "concept.png").write_bytes(concept.read_bytes())
        print(f"reference set: {len(list(ref.glob('*.png')))} approved renders for the build phase")
        print(telegram_send_proposal(out_dir, slug))
        # 2026-08-16: demo video rides a DETACHED process — the H3 gateway can
        # cold-start 35+ minutes and the cycle must never await it. The script
        # polls, retries and telegrams the finished clip entirely on its own.
        try:
            (HERE / "logs").mkdir(exist_ok=True)
            vlog = (HERE / "logs" / f"video-{slug}.log").open("a")
            subprocess.Popen([sys.executable, str(HERE / "gen_demo_video.py"),
                              slug], cwd=HERE, stdout=vlog,
                             stderr=subprocess.STDOUT, start_new_session=True)
            print(f"demo video: detached (logs/video-{slug}.log)")
        except Exception as e:
            print(f"demo video: spawn failed (non-fatal): {e}")
        (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
        total = sum(e.get("cost_usd") or 0 for e in run_log.values() if isinstance(e, dict) and "cost_usd" in e)
        print(f"\n== PROPOSAL READY: {slug} (${total:.2f})")
        print(f"   preview: {out_dir}/hero.png + parts.png | scores: {out_dir}/discover.md")
        if not args.auto:
            print(f"   GO: ./text2cad {slug} --go   |   NO: ./text2cad {slug} --reject 'reason'")
            return 0
        # full-auto: proposal is FYI only — continue straight into the build path
        print("   AUTO mode: continuing into build")
        args.go, args.prompt, args.slug = True, slug, slug
    if args.repair or args.review or args.go or args.arbitrate:
        slug = args.slug or args.prompt
    else:
        slug = args.slug or re.sub(r"[^a-z0-9]+", "-", args.prompt.lower()).strip("-")[:40]
    out_dir = HERE / "out" / slug
    verdict = ""

    if args.arbitrate:
        run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
            if (out_dir / "run.json").is_file() else {"slug": slug}
        prior = run_log.get("escalated") or run_log.get("arbitrated") or {}
        fails = prior.get("fails") or ["unknown"]
        tier = prior.get("tier") or fail_tier(fails)
        print(f"== text2cad arbitrate: {slug} -> {out_dir}")
        run_arbitration(slug, out_dir, fails, tier, TIER_BUDGET[tier], run_log)
        (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
        return 0

    if args.repair or args.review:
        if not list(out_dir.glob("*.stl")):
            print(f"ABORT: no .stl in {out_dir} to repair"); return 1
        run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
            if (out_dir / "run.json").is_file() else {"slug": slug}
        if args.amend:
            prop = out_dir / "brief_proposed.md"
            if not prop.is_file():
                print(f"ABORT: no brief_proposed.md in {out_dir} — nothing to amend"); return 1
            (out_dir / "brief.md").write_text(prop.read_text(encoding="utf-8"), encoding="utf-8")
            prop.unlink()
            print("brief.md amended from arbitration proposal")
        print(f"== text2cad {'review' if args.review else 'repair'}: {slug} -> {out_dir}")
    else:
        out_dir.mkdir(parents=True, exist_ok=True)
        if args.go:
            if not (out_dir / "brief.md").is_file():
                print(f"ABORT: no brief.md in {out_dir} — run --discover first"); return 1
            run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
                if (out_dir / "run.json").is_file() else {"slug": slug}
            print(f"== text2cad GO (human-approved): {slug} -> {out_dir}")
            # 2026-08-16: the human GOes the PROPOSAL — the draft renders —
            # so from GO onward the approved draft hero IS the likeness
            # target. Keeping the pre-draft AI concept.png as the anchor
            # scored a correct upright build 2/10 against the obsolete
            # horizontal concept photo and sent build2 off to destroy the
            # approved layout (one-way-newsreel). Original kept alongside.
            hero, concept = out_dir / "hero.png", out_dir / "concept.png"
            if hero.is_file() and concept.is_file():
                orig = out_dir / "concept_orig_ai.png"
                if not orig.is_file():
                    orig.write_bytes(concept.read_bytes())
                # 2026-08-17: the anchor used to be the raw CAD render, which is
                # byte-identical to what the lens is judging whenever BUILD adds
                # no geometry — the lens then cannot answer and its 0/10 killed a
                # $29 run. Re-surface the SAME geometry through self-hosted i2i
                # instead ($0, ~21s): same object and same camera, so silhouette
                # differences are real, and a photograph is never byte-identical
                # to a flat-shaded render. Falls back to the raw hero if the
                # gateway is down — the milestone guard covers that case.
                made = concept_from_render(out_dir, hero)
                if not made:
                    concept.write_bytes(hero.read_bytes())
                ref = out_dir / "reference" / "concept.png"
                if ref.parent.is_dir():
                    ref.write_bytes(concept.read_bytes())
                print(f"GO: likeness anchor = {'i2i photo of' if made else 'raw render of'} "
                      "the approved draft (original t2i -> concept_orig_ai.png)")
        else:
            run_log = {"prompt": args.prompt, "slug": slug}
            print(f"== text2cad: {slug} -> {out_dir}")

            run_phase("brief", brief_prompt(args.prompt, out_dir), out_dir, BRIEF_TURNS, run_log, timeout_s=1800)
            if not (out_dir / "brief.md").is_file():
                print("ABORT: brief.md was not produced"); return 1

        run_build(slug, out_dir, run_log)
        if run_log.get("build_aborted"):
            (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
            telegram_send_text(f"text2cad {slug}: RUN ABORTED early — "
                               f"{run_log['build_aborted']}")
            print(f"\n== ABORT {slug}: {run_log['build_aborted']}")
            write_postmortem(slug)
            return 1
        if not list(out_dir.glob("*.stl")):
            print("ABORT: no .stl produced"); return 1

    run_log["gate"] = run_gate(out_dir, args.no_slice)

    lens_fails = []
    if not args.repair:
        run_log["panel"] = run_panel(slug, out_dir, run_log)
        lens_fails = [f"lens:{k} {v}" for k, v in run_log["panel"].items()
                      if not v.startswith("PASS")]

    spent = {t: 0 for t in TIER_BUDGET}
    attempt = 0
    bonus_granted = {t: False for t in TIER_BUDGET}
    while not (run_log["gate"].get("pass") and not lens_fails):
        fails = (run_log["gate"].get("fails") or []) + lens_fails or ["unknown"]
        tier = fail_tier(fails)
        if spent[tier] >= TIER_BUDGET[tier]:
            # one bonus repair per tier, and only while that tier is still
            # climbing. Previously this was two guards whose conditions were
            # identical before any bonus (spent >= budget + 0 vs spent >=
            # budget), so the first guard always won and the bonus was
            # unreachable dead code.
            if bonus_granted[tier] or not scores_improving(out_dir):
                run_arbitration(slug, out_dir, fails, tier, spent[tier], run_log)
                break
            bonus_granted[tier] = True
            telegram_send_text(f"{slug}: budget exhausted but failing lens scores "
                               f"still climbing — granting 1 bonus repair")
        spent[tier] += 1
        attempt += 1
        verdict = run_phase(f"repair{attempt}",
                            repair_prompt(slug, out_dir, fails) +
                            f"\nSeverity tier: {tier.upper()} (attempt {spent[tier]}/{TIER_BUDGET[tier]} for this tier).",
                            out_dir, REPAIR_TURNS, run_log, timeout_s=5400)
        stuck = (verdict or "").strip().splitlines()[-1] if (verdict or "").strip() else ""
        if is_stuck(stuck, verdict):
            # repair declared itself stuck — skip the remaining repair budget
            # and let arbitration decide (it telegrams GO/NO if spec conflict)
            run_arbitration(slug, out_dir, fails + [f"repair{attempt}: {stuck}"],
                            tier, spent[tier], run_log)
            break
        run_log["gate"] = run_gate(out_dir, args.no_slice)
        # immediate heads-up the moment the repair session ends — the photo
        # alert below only fires after the lens re-checks (~15 min later)
        telegram_send_text(
            f"{slug} repair{attempt} finished ({(verdict or '').strip().splitlines()[-1][:80] if (verdict or '').strip() else 'no reply — hit turn limit'}), "
            f"gate={'PASS' if run_log['gate'].get('pass') else 'FAIL'} — re-judging failed lenses now, photo follows")
        if lens_fails:  # change-only rescore: re-run failed lenses, keep passed verdicts
            failed = [k for k in run_log["panel"] if not run_log["panel"][k].startswith("PASS")]
            run_log["panel"] = run_panel(slug, out_dir, run_log, lenses=failed)
            lens_fails = [f"lens:{k} {v}" for k, v in run_log["panel"].items()
                          if not v.startswith("PASS")]
            if not lens_fails and len(failed) < len(LENSES):
                # every failing lens now passes — confirm the lenses this round
                # skipped didn't regress before declaring the panel clean
                confirm = [k for k in LENSES if k not in failed]
                run_log["panel"] = run_panel(slug, out_dir, run_log, lenses=confirm)
                lens_fails = [f"lens:{k} {v}" for k, v in run_log["panel"].items()
                              if not v.startswith("PASS")]
        hero = hero_render(slug, out_dir)
        if hero:
            panel = run_log.get("panel") or {}
            telegram_send_photo(hero, f"{slug} repair{attempt}: " + (" ".join(
                f"{k}:{' '.join(str(v).split()[:2])}" for k, v in panel.items())
                or f"gate={'PASS' if run_log['gate'].get('pass') else 'FAIL'}"))

    panel = run_log.get("panel") or {}
    verdict = ("PANEL " + " ".join(f"{k}:{'PASS' if v.startswith('PASS') else 'FAIL'}"
               for k, v in panel.items())) if panel else (verdict or "")
    (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")

    files = [p.name for p in sorted(out_dir.iterdir()) if p.suffix in (".step", ".stl", ".md", ".json")]
    total = sum(e.get("cost_usd") or 0 for e in run_log.values() if isinstance(e, dict) and "cost_usd" in e)

    # The publish decision, stated once and machine-readably. autoloop used to
    # grep `gate=PASS` alone, so a product whose entire lens panel crashed still
    # got published — the deterministic gate only proves a mesh prints, never
    # that the thing resembles what was approved or that anyone wants it.
    # Shipping requires BOTH: the gate passes AND every lens returned a verdict
    # AND none of them failed.
    expected = [x for x in LENSES if x != "likeness" or has_concept_ref(out_dir)]
    ship, unjudged, _ = ship_decision(run_log["gate"].get("pass"), panel, expected)
    run_log["ship"] = ship
    run_log["unjudged_lenses"] = unjudged
    (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
    if not ship and run_log["gate"].get("pass"):
        why = (f"{len(unjudged)} lens(es) never returned a verdict: {', '.join(unjudged)}"
               if unjudged else f"failing lenses: {', '.join(lens_fails)}")
        telegram_send_text(f"{slug}: gate PASSED but NOT shipping — {why}. "
                           f"An unjudged product is untested, not clean.")
        print(f"   NOT SHIPPING: {why}")

    print(f"\n== DONE {slug}: gate={'PASS' if run_log['gate'].get('pass') else 'FAIL'} "
          f"ship={'YES' if ship else 'NO'} "
          f"| {verdict.splitlines()[-1] if verdict else '?'}")
    print(f"   files: {files}")
    print(f"   total LLM cost: ${total:.4f}  (details: {out_dir}/run.json)")
    write_postmortem(slug)
    return 0


if __name__ == "__main__":
    sys.exit(main())
