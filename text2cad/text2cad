#!/usr/bin/env python3
"""text2cad — one-shot: text prompt -> print-ready 3D files (.step/.stl).

    ./text2cad "phone stand with cable slot"

Pipeline (each LLM phase is a headless `claude -p` session):
  1. BRIEF   shape-analysis skill  -> out/<slug>/brief.md
  2. BUILD   cadcode skill         -> params.py main.py <slug>.step <slug>.stl renders/
  3. GATE    gate.py (no LLM)      -> gate.json  (trimesh + optional OrcaSlicer)
  4. REVIEW  vision on renders     -> review_notes.md, repairs if needed

Routing: if PANDA_DEV_KEY is set in .env, sessions go through the panda-ccr
proxy (ANTHROPIC_BASE_URL/AUTH_TOKEN, proxy model strings). Otherwise DIRECT on
this machine's claude login. Per-phase models via BRIEF_MODEL/BUILD_MODEL/
REVIEW_MODEL in .env.
"""
import argparse
import json
import statistics
import threading
import os
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILLS = Path.home() / ".claude" / "skills"
CADCODE = SKILLS / "cadcode"
CAD_CMD = f"uv run --python 3.12 --with cadquery python3 {CADCODE}/scripts/cad"
REVIEW_CMD = f"uv run --python 3.12 --with cadquery python3 {CADCODE}/scripts/review"
MEASURE_CMD = f"uv run --python 3.12 --with cadquery python3 {CADCODE}/scripts/measure"
GATE_PY = HERE / "gate.py"
VENV_PY = HERE / ".venv" / "bin" / "python"

HEADLESS_WARNING = (
    "IMPORTANT — this is a one-shot, unattended, headless session. No future "
    "turn will wake you: never end your turn assuming something checks back. "
    "Wait on slow commands SYNCHRONOUSLY inside a single Bash call and keep "
    "issuing tool calls until the work is actually done.")

BLOCKING = "disconnected_bodies, collision, sliver, invalid_brep, empty, check_failed"


def load_env() -> None:
    env_file = HERE / ".env"
    if not env_file.is_file():
        return
    for line in env_file.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, _, v = line.partition("=")
            os.environ.setdefault(k.strip(), v.strip().strip('"'))


def phase_env() -> dict:
    env = dict(os.environ)
    env["PATH"] = "/root/.local/bin:" + env.get("PATH", "")
    # OOM guard: scripts/cad honors this as an address-space rlimit on itself.
    # 2026-08-13 the kernel OOM-killed a 15.4GB boolean chain and took the whole
    # cycle (and nearly the 15GB box) with it — a MemoryError inside one export
    # is repairable, a dead pipeline is not.
    env.setdefault("CADPY_MEM_LIMIT_MB", os.environ.get("CADPY_MEM_LIMIT_MB", "10240"))
    # 2026-08-17: BUILD spent its last hour on four ~15-minute attempts that each
    # died with "Claude's response exceeded the 64000 output token maximum",
    # producing nothing and burning $8.85. The largest tool call in that phase
    # was 296 characters, so the budget went on reasoning, not on writing files.
    # The error message names this variable as the control; raise it so a long
    # planning turn on a 14-part assembly has room to land.
    env.setdefault("CLAUDE_CODE_MAX_OUTPUT_TOKENS",
                   os.environ.get("CLAUDE_CODE_MAX_OUTPUT_TOKENS", "128000"))
    key = env.get("PANDA_DEV_KEY", "").strip()
    url = env.get("PROXY_URL", "").strip()
    if key and url:
        env["ANTHROPIC_BASE_URL"] = url
        env["ANTHROPIC_AUTH_TOKEN"] = key
    # Self-hosted lane (2026-08-18): SELFHOST_URL + SELFHOST_MODEL points EVERY
    # phase at an Anthropic-shaped gateway serving an open model. Deliberately a
    # separate switch from PANDA_DEV_KEY: that proxy fronts real Anthropic models
    # and keeps the `anthropic,` model prefix, this one does not.
    if selfhost_model():
        env["ANTHROPIC_BASE_URL"] = os.environ["SELFHOST_URL"].strip()
        env["ANTHROPIC_API_KEY"] = os.environ.get("SELFHOST_KEY", "").strip()
        env.pop("ANTHROPIC_AUTH_TOKEN", None)
        env.setdefault("CLAUDE_CODE_EFFORT_LEVEL",
                       os.environ.get("CLAUDE_CODE_EFFORT_LEVEL", "xhigh"))
    return env


def selfhost_model() -> str:
    """The model every phase runs on when the self-hosted gateway is armed."""
    if not os.environ.get("SELFHOST_URL", "").strip():
        return ""
    return os.environ.get("SELFHOST_MODEL", "").strip()


def model_for(phase: str) -> str:
    # The self-hosted lane is all-or-nothing on purpose: a per-phase override
    # here would silently route one phase back to Anthropic and make the
    # head-to-head numbers meaningless.
    sh = selfhost_model()
    if sh:
        return sh
    proxied = bool(os.environ.get("PANDA_DEV_KEY", "").strip())
    default = "anthropic,claude-sonnet-5" if proxied else "claude-sonnet-5"
    return os.environ.get(f"{phase.upper()}_MODEL", default)


_LOG_LOCK = threading.Lock()


def run_phase(name: str, prompt: str, out_dir: Path, max_turns: int, run_log: dict,
              timeout_s: int = 7200, model: str = "") -> str:
    # `model` overrides the {PHASE}_MODEL lookup: the panel runs many agents
    # under two budgets (propose = DISCOVER_MODEL, judge = JUDGE_MODEL) rather
    # than one env var per agent.
    model = model or model_for(name)
    # The per-phase timeouts below are sized for a CACHED prefix. The
    # self-hosted gateway reports cache_read=0 on every call (measured
    # 2026-08-18), so each turn re-pays full prefill at ~4k tok/s and the Opus-
    # era ceilings guillotine healthy phases. Scale them rather than editing 20
    # call sites.
    timeout_s = int(timeout_s * float(os.environ.get("PHASE_TIMEOUT_MULT", "1")))
    print(f"[{name}] model={model} max_turns={max_turns} "
          f"timeout={timeout_s}s ...", flush=True)
    t0 = time.time()
    allowed = ("Bash,Read,Write,Edit,Glob,Grep,TodoWrite,WebSearch,WebFetch,"
               "mcp__second-brain__memory_search,mcp__second-brain__memory_get,"
               "mcp__second-brain__memory_recent")
    cmd = ["claude", "-p", prompt, "--model", model,
           "--allowedTools", allowed,
           "--add-dir", str(out_dir), "--add-dir", str(SKILLS), "--add-dir", str(HERE),
           "--max-turns", str(max_turns), "--output-format", "json"]
    # 2026-08-16: the fidelity lens loaded all 14 part STLs into one trimesh
    # process, hit 14.8GB and the kernel OOM-killed the WHOLE pipeline. The
    # rlimit is inherited by every child of the phase, so a runaway load now
    # dies with a recoverable MemoryError inside the phase instead of taking
    # the box down. PHASE_MEM_MB=0 disables.
    cap_mb = int(os.environ.get("PHASE_MEM_MB", "12288"))
    preexec = None
    if cap_mb > 0:
        def preexec():
            import resource
            b = cap_mb << 20
            resource.setrlimit(resource.RLIMIT_AS, (b, b))
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=out_dir,
                           env=phase_env(), timeout=timeout_s, preexec_fn=preexec)
        try:
            data = json.loads(r.stdout.strip().splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            data = {"result": r.stdout[-2000:], "error": r.stderr[-2000:]}
        default_err = r.returncode != 0
    except subprocess.TimeoutExpired:
        data = {"result": "", "error": f"phase timed out after {timeout_s}s"}
        default_err = True
    # max_turns rides along so a postmortem can tell the two is_error cases
    # apart: num_turns at the cap is a BUDGET failure (the phase ran out of room
    # and needs a bigger cap or a narrower task), num_turns below it is a real
    # agent crash (retry). Without the cap on record they look identical.
    # `subtype` is the CLI's own verdict on HOW the phase ended — "success",
    # "error_max_turns", "error_during_execution". Everything downstream used to
    # infer starvation from num_turns >= max_turns, which is simply false: a
    # healthy judge came back 19/10 because num_turns counts messages, not agent
    # turns. Record the authoritative field instead of guessing from a proxy.
    # Self-hosted phases cost nothing per token, but the CLI does not know the
    # model and prices it as Anthropic anyway — measured 2026-08-18, a two-turn
    # "reply OK" was billed $0.157. Left alone that fiction lands in run.json,
    # phasecompare and the ledger. Record the real 0 and keep the CLI's figure
    # under cost_notional so the two lanes stay comparable on SOMETHING.
    cli_cost = data.get("total_cost_usd")
    entry = {"model": model, "wall_s": round(time.time() - t0, 1),
             "num_turns": data.get("num_turns"), "max_turns": max_turns,
             "subtype": data.get("subtype"),
             "cost_usd": 0.0 if selfhost_model() else cli_cost,
             # Cache accounting, measured 2026-08-17: the prompt prefix (system
             # prompt + tools + CLAUDE.md + skills) is shared across SEPARATE
             # headless invocations, so a phase either pays ~1.25x to WRITE that
             # prefix or ~0.1x to READ it. In a parallel fan-out exactly one
             # agent writes and the rest ride free, which is why judge-1 cost
             # $4.37 while judge-2/3 cost $0.83/$0.94 for identical work. Without
             # these fields that looks like a broken judge instead of the bill
             # for its two siblings.
             "cache_write": (data.get("usage") or {}).get("cache_creation_input_tokens"),
             "cache_read": (data.get("usage") or {}).get("cache_read_input_tokens"),
             "out_tokens": (data.get("usage") or {}).get("output_tokens"),
             "is_error": data.get("is_error", default_err)}
    if selfhost_model():
        entry["cost_notional"] = cli_cost
    with _LOG_LOCK:  # panel phases run concurrently
        # A re-judged lens or a repeated repair writes the SAME key, and the
        # old entry — with its cost — used to vanish. On 2026-08-17 three lens
        # re-runs and one build crash made run.json report $102.25 for a cycle
        # that actually spent $116.67, so every figure the pipeline published
        # about itself was 12% low. Keep the history beside the latest.
        prev = run_log.get(name)
        if isinstance(prev, dict) and "wall_s" in prev:
            n = 2
            while f"{name}#{n}" in run_log:
                n += 1
            run_log[f"{name}#{n}"] = prev
        run_log[name] = entry
        (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
    result = (data.get("result") or "").strip()
    print(f"[{name}] {entry['wall_s']}s, turns={entry['num_turns']}, "
          f"${entry['cost_usd']}: {result.splitlines()[-1][:120] if result else '(no output)'}", flush=True)
    # Quota death is a hard stop, not a phase failure: every phase rides the same
    # claude login, so once the weekly cap hits, each "retry" burns wall-clock and
    # produces nothing — the 08-13 cycle died this way SILENTLY. Alarm and abort.
    if entry["is_error"]:
        blob = (result + " " + str(data.get("error") or ""))[:2000]
        # covers "Claude AI usage limit reached", "5-hour limit reached",
        # "Weekly limit reached" — every phrasing the CLI uses for quota death
        if re.search(r"usage limit|limit reached|rate limit", blob, re.I):
            msg = (f"text2cad: claude quota exhausted during [{name}] — aborting the "
                   f"cycle (no PANDA_DEV_KEY fallback set). {blob[:200]}")
            print(msg, flush=True)
            telegram_send_text(msg)
            raise SystemExit(4)
    return result


