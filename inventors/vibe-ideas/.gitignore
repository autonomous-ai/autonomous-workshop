.env
.venv/
__pycache__/
*.pyc
board-game/images/
board-game/history/*/images/
board-game/.journal_log.jsonl
board-game/dashboard.html
board-game/.queue.lock
board-game/QUEUE.json.tmp.*
board-game/.telegram_offset
board-game/.telegram_pending.json
board-game/.telegram_messages.json
board-game/tools/bin/
board-game/.publish-*

# The old turn-based loop's archive. Nothing in the queue-based pipeline reads
# it — only contact_sheet.py and score_build.py, which belong to that same dead
# architecture. Kept on disk, out of the repo.
board-game/history/

# Loop-run logs of the CAD evaluator. Regenerated by
# scripts/run_codex_improvement_loop.py on every batch.
evaluate-cad-reconstruction/loop_runs/

# --- Generated CAD artifacts -------------------------------------------------
# The rule: commit what PRODUCES a thing, not the thing — except where the file
# is evidence about one specific moment and no clone can re-derive it
# (gate.json's measurement over a source hash, the lens verdicts, the two
# renders a human actually approved).
#
# Rebuild any of the below with:
#   .venv/bin/python cadcode/scripts/cad    <project_dir> --out-dir <project_dir>/build
#   .venv/bin/python cadcode/scripts/review <project_dir>
board-game/ideas/**/*.stl
board-game/ideas/**/*.step
board-game/ideas/**/*.step.json
board-game/ideas/**/*.png
!board-game/ideas/*/project/*_review/_assembled.png
!board-game/ideas/*/project/*_review/_qa.png
!board-game/ideas/*/reference/_assembled.png
!board-game/ideas/*/reference/_qa.png
# Pure functions of idea.json — `rules_check.py` / `ergonomics_check.py` give
# the same answer on any machine, so the answer is not worth storing.
board-game/ideas/*/rules_check.json
board-game/ideas/*/ergonomics_check.json
# These two generated receipts are nevertheless tracked at the pinned upstream
# commit and must remain part of this exact source snapshot.
!board-game/ideas/deep-claim/rules_check.json
!board-game/ideas/deep-claim/ergonomics_check.json
board-game/ideas/*/playtest.json
# Token counts and debriefs from one table run against one model. The sessions
# beside them ARE kept: those replay from a seed and a list of choices, and no
# clone can re-derive the choices a player made.
board-game/ideas/*/playtest/table/run_*.json

**/.DS_Store
