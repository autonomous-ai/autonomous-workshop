# Abstract Boardgame Oracle — runtime configuration.
#
# Every name here is ABO-scoped so two inventors can hold two endpoints without
# colliding. A real environment variable always wins over this file, a missing
# file is not an error, and nothing here is ever committed with a value in it.
#
# Absent any of these, the run parks with a typed Need rather than substituting
# a default. That is the point: a missing capability is a wait, never a guess.

# The model-seat endpoint. `agent-playtest` comes from games in which every
# seat's decision is made by an independent model, so without these there is no
# agent-playtest result and no `social` player style.
ABO_PLAYTEST_BASE_URL=
ABO_PLAYTEST_API_KEY=
ABO_PLAYTEST_MODEL=

# The nozzle the print profile will actually use, in millimetres. Without it
# `print-test` reports minimum wall thickness as unmeasured, and an unmeasured
# check never counts as a pass.
ABO_NOZZLE_MM=
