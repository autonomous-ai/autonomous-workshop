# Copy to .env (gitignored). Empty PANDA_DEV_KEY = run DIRECT on local claude login.

# --- panda-ccr proxy routing (same contract as minimax-panda) ---
PROXY_URL=https://api-panda.autonomous.ai
# From panda.autonomous.ai/profile/dev. When set, phases route via the proxy
# and models must use the proxy's "provider,model" format.
PANDA_DEV_KEY=

# --- Per-phase models. Defaults: claude-sonnet-5 (direct) or
#     anthropic,claude-sonnet-5 (proxy). Override to taste, e.g.:
# BRIEF_MODEL=anthropic,claude-haiku-4.5
# BUILD_MODEL=minimax,minimax/minimax-m3
# REVIEW_MODEL=anthropic,claude-sonnet-5

# --- Printability gate: OrcaSlicer CLI (leave either empty for mesh-only gate).
#     ORCA_PROFILE = "machine.json;process.json;filament.json" (3 full paths,
#     quoted — Orca system profiles contain spaces). Default: Bambu A1 mini.
ORCASLICER_CLI="/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer"
ORCA_PROFILE="/Applications/OrcaSlicer.app/Contents/Resources/profiles/BBL/machine/Bambu Lab A1 mini 0.4 nozzle.json;/Applications/OrcaSlicer.app/Contents/Resources/profiles/BBL/process/0.20mm Standard @BBL A1M.json;/Applications/OrcaSlicer.app/Contents/Resources/profiles/BBL/filament/Bambu PLA Basic @BBL A1M.json"
