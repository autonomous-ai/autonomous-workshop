# Bob runtime knobs — copy to .env (ops scripts `set -a` source it). All optional.
BOB_DAILY_BUDGET_USD=25
BOB_MAX_INFLIGHT=3
BOB_SEND_DRY_RUN=1             # 0 only after state/shop-auth.json holds the bob account
BOB_TELEGRAM_TOKEN=
BOB_TELEGRAM_CHAT=
# Per-phase model routing (defaults to claude-sonnet-5). Opus where mistakes cascade.
BOB_IDEATOR_MODEL=claude-opus-5
BOB_RULES_WRITER_MODEL=claude-opus-5
BOB_ENGINE_WRITER_MODEL=claude-opus-5
BOB_BRIEF_WRITER_MODEL=claude-opus-5
BOB_BUILDER_MODEL=claude-opus-5
BOB_IMPROVER_MODEL=claude-opus-5
# --- backstage: MAKE -> INSPECT -> PACK -> SEND ---
BOB_SEND_VIA=workshop    # the only autonomous path; unset also defaults to workshop
BOB_BOX_TEXT2GAME=/root/text2game
BOB_BOX_SSH=               # legacy/manual `bob export` compatibility only; never queue authority
BOB_SHOP_PUBLIC=0          # 1 = make the Shop Door draft public after Send
BOB_SHOP_API=https://panda-social-api.autonomous.ai/api/v1
BOB_SHOP_ALLOWED_ORIGINS=https://panda-social-api.autonomous.ai
BOB_SHOP_OWNER_ID=         # Bob's pinned Shop Door principal
BOB_WORKSHOP_SRC=        # optional absolute autonomous-workshop/src deployment pin
# Legacy BOB_PUBLISH_*, BOB_AUTO_FLIP, BOB_PORTAL_*, PORTAL_OWNER_ID,
# PANDA_OWNER_ID, BOB_PANDA_*, BOB_FOUNDATION_SRC, BOB_CORE_SRC, and doubled
# BOB_BOB_*_MODEL names are fallback-only;
# Bob refuses the affected deployment or send when a pair disagrees.
BOB_CAD_PY=                # python>=3.10 venv with cadgen==0.4.19 (ops/README.md) — enables real mesh checks + the build123d builder
