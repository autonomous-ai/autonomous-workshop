{
  "players": "2-4",
  "target_minutes": 20,
  "action_types": [
    "push_head_first",
    "push_tail_first",
    "probe"
  ],
  "rules": {
    "win": "The game ends at the end of the round in which any player's rack goes empty; the last push resolves in full. Score 1 point per tile in your score tray that is NOT your own colour, and 0 for tiles of your own colour. Tiles left in the rail or in a rack score for nobody. Most points wins. Tiebreak in order: fewest tiles of your own colour still in the rail, then fewest tiles of your own colour in other players' score trays, then most unspent probe chips, then the tied player sitting furthest clockwise from the start player."
  },
