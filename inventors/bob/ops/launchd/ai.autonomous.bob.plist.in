<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Main tick agent. StartInterval 1800s (30 min): the invent loop advances one
  step per tick, and text2cad's receipt says the unit of work must be an idea,
  not a burst - a slow steady cadence beats a daily monolith that loses the
  whole spend when killed (text2cad: "a kill loses the entire spend").
  bob.py tick is a logged no-op when audit/budget/lease say no, so a 30-min
  cadence is safe to fire around the clock.
-->
<dict>
    <key>Label</key>
    <string>ai.autonomous.bob</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/bob.py</string>
        <string>tick</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- RunAtLoad: first tick fires at install, so a fresh deploy proves
         itself immediately instead of 30 silent minutes later. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd agents get a bare PATH (/usr/bin:/bin); the claude CLI lives
         in ~/.local/bin, so harness/agents.py would fail with
         "claude: command not found" without this. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- Keep the scheduled process on the exact Foundation tree that
             install.sh validated, including nonstandard deployments. -->
        <key>BOB_CORE_SRC</key>
        <string>__CORE_SRC__</string>
    </dict>

    <!-- Both streams to one log: the watchdog greps its tail for Traceback,
         and text2cad got burned by buffered/split output ("for up to 8 hours
         there was no live log at all"). launchd appends, never buffers. -->
    <key>StandardOutPath</key>
    <string>__REPO__/state/logs/tick.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/state/logs/tick.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
