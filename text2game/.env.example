# .env.example - the COMPLETE contract for running text2game.
#
# Copy to .env (or drop in the one the owner hands you). Three kinds of line:
#   A. SECRETS      - only the owner has them; nothing runs end-to-end without
#   B. MACHINE PATHS - where the sibling toolchain lives on THIS machine;
#                      defaults are the panda VM layout, override elsewhere
#   C. DIALS/MODELS  - what the pipeline is told to do; the record of the run
# `./doctor.py` reads this file the way the phases do and prints what is missing.
# Setup on a fresh machine: SETUP.md.

# ===== A. SECRETS - from the owner =========================================
TELEGRAM_BOT_TOKEN=              # status + the decisions only a human can make
TELEGRAM_CHAT_DM=                # the chat id those go to
MEDIA_GATEWAY_KEY=               # MiniMax-H3 gateway (concept videos). Or leave
                                 # empty and point MEDIA_GATEWAY_KEY_FILE at a
                                 # file holding MEDIA_GATEWAY_API_KEY=...
# --- publish.py only (Panda Social DRAFT import) ---
ADMIN_TOKEN=                     # admindash API token
PANDA_OWNER_ID=                  # Mongo user id that owns the imported draft
MONGODB_URI=                     # or leave empty: publish reads PANDA_SECRETS_ENV
MONGODB_DBNAME=                  #   (below) line by line, never `source`d
GCS_BUCKET=
GCS_CDN_URL=
# The GCS service-account JSON is a FILE, not a line: text2cad's
# gcs_upload_project.py hardcodes /root/panda-secrets/gcs-sa.json - put the
# owner's file there (or a symlink). doctor.py checks that exact path.

# ===== B. MACHINE PATHS - defaults are the panda VM ========================
# The sibling text2cad checkout: gate.py, the cadcode skill + measure/cad
# runners, concept_image.py, gen_howto_video.py, the CAD venv, md2html.py,
# fe_colors.py, gcs_upload_project.py, bin/importdesign. Every script asks
# harness.text2cad_dir()/text2cad_py(); change it HERE, nowhere else.
TEXT2CAD_DIR=/root/text2cad
# TEXT2CAD_PY=/root/text2cad/.venv/bin/python   # cadquery trimesh numpy matplotlib
# RENDER_PY=                    # phase-2 renders; defaults to TEXT2CAD_PY
# MEASURE_CMD=                  # defaults to: uv run --python 3.12 --with cadquery python3 <TEXT2CAD_DIR>/skills/cadcode/scripts/measure
# SLICER_BIN=                   # defaults to prusa-slicer on PATH
# SLICER_PROFILE=               # defaults to profiles/petg.ini IN THIS REPO
# BACKEND_DIR=/root/panda-social-backend   # cwd for bin/importdesign (publish)
# ADMINDASH_URL=http://localhost:8090      # publish: product-page + thumbnails
# PANDA_SECRETS_ENV=/root/panda-secrets/.env   # publish fallback for MONGODB_URI/GCS_*
# GCS_PY=/root/gcsvenv/bin/python          # venv with google-cloud-storage (publish)
# UV_BIN=                       # defaults to uv on PATH
# CODEX_BIN=codex
# GAMEVAULT=/root/gamevault     # optional design vault (critic leads)
# SHARED_REPORTS=/root/shared-reports      # optional web dir (port 80) for videos/reports
# SHARED_REPORTS_URL=http://178.128.89.39  # ...and the URL it is served at
MEDIA_GATEWAY=https://2x4090-9091.eternalai.org
MEDIA_GATEWAY_KEY_FILE=/root/panda-secrets/media-gateway.env

# ===== C. DIALS AND MODELS - the record of what the pipeline was told =======
# --- phase 1: rules -------------------------------------------------------
MECHANISM_MODEL=claude-opus-5
GDD_MODEL=claude-opus-5
MANIFEST_MODEL=claude-opus-5
TODO_MODEL=claude-sonnet-5
REFEREE_MODEL=claude-sonnet-5
CRITIC_MODEL=claude-sonnet-5
EVALUATE_MODEL=claude-sonnet-5
EVALUATE_REPS=3        # median over independent reads, like the judges
REVISE_MODEL=claude-opus-5
PRIORART_MODEL=claude-sonnet-5

REFEREE_GAMES=3        # games played against the rules each round
MAX_ROUNDS=3           # loop rounds before the checkpoint reports as-is
SCULPT_MAX=3           # parts allowed down the TRELLIS route (HF ZeroGPU: ~2-3/day)
PLATE_MM=160           # per-part footprint gate

# --- phase 2/3: geometry and print ---------------------------------------
# build and repair resolve their model from the JOB name, never from the run
# label: a label like build-g3 cannot be an env var name, and until 2026-08-19
# every group silently took the sonnet default because of it.
#
# Sonnet on build/repair is a CHOICE (Tam, 2026-08-19), not that old default.
# Phase 2 is seven bounded sessions and each one is measured against the
# contract and gated for printability with two repairs before it stops, so a
# weak build is caught by a machine rather than shipped.
ART_DIRECTION_MODEL=claude-opus-5
BUILD_MODEL=claude-sonnet-5
REPAIR_MODEL=claude-sonnet-5
COHERENCE_MODEL=claude-sonnet-5
RULEBOOK_MODEL=claude-sonnet-5
VIDEO_SPEC_MODEL=claude-sonnet-5

BUILD_TURNS=120
COHERENCE_MIN=6        # below this, --phase all will not continue to phase 3
BED_X=256              # printer bed for plate packing
BED_Y=256

# --- DISCOVER panel -------------------------------------------------------
# DISCOVER decides WHAT gets made, and until 2026-08-20 it was the only stage
# with no model line at all: model_for("discover") found no DISCOVER_MODEL and
# fell through to the sonnet default, so the cheapest model in the config was
# choosing the product while opus wrote the rules for it. Both jobs are opus
# now (Tam, 2026-08-20) - the proposers because a lane that cannot invent
# cannot be judged into inventing, and the judges because `desire` is scored on
# a NAME, a BOX-FACE and a FIRST-LOOK and nothing else, and that is the axis
# that kept passing games nobody would pick up in a shop.
DISCOVER_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5

NOVELTY=8
MECHANISM=8
ORNAMENT=4
CRAFT=7
PARTS=6-10
NOVELTY_MIN=5
BUILDABLE_MIN=7
TEACH_MIN=7           # 5th judge axis: minutes to teach a stranger
                      # 6th axis is `resonance` - objective only, no floor
LANE_PENALTY=2        # points off the objective per consecutive repeat
LANE_PENALTY_CAP=2    # ...and the streak stops counting after this many
GDD_MAX_WORDS=1800
GDD_MAX_GLOSSARY=5
# Raised 40 -> 55 on 2026-08-20, same reason JUDGE_TURNS went 14 -> 22 the
# hour before: floors_block() made the propose prompt longer and propose-coop
# came back at 39 of 40 turns - one from the cap, 1212s, $4.06 - while family
# used 21 and legacy 29. Coop is the lane that has to invent hardest here, and
# it is the lane that produced the winner. A truncated proposer writes fewer
# candidates, not worse ones, so this fails silently.
DISCOVER_TURNS=55
# Raised 14 -> 22 on 2026-08-20. The first opus panel came back at 13/14,
# 14/14 and 13/14 turns: judge-2 was truncated AT the cap and still recorded
# subtype=success, and pick_winner takes MEDIANS over the three, so a silently
# half-scored judge moves the winner. 14 was sized when judges ran sonnet.
JUDGE_TURNS=22

# --- provider routing -----------------------------------------------------
# Which JOBS run on `codex exec` instead of `claude -p`. Comma list, or the
# aliases: `phase1` (mechanism,gdd,manifest,todo,referee,critic,evaluate,
# revise,priorart) or `phase23` (art_direction,build,repair,coherence,rulebook,
# video_spec), `all`, or `none`. Same flag on the driver: --codex.
# `all` really does mean all since 2026-08-19: build and repair used to be
# spared because their prompts said "Use the cadcode skill", but prompts.skill()
# now hands codex the handbook by path, so SKILL_BOUND is empty.
# DISCOVER is NOT in either alias - its two jobs stay on claude unless named.
# CODEX_JOBS=phase23
# CODEX_MODEL=gpt-5.6-sol   # this box's default; ChatGPT Pro, no per-token cost
# CODEX_EFFORT=high         # gpt-5.6-sol ships at "none"
# CODEX_SANDBOX=danger-full-access   # parity with how claude -p already runs here

# --- this run's target: easy to play, funny, trending ---
# RUN_TONE=  # one line, free text: the tone this run is for (funny, tense,
#            # gentle). Empty = no tone directive, the historical behaviour.
# TEACH_WEIGHT=1  # weight of `teach` in the DISCOVER objective. 1 = default.


# Design vault (github: gamevault). The critic gets machine-checked leads from
# check_compatibility() over the draft's mechanisms - conflicts, anti-pattern
# risks, recorded fixes. Empty map warns loudly and the critic runs without.
#CRITIC_VAULT=off
#VAULT_INGEST=off  # phase 3 end banks the run's harvest rows into the vault

# --- concept video (2026-08-22): after every DISCOVER, a 12-second MiniMax-H3
# t2va clip of the winner being PLAYED is generated from the winner block and
# sent to Telegram - the human gates phase 1 on seeing the concept move.
# Facts and failure modes: /root/docs/minimax-h3-gateway.md (cold start 35+min,
# jobs zombie, no cancel -> abandon-and-resubmit, curl only - WAF blocks urllib).
CONCEPT_VIDEO=on                 # off = skip entirely, panel is never blocked
CONCEPT_VIDEO_SECONDS=12         # 12 verified on the gateway; above untested

# --- the lid budget (2026-08-22, after dead-stop): rules that fit the box lid.
# Three critic rounds bought agency +1 with seats, lanes, spares, a seed and a
# rotation rule; the read-aloud hit 520 words inside GDD_MAX_WORDS=1800. These
# are the numbers that say "easy to play" where a checker can enforce them.
GDD_MAX_WORDS=900
GDD_MAX_RULE_NUMBERS=40
FIRST_MINUTE_MAX_WORDS=220
TURN_MAX_STEPS=4
# MECH_SOLITAIRE=allow   # owner override: a design that is a solo dexterity race by intent (no interaction id); never a default
